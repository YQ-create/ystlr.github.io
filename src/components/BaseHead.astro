---
// 全站 <head>：元信息、字体、RSS/站点地图、视图过渡路由。
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	/** 不希望被搜索引擎收录的页面（如 404） */
	noindex?: boolean;
}

const {
	title,
	description = SITE_DESCRIPTION,
	image = FallbackImage,
	noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image.src, Astro.url);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#181512" />
<meta name="color-scheme" content="dark" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<script is:inline>
	/* 站点固定深色，只把 data-theme=dark 写进 <html> 并补 js 类。
	   View Transitions 切页时 Astro 会用新文档的 <html> 属性覆盖当前节点，
	   所以 after-swap 立刻再写一次，保证深色 token 不丢。 */
	(() => {
		const d = document.documentElement;
		d.classList.add('js');
		const sync = () => {
			d.classList.add('js');
			d.dataset.theme = 'dark';
			d.dataset.glass = 'frosted';
		};
		sync();
		document.addEventListener('astro:after-swap', sync);
		document.addEventListener('astro:page-load', sync);
	})();
</script>
{noindex && <meta name="robots" content="noindex" />}

<Font cssVariable="--font-atkinson" preload />

<!-- 没有 JS 时把「滚动进场」的初始隐藏关掉，内容照常可见 -->
<noscript>
	<style>
		[data-reveal] {
			opacity: 1 !important;
			transform: none !important;
			filter: none !important;
			clip-path: none !important;
			-webkit-mask-image: none !important;
			mask-image: none !important;
		}
	</style>
</noscript>

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- 页面切换：淡入上浮；页头通过 transition:persist 保活，切换时不闪 -->
<script is:inline>
	// Chromium 137+ 的 Element.moveBefore() 禁止跨文档移动节点，而 Astro 的
	// transition:persist 会先把保活节点移出 body，再把它插进 DOMParser 新建的下一个
	// 文档里，于是抛 HierarchyRequestError 并让整次 View Transition 中止（表现是点了
	// 导航后地址栏不变、页面“看起来没跳”）。跨文档时退化成 insertBefore：节点身份
	// 仍然保留，只是有一瞬脱离文档。上游修复后可删除这段。
	(() => {
		const native = Element.prototype.moveBefore;
		if (typeof native !== 'function') return;
		Element.prototype.moveBefore = function (node, child) {
			try {
				return native.call(this, node, child);
			} catch {
				// 跨文档，或目标父节点不允许该子元素（例如直接挂到 <html> 下）时退化为
				// insertBefore：节点身份保留，代价是有一瞬脱离文档。
				return this.insertBefore(node, child);
			}
		};
	})();
</script>
<ClientRouter />
