---
// 全站 <head>：元信息、字体、RSS/站点地图、视图过渡路由。
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	/** 不希望被搜索引擎收录的页面（如 404） */
	noindex?: boolean;
	/** 页面类型：website（默认）| article（文章页，触发 BlogPosting JSON-LD） */
	type?: 'website' | 'article';
	/** 文章发布时间（article 类型时用于 article:published_time 与 JSON-LD） */
	publishedTime?: Date;
}

const {
	title,
	description = SITE_DESCRIPTION,
	image = FallbackImage,
	noindex = false,
	type = 'website',
	publishedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image.src, Astro.url);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0a0a0b" />
<meta name="color-scheme" content="dark" />
<!-- GitHub Pages 无法下发 CSP 响应头，用 meta 兜一层（静态站需内联脚本，故允许 unsafe-inline） -->
<meta
	http-equiv="Content-Security-Policy"
	content="default-src 'self'; script-src 'self' 'unsafe-inline' https://giscus.app; img-src 'self' data: https: blob:; style-src 'self' 'unsafe-inline'; frame-src https://giscus.app; connect-src 'self' https://api.github.com; font-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'"
/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<!-- 首屏防白闪：CSS 加载前先把当前主题背景铺上，避免主题闪一下 -->
<style is:inline>
	html {
		background-color: #181512;
		color-scheme: dark;
	}
	html[data-theme='light'] {
		background-color: #f6f3ee;
		color-scheme: light;
	}
</style>
<script is:inline>
	/* 默认深色，用户手动切换后记住偏好（localStorage）。
	   View Transitions 切页时 Astro 会用新文档的 <html> 属性覆盖当前节点，
	   所以 after-swap 立刻再写一次，保证主题 token 不丢。 */
	(() => {
		const d = document.documentElement;
		const KEY = 'ystlr-theme';
		const ACCENT_KEY = 'ystlr-accent';
		const ACCENTS = ['orange', 'blue', 'teal', 'violet', 'pink'];
		const sync = () => {
			d.classList.add('js');
			let theme = 'dark';
			try {
				const stored = localStorage.getItem(KEY);
				if (stored === 'dark' || stored === 'light') theme = stored;
			} catch {}
			d.dataset.theme = theme;
			d.dataset.glass = 'frosted';
			// 调色盘：默认暖橙
			let accent = 'orange';
			try {
				const stored = localStorage.getItem(ACCENT_KEY);
				if (stored && ACCENTS.includes(stored)) accent = stored;
			} catch {}
			d.dataset.accent = accent;
			window.__setTheme = (t) => {
				d.dataset.theme = t;
				try {
					localStorage.setItem(KEY, t);
				} catch {}
				// 广播给评论等需要跟随主题的第三方组件
				window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: t } }));
			};
			window.__getTheme = () => d.dataset.theme || 'dark';
			window.__setAccent = (a) => {
				if (!ACCENTS.includes(a)) return;
				d.dataset.accent = a;
				try {
					localStorage.setItem(ACCENT_KEY, a);
				} catch {}
				window.dispatchEvent(new CustomEvent('accent-change', { detail: { accent: a } }));
			};
			window.__getAccent = () => d.dataset.accent || 'orange';
		};
		sync();
		document.addEventListener('astro:after-swap', sync);
		document.addEventListener('astro:page-load', sync);
	})();
</script>
{noindex && <meta name="robots" content="noindex" />}

<Font cssVariable="--font-atkinson" preload />

<!-- 没有 JS 时把「滚动进场」的初始隐藏关掉，内容照常可见 -->
<noscript>
	<style>
		[data-reveal] {
			opacity: 1 !important;
			transform: none !important;
			filter: none !important;
			clip-path: none !important;
			-webkit-mask-image: none !important;
			mask-image: none !important;
		}
	</style>
</noscript>

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{type === 'article' && publishedTime && (
	<meta property="article:published_time" content={publishedTime.toISOString()} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{type === 'article' && (
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description: description,
			image: ogImage.toString(),
			datePublished: publishedTime?.toISOString(),
			dateModified: publishedTime?.toISOString(),
			author: { '@type': 'Person', name: AUTHOR_NAME },
			publisher: { '@type': 'Person', name: AUTHOR_NAME },
			mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
		})}
	/>
)}

<!-- 页面切换：淡入上浮；页头通过 transition:persist 保活，切换时不闪 -->
<script is:inline>
	// 兼容补丁（monkey-patch）：Chromium 137+ 的 Element.moveBefore() 禁止跨文档移动节点，
	// 而 Astro 的 transition:persist 会先把保活节点移出 body，再把它插进 DOMParser 新建的下一个
	// 文档里，于是抛 HierarchyRequestError 并让整次 View Transition 中止（表现是点了
	// 导航后地址栏不变、页面"看起来没跳"）。这里在跨文档时退化成 insertBefore：节点身份
	// 仍然保留，只是有一瞬脱离文档。
	// 移除条件：升级 Astro 后，若官方已修复「transition:persist 跨文档移动」问题（验证方式：
	// 删除本段，在 Chrome 137+ 上点导航，确认 View Transition 正常、地址栏正常变化），即可移除。
	(() => {
		const native = Element.prototype.moveBefore;
		if (typeof native !== 'function') return;
		Element.prototype.moveBefore = function (node, child) {
			try {
				return native.call(this, node, child);
			} catch {
				// 跨文档，或目标父节点不允许该子元素（例如直接挂到 <html> 下）时退化为
				// insertBefore：节点身份保留，代价是有一瞬脱离文档。
				return this.insertBefore(node, child);
			}
		};
	})();
</script>
<ClientRouter />
