---
/**
 * ChromaGrid — 彩色追光照片网格（1:1 移植 React Bits 官方 ChromaGrid，纯 CSS + 原生 JS，无 React）。
 *
 * 官方机制：整片网格维护一个「全局光源」(--chroma-x/--chroma-y/--chroma-power)，
 * 光标移动时经阻尼平滑跟随；每张卡片用 --chroma-ox/--chroma-oy 记录相对网格的偏移，
 * 彩色层以 radial-gradient 做 mask，只在光源处露出彩色，其余灰度。移出整片网格时 power 淡出。
 *
 * 卡片视觉：深色/浅色底衬面板(tile) + 内嵌圆角图片 + 底部标题/副标题 + 追光时彩色描边光晕。
 *
 * 数据约定：image 需为可访问的 URL（本地图请用 astro:assets 的 getImage 转 URL 后传入）。
 *
 * Props（语义与官方一致）：
 *   items        { image, title?, subtitle?, accent?, url?, alt?, borderColor?, lightbox? }[]
 *   lightbox     可选扩展：设置后卡片渲染成 <button data-lightbox>，点击派发灯箱（用于照片墙放大）
 *   columns      列数上限
 *   minCardWidth 卡片最小宽度（px）
 *   gap          间距（px）
 *   radius       聚光灯半径（px）
 *   softness     光斑边缘柔和度 0~1
 *   damping      光标跟随阻尼
 *   fadeOut      移开后淡出时长（秒）
 *   grayscale    灰度强度 0~1
 *   dim          压暗强度 0~1
 *   glow         底部强调色光晕强度
 *   borderGlow   边框彩色发光强度
 *   reveal       'spotlight'（追光）| 'card'（悬停整卡恢复彩色）
 *   aspectRatio  图片宽高比
 *   cardRadius   卡片圆角（px）
 *   showInfo     是否显示标题/副标题
 *   frame        是否套磨砂玻璃外框
 *   theme        'dark' | 'light'
 *   class        额外类名
 */
interface Item {
	image: string;
	title?: string;
	subtitle?: string;
	accent?: string;
	url?: string;
	alt?: string;
	borderColor?: string;
	/** 大图 URL：设置后卡片变为可点击按钮，点击走 data-lightbox 灯箱 */
	lightbox?: string;
}

interface Props {
	items?: Item[];
	columns?: number;
	minCardWidth?: number;
	gap?: number;
	radius?: number;
	softness?: number;
	damping?: number;
	fadeOut?: number;
	grayscale?: number;
	dim?: number;
	glow?: number;
	borderGlow?: number;
	reveal?: 'spotlight' | 'card';
	aspectRatio?: string;
	cardRadius?: number;
	showInfo?: boolean;
	frame?: boolean;
	theme?: 'dark' | 'light';
	class?: string;
}

const {
	items = [],
	columns = 3,
	minCardWidth = 180,
	gap = 12,
	radius = 260,
	softness = 0.6,
	damping = 0.45,
	fadeOut = 0.6,
	grayscale = 1,
	dim = 0.12,
	glow = 0.5,
	borderGlow = 1,
	reveal = 'spotlight',
	aspectRatio = '3 / 2',
	cardRadius = 22,
	showInfo = true,
	frame = false,
	theme = 'dark',
	class: className = '',
} = Astro.props;

const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

// 官方柔化边缘：smoothstep 生成 13 段渐变 stop
function falloffStops(soft: number): string {
	const core = clamp(1 - soft, 0, 0.95);
	const stops: string[] = [];
	for (let i = 0; i <= 12; i++) {
		const t = i / 12;
		const u = clamp((t - core) / Math.max(0.0001, 1 - core), 0, 1);
		const alpha = 1 - u * u * u * (u * (u * 6 - 15) + 10);
		stops.push(`rgba(0, 0, 0, ${alpha.toFixed(3)}) ${(t * 100).toFixed(1)}%`);
	}
	return stops.join(', ');
}

// 官方内置深/浅主题的中性色变量
const THEMES: Record<'dark' | 'light', Record<string, string>> = {
	dark: {
		'--chroma-frame': 'rgba(38, 35, 46, 0.66)',
		'--chroma-frame-edge': 'rgba(255, 255, 255, 0.08)',
		'--chroma-frame-highlight': 'rgba(255, 255, 255, 0.07)',
		'--chroma-frame-shadow': '0 22px 44px -20px rgba(0, 0, 0, 0.8), 0 6px 16px -8px rgba(0, 0, 0, 0.5)',
		'--chroma-tile': 'linear-gradient(180deg, #3a3644 0%, #27242f 100%)',
		'--chroma-tile-edge': 'rgba(255, 255, 255, 0.07)',
		'--chroma-tile-highlight': 'rgba(255, 255, 255, 0.12)',
		'--chroma-tile-shadow': '0 4px 10px -4px rgba(0, 0, 0, 0.7)',
		'--chroma-media-edge': 'rgba(255, 255, 255, 0.06)',
		'--chroma-well': 'rgba(255, 255, 255, 0.08)',
		'--chroma-ink': '#f4f4f5',
		'--chroma-muted': 'rgba(244, 244, 245, 0.55)',
		'--chroma-hover': 'brightness(1.12)',
		'--chroma-press': 'brightness(0.85)',
	},
	light: {
		'--chroma-frame': 'rgba(240, 240, 243, 0.8)',
		'--chroma-frame-edge': 'rgba(24, 24, 27, 0.07)',
		'--chroma-frame-highlight': 'rgba(255, 255, 255, 0.95)',
		'--chroma-frame-shadow': '0 22px 44px -22px rgba(24, 24, 27, 0.3), 0 6px 16px -10px rgba(24, 24, 27, 0.16)',
		'--chroma-tile': 'linear-gradient(180deg, #ffffff 0%, #f6f6f8 100%)',
		'--chroma-tile-edge': 'rgba(24, 24, 27, 0.08)',
		'--chroma-tile-highlight': 'rgba(255, 255, 255, 1)',
		'--chroma-tile-shadow': '0 4px 10px -5px rgba(24, 24, 27, 0.25)',
		'--chroma-media-edge': 'rgba(24, 24, 27, 0.06)',
		'--chroma-well': 'rgba(24, 24, 27, 0.05)',
		'--chroma-ink': '#27272a',
		'--chroma-muted': 'rgba(39, 39, 42, 0.55)',
		'--chroma-hover': 'brightness(0.97)',
		'--chroma-press': 'brightness(0.92)',
	},
};

const themeVars = THEMES[theme] ?? THEMES.dark;

const rootVars: Record<string, string> = {
	...themeVars,
	'--chroma-cols': String(Math.max(1, Math.round(columns))),
	'--chroma-min': `${Math.max(80, minCardWidth)}px`,
	'--chroma-gap': `${Math.max(0, gap)}px`,
	'--chroma-r': `${Math.max(20, radius)}px`,
	'--chroma-stops': falloffStops(clamp(softness, 0, 1)),
	'--chroma-gray': String(clamp(grayscale, 0, 1)),
	'--chroma-dim': String(clamp(dim, 0, 0.9)),
	'--chroma-glow': String(clamp(glow, 0, 1)),
	'--chroma-border': String(clamp(borderGlow, 0, 1)),
	'--chroma-fade': `${Math.max(0, fadeOut)}s`,
	'--chroma-ratio': aspectRatio,
	'--chroma-radius': `${Math.max(0, cardRadius)}px`,
};

const safeItems = items.map((it, i) => ({
	image: it.image,
	title: it.title ?? '',
	subtitle: it.subtitle ?? '',
	accent: it.accent ?? it.borderColor ?? '#ffffff',
	url: it.url ?? null,
	alt: it.alt ?? it.title ?? '',
	lightbox: it.lightbox ?? null,
	key: i,
}));

const styleString = Object.entries(rootVars)
	.map(([k, v]) => `${k}:${v}`)
	.join(';');
---

<div
	class={`chroma-grid${frame ? ' has-frame' : ''}${className ? ` ${className}` : ''}`}
	data-chroma
	data-reveal={reveal === 'card' ? 'card' : 'spotlight'}
	data-theme={theme}
	data-cfg={JSON.stringify({ damping, fadeOut })}
	style={styleString}
>
	<div class="chroma-grid-inner">
		{safeItems.map((item) => {
			const accent = item.accent;
			const body = (
				<>
					<span class="chroma-wash" aria-hidden="true"></span>
					<div class="chroma-media" data-chroma-area>
						<img class="chroma-mono" src={item.image} alt={item.alt} loading="lazy" />
						<img class="chroma-color" src={item.image} alt="" aria-hidden="true" loading="lazy" />
						<span class="chroma-media-rim" aria-hidden="true"></span>
					</div>
					{showInfo && (item.title || item.subtitle) ? (
						<div class="chroma-info">
							{item.title && <span class="chroma-title">{item.title}</span>}
							{item.subtitle && <span class="chroma-subtitle">{item.subtitle}</span>}
						</div>
					) : null}
					<span class="chroma-card-rim" aria-hidden="true"></span>
					<span class="chroma-card-glow" aria-hidden="true"></span>
				</>
			);
			const cardStyle = `--chroma-accent:${accent};`;
			return item.lightbox ? (
				<button
					class="chroma-card"
					data-chroma-area
					style={cardStyle}
					type="button"
					data-lightbox
					data-full={item.lightbox}
					data-caption={item.title || item.subtitle || ''}
					aria-label={`放大查看：${item.title || '照片'}`}
				>
					{body}
				</button>
			) : item.url ? (
				<a
					class="chroma-card"
					data-chroma-area
					style={cardStyle}
					href={item.url}
					target="_blank"
					rel="noopener noreferrer"
				>
					{body}
				</a>
			) : (
				<article class="chroma-card" data-chroma-area style={cardStyle}>
					{body}
				</article>
			);
		})}
	</div>
	{frame && <span class="chroma-frame-rim" aria-hidden="true"></span>}
</div>

<style>
	.chroma-grid {
		--chroma-x: -9999px;
		--chroma-y: -9999px;
		--chroma-power: 0;
		position: relative;
		width: 100%;
		box-sizing: border-box;
		-webkit-tap-highlight-color: transparent;
	}

	.chroma-grid.has-frame {
		padding: 10px;
		border-radius: calc(var(--chroma-radius) + 10px);
		background: var(--chroma-frame);
		box-shadow: var(--chroma-frame-shadow);
		-webkit-backdrop-filter: blur(20px) saturate(1.6);
		backdrop-filter: blur(20px) saturate(1.6);
	}

	.chroma-frame-rim {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow:
			inset 0 0 0 1px var(--chroma-frame-edge),
			inset 0 1px 0 var(--chroma-frame-highlight);
		pointer-events: none;
	}

	.chroma-grid-inner {
		display: grid;
		gap: var(--chroma-gap);
		grid-template-columns: repeat(
			auto-fill,
			minmax(
				min(
					100%,
					max(var(--chroma-min), calc((100% - (var(--chroma-cols) - 1) * var(--chroma-gap)) / var(--chroma-cols)))
				),
				1fr
			)
		);
	}

	.chroma-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 10px;
		min-width: 0;
		padding: 8px;
		box-sizing: border-box;
		border: none;
		border-radius: var(--chroma-radius);
		background: var(--chroma-tile);
		box-shadow: var(--chroma-tile-shadow);
		color: var(--chroma-ink);
		text-decoration: none;
		font: inherit;
		text-align: left;
		overflow: hidden;
		isolation: isolate;
		transition: filter 0.25s ease;
	}
	.chroma-card:hover {
		filter: var(--chroma-hover);
	}
	a.chroma-card:active,
	button.chroma-card:active {
		filter: var(--chroma-press);
	}
	a.chroma-card:focus-visible,
	button.chroma-card:focus-visible {
		outline: 2px solid var(--chroma-ink);
		outline-offset: 2px;
	}
	button.chroma-card {
		cursor: pointer;
	}

	.chroma-wash,
	.chroma-color,
	.chroma-card-glow {
		-webkit-mask-image: radial-gradient(
			circle var(--chroma-r) at calc(var(--chroma-x) - var(--chroma-ox, 0px))
				calc(var(--chroma-y) - var(--chroma-oy, 0px)),
			var(--chroma-stops)
		);
		mask-image: radial-gradient(
			circle var(--chroma-r) at calc(var(--chroma-x) - var(--chroma-ox, 0px))
				calc(var(--chroma-y) - var(--chroma-oy, 0px)),
			var(--chroma-stops)
		);
	}

	.chroma-wash {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background: radial-gradient(130% 70% at 50% 100%, var(--chroma-accent), transparent 72%);
		opacity: calc(var(--chroma-glow) * var(--chroma-power) * 0.45);
	}

	.chroma-media {
		position: relative;
		z-index: 1;
		aspect-ratio: var(--chroma-ratio);
		border-radius: max(0px, calc(var(--chroma-radius) - 8px));
		overflow: hidden;
		background: var(--chroma-well);
	}

	.chroma-media img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		user-select: none;
		-webkit-user-drag: none;
	}

	.chroma-mono {
		filter: grayscale(var(--chroma-gray)) brightness(calc(1 - var(--chroma-dim)));
	}

	.chroma-color {
		opacity: var(--chroma-power);
	}

	.chroma-media-rim {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 0 0 1px var(--chroma-media-edge);
		pointer-events: none;
	}

	.chroma-info {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
		padding: 2px 6px 4px;
	}

	.chroma-title {
		overflow: hidden;
		font-size: 15px;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.01em;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.chroma-subtitle {
		overflow: hidden;
		font-size: 13px;
		line-height: 1.35;
		color: var(--chroma-muted);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.chroma-card-rim,
	.chroma-card-glow {
		position: absolute;
		inset: 0;
		z-index: 2;
		border-radius: inherit;
		pointer-events: none;
	}

	.chroma-card-rim {
		box-shadow:
			inset 0 0 0 1px var(--chroma-tile-edge),
			inset 0 1px 0 var(--chroma-tile-highlight);
	}

	.chroma-card-glow {
		box-shadow:
			inset 0 0 0 1px var(--chroma-accent),
			inset 0 0 16px -8px var(--chroma-accent);
		opacity: calc(var(--chroma-border) * var(--chroma-power));
	}

	.chroma-grid[data-reveal='card'] .chroma-wash,
	.chroma-grid[data-reveal='card'] .chroma-color,
	.chroma-grid[data-reveal='card'] .chroma-card-glow {
		-webkit-mask-image: none;
		mask-image: none;
		opacity: 0;
		transition: opacity var(--chroma-fade) ease;
	}
	.chroma-grid[data-reveal='card'] .chroma-card:hover .chroma-wash {
		opacity: calc(var(--chroma-glow) * 0.45);
		transition-duration: 0.3s;
	}
	.chroma-grid[data-reveal='card'] .chroma-card:hover .chroma-color {
		opacity: 1;
		transition-duration: 0.3s;
	}
	.chroma-grid[data-reveal='card'] .chroma-card:hover .chroma-card-glow {
		opacity: var(--chroma-border);
		transition-duration: 0.3s;
	}
</style>

<script>
	// ===== 原生 JS 移植 ChromaGrid（官方逻辑 1:1） =====
	// 每个 .chroma-grid 实例维护自己的光源状态；rAF 循环做阻尼跟随。
	const init = () => {
		document.querySelectorAll<HTMLElement>('[data-chroma]').forEach((root) => {
			if (root.dataset.chromaReady === '1') return;
			root.dataset.chromaReady = '1';

			const cfg = (() => {
				try {
					return JSON.parse(root.dataset.cfg || '{}');
				} catch {
					return {};
				}
			})();
			// 配置优先取 data-cfg，缺省读内联 CSS 变量
			const damping = Number(cfg.damping ?? 0.45);
			const fadeOut = Number(cfg.fadeOut ?? 0.6);
			const spotlight = (root.dataset.reveal ?? 'spotlight') !== 'card';

			const state = { x: 0, y: 0, tx: 0, ty: 0, power: 0, target: 0, primed: false };
			let raf = 0;
			let last = 0;
			const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

			const place = () => {
				const box = root.getBoundingClientRect();
				root.querySelectorAll<HTMLElement>('[data-chroma-area]').forEach((node) => {
					const rect = node.getBoundingClientRect();
					node.style.setProperty('--chroma-ox', `${rect.left - box.left}px`);
					node.style.setProperty('--chroma-oy', `${rect.top - box.top}px`);
				});
			};

			const frame = (now: number) => {
				raf = 0;
				const dt = last ? Math.min(0.05, (now - last) / 1000) : 1 / 60;
				last = now;
				const follow = reduce ? 1 : 1 - Math.exp(-dt / Math.max(0.01, damping * 0.32));
				state.x += (state.tx - state.x) * follow;
				state.y += (state.ty - state.y) * follow;
				const span = state.target > state.power ? 0.1 : Math.max(0.02, fadeOut * 0.35);
				state.power += (state.target - state.power) * (reduce ? 1 : 1 - Math.exp(-dt / span));
				root.style.setProperty('--chroma-x', `${state.x.toFixed(2)}px`);
				root.style.setProperty('--chroma-y', `${state.y.toFixed(2)}px`);
				root.style.setProperty('--chroma-power', state.power.toFixed(4));
				const settled =
					Math.abs(state.tx - state.x) < 0.1 &&
					Math.abs(state.ty - state.y) < 0.1 &&
					Math.abs(state.target - state.power) < 0.002;
				if (settled) {
					state.power = state.target;
					root.style.setProperty('--chroma-power', state.power.toFixed(4));
					last = 0;
				} else {
					raf = requestAnimationFrame(frame);
				}
			};

			const wake = () => {
				if (!raf) raf = requestAnimationFrame(frame);
			};

			const onMove = (event: PointerEvent) => {
				if (!spotlight) return;
				const box = root.getBoundingClientRect();
				state.tx = event.clientX - box.left;
				state.ty = event.clientY - box.top;
				if (!state.primed || state.power < 0.02) {
					state.x = state.tx;
					state.y = state.ty;
					state.primed = true;
				}
				state.target = 1;
				wake();
			};

			const onLeave = () => {
				state.target = 0;
				wake();
			};

			const ro = new ResizeObserver(place);
			ro.observe(root);
			root.addEventListener('pointermove', onMove, { passive: true });
			root.addEventListener('pointerdown', onMove);
			root.addEventListener('pointerleave', onLeave);
			root.addEventListener('pointercancel', onLeave);
			place();
		});
	};

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
	else init();
	document.addEventListener('astro:page-load', init);
</script>
