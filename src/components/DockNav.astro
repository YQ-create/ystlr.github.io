---
// 移动端底部导航：文字标签常显（首页/文章/知识库/发现/关于）。
// 桌面端由顶部 Header 主导航负责，这里在 ≥861px 隐藏；窄屏作为底部导航。
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const items = [
	{ href: '/', label: '首页' },
	{ href: '/blog', label: '文章' },
	{ href: '/knowledge', label: '知识库' },
	{ href: '/discover', label: '发现' },
	{ href: '/about', label: '关于' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<nav class="dock" data-dock aria-label="主导航" transition:persist="site-dock">
	{items.map((item) => (
		<a
			class:list={['dock__tab', { 'is-active': isActive(item.href) }]}
			href={item.href}
			aria-current={isActive(item.href) ? 'page' : undefined}
		>
			<span class="dock__label">{item.label}</span>
		</a>
	))}
</nav>

<style>
	.dock {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 90;
		display: flex;
		align-items: center;
		justify-content: space-around;
		gap: 2px;
		padding: 6px 8px calc(6px + env(safe-area-inset-bottom, 0px));
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(20, 20, 24, 0.92);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
	}
	.dock__tab {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		border-radius: 10px;
		color: rgb(var(--muted));
		font-family: var(--font-sans), system-ui, sans-serif;
		font-size: 0.82rem;
		font-weight: 500;
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
	}
	.dock__tab:active {
		background: var(--chip-bg);
	}
	.dock__tab.is-active {
		color: rgb(var(--accent));
		font-weight: 600;
	}
	.dock__label {
		white-space: nowrap;
	}

	/* 浅色主题 */
	:global(:root[data-theme='light']) .dock {
		background: rgba(252, 250, 246, 0.94);
		border-top-color: rgba(90, 76, 60, 0.12);
	}

	/* 桌面端隐藏：顶部 Header 已承载主导航 */
	@media (min-width: 861px) {
		.dock {
			display: none;
		}
	}
</style>

<script>
	// 换页后刷新当前页高亮（dock 用 transition:persist 保活，不会随导航重建）
	function refreshActive() {
		const dock = document.querySelector<HTMLElement>('[data-dock]');
		if (!dock) return;
		const path = location.pathname.replace(/\/+$/, '') || '/';
		dock.querySelectorAll<HTMLAnchorElement>('.dock__tab').forEach((tab) => {
			const href = (tab.getAttribute('href') || '').replace(/\/+$/, '') || '/';
			const hit = href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
			tab.classList.toggle('is-active', hit);
			if (hit) tab.setAttribute('aria-current', 'page');
			else tab.removeAttribute('aria-current');
		});
	}
	refreshActive();
	document.addEventListener('astro:page-load', refreshActive);
</script>
