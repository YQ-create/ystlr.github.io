---
// 3D 漂移照片墙 · DriftWall
// -----------------------------------------------------------------------------
// 结构：.wall（透视 / 裁剪 / 遮罩）> .plane（rotateX + rotateY + scale）> .lane > .track > .set ×2 > .tile
//   - 竖向模式（up/down）：columns 条竖向车道，每条车道把图片复制两份做无缝循环；
//   - 横向模式（left/right）：rows 条横向车道，同样的复制两份思路；
//   - 车道之间的速度、相位、景深、错位都由固定种子的 mulberry32 生成，
//     服务端渲染与客户端初始化拿到同一份数字，构建之间也不会抖。
// 只依赖浏览器原生能力：CSS @keyframes 负责漂移，原生 JS 负责指针视差、铺满缩放、窄屏车道数。
// Astro View Transitions 会替换 <body>，所以初始化挂在 astro:page-load 上，并用 data-ready 防止重复初始化。

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface DriftItem {
	image: ImageMetadata;
	title?: string;
	href?: string;
}

type DriftDirection = 'up' | 'down' | 'left' | 'right';

interface Props {
	items: DriftItem[];
	columns?: number;
	rows?: number;
	tileWidth?: number;
	tileHeight?: number;
	gap?: number;
	tilt?: number;
	turn?: number;
	perspective?: number;
	depth?: number;
	speed?: number;
	direction?: DriftDirection;
	variance?: number;
	parallax?: number;
	lift?: number;
	fade?: number;
	dim?: number;
	overlayColor?: string;
	height?: string;
	className?: string;
}

const {
	items,
	columns = 5,
	rows = 3,
	tileWidth = 200,
	tileHeight = 132,
	gap = 18,
	tilt = 16,
	turn = -14,
	perspective = 1200,
	depth = 120,
	speed = 42,
	direction = 'left',
	variance = 0.45,
	parallax = 0.6,
	lift = 64,
	fade = 0.6,
	dim = 0.55,
	overlayColor = 'rgb(246, 240, 229)',
	height = 'clamp(420px, 62vh, 680px)',
	className = '',
} = Astro.props;

/* ---------- 数值兜底：外部传进来的值一律夹到安全区间 ---------- */
const clamp = (value: unknown, min: number, max: number, fallback: number): number => {
	const n = Number(value);
	if (!Number.isFinite(n)) return fallback;
	return Math.min(max, Math.max(min, n));
};

const safeDirection: DriftDirection = (['up', 'down', 'left', 'right'] as string[]).includes(direction)
	? direction
	: 'left';

const safeColumns = Math.round(clamp(columns, 1, 8, 5));
const safeRows = Math.round(clamp(rows, 1, 6, 3));
const safeTileW = Math.round(clamp(tileWidth, 48, 640, 200));
const safeTileH = Math.round(clamp(tileHeight, 32, 640, 132));
const safeGap = Math.round(clamp(gap, 0, 96, 18));
const safeTilt = clamp(tilt, -45, 45, 16);
const safeTurn = clamp(turn, -45, 45, -14);
const safePerspective = Math.round(clamp(perspective, 200, 4000, 1200));
const safeDepth = clamp(depth, 0, 800, 120);
const safeSpeed = clamp(speed, 1, 600, 42);
const safeVariance = clamp(variance, 0, 1, 0.45);
const safeParallax = clamp(parallax, 0, 1, 0.6);
const safeLift = Math.round(clamp(lift, 0, 260, 64));
const safeFade = clamp(fade, 0, 1, 0.6);
const safeDim = clamp(dim, 0, 1, 0.55);
const safeHeight =
	typeof height === 'string' && height.trim() ? height.trim() : 'clamp(420px, 62vh, 680px)';
const safeClassName = typeof className === 'string' ? className : '';
// 颜色只允许作为 CSS 值出现，去掉可能截断 style 属性的字符
const safeOverlay =
	String(overlayColor ?? '')
		.replace(/[<>;"'\\]/g, '')
		.trim() || 'rgb(246, 240, 229)';

const gallery = (Array.isArray(items) ? items : []).filter(
	(item): item is DriftItem => Boolean(item && item.image),
);

/* ---------- 车道方向与内容长度 ---------- */
const isVertical = safeDirection === 'up' || safeDirection === 'down';
const laneCount = isVertical ? safeColumns : safeRows;

// 墙高是 CSS 表达式（clamp / vh），构建期只能估：取其中的 px 值，宁大勿小
const heightPx = [...safeHeight.matchAll(/(\d+(?:\.\d+)?)px/g)].map((match) => Number(match[1]));
const estHeight = heightPx.length
	? (Math.min(...heightPx) + Math.max(...heightPx)) / 2
	: 680;
const estWidth = 1024;

const unit = (isVertical ? safeTileH : safeTileW) + safeGap;
// 一份内容至少铺满主轴，再多一张备一张，循环时才不会在边缘露底
const perLane = Math.max(2, Math.ceil((isVertical ? estHeight : estWidth) / unit) + 1);
// 一份内容沿主轴的长度：动画位移 -50%，正好等于这段距离
const copyLength = perLane * unit;

// 车道在副轴上的总跨度（竖向模式是宽度，横向模式是高度）
const crossExtent = isVertical
	? laneCount * safeTileW + (laneCount - 1) * safeGap
	: laneCount * safeTileH + (laneCount - 1) * safeGap;

// 平面基础缩放 1.15；横向模式车道少时按预估铺满所需再放大一点，客户端会按真实尺寸复算
const seedScale = Math.min(
	2.4,
	Math.max(
		1.15,
		1.06 *
			Math.max(
				(isVertical ? estHeight : estWidth) / copyLength,
				(isVertical ? estWidth : estHeight) / crossExtent,
			),
	),
);

/* ---------- 确定性随机：服务端与客户端必须算出同一份布局 ---------- */
function mulberry32(seed: number): () => number {
	let a = seed >>> 0;
	return () => {
		a = (a + 0x6d2b79f5) >>> 0;
		let t = a;
		t = Math.imul(t ^ (t >>> 15), t | 1);
		t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const DRIFT_SEED = 0x1a2b3c4d;
const random = mulberry32(DRIFT_SEED);
const baseDuration = Math.max(4, copyLength / safeSpeed);

interface Lane {
	z: number;
	offset: number;
	duration: number;
	delay: number;
	tiles: DriftItem[];
}

const lanes: Lane[] = [];

if (gallery.length > 0) {
	for (let index = 0; index < laneCount; index += 1) {
		// 每条车道依次抽四个数：时长倍率、相位、景深、错位
		const duration = Math.max(2, baseDuration * (1 + (random() * 2 - 1) * safeVariance));
		const delay = -random() * duration;
		const z = -random() * safeDepth;
		const offset = (random() * 2 - 1) * 6;
		const tiles: DriftItem[] = [];
		for (let slot = 0; slot < perLane; slot += 1) {
			tiles.push(gallery[(slot + index * 3) % gallery.length] as DriftItem);
		}
		lanes.push({ z, offset, duration, delay, tiles });
	}
}

/* ---------- 内联变量 ---------- */
const wallStyle = [
	`--dw-height:${safeHeight}`,
	`--dw-persp:${safePerspective}px`,
	`--dw-tilt:${safeTilt}deg`,
	`--dw-turn:${safeTurn}deg`,
	`--dw-tw:${safeTileW}px`,
	`--dw-th:${safeTileH}px`,
	`--dw-gap:${safeGap}px`,
	`--dw-lift:${safeLift}px`,
	`--dw-fade:${(safeFade * 240).toFixed(1)}px`,
	`--dw-dim:${safeDim}`,
	`--dw-overlay:${safeOverlay}`,
	`--dw-scale:${seedScale.toFixed(3)}`,
].join(';');

const laneStyle = (lane: Lane): string =>
	[
		`--dw-z:${lane.z.toFixed(2)}px`,
		`--dw-offset:${lane.offset.toFixed(2)}px`,
		`--dw-dur:${lane.duration.toFixed(2)}s`,
		`--dw-delay:${lane.delay.toFixed(2)}s`,
	].join(';');
---

{
	lanes.length > 0 && (
		<div
			class:list={['wall', safeClassName]}
			data-dw
			data-axis={isVertical ? 'v' : 'h'}
			data-direction={safeDirection}
			data-tilt={String(safeTilt)}
			data-turn={String(safeTurn)}
			data-parallax={String(safeParallax)}
			data-scale={seedScale.toFixed(3)}
			data-tile-w={String(safeTileW)}
			data-tile-h={String(safeTileH)}
			data-gap={String(safeGap)}
			data-copy={String(copyLength)}
			data-lane-count={String(laneCount)}
			style={wallStyle}
		>
			<div class="plane" data-plane>
				{lanes.map((lane) => (
					<div class="lane" data-lane style={laneStyle(lane)}>
						<div class="track" data-track>
							{[0, 1].map((copy) => (
								<div
									class="set"
									aria-hidden={copy === 1 ? 'true' : undefined}
									inert={copy === 1 ? true : undefined}
								>
									{lane.tiles.map((item) => {
										const label = item.title ?? '照片';
										const media = (
											<Image
												src={item.image}
												alt={item.title ?? ''}
												width={safeTileW}
												height={safeTileH}
												fit="cover"
												sizes={`${safeTileW}px`}
												loading="lazy"
												decoding="async"
											/>
										);
										return item.href ? (
											<a
												class="tile"
												href={item.href}
												aria-label={item.title ?? `查看照片：${label}`}
												tabindex={copy === 1 ? -1 : undefined}
											>
												{media}
												{item.title && <span class="cap">{item.title}</span>}
											</a>
										) : (
											<figure class="tile">
												{media}
												{item.title && <figcaption class="cap">{item.title}</figcaption>}
											</figure>
										);
									})}
								</div>
							))}
						</div>
					</div>
				))}
			</div>
			<div class="overlay" aria-hidden="true"></div>
		</div>
	)
}

<script>
	type Cleanup = () => void;

	const live: Array<{ root: HTMLElement; clean: Cleanup }> = [];
	const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
	const coarseQuery = window.matchMedia('(pointer: coarse)');
	const prefersReduced = () => reducedQuery.matches;
	const coarsePointer = () => coarseQuery.matches;

	const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
	const num = (value: string | undefined, fallback: number) => {
		const parsed = Number(value);
		return Number.isFinite(parsed) ? parsed : fallback;
	};

	/** 初始化一面墙：重复进入时直接跳过（data-ready 是幂等标记） */
	function initWall(root: HTMLElement) {
		if (root.dataset.ready === '1') return;
		root.dataset.ready = '1';

		const plane = root.querySelector<HTMLElement>('[data-plane]');
		if (!plane) return;

		const stops: Cleanup[] = [];
		const axis = root.dataset.axis === 'v' ? 'v' : 'h';
		const baseTilt = num(root.dataset.tilt, 16);
		const baseTurn = num(root.dataset.turn, -14);
		const parallax = clamp(num(root.dataset.parallax, 0.6), 0, 1);
		const tileW = num(root.dataset.tileW, 200) * 1;
		const tileH = num(root.dataset.tileH, 132);
		const gap = num(root.dataset.gap, 18);
		const copyLength = Math.max(1, num(root.dataset.copy, 1));
		const laneEls = Array.from(root.querySelectorAll<HTMLElement>('[data-lane]'));
		const animate = !prefersReduced();

		let scale = clamp(num(root.dataset.scale, 1.15), 1.15, 2.4);

		// 平面当前值 / 目标值：视差只写这两个数，逐帧插值逼近
		let rx = baseTilt;
		let ry = baseTurn;
		let offsetX = 0;
		let offsetY = 0;

		const writeTransform = () => {
			plane.style.transform =
				`translate3d(${offsetX.toFixed(2)}px, ${offsetY.toFixed(2)}px, 0) ` +
				`rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
		};

		// 窄屏减少车道：只写 data-max-lanes，由 CSS 用 nth-child 隐藏多出来的车道；
		// 每条车道的动画是独立 @keyframes，隐藏不改变可见车道的时长，无需重建 DOM。
		const applyLaneLimit = () => {
			const limit = window.innerWidth < 720 ? 2 : window.innerWidth < 1100 ? 3 : 0;
			if (limit > 0) root.dataset.maxLanes = String(limit);
			else delete root.dataset.maxLanes;
		};

		const visibleLaneCount = () =>
			laneEls.filter((lane) => window.getComputedStyle(lane).display !== 'none').length || 1;

		// 按真实尺寸复算铺满所需缩放：倾斜的平面不会在上下 / 左右露白
		const fit = () => {
			const width = root.clientWidth || 1;
			const height = root.clientHeight || 1;
			const visible = visibleLaneCount();
			const cross =
				axis === 'v'
					? visible * tileW + (visible - 1) * gap
					: visible * tileH + (visible - 1) * gap;
			const needed =
				axis === 'v'
					? Math.max(height / copyLength, width / cross)
					: Math.max(width / copyLength, height / cross);
			scale = clamp(needed * 1.06, 1.15, 2.4);
			root.style.setProperty('--dw-scale', scale.toFixed(3));
		};

		applyLaneLimit();
		fit();
		// 降级动效时把手势交给 CSS（@media 里用 --dw-scale 拍平），不写内联 transform
		if (animate) writeTransform();

		/* ---------- 指针视差 ---------- */
		if (animate && !coarsePointer() && parallax > 0) {
			let targetRx = baseTilt;
			let targetRy = baseTurn;
			let targetX = 0;
			let targetY = 0;
			let frame = 0;

			const step = () => {
				const k = 0.12;
				rx += (targetRx - rx) * k;
				ry += (targetRy - ry) * k;
				offsetX += (targetX - offsetX) * k;
				offsetY += (targetY - offsetY) * k;

				const settled =
					Math.abs(targetRx - rx) < 0.02 &&
					Math.abs(targetRy - ry) < 0.02 &&
					Math.abs(targetX - offsetX) < 0.05 &&
					Math.abs(targetY - offsetY) < 0.05;

				if (settled) {
					rx = targetRx;
					ry = targetRy;
					offsetX = targetX;
					offsetY = targetY;
					writeTransform();
					frame = 0;
					return;
				}
				writeTransform();
				frame = requestAnimationFrame(step);
			};

			const kick = () => {
				if (!frame) frame = requestAnimationFrame(step);
			};

			const onMove = (event: PointerEvent) => {
				if (event.pointerType === 'touch') return;
				const rect = root.getBoundingClientRect();
				if (!rect.width || !rect.height) return;
				const dx = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
				const dy = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
				targetRy = baseTurn + dx * parallax * 6;
				targetRx = baseTilt - dy * parallax * 6;
				targetX = dx * parallax * 8;
				targetY = dy * parallax * 6;
				kick();
			};

			const onLeave = () => {
				targetRx = baseTilt;
				targetRy = baseTurn;
				targetX = 0;
				targetY = 0;
				kick();
			};

			root.addEventListener('pointermove', onMove, { passive: true });
			root.addEventListener('pointerleave', onLeave, { passive: true });
			root.addEventListener('pointercancel', onLeave, { passive: true });
			stops.push(() => {
				root.removeEventListener('pointermove', onMove);
				root.removeEventListener('pointerleave', onLeave);
				root.removeEventListener('pointercancel', onLeave);
				if (frame) cancelAnimationFrame(frame);
			});
		}

		/* ---------- 尺寸变化：防抖后重算车道数与缩放 ---------- */
		let resizeTimer = 0;
		const onResize = () => {
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => {
				applyLaneLimit();
				fit();
				if (animate) writeTransform();
			}, 180);
		};
		window.addEventListener('resize', onResize, { passive: true });
		stops.push(() => {
			window.clearTimeout(resizeTimer);
			window.removeEventListener('resize', onResize);
		});

		live.push({
			root,
			clean: () => {
				stops.forEach((stop) => stop());
				root.dataset.ready = '';
			},
		});
	}

	function mount() {
		// View Transitions 换过 <body> 之后，旧墙已经脱离文档：顺手回收它们的事件
		for (let index = live.length - 1; index >= 0; index -= 1) {
			const entry = live[index];
			if (entry && !entry.root.isConnected) {
				entry.clean();
				live.splice(index, 1);
			}
		}
		document.querySelectorAll<HTMLElement>('[data-dw]').forEach(initWall);
	}

	document.addEventListener('astro:page-load', mount);
	if (document.readyState !== 'loading') mount();
	else document.addEventListener('DOMContentLoaded', mount, { once: true });
</script>

<style>
	/* ---------- 墙：透视 + 裁剪 + 边缘淡出 ---------- */
	.wall {
		--dw-mask-h: linear-gradient(
			to right,
			transparent 0,
			#000 var(--dw-fade),
			#000 calc(100% - var(--dw-fade)),
			transparent 100%
		);
		--dw-mask-v: linear-gradient(
			to bottom,
			transparent 0,
			#000 var(--dw-fade),
			#000 calc(100% - var(--dw-fade)),
			transparent 100%
		);
		position: relative;
		height: var(--dw-height);
		overflow: hidden;
		isolation: isolate;
		border-radius: var(--r-lg, 22px);
		perspective: var(--dw-persp);
		perspective-origin: 50% 50%;
		background:
			radial-gradient(120% 90% at 50% 0%, rgba(var(--paper), 0.9), rgba(var(--bg-deep), 0.55) 70%),
			rgb(var(--bg));
		box-shadow:
			inset 0 0 0 1px rgba(var(--line), 0.75),
			inset 0 24px 50px -34px rgba(var(--shadow-color), 35%);
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
	}
	.wall[data-axis='h'] {
		-webkit-mask-image: var(--dw-mask-h);
		mask-image: var(--dw-mask-h);
	}
	.wall[data-axis='v'] {
		-webkit-mask-image: var(--dw-mask-v);
		mask-image: var(--dw-mask-v);
	}

	/* ---------- 平面：倾斜的 3D 面 ---------- */
	.plane {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--dw-gap);
		transform-style: preserve-3d;
		transform-origin: 50% 50%;
		transform: rotateX(var(--dw-tilt)) rotateY(var(--dw-turn)) scale(var(--dw-scale, 1.15));
		will-change: transform;
	}
	.wall[data-axis='v'] .plane {
		flex-direction: row;
	}
	.wall[data-axis='h'] .plane {
		flex-direction: column;
	}

	/* ---------- 车道：景深 + 轻微错位 ---------- */
	.lane {
		flex: none;
		transform-style: preserve-3d;
		will-change: transform;
	}
	.wall[data-axis='v'] .lane {
		transform: translate3d(0, var(--dw-offset, 0px), var(--dw-z, 0px));
	}
	.wall[data-axis='h'] .lane {
		transform: translate3d(var(--dw-offset, 0px), 0, var(--dw-z, 0px));
	}

	/* ---------- 轨道：复制两份内容，位移 -50% 即一份，实现无缝循环 ---------- */
	.track {
		display: flex;
		flex-direction: column;
		width: var(--dw-tw);
		transform-style: preserve-3d;
		animation-duration: var(--dw-dur, 24s);
		animation-delay: var(--dw-delay, 0s);
		animation-timing-function: linear;
		animation-iteration-count: infinite;
		animation-fill-mode: both;
		will-change: transform;
	}
	.wall[data-axis='v'] .track {
		animation-name: dw-drift-y;
	}
	.wall[data-axis='h'] .track {
		flex-direction: row;
		width: max-content;
		animation-name: dw-drift-x;
	}
	/* 反向 = 内容朝另一个方向流，keyframes 只需两份 */
	.wall[data-direction='down'] .track,
	.wall[data-direction='right'] .track {
		animation-direction: reverse;
	}

	/* 一份内容：末尾补一个 gap 的留白，两份之间正好保持同样的间距，
	   track 总高（宽）= 2 × 一份，translate(-50%) 严丝合缝 */
	.set {
		display: flex;
		flex-direction: column;
		gap: var(--dw-gap);
		padding-bottom: var(--dw-gap);
	}
	.wall[data-axis='h'] .set {
		flex-direction: row;
		padding-bottom: 0;
		padding-right: var(--dw-gap);
	}

	@keyframes dw-drift-y {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(0, -50%, 0);
		}
	}
	@keyframes dw-drift-x {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	/* ---------- 图片：暖色描边 + 柔和投影，呼应站点的玻璃质感 ---------- */
	.tile {
		position: relative;
		display: block;
		flex: none;
		width: var(--dw-tw);
		height: var(--dw-th);
		margin: 0;
		overflow: hidden;
		border-radius: 14px;
		border: 1px solid var(--glass-brd-dim);
		background: rgb(var(--paper));
		box-shadow:
			0 10px 24px -14px rgba(var(--shadow-color), 45%),
			0 1px 2px rgba(var(--shadow-color), 12%);
		transform: translateZ(0);
		transition:
			transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
			box-shadow 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
		text-decoration: none;
		color: inherit;
		-webkit-tap-highlight-color: transparent;
	}
	.tile :global(img) {
