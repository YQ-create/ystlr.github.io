---
/**
 * ElectricLogo — 电流闪电 logo（无依赖，Canvas 2D）。
 *
 * 一个发光的闪电图标，边缘有电弧粒子游走、随机分叉与闪烁，
 * 鼠标靠近会增强电流。比 WebGL SDF 版轻量，视觉接近「电弧」质感。
 */
interface Props {
	size?: number;
	color?: string;
	glow?: string;
	class?: string;
}

const { size = 40, color = '#ecc7ff', glow = '#ad6dff', class: className = '' } = Astro.props;
---

<div
	class:list={['electric-logo', className]}
	data-elogo
	data-color={color}
	data-glow={glow}
	style={`width: ${size}px; height: ${size}px;`}
>
	<canvas data-elogo-canvas aria-hidden="true"></canvas>
</div>

<style>
	.electric-logo {
		position: relative;
		display: inline-block;
	}
	.electric-logo canvas {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	// @ts-nocheck
	// 电流闪电：沿闪电轮廓采样，电弧粒子随机游走、分叉、闪烁。
	const BOLT = 'M39 3 12 37h17l-4 24 27-34H35z'; // 64x64 视口的闪电 path

	function hexToRgb(hex) {
		let h = String(hex || '').replace('#', '');
		if (h.length === 3) h = h.replace(/./g, (c) => c + c);
		const n = parseInt(h.slice(0, 6), 16);
		return Number.isNaN(n) ? [236, 199, 255] : [(n >> 16) & 255, ((n >> 8) & 255) & 255, n & 255];
	}

	function setup(host) {
		const canvas = host.querySelector('[data-elogo-canvas]');
		const ctx = canvas?.getContext('2d');
		if (!canvas || !ctx) return () => {};

		const color = hexToRgb(host.dataset.color);
		const glow = hexToRgb(host.dataset.glow);
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// 用 Path2D 采样闪电路径的点序列
		function samplePath() {
			const path = new Path2D(BOLT);
			// 简化：手动列出闪电的折线顶点（对应 BOLT path 的 7 个点）
			return [
				[39, 3], [12, 37], [29, 37], [25, 61], [52, 27], [35, 27], [39, 3],
			];
		}
		const points = samplePath();

		// 沿折线插值取点（密度可控）
		function resample(segments) {
			const out = [];
			for (let i = 0; i < points.length - 1; i++) {
				const [ax, ay] = points[i];
				const [bx, by] = points[i + 1];
				for (let s = 0; s <= segments; s++) {
					const t = s / segments;
					out.push([ax + (bx - ax) * t, ay + (by - ay) * t]);
				}
			}
			return out;
		}
		const spine = resample(6);

		let width = 0;
		let height = 0;
		let dpr = 1;
		let raf = 0;
		let last = 0;
		let alive = true;
		let visible = true;
		let time = 0;
		let boost = 0;

		const sparks = [];

		const resize = () => {
			const rect = host.getBoundingClientRect();
			width = Math.max(1, rect.width);
			height = Math.max(1, rect.height);
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			draw();
		};

		const draw = () => {
			ctx.clearRect(0, 0, width, height);
			const scale = Math.min(width, height) / 64;
			const ox = (width - 64 * scale) / 2;
			const oy = (height - 64 * scale) / 2;
			const px = (x) => ox + x * scale;
			const py = (y) => oy + y * scale;

			// 外层光晕（闪电形状）
			ctx.save();
			ctx.shadowColor = `rgba(${glow[0]},${glow[1]},${glow[2]},0.9)`;
			ctx.shadowBlur = 12 * scale * (1 + boost);
			ctx.fillStyle = `rgba(${color[0]},${color[1]},${color[2]},1)`;
			ctx.beginPath();
			ctx.moveTo(px(points[0][0]), py(points[0][1]));
			for (let i = 1; i < points.length; i++) ctx.lineTo(px(points[i][0]), py(points[i][1]));
			ctx.closePath();
			ctx.fill();
			ctx.fill();
			ctx.restore();

			// 电弧粒子：沿 spine 游走 + 抖动 + 分叉
			for (let i = 0; i < 6; i++) {
				const prog = (i / 6 + time * 0.35) % 1;
				const idx = prog * (spine.length - 1);
				const a = Math.floor(idx);
				const b = Math.min(a + 1, spine.length - 1);
				const t = idx - a;
				const sx = spine[a][0] + (spine[b][0] - spine[a][0]) * t;
				const sy = spine[a][1] + (spine[b][1] - spine[a][1]) * t;
				const jitter = 2.2 * Math.sin(time * 9 + i * 2.4);
				const x = px(sx) + jitter * scale;
				const y = py(sy) + Math.cos(time * 7 + i * 1.7) * 1.6 * scale;
				const r = (0.8 + Math.random() * 1.6) * scale;
				const alpha = 0.35 + 0.45 * (0.5 + 0.5 * Math.sin(time * 6 + i * 2.1));
				ctx.fillStyle = `rgba(${color[0]},${color[1]},${color[2]},${alpha})`;
				ctx.beginPath();
				ctx.arc(x, y, r, 0, Math.PI * 2);
				ctx.fill();

				// 偶尔的分叉支线
				if (i % 2 === 0) {
					const bx = x + Math.sin(time * 11 + i) * 5 * scale;
					const by = y + 4 * scale;
					ctx.strokeStyle = `rgba(${glow[0]},${glow[1]},${glow[2]},${alpha * 0.8})`;
					ctx.lineWidth = 0.8 * scale;
					ctx.beginPath();
					ctx.moveTo(x, y);
					ctx.lineTo(bx, by);
					ctx.stroke();
				}
			}

			// 点击电弧（瞬时强光）
			if (sparks.length) {
				ctx.save();
				ctx.shadowColor = `rgba(${glow[0]},${glow[1]},${glow[2]},1)`;
				ctx.shadowBlur = 18 * scale;
				ctx.fillStyle = `rgba(255,255,255,${0.85 * sparks[0].life})`;
				ctx.fillRect(0, 0, width, height * 0.02);
				ctx.restore();
				sparks[0].life -= 0.08;
				if (sparks[0].life <= 0) sparks.shift();
			}
		};

		const frame = (now) => {
			raf = 0;
			if (!alive || !visible || document.hidden) return;
			const dt = last ? Math.min(0.05, (now - last) / 1000) : 0.016;
			last = now;
			if (!reduce) {
				time += dt;
				boost += (0 - boost) * 0.05;
			}
			draw();
			raf = requestAnimationFrame(frame);
		};

		const wake = () => {
			if (!raf && alive && visible && !document.hidden) raf = requestAnimationFrame(frame);
		};

		const onDown = () => {
			if (reduce) return;
			boost = 1;
			sparks.push({ life: 1 });
			wake();
		};

		const io = new IntersectionObserver((entries) => {
			visible = entries.some((e) => e.isIntersecting);
			if (visible) { last = 0; wake(); }
		});
		io.observe(host);
		host.addEventListener('pointerdown', onDown);
		resize();
		wake();

		const ro = new ResizeObserver(resize);
		ro.observe(host);

		return () => {
			alive = false;
			cancelAnimationFrame(raf);
			io.disconnect();
			ro.disconnect();
			host.removeEventListener('pointerdown', onDown);
		};
	}

	const instances = new Map();
	function mount() {
		document.querySelectorAll('[data-elogo]').forEach((host) => {
			if (host.dataset.elogoBound === '1') return;
			host.dataset.elogoBound = '1';
			instances.set(host, setup(host));
		});
	}
	function unmount() {
		instances.forEach((destroy) => destroy());
		instances.clear();
		document.querySelectorAll('[data-elogo]').forEach((host) => { delete host.dataset.elogoBound; });
	}
	let bound = false;
	function initElectricLogo() {
		if (bound) return;
		bound = true;
		document.addEventListener('astro:before-swap', unmount);
		document.addEventListener('astro:page-load', mount);
		if (document.readyState !== 'loading') mount();
		else document.addEventListener('DOMContentLoaded', mount, { once: true });
	}
	initElectricLogo();
</script>
