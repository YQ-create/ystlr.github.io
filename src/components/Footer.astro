---
import { AUTHOR_NAME, ICP_NUMBER, SOCIAL_LINKS, SITE_TITLE, SITE_DESCRIPTION } from '../consts';
const year = new Date().getFullYear();

const nav = [
	{ href: '/blog', label: '文章' },
	{ href: '/blog/archive', label: '归档' },
	{ href: '/gallery', label: '照片' },
	{ href: '/discover', label: '发现' },
	{ href: '/about', label: '关于' },
	{ href: '/privacy', label: '隐私' },
	{ href: '/rss.xml', label: 'RSS' },
];
---

<footer class="site-foot">
	<div class="foot-shell glass">
		<div class="foot-brand">
			<p class="foot-mark">{SITE_TITLE}<span>.</span></p>
			<p class="foot-desc">{SITE_DESCRIPTION}</p>
		</div>

		<nav class="foot-nav" aria-label="页脚导航">
			{nav.map((item) => (
				<a href={item.href}>{item.label}</a>
			))}
		</nav>

		<div class="foot-contact">
			{SOCIAL_LINKS.github && (
				<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">GitHub</a>
			)}
			{SOCIAL_LINKS.email && <a href={SOCIAL_LINKS.email}>写封邮件</a>}
		</div>
	</div>

	<div class="foot-bottom">
		<p class="foot-copy">
			&copy; {year} {AUTHOR_NAME} · 用 Astro 构建，托管在 GitHub Pages
			{ICP_NUMBER && (
				<>
					· <a class="foot-icp" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener nofollow">{ICP_NUMBER}</a>
				</>
			)}
			<a class="foot-manage" href="/admin/" rel="nofollow">管理</a>
		</p>
		<button class="foot-top" type="button" data-back-top>
			<span>回到顶部</span>
			<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
				<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M8 13V3M3.5 7.5 8 3l4.5 4.5"></path>
			</svg>
		</button>
	</div>
</footer>

<style>
	.site-foot {
		max-width: var(--w-wide);
		margin: clamp(3rem, 7vw, 5rem) auto 0;
		padding: 0 var(--gutter) 2.5rem;
	}
	.foot-shell {
		display: grid;
		grid-template-columns: 1.3fr auto auto;
		align-items: center;
		gap: clamp(1.4rem, 4vw, 3rem);
		padding: clamp(1.4rem, 3vw, 2.2rem) clamp(1.4rem, 3vw, 2.4rem);
		border-radius: var(--r-xl);
	}
	.foot-mark {
		margin: 0;
		font-size: 1.6rem;
		font-weight: 800;
		letter-spacing: -0.01em;
		color: rgb(var(--ink));
	}
	.foot-mark span {
		color: rgb(var(--accent));
	}
	.foot-desc {
		margin: 0.35rem 0 0;
		max-width: 34ch;
		font-size: 0.85rem;
		line-height: 1.6;
		color: rgb(var(--muted));
	}
	.foot-nav,
	.foot-contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
	}
	.foot-nav a,
	.foot-contact a {
		font-size: 0.88rem;
		color: rgb(var(--muted));
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.foot-nav a:hover,
	.foot-contact a:hover {
		color: rgb(var(--accent));
	}
	/* 后台入口：低调但不至于看不清（对比度达标） */
	.foot-manage {
		margin-left: 0.7rem;
		color: rgb(var(--muted));
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: rgba(var(--muted), 0.5);
		transition:
			color var(--dur-fast) var(--ease-out),
			text-decoration-color var(--dur-fast) var(--ease-out);
	}
	.foot-manage:hover,
	.foot-manage:focus-visible {
		color: rgb(var(--accent));
		text-decoration-color: rgb(var(--accent));
	}
	.foot-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 1.2rem 0 0;
	}
	.foot-icp {
		color: inherit;
		text-decoration: none;
	}
	.foot-icp:hover {
		color: rgb(var(--ink-soft));
	}
	.foot-top {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.7rem;
		border: 1px solid rgb(var(--line-soft));
		border-radius: var(--r-pill);
		background: none;
		color: rgb(var(--muted));
		font: inherit;
		font-size: 0.72rem;
		cursor: pointer;
		white-space: nowrap;
		transition:
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}
	.foot-top:hover {
		color: rgb(var(--ink));
		border-color: rgb(var(--line));
	}
	.foot-copy {
		margin: 0;
		text-align: left;
		font-size: 0.76rem;
		letter-spacing: 0.06em;
		color: rgb(var(--muted-light));
	}
	@media (max-width: 820px) {
		.foot-shell {
			grid-template-columns: 1fr;
			gap: 1.2rem;
		}
		.foot-bottom {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.8rem;
		}
		.foot-copy {
			line-height: 1.8;
		}
	}
</style>

<script>
	function initBackTop() {
		const btn = document.querySelector<HTMLButtonElement>('[data-back-top]');
		if (!btn || btn.dataset.ready === '1') return;
		btn.dataset.ready = '1';
		btn.addEventListener('click', () => {
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
		});
	}
	initBackTop();
	document.addEventListener('astro:page-load', initBackTop);
</script>
