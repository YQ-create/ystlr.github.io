---
// Giscus 评论组件
// 接入步骤：
// 1. 在 https://giscus.app 输入站点仓库（公开仓库），生成 repo / repoId / categoryId；
// 2. 将下面 GISCUS_CONFIG 中的占位值替换为真实参数；
// 3. 仓库需开启 GitHub Discussions，并安装 Giscus GitHub App。
// 未配置时页面不渲染评论区，不影响其他内容。

const GISCUS_CONFIG = {
	repo: 'YQ-create/ystlr.github.io',
	repoId: 'R_kgDOVaDvHA',
	category: 'Announcements',
	categoryId: 'DIC_kwDOVaDvHM4DJ0Mc',
	mapping: 'pathname',
	strict: '0',
	reactionsEnabled: '1',
	emitMetadata: '0',
	inputPosition: 'top',
	theme: 'dark',
	lang: 'zh-CN',
};
const enabled = Boolean(GISCUS_CONFIG.repoId && GISCUS_CONFIG.categoryId);
---

{
	enabled && (
		<section class="giscus-section" id="comments">
			<h3 class="giscus-title">评论</h3>
			<div class="giscus-host">
				<script
					src="https://giscus.app/client.js"
					data-repo={GISCUS_CONFIG.repo}
					data-repo-id={GISCUS_CONFIG.repoId}
					data-category={GISCUS_CONFIG.category}
					data-category-id={GISCUS_CONFIG.categoryId}
					data-mapping={GISCUS_CONFIG.mapping}
					data-strict={GISCUS_CONFIG.strict}
					data-reactions-enabled={GISCUS_CONFIG.reactionsEnabled}
					data-emit-metadata={GISCUS_CONFIG.emitMetadata}
					data-input-position={GISCUS_CONFIG.inputPosition}
					data-theme={GISCUS_CONFIG.theme}
					data-lang={GISCUS_CONFIG.lang}
					crossorigin="anonymous"
					async
				></script>
			</div>
		</section>
	)
}

<script>
	// 评论跟随站点主题：站点可在深色/浅色间切换，这里把当前主题通过 postMessage
	// 同步给 giscus iframe（giscus 支持 setConfig 换肤）。切页时 iframe 会被重建，需重新同步。

	function currentTheme(): string {
		return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
	}

	function sendTheme(frame: HTMLIFrameElement | null | undefined): void {
		if (!frame?.contentWindow) return;
		frame.contentWindow.postMessage(
			{ giscus: { setConfig: { theme: currentTheme() } } },
			'https://giscus.app',
		);
	}

	function hookFrame(): void {
		const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
		if (!frame) return;
		// iframe 可能还没 ready，load 后再发一次最稳妥；也直接发一次
		sendTheme(frame);
		if (frame.dataset.themeHooked !== '1') {
			frame.dataset.themeHooked = '1';
			frame.addEventListener('load', () => sendTheme(frame));
		}
	}

	// 用户切换主题时同步
	window.addEventListener('theme-change', () => {
		sendTheme(document.querySelector<HTMLIFrameElement>('iframe.giscus-frame'));
	});

	document.addEventListener('astro:page-load', hookFrame);
	new MutationObserver(hookFrame).observe(document.documentElement, {
		childList: true,
		subtree: true,
	});

	if (document.readyState !== 'loading') hookFrame();
</script>

<style>
	.giscus-section {
		margin-top: 3.5em;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--line));
	}
	.giscus-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.05rem;
		margin-bottom: 1.2em;
		color: rgb(var(--muted));
	}
	.giscus-title::before {
		content: '';
		width: 3px;
		height: 0.9em;
		border-radius: 2px;
		background: rgb(var(--accent));
	}
	.giscus-host {
		min-height: 120px;
	}
</style>
