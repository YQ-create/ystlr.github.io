---
/**
 * GradualBlur — 渐进模糊边缘（React Bits 同名组件的原生移植，无 React、无第三方依赖）。
 *
 * 原理：N 层 backdrop-filter 叠在同一个区域上，每层用分段 linear-gradient 做 mask，
 * 只让自己在渐变的一段生效；越靠边缘叠加的层数越多、模糊半径按曲线递增，
 * 于是形成「越靠边越糊」的连续过渡。再叠一层同方向的渐变 tint，让内容真正沉进背景色。
 *
 * 与 React 版的差异（按本站约定调整）：
 * - 层 DOM 在服务端生成，客户端脚本只负责 autoHide（滚动进度）与 hoverIntensity；
 * - 参数经 data-cfg(JSON) 传入；setup(root) 返回 destroy，配合 astro:page-load 重建，
 *   View Transitions 换页不会累积滚动 / 指针监听器；
 * - container 只支持 CSS 选择器字符串（静态站用不到 Element / RefObject）；
 * - 支持 prefers-reduced-motion 关闭过渡。
 */
interface Props {
	position?: 'top' | 'bottom' | 'left' | 'right';
	target?: 'parent' | 'page';
	height?: string | number;
	width?: string | number;
	strength?: number;
	layers?: number;
	curve?: 'linear' | 'bezier' | 'ease-in' | 'ease-out' | 'ease-in-out';
	exponential?: boolean;
	opacity?: number;
	saturation?: number;
	tint?: string;
	autoHide?: boolean;
	/** 内部滚动容器的 CSS 选择器；target="page" 时留空 */
	container?: string | null;
	hoverIntensity?: number;
	duration?: number | string;
	easing?: string;
	zIndex?: number;
	class?: string;
}

const {
	position = 'bottom',
	target = 'parent',
	height = '6rem',
	width,
	strength = 2,
	layers = 8,
	curve = 'linear',
	exponential = true,
	opacity = 1,
	saturation = 1,
	tint = 'transparent',
	autoHide = false,
	container = null,
	hoverIntensity = 1,
	duration = 0.3,
	easing = 'ease-out',
	zIndex = 1000,
	class: className = '',
} = Astro.props;

const CURVES: Record<string, (t: number) => number> = {
	linear: (t) => t,
	bezier: (t) => t * t * (3 - 2 * t),
	'ease-in': (t) => t * t,
	'ease-out': (t) => 1 - (1 - t) * (1 - t),
	'ease-in-out': (t) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2),
};
const DIRECTIONS: Record<string, string> = {
	top: 'to top',
	bottom: 'to bottom',
	left: 'to left',
	right: 'to right',
};

const clamp01 = (v: number) => Math.min(Math.max(v, 0), 1);
const toLength = (v: string | number) => (typeof v === 'number' ? `${v}px` : v);
const toTime = (v: string | number) => (typeof v === 'number' ? `${v}s` : v);

const edge = DIRECTIONS[position] ? position : 'bottom';
const vertical = edge === 'top' || edge === 'bottom';
const count = Math.min(Math.max(Math.round(layers) || 1, 1), 16);
const shape = CURVES[curve] ?? CURVES.linear;
const maxBlur = Math.max(strength, 0) * 12;
const level = (u: number) => {
	const t = shape(clamp01(u));
	return maxBlur * (exponential ? (Math.pow(2, 4 * t) - 1) / 15 : t);
};
const boost = Math.pow(Math.max(saturation, 0), 1 / count);
const fade = `${toTime(duration)} ${easing}`;
const direction = DIRECTIONS[edge];

// 每一层：blur 半径是「累计模糊量的平方差开根」，叠加后才是连续的渐进模糊
const steps: string[] = [];
for (let i = 0; i < count; i++) {
	const from = level(i / count);
	const to = level((i + 1) / count);
	const radius = Math.sqrt(Math.max(to * to - from * from, 0));
	const filter = [
		`blur(calc(${radius.toFixed(3)}px * var(--gradual-blur-reveal, 1) * var(--gradual-blur-hover, 1)))`,
		boost !== 1
			? `saturate(calc(1 + ${(boost - 1).toFixed(4)} * var(--gradual-blur-reveal, 1)))`
			: '',
	]
		.filter(Boolean)
		.join(' ');
	const mask = `linear-gradient(${direction}, transparent ${((i / count) * 100).toFixed(2)}%, #000 ${(((i + 1) / count) * 100).toFixed(2)}%)`;
	steps.push(
		[
			'position:absolute',
			'inset:0',
			'border-radius:inherit',
			`backdrop-filter:${filter}`,
			`-webkit-backdrop-filter:${filter}`,
			`mask-image:${mask}`,
			`-webkit-mask-image:${mask}`,
			`opacity:${opacity}`,
			`transition:backdrop-filter ${fade},-webkit-backdrop-filter ${fade}`,
		].join(';'),
	);
}

// tint：9 段 smoothstep 的黑色渐变，让内容真正融进底色而不是单纯变糊
const stops = Array.from({ length: 9 }, (_, k) => {
	const u = k / 8;
	const t = shape(u);
	const alpha = t * t * t * (t * (t * 6 - 15) + 10);
	return `rgba(0, 0, 0, ${alpha.toFixed(3)}) ${(u * 100).toFixed(1)}%`;
}).join(', ');
const tintMask = `linear-gradient(${direction}, ${stops})`;
const washStyle =
	tint && tint !== 'transparent'
		? [
				'position:absolute',
				'inset:0',
				'border-radius:inherit',
				`background:${tint}`,
				`mask-image:${tintMask}`,
				`-webkit-mask-image:${tintMask}`,
				'opacity:calc(var(--gradual-blur-reveal, 1) * min(var(--gradual-blur-hover, 1), 1))',
				`transition:opacity ${fade}`,
			].join(';')
		: null;

const depth = toLength(vertical ? height : (width ?? height));
const span = vertical && width != null ? toLength(width) : null;
const rounded = target !== 'page' && !span;
const corner = (a: string, b: string) => (rounded && (edge === a || edge === b) ? 'inherit' : null);
const rootStyle = [
	`position:${target === 'page' ? 'fixed' : 'absolute'}`,
	`z-index:${zIndex}`,
	corner('top', 'left') ? 'border-top-left-radius:inherit' : '',
	corner('top', 'right') ? 'border-top-right-radius:inherit' : '',
	corner('bottom', 'left') ? 'border-bottom-left-radius:inherit' : '',
	corner('bottom', 'right') ? 'border-bottom-right-radius:inherit' : '',
	edge === 'bottom' ? '' : 'top:0',
	edge === 'top' ? '' : 'bottom:0',
	edge === 'right' ? '' : 'left:0',
	edge === 'left' ? '' : 'right:0',
	vertical ? `height:${depth}` : '',
	vertical ? (span ? `width:${span}` : '') : `width:${depth}`,
	span ? 'margin-inline:auto' : '',
]
	.filter(Boolean)
	.join(';');

const cfg = { autoHide, container, target, edge, vertical, hoverIntensity };
---

<div
	class:list={['gradual-blur', className]}
	data-gradual-blur
	data-cfg={JSON.stringify(cfg)}
	style={rootStyle}
	aria-hidden="true"
>
	{steps.map((s) => <div style={s} />)}
	{washStyle && <div style={washStyle} />}
</div>

<style>
	.gradual-blur {
		pointer-events: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.gradual-blur > div {
			transition: none !important;
		}
	}
</style>

<script>
	// @ts-nocheck
	const clamp01 = (v) => Math.min(Math.max(v, 0), 1);

	const instances = [];
	let bound = false;
	let pageToken = 0;
	let mountedToken = -1;

	/** 找到驱动 autoHide 的滚动源：显式 container > 页面 > 父级可滚动元素/兄弟节点 */
	function findScroller(root, cfg) {
		if (cfg.container) return document.querySelector(cfg.container);
		if (cfg.target === 'page') return window;
		const parent = root.parentElement;
		if (!parent) return null;
		const scrolls = (node) => {
			const style = getComputedStyle(node);
			return /(auto|scroll|overlay)/.test(cfg.vertical ? style.overflowY : style.overflowX);
		};
		return (
			Array.from(parent.children).find((child) => child !== root && scrolls(child)) ||
			(scrolls(parent) ? parent : null)
		);
	}

	function setup(root) {
		let cfg = {};
		try {
			cfg = JSON.parse(root.dataset.cfg || '{}');
		} catch {
			cfg = {};
		}
		const cleanups = [];

		// ---- autoHide：顶部/左边随「已滚动距离」淡入，底部/右边随「剩余距离」淡出 ----
		if (cfg.autoHide) {
			const scroller = findScroller(root, cfg);
			if (scroller) {
				const element = scroller instanceof Element ? scroller : null;
				const start = cfg.edge === 'top' || cfg.edge === 'left';
				const update = () => {
					const page = document.documentElement;
					const offset = element
						? cfg.vertical
							? element.scrollTop
							: element.scrollLeft
						: cfg.vertical
							? window.scrollY
							: window.scrollX;
					const limit = element
						? cfg.vertical
							? element.scrollHeight - element.clientHeight
							: element.scrollWidth - element.clientWidth
						: cfg.vertical
							? page.scrollHeight - window.innerHeight
							: page.scrollWidth - window.innerWidth;
					const box = root.getBoundingClientRect();
					const reach = Math.max(cfg.vertical ? box.height : box.width, 1);
					const room = start ? offset : limit - offset;
					root.style.setProperty('--gradual-blur-reveal', clamp01(room / reach).toFixed(3));
				};

				update();
				const source = element ?? window;
				source.addEventListener('scroll', update, { passive: true });
				window.addEventListener('resize', update);
				const ro = element && typeof ResizeObserver !== 'undefined' ? new ResizeObserver(update) : null;
				if (ro && element) {
					ro.observe(element);
					if (element.firstElementChild) ro.observe(element.firstElementChild);
				}
				cleanups.push(() => {
					source.removeEventListener('scroll', update);
					window.removeEventListener('resize', update);
					ro?.disconnect();
					root.style.removeProperty('--gradual-blur-reveal');
				});
			}
		} else {
			// 从别的页面切回来时，节点是新的；显式清一次，避免残留上一次的 reveal 值
			root.style.removeProperty('--gradual-blur-reveal');
		}

		// ---- hoverIntensity：指针进入边缘区域时减弱模糊（rAF 节流，不压滚动） ----
		if (cfg.hoverIntensity !== 1) {
			let frame = 0;
			let inside = false;
			let point = null;
			const check = () => {
				frame = 0;
				if (!point) return;
				const box = root.getBoundingClientRect();
				const now =
					point.x >= box.left && point.x <= box.right && point.y >= box.top && point.y <= box.bottom;
				if (now === inside) return;
				inside = now;
				root.style.setProperty(
					'--gradual-blur-hover',
					inside ? String(Math.max(cfg.hoverIntensity, 0)) : '1',
				);
			};
			const onMove = (e) => {
				point = { x: e.clientX, y: e.clientY };
				if (!frame) frame = requestAnimationFrame(check);
			};
			const onLeave = () => {
				point = null;
				inside = false;
				root.style.setProperty('--gradual-blur-hover', '1');
			};
			window.addEventListener('pointermove', onMove, { passive: true });
			document.documentElement.addEventListener('pointerleave', onLeave);
			cleanups.push(() => {
				if (frame) cancelAnimationFrame(frame);
				window.removeEventListener('pointermove', onMove);
				document.documentElement.removeEventListener('pointerleave', onLeave);
				root.style.removeProperty('--gradual-blur-hover');
			});
		}

		return {
			destroy() {
				for (const fn of cleanups) fn();
			},
		};
	}

	function mount() {
		if (mountedToken === pageToken) return;
		mountedToken = pageToken;
		for (const item of instances.splice(0)) item.destroy();
		document.querySelectorAll('[data-gradual-blur]:not([data-gradual-blur-ready])').forEach((root) => {
			root.dataset.gradualBlurReady = '1';
			const instance = setup(root);
			if (instance) instances.push(instance);
		});
	}

	if (!bound) {
		bound = true;
		document.addEventListener('astro:before-swap', () => {
			pageToken += 1;
		});
		document.addEventListener('astro:page-load', mount);
	}
	mount();
</script>
