---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import HeaderLink from './HeaderLink.astro';
import MusicPlayer from './MusicPlayer.astro';

const navItems = [
	{ href: '/', label: '首页' },
	{ href: '/blog', label: '文章' },
	{ href: '/gallery', label: '照片墙' },
	{ href: '/discover', label: '发现' },
	{ href: '/about', label: '关于' },
];
---

<header>
	<nav>
		<h2>
			<a href="/" class="logo">
				<span class="dot" aria-hidden="true"></span>
				{SITE_TITLE}
			</a>
		</h2>
		<div class="internal-links">
			{navItems.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</div>
		<div class="header-right">
			<div class="social-links">
				{SOCIAL_LINKS.github && (
					<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">
						<span class="sr-only">GitHub</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="19" height="19">
							<path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							></path>
						</svg>
					</a>
				)}
				{SOCIAL_LINKS.email && (
					<a href={SOCIAL_LINKS.email}>
						<span class="sr-only">邮箱</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="19" height="19">
							<path
								fill="currentColor"
								d="M1.5 3h13a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5Zm.7 1 5.68 4.38a.5.5 0 0 0 .64 0L14.1 4H2.2ZM14 5.62 9.62 8.99a1.5 1.5 0 0 1-1.92 0L3 5.62V12h11V5.62Z"
							></path>
						</svg>
					</a>
				)}
			</div>
			<MusicPlayer />
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 1em 1em 0;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1040px;
		margin: 0 auto;
		gap: 1em;
		padding: 0.7em 1.2em;
		background: rgba(253, 250, 244, 0.82);
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		backdrop-filter: blur(12px);
	}
	h2 {
		margin: 0;
		font-size: 1.02em;
	}
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		color: rgb(var(--ink));
		font-weight: 700;
		letter-spacing: 0.03em;
	}
	.dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: rgb(var(--accent));
		box-shadow: 0 0 10px rgba(var(--accent), 0.35);
	}
	.internal-links {
		display: flex;
		gap: 0.2em;
	}
	nav a {
		padding: 0.5em 0.7em;
		color: rgb(var(--muted));
		text-decoration: none;
		border-radius: 999px;
		font-size: 0.92rem;
	}
	nav a:hover {
		color: rgb(var(--ink));
	}
	nav a.active {
		color: rgb(var(--accent));
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 0.9em;
	}
	.social-links {
		gap: 0.9em;
	}
	.social-links a {
		color: rgb(var(--muted));
		padding: 0.4em;
	}
	.social-links a:hover {
		color: rgb(var(--accent));
	}
	@media (max-width: 900px) {
		.social-links {
			display: none;
		}
	}
	@media (max-width: 720px) {
		header {
			padding: 0.7em 0.6em 0;
		}
		nav {
			justify-content: space-between;
			border-radius: 18px;
			padding: 0.55em 0.7em;
			gap: 0.4em;
		}
		nav a {
			padding: 0.45em 0.5em;
			font-size: 0.85rem;
		}
		.internal-links {
			gap: 0;
		}
		h2 {
			font-size: 0.95em;
		}
	}
</style>
