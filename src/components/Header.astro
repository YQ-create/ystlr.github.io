---
// 顶部菜单（精简 · 分散导航 + 设置子菜单）：
// 左侧品牌气泡，右侧「设置」齿轮 + 「菜单」汉堡两个气泡。
// 功能键（调色板 / 音乐 / 搜索 / 管理 / 写信）全部收纳进设置子菜单，
// 导航（首页/文章/知识库/发现/关于）由汉堡展开、分散固定在顶端。
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import MusicPlayer from './MusicPlayer.astro';
import AppearancePanel from './AppearancePanel.astro';
import ElectricLogo from './ElectricLogo.astro';

// 当前板块名：给左上角做页眉用，取不到就不显示
const SECTION_LABELS: Record<string, string> = {
	'/': '首页',
	'/blog': '文章',
	'/knowledge': '知识库',
	'/discover': '发现',
	'/about': '关于',
	'/privacy': '隐私',
};
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const sectionLabel = SECTION_LABELS[path] ?? '';

// 导航菜单项：汉堡展开后分散在顶端
const navItems = [
	{ num: '01', label: '首页', href: '/' },
	{ num: '02', label: '文章', href: '/blog' },
	{ num: '03', label: '知识库', href: '/knowledge' },
	{ num: '04', label: '发现', href: '/discover' },
	{ num: '05', label: '关于', href: '/about' },
];

const emailHref = SOCIAL_LINKS.email ?? 'mailto:hello@ystlr.com';
---

<header class="site-head" transition:persist="site-head" transition:name="site-header">
	<div class="head-shell">
		<a class="head-brand glass" href="/" aria-label={`${SITE_TITLE} 首页`}>
			<ElectricLogo size={22} class="head-brand__bolt" />
			<span class="head-brand__mark">ystlr</span>
			<span class:list={['head-brand__meta', !sectionLabel && 'is-empty']} data-head-meta>
				<span class="head-brand__rule" aria-hidden="true"></span>
				<span class="head-brand__here" data-head-here>{sectionLabel}</span>
			</span>
		</a>

		<div class="head-actions">
			<button class="head-settings glass" type="button" data-settings-toggle aria-expanded="false" aria-controls="settings-panel" aria-label="设置" title="设置">
				<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M10 13.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z"></path>
					<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M15.7 8.6 14.1 7.5l.1-1.1-1.2-1.9-1 .4-1-.4-1.2 1.9.1 1.1L8.2 8.6l-1.5 1.1-.1 1.1 1.2 1.9 1-.4 1 .4 1.2-1.9-.1-1.1 1.6-1.1.1-1.1-1.2-1.9-1 .4-1-.4-1.2 1.9.1 1.1-1.6 1.1Z"></path>
				</svg>
			</button>
			<button class="head-toggle glass" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-overlay" aria-label="菜单" title="菜单">
				<span class="head-toggle__line" aria-hidden="true"></span>
				<span class="head-toggle__line" aria-hidden="true"></span>
			</button>
		</div>
	</div>

	<!-- 工具组件：按钮在顶部栏隐藏，面板（fixed 右上角）保留，由设置子菜单触发 -->
	<div class="head-tools" aria-hidden="true">
		<AppearancePanel />
		<MusicPlayer />
	</div>

	<!-- 导航菜单：分散固定在顶端 -->
	<div class="menu-overlay" id="menu-overlay" data-menu-overlay aria-hidden="true">
		<nav class="menu-nav" aria-label="主导航菜单">
			<ul class="menu-links" role="menu">
				{navItems.map((item) => (
					<li role="none">
						<a class="menu-link" href={item.href} role="menuitem" aria-label={item.label}>
							<span class="menu-link__num" aria-hidden="true">{item.num}</span>
							<span class="menu-link__label">{item.label}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>

	<!-- 设置子菜单 -->
	<div class="settings-panel" id="settings-panel" data-settings-panel hidden>
		<div class="settings-head">
			<span class="eyebrow">SETTINGS</span>
			<span class="settings-head__dot" aria-hidden="true"></span>
		</div>
		<ul class="settings-list">
			<li>
				<button class="settings-row" type="button" data-settings-action="appearance">
					<span class="settings-row__icon" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="15" height="15"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M8 2.5a5.5 5.5 0 1 0 0 11c.7 0 1.1-.5 1.1-1.05 0-.28-.1-.52-.28-.72-.18-.2-.28-.44-.28-.7 0-.6.5-1.05 1.1-1.05h1A2.58 2.58 0 0 0 13.2 7.4C13.2 4.7 10.9 2.5 8 2.5Z"></path><circle cx="5.5" cy="7.3" r=".75" fill="currentColor"></circle><circle cx="7" cy="5.2" r=".75" fill="currentColor"></circle><circle cx="9.4" cy="5.3" r=".75" fill="currentColor"></circle><circle cx="10.9" cy="7.4" r=".75" fill="currentColor"></circle></svg>
					</span>
					<span class="settings-row__text">
						<strong>外观调色板</strong>
						<em>主题 · 颜色 · 底图</em>
					</span>
				</button>
			</li>
			<li>
				<button class="settings-row" type="button" data-settings-action="music">
					<span class="settings-row__icon" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="15" height="15"><path fill="currentColor" d="M13.5 1.6a.6.6 0 0 1 .7.6v8.1a2.4 2.4 0 1 1-1.2-2.1V4.3L6.5 5.7v6a2.4 2.4 0 1 1-1.2-2.1V3.4a.6.6 0 0 1 .47-.58l7.73-1.22Z"></path></svg>
					</span>
					<span class="settings-row__text">
						<strong>音乐播放器</strong>
						<em>播放 · 曲目列表</em>
					</span>
				</button>
			</li>
			<li>
				<button class="settings-row" type="button" data-search-open>
					<span class="settings-row__icon" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="15" height="15"><path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm4-1.5 3 3"></path></svg>
					</span>
					<span class="settings-row__text">
						<strong>站内搜索</strong>
						<em>快捷键 ⌘K</em>
					</span>
				</button>
			</li>
			<li>
				<a class="settings-row" href="/admin">
					<span class="settings-row__icon" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="15" height="15"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M4.5 2.5h7a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Zm2 1.5v2h3V4M5 8h6M5 10.5h6"></path></svg>
					</span>
					<span class="settings-row__text">
						<strong>管理后台</strong>
						<em>发布 · 编辑 · 上传</em>
					</span>
				</a>
			</li>
			<li>
				<a class="settings-row" href={emailHref}>
					<span class="settings-row__icon" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="15" height="15"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M2.5 3.5h11a.6.6 0 0 1 .6.6v7.8a.6.6 0 0 1-.6.6h-11a.6.6 0 0 1-.6-.6V4.1a.6.6 0 0 1 .6-.6Zm.6 1 4.6 3.6a.5.5 0 0 0 .6 0L12.9 4.5"></path></svg>
					</span>
					<span class="settings-row__text">
						<strong>写信给我</strong>
						<em>邮件联系</em>
					</span>
				</a>
			</li>
		</ul>
	</div>
</header>

<script>
	// 滚动收缩：滚过 16px 后收紧页头内边距，首屏 hero 时脱离文档流。
	let scrollBound = false;
	let scrollRaf = 0;
	function onScroll() {
		if (scrollRaf) return;
		scrollRaf = requestAnimationFrame(() => {
			scrollRaf = 0;
			const shell = document.querySelector<HTMLElement>('.site-head');
			if (!shell) return;
			shell.classList.toggle('is-scrolled', window.scrollY > 16);
			shell.classList.toggle('is-top', document.body.dataset.hero === '1' && window.scrollY < 24);
		});
	}
	if (!scrollBound) {
		scrollBound = true;
		window.addEventListener('scroll', onScroll, { passive: true });
	}
	onScroll();
	document.addEventListener('astro:page-load', onScroll);

	// 板块名 sync（页头 persist 保活，换页后手动重写）
	const SECTION_LABELS: Record<string, string> = {
		'/': '首页',
		'/blog': '文章',
		'/knowledge': '知识库',
		'/discover': '发现',
		'/about': '关于',
		'/privacy': '隐私',
	};
	function syncSection() {
		const meta = document.querySelector<HTMLElement>('[data-head-meta]');
		const here = document.querySelector<HTMLElement>('[data-head-here]');
		if (!meta || !here) return;
		const path = location.pathname.replace(/\/+$/, '') || '/';
		const label = SECTION_LABELS[path] ?? '';
		here.textContent = label;
		meta.classList.toggle('is-empty', !label);
	}
	syncSection();
	document.addEventListener('astro:page-load', syncSection);

	// ---- 导航菜单（汉堡）+ 设置子菜单（齿轮）----
	function initMenus() {
		const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
		const menuOverlay = document.querySelector<HTMLElement>('[data-menu-overlay]');
		const settingsToggle = document.querySelector<HTMLButtonElement>('[data-settings-toggle]');
		const settingsPanel = document.querySelector<HTMLElement>('[data-settings-panel]');
		if (!menuToggle || !menuOverlay || !settingsToggle || !settingsPanel) return;

		const navLinks = Array.from(menuOverlay.querySelectorAll<HTMLElement>('.menu-link'));

		const closeMenu = () => {
			menuToggle.classList.remove('is-open');
			menuToggle.setAttribute('aria-expanded', 'false');
			menuOverlay.classList.remove('is-open');
			menuOverlay.setAttribute('aria-hidden', 'true');
			document.body.classList.remove('menu-open');
			navLinks.forEach((l) => { l.style.transitionDelay = '0s'; });
		};
		const openMenu = () => {
			closeSettings();
			menuToggle.classList.add('is-open');
			menuToggle.setAttribute('aria-expanded', 'true');
			menuOverlay.classList.add('is-open');
			menuOverlay.setAttribute('aria-hidden', 'false');
			document.body.classList.add('menu-open');
			navLinks.forEach((l, i) => { l.style.transitionDelay = `${i * 0.05}s`; });
		};

		const closeSettings = () => {
			settingsToggle.classList.remove('is-open');
			settingsToggle.setAttribute('aria-expanded', 'false');
			settingsPanel.classList.remove('is-open');
			settingsPanel.hidden = true;
		};
		const openSettings = () => {
			closeMenu();
			settingsToggle.classList.add('is-open');
			settingsToggle.setAttribute('aria-expanded', 'true');
			settingsPanel.hidden = false;
			requestAnimationFrame(() => settingsPanel.classList.add('is-open'));
		};

		menuToggle.addEventListener('click', () => {
			if (menuOverlay.classList.contains('is-open')) closeMenu();
			else openMenu();
		});
		settingsToggle.addEventListener('click', (e) => {
			e.stopPropagation();
			if (settingsPanel.classList.contains('is-open')) closeSettings();
			else openSettings();
		});

		// 设置子菜单内部：不冒泡，避免触发其它面板的外部关闭
		settingsPanel.addEventListener('pointerdown', (e) => e.stopPropagation());
		settingsPanel.addEventListener('click', (e) => e.stopPropagation());
		// 触发收纳的功能
		settingsPanel.querySelectorAll<HTMLElement>('[data-settings-action]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const action = btn.dataset.settingsAction;
				if (action === 'appearance') document.querySelector<HTMLButtonElement>('[data-ap-toggle]')?.click();
				else if (action === 'music') document.querySelector<HTMLButtonElement>('[data-music-toggle]')?.click();
				closeSettings();
			});
		});
		// 搜索 / 管理 / 写信 点击后收起设置菜单
		settingsPanel.querySelectorAll<HTMLElement>('[data-search-open], a.settings-row').forEach((el) => {
			el.addEventListener('click', () => closeSettings());
		});

		// ESC 关闭所有
		window.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape') return;
			if (menuOverlay.classList.contains('is-open')) closeMenu();
			if (settingsPanel.classList.contains('is-open')) closeSettings();
		});

		// 点击外部关闭设置菜单（导航菜单由汉堡/链接/ESC 控制）
		document.addEventListener('pointerdown', (e) => {
			const t = e.target as HTMLElement;
			if (!settingsPanel.hidden && !settingsPanel.contains(t) && !settingsToggle.contains(t)) closeSettings();
		});

		// 换页重置
		document.addEventListener('astro:page-load', () => {
			closeMenu();
			closeSettings();
		});
	}
	initMenus();
</script>

<style>
	.site-head {
		position: sticky;
		top: 0;
		z-index: 120;
		padding: 1.05rem var(--gutter) 0;
		pointer-events: none;
		transition: padding-top var(--dur) var(--ease-out);
	}

	/* ── 液态玻璃基础 ── */
	.glass {
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.05));
		backdrop-filter: blur(16px) saturate(1.4);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		border: 1px solid rgba(255, 255, 255, 0.18);
		box-shadow:
			inset 0 1px 1px rgba(255, 255, 255, 0.35),
			inset 0 -1px 1px rgba(255, 255, 255, 0.06),
			0 8px 24px -10px rgba(0, 0, 0, 0.45);
	}

	.head-shell {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem;
		width: 100%;
		max-width: var(--w-wide, 1272px);
		margin: 0 auto;
		pointer-events: none;
	}
	.head-shell > * {
		pointer-events: auto;
	}

	.head-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-width: 0;
		padding: 7px 16px 7px 10px;
		border-radius: 999px;
		color: rgb(var(--ink));
		text-decoration: none;
	}
	.head-brand__mark {
		font-family: var(--font-sans), system-ui, sans-serif;
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1;
	}
	.head-brand__rule {
		width: 1px;
		height: 12px;
		background: rgba(var(--line), 1);
	}
	.head-brand__meta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
	}
	.head-brand__meta.is-empty {
		display: none;
	}
	.head-brand__here {
		color: rgb(var(--muted));
		font-family: var(--font-editorial), 'Noto Serif SC', 'Songti SC', STSong, Georgia, serif;
		font-size: 0.82rem;
		line-height: 1;
		white-space: nowrap;
	}

	.head-actions {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex: none;
	}

	:global(body[data-hero='1']) .site-head {
		position: fixed;
		inset: 0 0 auto;
	}
	.site-head.is-scrolled {
		padding-top: 0.4rem;
	}

	/* ── 设置 + 汉堡气泡 ── */
	.head-settings,
	.head-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		padding: 0;
		border-radius: 50%;
		cursor: pointer;
		color: rgb(var(--ink));
		transition:
			transform 0.3s var(--ease-out),
			color 0.3s var(--ease-out);
	}
	.head-settings:hover,
	.head-toggle:hover {
		transform: translateY(-1px);
		color: rgb(var(--accent));
	}
	.head-settings.is-open,
	.head-toggle.is-open {
		color: rgb(var(--accent));
	}
	.head-settings.is-open svg {
		transform: rotate(40deg);
	}
	.head-settings svg {
		transition: transform 0.4s var(--ease-spring);
	}

	.head-toggle {
		flex-direction: column;
		gap: 5px;
	}
	.head-toggle__line {
		width: 16px;
		height: 1.6px;
		border-radius: 1px;
		background: rgb(var(--ink));
		transition:
			transform 0.3s var(--ease-out),
			opacity 0.3s var(--ease-out);
	}
	.head-toggle.is-open .head-toggle__line:first-child {
		transform: translateY(3.3px) rotate(45deg);
	}
	.head-toggle.is-open .head-toggle__line:last-child {
		transform: translateY(-3.3px) rotate(-45deg);
	}

	/* 工具组件：按钮隐藏（不显示在顶部栏），面板 fixed 保留 */
	.head-tools {
		position: absolute;
		left: 0;
		top: 0;
		width: 0;
		height: 0;
	}
	.head-tools :global(.ap),
	.head-tools :global(.music) {
		position: absolute;
		left: -9999px;
		top: 0;
	}

	/* ── 导航菜单：分散固定在顶端 ── */
	.menu-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 130;
		background: linear-gradient(180deg, rgba(16, 16, 20, 0.94), rgba(16, 16, 20, 0.88));
		backdrop-filter: blur(24px) saturate(1.4);
		-webkit-backdrop-filter: blur(24px) saturate(1.4);
		border-bottom: 1px solid rgba(255, 255, 255, 0.14);
		box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.7);
		transform: translateY(-102%);
		transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.menu-overlay.is-open {
		transform: translateY(0);
	}
	.menu-nav {
		width: 100%;
		max-width: var(--w-wide, 1272px);
		margin: 0 auto;
		padding: calc(var(--head-h, 64px) + 1.4rem) var(--gutter) 1.6rem;
	}
	.menu-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	.menu-link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		text-decoration: none;
		color: rgb(var(--ink));
		opacity: 0;
		transform: translateY(-8px);
		transition:
			opacity 0.45s var(--ease-out),
			transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
			color 0.25s var(--ease-out);
	}
	.menu-overlay.is-open .menu-link {
		opacity: 1;
		transform: none;
	}
	.menu-link:hover {
		color: rgb(var(--accent));
	}
	.menu-link__num {
		font-family: var(--font-sans), system-ui, sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		color: rgb(var(--muted));
		transform: translateY(-0.4em);
	}
	.menu-link__label {
		font-family: var(--font-editorial), 'Noto Serif SC', 'Songti SC', STSong, Georgia, serif;
		font-size: clamp(1.5rem, 3.2vw, 2.6rem);
		line-height: 1;
		letter-spacing: 0.01em;
	}

	/* ── 设置子菜单 ── */
	.settings-panel {
		position: fixed;
		top: calc(var(--head-h, 64px) + 10px);
		right: var(--gutter);
		z-index: 200;
		width: min(300px, calc(100vw - 2rem));
		padding: 0.9rem;
		border-radius: var(--r-lg);
		background: linear-gradient(160deg, rgba(44, 44, 52, 0.9), rgba(26, 26, 30, 0.88));
		backdrop-filter: blur(30px) saturate(1.5);
		-webkit-backdrop-filter: blur(30px) saturate(1.5);
		border: 1px solid rgba(255, 255, 255, 0.16);
		box-shadow:
			inset 0 1px 1px rgba(255, 255, 255, 0.32),
			0 24px 60px -20px rgba(0, 0, 0, 0.6);
		opacity: 0;
		transform: translateY(-8px) scale(0.98);
		transform-origin: top right;
		transition:
			opacity 0.22s var(--ease-out),
			transform 0.3s var(--ease-spring);
	}
	.settings-panel.is-open {
		opacity: 1;
		transform: none;
	}
	.settings-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.1rem 0.2rem 0.7rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}
	.settings-head__dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: rgb(var(--accent));
		box-shadow: 0 0 0 3px rgba(var(--accent), 0.18);
	}
	.settings-list {
