---
// 悬浮页头：PillNav 胶囊导航（圆形 logo + 胶囊条 + 当前页小点），右侧工具组。
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import PillNav from './PillNav.astro';
import MusicPlayer from './MusicPlayer.astro';

// 主导航：PillNav 的项就是这五个页面
const primaryNav = [
	{ label: '文章', href: '/blog' },
	{ label: '知识库', href: '/knowledge' },
	{ label: '照片', href: '/gallery' },
	{ label: '发现', href: '/discover' },
	{ label: '关于', href: '/about' },
];

// 首屏就给出正确的当前页，避免 hydration 前高亮闪一下
const activePath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-head" transition:persist="site-head" transition:name="site-header">
	<div class="head-shell">
		<div class="head-nav">
			<PillNav
				items={primaryNav}
				logoText="Y"
				logoHref="/"
				logoAlt={`${SITE_TITLE} 首页`}
				activeHref={activePath}
				layout="split"
				size="md"
				itemStyle="plain"
				hoverEffect="glide"
				indicator="dot"
				collapse="auto"
				bounce={0.3}
				stretch={0.55}
				intro={true}
			/>
		</div>
		<div class="head-actions">
			<button class="head-search" type="button" data-search-open aria-label="站内搜索（⌘K）" title="站内搜索 ⌘K">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm4-1.5 3 3"></path>
				</svg>
			</button>
			<MusicPlayer />
			<a class="head-cta" href={SOCIAL_LINKS.email}>
				<span>写信给我</span>
				<svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M3.4 8.6 8.6 3.4M4.3 3.4h4.3v4.3"></path>
				</svg>
			</a>
		</div>
	</div>
</header>

<script>
	function currentPath() {
		const p = location.pathname.replace(/\/+$/, '');
		return p === '' ? '/' : p;
	}

	// window 级监听只需绑一次：View Transitions 不会重建 window
	let scrollBound = false;
	let scrollRaf = 0;
	let headerShell: HTMLElement | null = null;

	function onScroll() {
		if (!headerShell || scrollRaf) return;
		scrollRaf = requestAnimationFrame(() => {
			scrollRaf = 0;
			if (!headerShell) return;
			headerShell.classList.toggle('is-scrolled', window.scrollY > 16);
			headerShell.classList.toggle('is-top', document.body.dataset.hero === '1' && window.scrollY < 24);
		});
	}

	// scroll-spy 的观察目标在页面内容里，换页会整体替换，必须每次 page-load 重建
	let spyIO: IntersectionObserver | null = null;

	function init() {
		headerShell = document.querySelector<HTMLElement>('.site-head');
		const shell = headerShell;
		if (!shell) return;

		// 滚动收缩：只绑一次，避免换页时监听器越堆越多
		if (!scrollBound) {
			scrollBound = true;
			window.addEventListener('scroll', onScroll, { passive: true });
		}
		onScroll();

		// 首页 scroll-spy：视口中线落在哪个板块，就把哪个导航项点亮
		// （PillNav 自己监听 scroll-spy 事件，这里只负责发现当前板块）
		spyIO?.disconnect();
		spyIO = null;
		const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-section]'));
		if (sections.length) {
			const map: Record<string, string> = {
				articles: '/blog',
				knowledge: '/knowledge',
				discover: '/discover',
				about: '/about',
			};
			let current = '';
			const io = new IntersectionObserver(
				(entries) => {
					const visible = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
					if (!visible) return;
					const name = (visible.target as HTMLElement).dataset.section ?? '';
					if (name === current) return;
					current = name;
					window.dispatchEvent(new CustomEvent('scroll-spy', { detail: { href: map[name] ?? '' } }));
				},
				{ rootMargin: '-45% 0px -45% 0px', threshold: 0 },
			);
			sections.forEach((section) => io.observe(section));
			spyIO = io;
		} else {
			// 非首页：清掉上一页可能残留的高亮
			window.dispatchEvent(new CustomEvent('scroll-spy', { detail: { href: '' } }));
		}

		// 首页上点导航：平滑滚到对应板块，而不是跳转页面
		// 页头通过 transition:persist 保活，导航元素不重建，只绑一次
		if (!shell.dataset.linkWired) {
			shell.dataset.linkWired = '1';
			const links = Array.from(document.querySelectorAll<HTMLElement>('[data-pn-item]'));
			const sectionByHref: Record<string, string> = {
				'/blog': 'articles',
				'/knowledge': 'knowledge',
				'/discover': 'discover',
				'/about': 'about',
			};
			for (const link of links) {
				link.addEventListener('click', (e) => {
					const onHome = currentPath() === '/';
					if (!onHome) return; // 非首页正常跳转
					const href = link.dataset.href || '/';
					const targetId = sectionByHref[href];
					if (!targetId) return;
					const sec = document.getElementById(targetId);
					if (!sec) return; // 首页没有对应板块就正常跳转
					e.preventDefault();
					sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
					history.replaceState(null, '', `/#${targetId}`);
				});
			}
		}
	}

	init();
	document.addEventListener('astro:page-load', init);
</script>

<style>
	.site-head {
		position: sticky;
		top: 0;
		z-index: 120;
		padding: 0.75rem var(--gutter) 0;
		pointer-events: none;
	}
	/* 版心：左侧胶囊导航，右侧工具组，与正文同宽 */
	.head-shell {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem;
		width: 100%;
		max-width: var(--w-wide, 1272px);
		margin: 0 auto;
		pointer-events: none;
	}
	.head-shell > * {
		pointer-events: auto;
	}
	.head-nav {
		display: flex;
		min-width: 0;
		flex: 1 1 auto;
	}
	.head-actions {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex: none;
	}

	/* 首页：页头脱离文档流，Hero 从屏幕最顶端开始 */
	:global(body[data-hero='1']) .site-head {
		position: fixed;
		inset: 0 0 auto;
	}

	/* 滚动收缩：收紧页头内边距 */
	.site-head.is-scrolled {
		padding-top: 0.4rem;
	}
	.site-head {
		transition: padding-top var(--dur) var(--ease-out);
	}

	/* 页头条几何：参考 studio 版式——更宽、更扁、更小的圆角、发丝描边 */
	.site-head {
		padding-top: 1.05rem;
	}
	.site-head :global(.card-nav) {
		--cn-bar: 56px;
		--cn-radius: 12px;
		--cn-inset: 6px;
		font-size: 13px;
	}
	.site-head :global(.card-nav__panel) {
		-webkit-backdrop-filter: blur(18px) saturate(1.25);
		backdrop-filter: blur(18px) saturate(1.25);
		box-shadow:
			inset 0 0 0 1px var(--glass-brd),
			0 18px 40px -28px rgba(0, 0, 0, 0.9);
	}

	/* 右侧主按钮：反色实心，和参考站右上角的 CTA 对应 */
	.head-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		height: 38px;
		margin-left: 0.3rem;
		padding: 0 0.3rem 0 1rem;
		border-radius: 999px;
		background: rgb(var(--accent));
		color: rgb(11, 11, 12);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		transition:
			transform 0.25s var(--ease-out),
			filter 0.25s var(--ease-out);
	}
	.head-cta:hover {
		transform: translateY(-1px);
		filter: brightness(1.07);
	}
	/* 圆形箭头盘：深色底 + 米白箭头 */
	.head-cta svg {
		width: 30px;
		height: 30px;
		padding: 9px;
		border-radius: 50%;
		background: rgb(11, 11, 12);
		color: rgb(236, 235, 230);
		box-sizing: border-box;
		transition: transform 0.3s var(--ease-out);
	}
	.head-cta:hover svg {
		transform: rotate(-45deg);
	}
	@media (max-width: 720px) {
		.head-cta {
			display: none;
		}
	}

	@media (max-width: 620px) {
		.site-head {
			padding: 0.5rem 0.6rem 0;
		}
		.brand-name {
			font-size: 0.95rem;
		}
	}
</style>
