---
// 悬浮玻璃页头：滑动高亮块 + 滚动收缩 + 视图过渡锚点。
// 导航标签刻意保持两个汉字，等宽排列，高亮块才能滑动得干净。
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import MusicPlayer from './MusicPlayer.astro';
import GlassSurface from './GlassSurface.astro';

const navItems = [
	{ href: '/', label: '首页' },
	{ href: '/blog', label: '文章' },
	{ href: '/knowledge', label: '知识库' },
	{ href: '/discover', label: '发现' },
	{ href: '/gallery', label: '照片' },
	{ href: '/about', label: '关于' },
];
---

<header class="site-head" transition:persist="site-head" transition:name="site-header">
	<div class="head-shell" data-head-shell>
			<GlassSurface class="head-shell__glass" borderRadius={999} backgroundOpacity={0.38} blur={22} />
		<a class="brand" href="/" aria-label={`${SITE_TITLE} 首页`}>
			<span class="brand-dot" aria-hidden="true"><i></i></span>
			<span class="brand-name">{SITE_TITLE}</span>
			<span class="brand-sub" aria-hidden="true">/ journal</span>
		</a>

		<nav class="nav" data-nav aria-label="主导航">
			<span class="nav-ind" data-nav-ind aria-hidden="true"></span>
			{navItems.map((item) => (
				<a href={item.href} class="nav-link" data-nav-item data-href={item.href}>
					{item.label}
				</a>
			))}
		</nav>

		<div class="head-actions">
			<div class="social">
				{SOCIAL_LINKS.github && (
					<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener" aria-label="GitHub">
						<svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
							<path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							></path>
						</svg>
					</a>
				)}
				{SOCIAL_LINKS.email && (
					<a href={SOCIAL_LINKS.email} aria-label="邮箱">
						<svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
							<path
								fill="currentColor"
								d="M1.5 3h13a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5Zm.7 1 5.68 4.38a.5.5 0 0 0 .64 0L14.1 4H2.2ZM14 5.62 9.62 8.99a1.5 1.5 0 0 1-1.92 0L3 5.62V12h11V5.62Z"
							></path>
						</svg>
					</a>
				)}
			</div>
			<button class="theme-toggle" data-theme-toggle type="button" aria-label="切换浅色/深色主题" aria-pressed="false">
				<svg class="theme-toggle__sun" viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
					<circle cx="8" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
					<g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
						<path d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M12.8 3.2l-1.1 1.1M4.3 11.7l-1.1 1.1"></path>
					</g>
				</svg>
				<svg class="theme-toggle__moon" viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
					<path
						fill="currentColor"
						d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7Z"
					></path>
				</svg>
			</button>
			<div class="palette" data-palette>
				<button class="palette-btn" type="button" data-palette-toggle aria-label="切换配色" aria-expanded="false">
					<span class="palette-dot" aria-hidden="true"></span>
				</button>
				<div class="palette-panel" data-palette-panel hidden>
					<button class="palette-swatch" type="button" data-accent="orange" style="--sw:#d0845c" aria-label="暖橙" title="暖橙"></button>
					<button class="palette-swatch" type="button" data-accent="blue" style="--sw:#608cc8" aria-label="海蓝" title="海蓝"></button>
					<button class="palette-swatch" type="button" data-accent="teal" style="--sw:#52a694" aria-label="青绿" title="青绿"></button>
					<button class="palette-swatch" type="button" data-accent="violet" style="--sw:#9678c4" aria-label="藕紫" title="藕紫"></button>
					<button class="palette-swatch" type="button" data-accent="pink" style="--sw:#c66e8a" aria-label="玫粉" title="玫粉"></button>
				</div>
			</div>
			<MusicPlayer />
		</div>
	</div>
</header>

<script>
	const SHELL = '[data-head-shell]';
	const NAV = '[data-nav]';
	const IND = '[data-nav-ind]';

	function currentPath() {
		const p = location.pathname.replace(/\/+$/, '');
		return p === '' ? '/' : p;
	}

	/** 把高亮块滑到目标链接下面；first=true 时不做过渡，避免从 0 飞过来 */
	function slideTo(link: HTMLElement, first = false) {
		const nav = link.closest<HTMLElement>(NAV);
		const ind = nav?.querySelector<HTMLElement>(IND);
		if (!nav || !ind) return;

		const navRect = nav.getBoundingClientRect();
		const r = link.getBoundingClientRect();
		ind.style.width = `${r.width}px`;
		ind.style.transform = `translate3d(${r.left - navRect.left}px, -50%, 0)`;
		if (first) {
			ind.classList.add('no-anim');
			requestAnimationFrame(() => ind.classList.remove('no-anim'));
		}
	}

	function init() {
		const shell = document.querySelector<HTMLElement>(SHELL);
		const nav = document.querySelector<HTMLElement>(NAV);
		if (!shell || !nav) return;

		const links = Array.from(nav.querySelectorAll<HTMLElement>('[data-nav-item]'));
		const path = currentPath();

		// 页头被 transition:persist 保活，active 状态得按当前路径重算
		let active = links.find((a) => a.dataset.href === path);
		if (!active) {
			active =
				links
					.filter((a) => a.dataset.href !== '/' && path.startsWith(a.dataset.href!))
					.sort((a, b) => b.dataset.href!.length - a.dataset.href!.length)[0] ??
				links[0];
		}
		links.forEach((a) => {
			const on = a === active;
			a.classList.toggle('is-active', on);
			if (on) a.setAttribute('aria-current', 'page');
			else a.removeAttribute('aria-current');
		});
		slideTo(active, true);

		// 悬停：高亮块跟手预览，离开后回到当前页
		for (const link of links) {
			link.addEventListener('pointerenter', () => slideTo(link));
			link.addEventListener('focus', () => slideTo(link));
		}
		nav.addEventListener('pointerleave', () => slideTo(active!));
		nav.addEventListener('focusout', (e) => {
			if (!nav.contains(e.relatedTarget as Node)) slideTo(active!);
		});

		// 滚动收缩
		let raf = 0;
		const onScroll = () => {
			if (raf) return;
			raf = requestAnimationFrame(() => {
				raf = 0;
				shell.classList.toggle('is-scrolled', window.scrollY > 16);
				shell.classList.toggle('is-top', document.body.dataset.hero === '1' && window.scrollY < 24);
			});
		};
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		// 窗口尺寸变化时重新对齐（字体加载完宽度也会变）
		const onResize = () => slideTo(active!, true);
		window.addEventListener('resize', onResize);
		document.fonts?.ready.then(onResize);

		// 主题切换
		const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
		if (toggle && !toggle.dataset.wired) {
			toggle.dataset.wired = '1';
			const syncAria = () => {
				const cur = window.__getTheme?.() ?? document.documentElement.dataset.theme ?? 'dark';
				toggle.setAttribute('aria-pressed', String(cur === 'light'));
			};
			toggle.addEventListener('click', () => {
				const cur = window.__getTheme?.() ?? document.documentElement.dataset.theme ?? 'dark';
				const next = cur === 'dark' ? 'light' : 'dark';
				window.__setTheme?.(next);
				syncAria();
				// 同步 theme-color meta
				const meta = document.querySelector('meta[name="theme-color"]');
				if (meta) meta.setAttribute('content', next === 'light' ? '#f6f3ee' : '#181512');
			});
			syncAria();
		}

		// 调色盘：切换强调色
		const palette = document.querySelector<HTMLElement>('[data-palette]');
		if (palette && !palette.dataset.wired) {
			palette.dataset.wired = '1';
			const pToggle = palette.querySelector<HTMLButtonElement>('[data-palette-toggle]');
			const panel = palette.querySelector<HTMLElement>('[data-palette-panel]');
			const swatches = Array.from(palette.querySelectorAll<HTMLButtonElement>('.palette-swatch'));

			const syncActive = () => {
				const cur = window.__getAccent?.() ?? 'orange';
				swatches.forEach((s) => s.classList.toggle('is-active', s.dataset.accent === cur));
			};
			const close = () => {
				if (panel) panel.hidden = true;
				pToggle?.setAttribute('aria-expanded', 'false');
			};

			pToggle?.addEventListener('click', () => {
				const open = panel?.hidden ?? true;
				if (panel) panel.hidden = !open;
				pToggle.setAttribute('aria-expanded', String(!open));
			});
			swatches.forEach((s) => {
				s.addEventListener('click', () => {
					window.__setAccent?.(s.dataset.accent ?? 'orange');
					syncActive();
					close();
				});
			});
			document.addEventListener('click', (e) => {
				if (palette.contains(e.target as Node)) return;
				if (panel && !panel.hidden) close();
			});
			syncActive();
		}

		// 首页 scroll-spy：收到板块切换事件时，把高亮块滑到对应导航项
		window.addEventListener('scroll-spy', ((e: CustomEvent) => {
			const href = e.detail?.href;
			if (!href) return;
			const link = links.find((a) => a.dataset.href === href);
			if (link) slideTo(link);
		}) as EventListener);

		// 首页上点导航：平滑滚到对应板块，而不是跳转页面
		// 板块 id 与导航 href 的映射（articles→/blog 等）
		const sectionByHref: Record<string, string> = {
			'/': 'home',
			'/blog': 'articles',
			'/knowledge': 'knowledge',
			'/discover': 'discover',
			'/about': 'about',
		};
		for (const link of links) {
			link.addEventListener('click', (e) => {
				const onHome = currentPath() === '/';
				if (!onHome) return; // 非首页正常跳转
				const href = link.dataset.href || '/';
				const targetId = sectionByHref[href];
				if (!targetId) return;
				const sec = document.getElementById(targetId);
				if (!sec) return; // 首页没有对应板块就正常跳转
				e.preventDefault();
				sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
				history.replaceState(null, '', href === '/' ? '/' : `/#${targetId}`);
			});
		}
	}

	document.addEventListener('astro:page-load', init);
	if (document.readyState !== 'loading') init();
</script>

<style>
	.site-head {
		position: sticky;
		top: 0;
		z-index: 120;
		padding: 0.75rem var(--gutter) 0;
		pointer-events: none;
	}
	.head-shell {
		position: relative;
		isolation: isolate;
		pointer-events: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: var(--w-wide);
		margin: 0 auto;
		padding: 0.55rem 0.6rem 0.55rem 1.1rem;
		border-radius: var(--r-pill);
		transition:
			padding var(--dur) var(--ease-out),
			background-color var(--dur) var(--ease-out),
			box-shadow var(--dur) var(--ease-out),
			transform var(--dur) var(--ease-out);
	}
	.head-shell.is-scrolled {
		padding-block: 0.32rem;
		background: var(--glass-bg-strong);
		box-shadow: var(--glass-shine), var(--shadow-lg);
	}

	/* ---- 品牌 ---- */
	.brand {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		text-decoration: none;
		color: rgb(var(--ink));
		font-weight: 800;
		letter-spacing: 0.02em;
		font-size: 1.02rem;
		flex-shrink: 0;
	}
	.brand-dot {
		position: relative;
		align-self: center;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: rgb(var(--accent));
		box-shadow: 0 0 0 0 rgba(var(--accent), 0.45);
		animation: dot-pulse 3.6s var(--ease-out) infinite;
	}
	.brand-dot i {
		position: absolute;
		inset: -3px;
		border-radius: 50%;
		border: 1px solid rgba(var(--accent), 0.35);
	}
	.brand-sub {
		font-size: 0.72rem;
		font-weight: 400;
		letter-spacing: 0.12em;
		color: rgb(var(--muted-light));
		text-transform: lowercase;
	}
	@keyframes dot-pulse {
		0%,
		62%,
		100% {
			box-shadow: 0 0 0 0 rgba(var(--accent), 0.4);
		}
		30% {
			box-shadow: 0 0 0 7px rgba(var(--accent), 0);
		}
	}

	/* ---- 导航 ---- */
	.nav {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.1rem;
		padding: 0.18rem;
		border-radius: var(--r-pill);
		background: var(--chip-bg-dim);
		isolation: isolate;
	}
	.nav-ind {
		position: absolute;
		left: 0;
		top: 50%;
		height: calc(100% - 0.36rem);
		width: 3rem;
		border-radius: var(--r-pill);
		background: var(--glass-bg-strong);
		box-shadow: 0 1px 2px rgba(var(--shadow-color), 0.12), 0 6px 16px -8px rgba(var(--shadow-color), 0.4);
		transform: translate3d(0, -50%, 0);
		transition:
			transform 0.42s var(--ease-spring),
			width 0.42s var(--ease-spring);
		z-index: -1;
	}
	.nav-ind.no-anim {
		transition: none;
	}
	.nav-link {
		position: relative;
		padding: 0.42rem 0.78rem;
		border-radius: var(--r-pill);
		font-size: 0.9rem;
		font-weight: 500;
		color: rgb(var(--muted));
		text-decoration: none;
		white-space: nowrap;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.nav-link:hover {
		color: rgb(var(--ink));
	}
	.nav-link.is-active {
		color: rgb(var(--accent-deep));
		font-weight: 700;
	}

	/* ---- 右侧操作 ---- */
	.head-shell > :not(.head-shell__glass) {
		position: relative;
		z-index: 1;
	}
	/* 首页：页头脱离文档流，Hero 从屏幕最顶端开始，两者同一张画面 */
	:global(body[data-hero='1']) .site-head {
		position: fixed;
		inset: 0 0 auto;
	}

	/* 首页：页头浮在整屏画面上，不另起一块玻璃 */
	.head-shell :global(.head-shell__glass) {
		transition: opacity 0.55s var(--ease-out);
	}
	:global(body[data-hero='1']) .head-shell.is-top {
		box-shadow: none;
	}
	:global(body[data-hero='1']) .head-shell.is-top :global(.head-shell__glass) {
		opacity: 0;
	}

	.head-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
	}
	.social {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}
	.social a {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		color: rgb(var(--muted));
		text-decoration: none;
		transition:
			color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
	}
	.social a:hover {
		color: rgb(var(--accent));
		background: var(--chip-bg);
	}

	/* ---- 主题切换 ---- */
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: rgb(var(--muted));
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
	}
	.theme-toggle:hover {
		color: rgb(var(--accent));
		background: var(--chip-bg);
	}
	.theme-toggle__sun,
	.theme-toggle__moon {
		grid-area: 1 / 1;
		transition:
			opacity var(--dur-fast) var(--ease-out),
			transform var(--dur) var(--ease-spring);
	}
	/* 深色主题：显示月亮（点一下切到浅色），太阳隐藏 */
	.theme-toggle .theme-toggle__moon {
		opacity: 1;
		transform: none;
	}
	.theme-toggle .theme-toggle__sun {
		opacity: 0;
		transform: scale(0.4) rotate(-90deg);
	}
	/* 浅色主题：显示太阳（点一下切回深色） */
	:global(html[data-theme='light']) .theme-toggle .theme-toggle__sun {
		opacity: 1;
		transform: none;
	}
	:global(html[data-theme='light']) .theme-toggle .theme-toggle__moon {
		opacity: 0;
		transform: scale(0.4) rotate(90deg);
	}

	/* ---- 调色盘 ---- */
	.palette {
		position: relative;
		display: flex;
		align-items: center;
	}
	.palette-btn {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: transparent;
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
	}
	.palette-btn:hover {
		background: var(--chip-bg);
	}
	.palette-dot {
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: rgb(var(--accent));
		box-shadow: 0 0 0 2px rgba(var(--accent), 0.18), 0 2px 6px -1px rgba(var(--accent), 0.55);
		transition: background-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
	}
	.palette-panel {
		position: absolute;
		top: calc(100% + 0.7rem);
		right: 0;
		display: flex;
		gap: 0.45rem;
		padding: 0.6rem 0.7rem;
		border-radius: var(--r-pill);
		background: var(--glass-bg-strong);
		border: 1px solid var(--glass-brd);
		-webkit-backdrop-filter: blur(18px) saturate(1.3);
		backdrop-filter: blur(18px) saturate(1.3);
		box-shadow: var(--glass-shine), var(--shadow-lg);
		opacity: 0;
		transform: translate3d(0, -6px, 0) scale(0.96);
		transform-origin: top right;
		transition:
			opacity 0.2s var(--ease-out),
			transform 0.28s var(--ease-spring);
		z-index: 50;
	}
	.palette-panel:not([hidden]) {
		opacity: 1;
		transform: none;
	}
	.palette-panel[hidden] {
		display: none;
	}
	.palette-swatch {
		position: relative;
		width: 22px;
		height: 22px;
		padding: 0;
		border: 2px solid transparent;
		border-radius: 50%;
		background: var(--sw);
		cursor: pointer;
		transition:
			transform var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}
	.palette-swatch:hover {
		transform: scale(1.18);
	}
	.palette-swatch.is-active {
		border-color: rgb(var(--ink));
	}
	@media (max-width: 860px) {
		.palette-panel {
			right: -1rem;
		}
	}

	@media (max-width: 860px) {
		.brand-sub,
		.social {
			display: none;
		}
	}
	@media (max-width: 620px) {
		.site-head {
			padding: 0.5rem 0.6rem 0;
		}
		.head-shell {
			border-radius: 20px;
			padding: 0.45rem 0.45rem 0.45rem 0.7rem;
			gap: 0.5rem;
		}
		.brand {
			font-size: 0.95rem;
		}
		.nav {
			gap: 0;
