---
// 悬浮页头：左侧站点标 + 当前板块（跑马页眉），右侧工具组。
// 主导航不在这里 —— 已移到页面底部的 DockNav（数字标签 + 斜体标签展开），
// 两处各放一份导航只会互相打架，所以页头只留身份与工具。
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import MusicPlayer from './MusicPlayer.astro';
import AppearancePanel from './AppearancePanel.astro';

// 当前板块名：给左上角做页眉用，取不到就不显示
const SECTION_LABELS: Record<string, string> = {
	'/': '首页',
	'/blog': '文章',
	'/knowledge': '知识库',
	'/gallery': '照片',
	'/discover': '发现',
	'/about': '关于',
	'/privacy': '隐私',
};
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const sectionLabel = SECTION_LABELS[path] ?? '';
---

<header class="site-head" transition:persist="site-head" transition:name="site-header">
	<div class="head-shell">
		<a class="head-brand" href="/" aria-label={`${SITE_TITLE} 首页`}>
			<span class="head-brand__mark">ystlr</span>
			<span class:list={['head-brand__meta', !sectionLabel && 'is-empty']} data-head-meta>
				<span class="head-brand__rule" aria-hidden="true"></span>
				<span class="head-brand__here" data-head-here>{sectionLabel}</span>
			</span>
		</a>
		<div class="head-actions">
			<button class="head-search" type="button" data-search-open aria-label="站内搜索（⌘K）" title="站内搜索 ⌘K">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm4-1.5 3 3"></path>
				</svg>
			</button>
			<AppearancePanel />
			<MusicPlayer />
			<a class="head-cta" href={SOCIAL_LINKS.email}>
				<span>写信给我</span>
				<svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M3.4 8.6 8.6 3.4M4.3 3.4h4.3v4.3"></path>
				</svg>
			</a>
		</div>
	</div>
</header>

<script>
	// 滚动收缩：滚过 16px 后收紧页头内边距，首屏 hero 时脱离文档流。
	// window 级监听只绑一次（View Transitions 不会重建 window）。
	let scrollBound = false;
	let scrollRaf = 0;

	function onScroll() {
		if (scrollRaf) return;
		scrollRaf = requestAnimationFrame(() => {
			scrollRaf = 0;
			const shell = document.querySelector<HTMLElement>('.site-head');
			if (!shell) return;
			shell.classList.toggle('is-scrolled', window.scrollY > 16);
			shell.classList.toggle('is-top', document.body.dataset.hero === '1' && window.scrollY < 24);
		});
	}

	if (!scrollBound) {
		scrollBound = true;
		window.addEventListener('scroll', onScroll, { passive: true });
	}
	onScroll();
	document.addEventListener('astro:page-load', onScroll);

	// 页头被 persist 保活，左上角的板块名不会随换页重渲染，只能每次手动对一次
	const SECTION_LABELS: Record<string, string> = {
		'/': '首页',
		'/blog': '文章',
		'/knowledge': '知识库',
		'/gallery': '照片',
		'/discover': '发现',
		'/about': '关于',
		'/privacy': '隐私',
	};

	function syncSection() {
		const meta = document.querySelector<HTMLElement>('[data-head-meta]');
		const here = document.querySelector<HTMLElement>('[data-head-here]');
		if (!meta || !here) return;
		const path = location.pathname.replace(/\/+$/, '') || '/';
		const label = SECTION_LABELS[path] ?? '';
		here.textContent = label;
		meta.classList.toggle('is-empty', !label);
	}

	syncSection();
	document.addEventListener('astro:page-load', syncSection);
</script>

<style>
	.site-head {
		position: sticky;
		top: 0;
		z-index: 120;
		padding: 1.05rem var(--gutter) 0;
		pointer-events: none;
		transition: padding-top var(--dur) var(--ease-out);
	}

	/* 版心：左侧页眉，右侧工具组，与正文同宽 */
	.head-shell {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem;
		width: 100%;
		max-width: var(--w-wide, 1272px);
		margin: 0 auto;
		pointer-events: none;
	}

	.head-shell > * {
		pointer-events: auto;
	}

	/* 页眉：站点标 + 发丝竖线 + 当前板块 */
	.head-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-width: 0;
		color: rgb(var(--ink));
		text-decoration: none;
	}

	.head-brand__mark {
		font-family: var(--font-sans), system-ui, sans-serif;
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.head-brand__rule {
		width: 1px;
		height: 12px;
		background: rgba(var(--line), 1);
	}

	/* 页头常驻（transition:persist），板块名得靠脚本换页后重写 */
	.head-brand__meta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
	}

	.head-brand__meta.is-empty {
		display: none;
	}

	.head-brand__here {
		color: rgb(var(--muted));
		font-family: var(--font-editorial), 'Noto Serif SC', 'Songti SC', STSong, Georgia, serif;
		font-size: 0.82rem;
		line-height: 1;
		white-space: nowrap;
	}

	.head-actions {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex: none;
	}

	/* 首页：页头脱离文档流，Hero 从屏幕最顶端开始 */
	:global(body[data-hero='1']) .site-head {
		position: fixed;
		inset: 0 0 auto;
	}

	/* 滚动收缩：收紧页头内边距 */
	.site-head.is-scrolled {
		padding-top: 0.4rem;
	}

	/* 站内搜索：与音乐按钮同一套圆形控件 */
	.head-search {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		padding: 0;
		border-radius: 50%;
		border: 1px solid rgba(var(--line), 1);
		background: var(--chip-bg);
		color: rgb(var(--muted));
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
	}

	.head-search:hover {
		color: rgb(var(--ink));
		border-color: rgba(var(--accent), 0.45);
		background: var(--chip-bg-strong);
	}

	.head-search:focus-visible {
		outline: 2px solid rgba(var(--accent), 0.6);
		outline-offset: 2px;
	}

	.head-search svg {
		width: 15px;
		height: 15px;
	}

	.head-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		height: 38px;
		margin-left: 0.3rem;
		padding: 0 0.3rem 0 1rem;
		border-radius: 999px;
		background: rgb(var(--accent));
		color: rgb(11, 11, 12);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		transition:
			transform 0.25s var(--ease-out),
			filter 0.25s var(--ease-out);
	}

	.head-cta:hover {
		transform: translateY(-1px);
		filter: brightness(1.07);
	}

	/* 圆形箭头盘：深色底 + 米白箭头 */
	.head-cta svg {
		width: 30px;
		height: 30px;
		padding: 9px;
		border-radius: 50%;
		background: rgb(11, 11, 12);
		color: rgb(236, 235, 230);
		box-sizing: border-box;
		transition: transform 0.3s var(--ease-out);
	}

	.head-cta:hover svg {
		transform: rotate(-45deg);
	}

	@media (max-width: 720px) {
		.head-cta {
			display: none;
		}
	}

	@media (max-width: 620px) {
		.site-head {
			padding: 0.5rem 0.6rem 0;
		}

		.head-brand__mark {
			font-size: 0.88rem;
		}

		.head-brand__here {
			font-size: 0.76rem;
		}
	}
</style>
