---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/projects">作品</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<div class="social-links">
			{SOCIAL_LINKS.github && (
				<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">
					<span class="sr-only">GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
			)}
			{SOCIAL_LINKS.x && (
				<a href={SOCIAL_LINKS.x} target="_blank" rel="noopener">
					<span class="sr-only">X</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
						<path
							fill="currentColor"
							d="M12.6.5h2.4l-5.3 6.06L16.2 15.5h-4.85l-3.8-4.97-4.35 4.97H.8l5.62-6.42L0 .5h4.97l3.43 4.54L12.6.5Zm-.85 13.55h1.33L4.34 1.85H2.9l8.85 12.2Z"
						></path>
					</svg>
				</a>
			)}
			{SOCIAL_LINKS.email && (
				<a href={SOCIAL_LINKS.email}>
					<span class="sr-only">邮箱</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="currentColor"
							d="M1.5 3h13a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5Zm.7 1 5.68 4.38a.5.5 0 0 0 .64 0L14.1 4H2.2ZM14 5.62 9.62 8.99a1.5 1.5 0 0 1-1.92 0L3 5.62V12h11V5.62Z"
						></path>
					</svg>
				</a>
			)}
		</div>
	</nav>
</header>

<style>
	header {
		background: rgb(var(--paper));
		border-bottom: 1px solid rgb(var(--line));
		position: sticky;
		top: 0;
		z-index: 10;
	}
	h2 {
		margin: 0;
		font-size: 1.05em;
		letter-spacing: 0.02em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--ink));
		font-weight: 700;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1em;
	}
	nav a {
		padding: 0.9em 0.5em;
		color: rgb(var(--muted));
		border-bottom: 2px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		color: rgb(var(--ink));
		border-bottom-color: rgb(var(--accent));
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
	}
	.social-links {
		gap: 0.9em;
	}
	.social-links a {
		color: rgb(var(--muted));
		padding: 0.5em 0;
	}
	.social-links a:hover {
		color: rgb(var(--accent));
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		nav {
			justify-content: center;
			gap: 0.5em;
		}
	}
</style>
