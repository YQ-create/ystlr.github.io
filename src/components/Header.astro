---
// 悬浮玻璃页头（卡片式导航 CardNav）：居中 logo，左汉堡展开卡片菜单，右侧主题/配色/音乐。
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import CardNav from './CardNav.astro';
import MusicPlayer from './MusicPlayer.astro';

// 卡片菜单数据：三个分组，每个分组一张卡片（标题 + 描述 + 链接）
const navItems = [
	{
		label: '文字',
		description: '文章与成体系的笔记',
		links: [
			{ label: '文章', href: '/blog' },
			{ label: '知识库', href: '/knowledge' },
		],
	},
	{
		label: '影像',
		description: '照片墙与收藏的链接',
		links: [
			{ label: '照片', href: '/gallery' },
			{ label: '发现', href: '/discover' },
		],
	},
	{
		label: '关于',
		description: '认识我，或联系我',
		links: [
			{ label: '关于我', href: '/about' },
			...(SOCIAL_LINKS.github ? [{ label: 'GitHub', href: SOCIAL_LINKS.github, external: true }] : []),
			...(SOCIAL_LINKS.email ? [{ label: '邮箱', href: SOCIAL_LINKS.email, external: true }] : []),
		],
	},
];
---

<header class="site-head" transition:persist="site-head" transition:name="site-header">
	<CardNav
		items={navItems}
		logoHref="/"
		logoAlt={`${SITE_TITLE} 首页`}
		openOn="hover"
		cardEffect="rise"
		stagger={0.12}
		bounce={0.2}
		maxWidth={1272}
		menuLabel={true}
		intro={true}
	>
		<span slot="logo" class="brand">
			<span class="brand-dot" aria-hidden="true"><i></i></span>
			<span class="brand-name">{SITE_TITLE}</span>
		</span>

		<Fragment slot="actions">
			<button class="head-search" type="button" data-search-open aria-label="站内搜索（⌘K）" title="站内搜索 ⌘K">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm4-1.5 3 3"></path>
				</svg>
			</button>
			<button class="theme-toggle" data-theme-toggle type="button" aria-label="切换浅色/深色主题" aria-pressed="false">
				<svg class="theme-toggle__sun" viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
					<circle cx="8" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
					<g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
						<path d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M12.8 3.2l-1.1 1.1M4.3 11.7l-1.1 1.1"></path>
					</g>
				</svg>
				<svg class="theme-toggle__moon" viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
					<path fill="currentColor" d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7Z"></path>
				</svg>
			</button>
			<div class="palette" data-palette>
				<button class="palette-btn" type="button" data-palette-toggle aria-label="切换配色" aria-expanded="false">
					<span class="palette-dot" aria-hidden="true"></span>
				</button>
				<div class="palette-panel" data-palette-panel hidden>
					<button class="palette-swatch" type="button" data-accent="orange" style="--sw:#d0845c" aria-label="暖橙" title="暖橙"></button>
					<button class="palette-swatch" type="button" data-accent="blue" style="--sw:#608cc8" aria-label="海蓝" title="海蓝"></button>
					<button class="palette-swatch" type="button" data-accent="teal" style="--sw:#52a694" aria-label="青绿" title="青绿"></button>
					<button class="palette-swatch" type="button" data-accent="violet" style="--sw:#9678c4" aria-label="藕紫" title="藕紫"></button>
					<button class="palette-swatch" type="button" data-accent="pink" style="--sw:#c66e8a" aria-label="玫粉" title="玫粉"></button>
				</div>
			</div>
			<MusicPlayer />
			<a class="head-cta" href={SOCIAL_LINKS.email}>
				<span>写信给我</span>
				<svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M3.4 8.6 8.6 3.4M4.3 3.4h4.3v4.3"></path>
				</svg>
			</a>
		</Fragment>
	</CardNav>
</header>

<script>
	function currentPath() {
		const p = location.pathname.replace(/\/+$/, '');
		return p === '' ? '/' : p;
	}

	function init() {
		const shell = document.querySelector<HTMLElement>('.site-head');
		if (!shell) return;

		// 卡片菜单里的导航链接（CardNav 内部已渲染 data-nav-item）
		const links = Array.from(document.querySelectorAll<HTMLElement>('[data-card-nav] [data-nav-item]'));

		// 当前页 active 高亮
		const path = currentPath();
		let active = links.find((a) => a.dataset.href === path);
		if (!active) {
			active =
				links
					.filter((a) => {
						const h = a.dataset.href || '';
						return h !== '/' && !/^(https?:|mailto:)/.test(h) && path.startsWith(h);
					})
					.sort((a, b) => (b.dataset.href || '').length - (a.dataset.href || '').length)[0];
		}
		links.forEach((a) => {
			const on = a === active;
			a.classList.toggle('is-active', on);
			if (on) a.setAttribute('aria-current', 'page');
			else a.removeAttribute('aria-current');
		});

		// 滚动收缩
		let raf = 0;
		const onScroll = () => {
			if (raf) return;
			raf = requestAnimationFrame(() => {
				raf = 0;
				shell.classList.toggle('is-scrolled', window.scrollY > 16);
				shell.classList.toggle('is-top', document.body.dataset.hero === '1' && window.scrollY < 24);
			});
		};
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		// 主题切换
		const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
		if (toggle && !toggle.dataset.wired) {
			toggle.dataset.wired = '1';
			const syncAria = () => {
				const cur = window.__getTheme?.() ?? document.documentElement.dataset.theme ?? 'dark';
				toggle.setAttribute('aria-pressed', String(cur === 'light'));
			};
			toggle.addEventListener('click', () => {
				const cur = window.__getTheme?.() ?? document.documentElement.dataset.theme ?? 'dark';
				const next = cur === 'dark' ? 'light' : 'dark';
				window.__setTheme?.(next);
				syncAria();
				const meta = document.querySelector('meta[name="theme-color"]');
				if (meta) meta.setAttribute('content', next === 'light' ? '#f6f3ee' : '#181512');
			});
			syncAria();
		}

		// 调色盘：切换强调色（fixed 定位，避免被卡片面板的 overflow:hidden 裁剪）
		const palette = document.querySelector<HTMLElement>('[data-palette]');
		if (palette && !palette.dataset.wired) {
			palette.dataset.wired = '1';
			const pToggle = palette.querySelector<HTMLButtonElement>('[data-palette-toggle]');
			const panel = palette.querySelector<HTMLElement>('[data-palette-panel]');
			const swatches = Array.from(palette.querySelectorAll<HTMLButtonElement>('.palette-swatch'));

			const syncActive = () => {
				const cur = window.__getAccent?.() ?? 'orange';
				swatches.forEach((s) => s.classList.toggle('is-active', s.dataset.accent === cur));
			};
			const close = () => {
				if (panel) panel.hidden = true;
				pToggle?.setAttribute('aria-expanded', 'false');
			};

			pToggle?.addEventListener('click', () => {
				const open = panel?.hidden ?? true;
				if (open && panel && pToggle) {
					const rect = pToggle.getBoundingClientRect();
					panel.style.top = `${rect.bottom + 12}px`;
					panel.style.right = `${Math.max(12, window.innerWidth - rect.right)}px`;
				}
				if (panel) panel.hidden = !open;
				pToggle.setAttribute('aria-expanded', String(!open));
			});
			swatches.forEach((s) => {
				s.addEventListener('click', () => {
					window.__setAccent?.(s.dataset.accent ?? 'orange');
					syncActive();
					close();
				});
			});
			document.addEventListener('click', (e) => {
				if (palette.contains(e.target as Node)) return;
				if (panel && !panel.hidden) close();
			});
			syncActive();
		}

		// 首页 scroll-spy：收到板块切换事件时，更新 active 高亮
		window.addEventListener('scroll-spy', ((e: CustomEvent) => {
			const href = e.detail?.href;
			if (!href) return;
			links.forEach((a) => {
				const on = a.dataset.href === href;
				a.classList.toggle('is-active', on);
				if (on) a.setAttribute('aria-current', 'page');
				else a.removeAttribute('aria-current');
			});
		}) as EventListener);

		// 首页上点导航：平滑滚到对应板块，而不是跳转页面
		const sectionByHref: Record<string, string> = {
			'/blog': 'articles',
			'/knowledge': 'knowledge',
			'/discover': 'discover',
			'/about': 'about',
		};
		for (const link of links) {
			link.addEventListener('click', (e) => {
				const onHome = currentPath() === '/';
				if (!onHome) return; // 非首页正常跳转
				const href = link.dataset.href || '/';
				const targetId = sectionByHref[href];
				if (!targetId) return;
				const sec = document.getElementById(targetId);
				if (!sec) return; // 首页没有对应板块就正常跳转
				e.preventDefault();
				sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
				history.replaceState(null, '', `/#${targetId}`);
			});
		}
	}

	document.addEventListener('astro:page-load', init);
	if (document.readyState !== 'loading') init();
</script>

<style>
	.site-head {
		position: sticky;
		top: 0;
		z-index: 120;
		padding: 0.75rem var(--gutter) 0;
		pointer-events: none;
	}
	.site-head :global(.card-nav) {
		pointer-events: auto;
	}

	/* 品牌（居中 logo） */
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		font-size: 1.05rem;
		color: rgb(var(--ink));
		line-height: 1;
	}
	.brand-dot {
		position: relative;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: rgb(var(--accent));
		box-shadow: 0 0 0 0 rgba(var(--accent), 0.45);
		animation: dot-pulse 3.6s var(--ease-out) infinite;
	}
	.brand-dot i {
		position: absolute;
		inset: -3px;
		border-radius: 50%;
		border: 1px solid rgba(var(--accent), 0.35);
	}
	.brand-name {
		white-space: nowrap;
	}
	@keyframes dot-pulse {
		0%,
		62%,
		100% {
			box-shadow: 0 0 0 0 rgba(var(--accent), 0.4);
		}
		30% {
			box-shadow: 0 0 0 7px rgba(var(--accent), 0);
		}
	}

	/* 首页：页头脱离文档流，Hero 从屏幕最顶端开始 */
	:global(body[data-hero='1']) .site-head {
		position: fixed;
		inset: 0 0 auto;
	}

	/* 滚动收缩：收紧页头内边距 */
	.site-head.is-scrolled {
		padding-top: 0.4rem;
	}
	.site-head {
		transition: padding-top var(--dur) var(--ease-out);
	}

	/* 右侧操作按钮 */
	.theme-toggle,
	.palette-btn {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: rgb(var(--muted));
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
	}
	.theme-toggle:hover,
	.palette-btn:hover {
		color: rgb(var(--accent));
		background: var(--chip-bg);
	}
	.theme-toggle__sun,
	.theme-toggle__moon {
		grid-area: 1 / 1;
		transition:
			opacity var(--dur-fast) var(--ease-out),
			transform var(--dur) var(--ease-spring);
	}
	.theme-toggle .theme-toggle__moon {
		opacity: 1;
		transform: none;
	}
	.theme-toggle .theme-toggle__sun {
		opacity: 0;
		transform: scale(0.4) rotate(-90deg);
	}
	:global(html[data-theme='light']) .theme-toggle .theme-toggle__sun {
		opacity: 1;
		transform: none;
	}
	:global(html[data-theme='light']) .theme-toggle .theme-toggle__moon {
		opacity: 0;
		transform: scale(0.4) rotate(90deg);
	}

	/* 调色盘 */
	.palette {
		position: relative;
		display: flex;
		align-items: center;
	}
	.palette-dot {
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: rgb(var(--accent));
		box-shadow: 0 0 0 2px rgba(var(--accent), 0.18), 0 2px 6px -1px rgba(var(--accent), 0.55);
		transition: background-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
	}
	.palette-panel {
		position: fixed;
		display: flex;
		gap: 0.45rem;
		padding: 0.6rem 0.7rem;
		border-radius: var(--r-pill);
		background: var(--glass-bg-strong);
		border: 1px solid var(--glass-brd);
		-webkit-backdrop-filter: blur(18px) saturate(1.3);
		backdrop-filter: blur(18px) saturate(1.3);
		box-shadow: var(--glass-shine), var(--shadow-lg);
		opacity: 0;
		transform: translate3d(0, -6px, 0) scale(0.96);
		transform-origin: top right;
		transition:
			opacity 0.2s var(--ease-out),
			transform 0.28s var(--ease-spring);
		z-index: 50;
	}
	.palette-panel:not([hidden]) {
		opacity: 1;
		transform: none;
	}
	.palette-panel[hidden] {
		display: none;
	}
	.palette-swatch {
		position: relative;
		width: 22px;
		height: 22px;
		padding: 0;
		border: 2px solid transparent;
		border-radius: 50%;
		background: var(--sw);
		cursor: pointer;
		transition:
			transform var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}
	.palette-swatch:hover {
		transform: scale(1.18);
	}
	.palette-swatch.is-active {
		border-color: rgb(var(--ink));
	}

	/* 页头条几何：参考 studio 版式——更宽、更扁、更小的圆角、发丝描边 */
	.site-head {
		padding-top: 1.05rem;
	}
	.site-head :global(.card-nav) {
		--cn-bar: 56px;
		--cn-radius: 12px;
		--cn-inset: 6px;
		font-size: 13px;
	}
	.site-head :global(.card-nav__panel) {
		-webkit-backdrop-filter: blur(18px) saturate(1.25);
		backdrop-filter: blur(18px) saturate(1.25);
		box-shadow:
			inset 0 0 0 1px var(--glass-brd),
			0 18px 40px -28px rgba(0, 0, 0, 0.9);
	}

	/* 右侧主按钮：反色实心，和参考站右上角的 CTA 对应 */
	.head-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		height: 34px;
		margin-left: 0.3rem;
		padding: 0 0.9rem;
		border-radius: 7px;
		background: rgb(var(--ink));
		color: rgb(var(--bg));
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		transition:
			opacity 0.25s var(--ease-out),
			transform 0.25s var(--ease-out);
	}
	.head-cta:hover {
		transform: translateY(-1px);
		opacity: 0.88;
	}
	@media (max-width: 720px) {
		.head-cta {
			display: none;
		}
	}

	@media (max-width: 620px) {
		.site-head {
			padding: 0.5rem 0.6rem 0;
		}
		.brand-name {
			font-size: 0.95rem;
		}
	}
</style>
