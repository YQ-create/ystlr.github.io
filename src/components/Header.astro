---
// 顶部主导航：logo + 首页/文章/知识库/发现/关于 + 独立搜索 + 工具菜单。
// 桌面端导航直接显示；移动端导航收进底部 DockNav（文字标签）。
// 外观/音乐/管理后台/写信收进「工具」二级菜单；搜索独立成图标。
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import MusicPlayer from './MusicPlayer.astro';
import AppearancePanel from './AppearancePanel.astro';
import ElectricLogo from './ElectricLogo.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const NAV = [
	{ href: '/', label: '首页' },
	{ href: '/blog', label: '文章' },
	{ href: '/knowledge', label: '知识库' },
	{ href: '/discover', label: '发现' },
	{ href: '/about', label: '关于' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

const emailHref = SOCIAL_LINKS.email ?? 'mailto:hello@ystlr.com';
---

<header class="site-head" transition:persist="site-head" transition:name="site-header">
	<div class="head-shell">
		<a class="head-brand" href="/" aria-label={`${SITE_TITLE} 首页`}>
			<ElectricLogo size={22} class="head-brand__bolt" />
			<span class="head-brand__mark">ystlr</span>
		</a>

		<nav class="head-nav" aria-label="主导航">
			{NAV.map((item) => (
				<a class:list={['head-nav__link', { 'is-active': isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))}
		</nav>

		<div class="head-actions">
			<button class="head-search" type="button" data-search-open aria-label="站内搜索" title="站内搜索">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm4-1.5 3 3"></path>
				</svg>
			</button>
			<button class="head-tools" type="button" data-tools-toggle aria-expanded="false" aria-controls="tools-panel" aria-label="工具" title="工具">
				<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M10 13.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z"></path>
					<path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M15.7 8.6 14.1 7.5l.1-1.1-1.2-1.9-1 .4-1-.4-1.2 1.9.1 1.1L8.2 8.6l-1.5 1.1-.1 1.1 1.2 1.9 1-.4 1 .4 1.2-1.9-.1-1.1 1.6-1.1.1-1.1-1.2-1.9-1 .4-1-.4-1.2 1.9.1 1.1-1.6 1.1Z"></path>
				</svg>
			</button>
		</div>
	</div>

	<!-- 工具组件：按钮在顶部栏隐藏，面板（fixed 右上角）保留，由工具菜单触发 -->
	<div class="head-hidden" aria-hidden="true">
		<AppearancePanel />
		<MusicPlayer />
	</div>

	<!-- 工具二级菜单 -->
	<div class="tools-panel" id="tools-panel" data-tools-panel hidden>
		<ul class="tools-list">
			<li>
				<button class="tools-row" type="button" data-tools-action="appearance">
					<span class="tools-row__icon" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="15" height="15"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M8 2.5a5.5 5.5 0 1 0 0 11c.7 0 1.1-.5 1.1-1.05 0-.28-.1-.52-.28-.72-.18-.2-.28-.44-.28-.7 0-.6.5-1.05 1.1-1.05h1A2.58 2.58 0 0 0 13.2 7.4C13.2 4.7 10.9 2.5 8 2.5Z"></path><circle cx="5.5" cy="7.3" r=".75" fill="currentColor"></circle><circle cx="7" cy="5.2" r=".75" fill="currentColor"></circle><circle cx="9.4" cy="5.3" r=".75" fill="currentColor"></circle><circle cx="10.9" cy="7.4" r=".75" fill="currentColor"></circle></svg>
					</span>
					<span class="tools-row__text"><strong>外观调色板</strong><em>主题 · 颜色 · 底图</em></span>
				</button>
			</li>
			<li>
				<button class="tools-row" type="button" data-tools-action="music">
					<span class="tools-row__icon" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="15" height="15"><path fill="currentColor" d="M13.5 1.6a.6.6 0 0 1 .7.6v8.1a2.4 2.4 0 1 1-1.2-2.1V4.3L6.5 5.7v6a2.4 2.4 0 1 1-1.2-2.1V3.4a.6.6 0 0 1 .47-.58l7.73-1.22Z"></path></svg>
					</span>
					<span class="tools-row__text"><strong>音乐播放器</strong><em>播放 · 曲目列表</em></span>
				</button>
			</li>
			<li>
				<a class="tools-row" href="/admin">
					<span class="tools-row__icon" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="15" height="15"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M4.5 2.5h7a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Zm2 1.5v2h3V4M5 8h6M5 10.5h6"></path></svg>
					</span>
					<span class="tools-row__text"><strong>管理后台</strong><em>发布 · 编辑 · 上传</em></span>
				</a>
			</li>
			<li>
				<a class="tools-row" href={emailHref}>
					<span class="tools-row__icon" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="15" height="15"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M2.5 3.5h11a.6.6 0 0 1 .6.6v7.8a.6.6 0 0 1-.6.6h-11a.6.6 0 0 1-.6-.6V4.1a.6.6 0 0 1 .6-.6Zm.6 1 4.6 3.6a.5.5 0 0 0 .6 0L12.9 4.5"></path></svg>
					</span>
					<span class="tools-row__text"><strong>写信给我</strong><em>邮件联系</em></span>
				</a>
			</li>
		</ul>
	</div>
</header>

<script>
	// 滚动收缩：滚过 16px 后收紧页头内边距。
	let scrollBound = false;
	let scrollRaf = 0;
	function onScroll() {
		if (scrollRaf) return;
		scrollRaf = requestAnimationFrame(() => {
			scrollRaf = 0;
			const shell = document.querySelector<HTMLElement>('.site-head');
			if (!shell) return;
			shell.classList.toggle('is-scrolled', window.scrollY > 16);
		});
	}
	if (!scrollBound) {
		scrollBound = true;
		window.addEventListener('scroll', onScroll, { passive: true });
	}
	onScroll();
	document.addEventListener('astro:page-load', onScroll);

	// 搜索快捷键提示：按平台显示 ⌘K 或 Ctrl+K
	function syncSearchHint() {
		const btn = document.querySelector<HTMLButtonElement>('[data-search-open]');
		if (!btn) return;
		const mac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
		btn.title = mac ? '站内搜索 ⌘K' : '站内搜索 Ctrl+K';
	}
	syncSearchHint();
	document.addEventListener('astro:page-load', syncSearchHint);

	// ---- 工具二级菜单 ----
	function initTools() {
		const toggle = document.querySelector<HTMLButtonElement>('[data-tools-toggle]');
		const panel = document.querySelector<HTMLElement>('[data-tools-panel]');
		if (!toggle || !panel) return;

		const close = () => {
			toggle.classList.remove('is-open');
			toggle.setAttribute('aria-expanded', 'false');
			panel.classList.remove('is-open');
			panel.hidden = true;
		};
		const open = () => {
			toggle.classList.add('is-open');
			toggle.setAttribute('aria-expanded', 'true');
			panel.hidden = false;
			requestAnimationFrame(() => panel.classList.add('is-open'));
		};

		toggle.addEventListener('click', (e) => {
			e.stopPropagation();
			if (panel.classList.contains('is-open')) close();
			else open();
		});
		panel.addEventListener('pointerdown', (e) => e.stopPropagation());
		panel.addEventListener('click', (e) => e.stopPropagation());
		panel.querySelectorAll<HTMLElement>('[data-tools-action]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const action = btn.dataset.toolsAction;
				if (action === 'appearance') document.querySelector<HTMLButtonElement>('[data-ap-toggle]')?.click();
				else if (action === 'music') document.querySelector<HTMLButtonElement>('[data-music-toggle]')?.click();
				close();
			});
		});
		panel.querySelectorAll<HTMLElement>('a.tools-row').forEach((el) => {
			el.addEventListener('click', () => close());
		});
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && panel.classList.contains('is-open')) close();
		});
		document.addEventListener('pointerdown', (e) => {
			const t = e.target as HTMLElement;
			if (!panel.hidden && !panel.contains(t) && !toggle.contains(t)) close();
		});
		document.addEventListener('astro:page-load', close);
	}
	initTools();
</script>

<style>
	.site-head {
		position: sticky;
		top: 0;
		z-index: 120;
		padding: 1.05rem var(--gutter) 0;
		transition: padding-top var(--dur) var(--ease-out);
	}
	.site-head.is-scrolled {
		padding-top: 0.4rem;
	}

	.head-shell {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 3vw, 2.4rem);
		width: 100%;
		max-width: var(--w-wide, 1272px);
		margin: 0 auto;
	}

	.head-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 7px 14px 7px 10px;
		border-radius: 999px;
		color: rgb(var(--ink));
		text-decoration: none;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04));
		backdrop-filter: blur(14px) saturate(1.4);
		-webkit-backdrop-filter: blur(14px) saturate(1.4);
		border: 1px solid rgba(255, 255, 255, 0.16);
		box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.3);
		flex: none;
	}
	.head-brand__mark {
		font-family: var(--font-sans), system-ui, sans-serif;
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	/* 主导航 */
	.head-nav {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex: 1;
		min-width: 0;
	}
	.head-nav__link {
		position: relative;
		padding: 0.5rem 0.9rem;
		border-radius: 999px;
		font-family: var(--font-sans), system-ui, sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
		color: rgb(var(--muted));
		text-decoration: none;
		white-space: nowrap;
		transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
	}
	.head-nav__link::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: 0.14rem;
		width: 0;
		height: 2px;
		border-radius: 2px;
		background: rgb(var(--accent));
		transform: translateX(-50%);
		transition: width 0.25s var(--ease-out);
	}
	.head-nav__link:hover {
		color: rgb(var(--ink));
		background: var(--chip-bg);
	}
	.head-nav__link:hover::after {
		width: 16px;
	}
	.head-nav__link.is-active {
		color: rgb(var(--accent));
		font-weight: 600;
	}
	.head-nav__link.is-active::after {
		width: 18px;
	}

	.head-actions {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex: none;
	}
	.head-search,
	.head-tools {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		padding: 0;
		border-radius: 50%;
		border: 1px solid rgba(var(--line), 1);
		background: var(--chip-bg);
		color: rgb(var(--muted));
		cursor: pointer;
		transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
	}
	.head-search:hover,
	.head-tools:hover {
		color: rgb(var(--accent));
		border-color: rgba(var(--accent), 0.5);
		transform: translateY(-1px);
	}
	.head-tools.is-open {
		color: rgb(var(--accent));
		border-color: rgba(var(--accent), 0.6);
	}
	.head-tools.is-open svg {
		transform: rotate(40deg);
	}
	.head-tools svg {
		transition: transform 0.4s var(--ease-spring);
	}

	/* 隐藏工具组件的按钮容器 */
	.head-hidden {
		position: absolute;
		left: 0;
		top: 0;
		width: 0;
		height: 0;
	}
	.head-hidden :global(.ap),
	.head-hidden :global(.music) {
		position: absolute;
		left: -9999px;
		top: 0;
	}

	/* 工具二级菜单 */
	.tools-panel {
		position: fixed;
		top: calc(var(--head-h, 64px) + 10px);
		right: var(--gutter);
		z-index: 200;
		width: min(280px, calc(100vw - 2rem));
		padding: 0.55rem;
		border-radius: var(--r-lg);
		background: linear-gradient(160deg, rgba(44, 44, 52, 0.94), rgba(26, 26, 30, 0.92));
		backdrop-filter: blur(30px) saturate(1.5);
		-webkit-backdrop-filter: blur(30px) saturate(1.5);
		border: 1px solid rgba(255, 255, 255, 0.16);
		box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.3), 0 24px 60px -20px rgba(0, 0, 0, 0.6);
		opacity: 0;
		transform: translateY(-8px) scale(0.98);
		transform-origin: top right;
		transition: opacity 0.22s var(--ease-out), transform 0.3s var(--ease-spring);
	}
	.tools-panel.is-open {
		opacity: 1;
		transform: none;
	}
	.tools-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tools-row {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		width: 100%;
		padding: 0.6rem 0.5rem;
		border: 0;
		border-radius: 10px;
		background: none;
		color: rgb(var(--ink));
		font: inherit;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
		transition: background 0.2s var(--ease-out);
	}
	.tools-row:hover {
		background: rgba(255, 255, 255, 0.08);
	}
	.tools-row__icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: rgba(var(--accent), 0.14);
		color: rgb(var(--accent));
	}
	.tools-row__text {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.tools-row__text strong {
		font-family: var(--font-sans), system-ui, sans-serif;
		font-size: 0.84rem;
		font-weight: 600;
		line-height: 1.2;
	}
	.tools-row__text em {
		font-style: normal;
		font-size: 0.68rem;
		color: rgb(var(--muted));
	}

	/* 浅色主题 */
	:global(:root[data-theme='light']) .head-brand {
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.42));
		border-color: rgba(90, 76, 60, 0.14);
		box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.95);
	}
	:global(:root[data-theme='light']) .tools-panel {
		background: linear-gradient(160deg, rgba(255, 255, 255, 0.96), rgba(250, 248, 244, 0.92));
		border-color: rgba(90, 76, 60, 0.14);
	}
	:global(:root[data-theme='light']) .tools-row:hover {
		background: rgba(90, 76, 60, 0.06);
	}

	/* 移动端：导航收进底部 DockNav，顶部只留 logo + 搜索 + 工具 */
	@media (max-width: 860px) {
		.head-nav {
			display: none;
		}
		.head-shell {
			justify-content: space-between;
		}
	}

	@media (max-width: 620px) {
		.site-head {
			padding: 0.5rem 0.6rem 0;
		}
		.head-brand__mark {
			font-size: 0.88rem;
		}
		.head-search,
		.head-tools {
			width: 40px;
			height: 40px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tools-panel {
			transition-duration: 0.01ms;
		}
	}
</style>
