---
// 首页 Hero 动态背景：GradientASCII（WebGL2 字符渐变光场）。
// 仅在首页引入；容器铺满 Hero 底层，文字内容叠在其上方。
---

<div class="hero-gradient" data-hero-bg aria-hidden="true"></div>

<script>
	import { GradientASCII } from '../scripts/gradient-ascii';

	function mount() {
		const host = document.querySelector<HTMLElement>('[data-hero-bg]');
		if (!host || host.dataset.ready === 'true') return;
		host.dataset.ready = 'true';

		new GradientASCII(host, {
			// 贴合站点暗色荧光绿主题：从深背景 → 墨绿 → 荧光绿 → 浅高光
			colors: ['#0d0f0e', '#1c3a20', '#86dc45', '#e8ffcc'],
			shape: 'rise',
			characters: ' =+xX0S8#@',
			cellSize: 18,
			density: 0.8,
			glyphOpacity: 0.85,
			glow: 0.25,
			softness: 0.6,
			scale: 1,
			flow: 0.5,
			speed: 0.8,
			gradientOpacity: 0.85,
			grain: 0.08,
			mouseInteraction: true,
			scrambleRadius: 0.1,
			clickEffect: 'wave',
			intro: true,
		});
	}

	document.addEventListener('astro:page-load', mount);
	if (document.readyState !== 'loading') mount();
</script>

<style>
	.hero-gradient {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
	}

	/* canvas 由脚本动态插入，需要用 :global 定位到它 */
	.hero-gradient :global(canvas) {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
