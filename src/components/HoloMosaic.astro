---
/**
 * HoloMosaic — 全息马赛克背景（WebGL2 着色器，无依赖）。
 *
 * 移植自 React 组件：一屏由「瓷砖」拼成的马赛克，每片瓷砖带彩虹光谱反射、
 * 金属倒角、闪烁与光泽。光源会随鼠标游走，点击产生扩散波纹。仅供视觉，
 * 不接收语义指针；滚出视口停帧，reduced-motion 下静止。
 */
interface Props {
	color?: string;
	metalColor?: string;
	spectrum?: 'full' | 'warm' | 'cool' | 'pearl';
	tileSize?: number;
	gap?: number;
	roundness?: number;
	bevel?: number;
	rotation?: number;
	scatter?: number;
	tilt?: number;
	swirl?: number;
	ripple?: number;
	bands?: number;
	softness?: number;
	intensity?: number;
	saturation?: number;
	glitter?: number;
	sheen?: number;
	grain?: number;
	speed?: number;
	variation?: number;
	filter?: 'none' | 'dither' | 'ascii';
	filterSize?: number;
	fade?: number;
	opacity?: number;
	intro?: boolean;
	mouseInteraction?: boolean;
	mouseStrength?: number;
	mouseRadius?: number;
	flipOnClick?: boolean;
	lightMode?: boolean;
	paused?: boolean;
	class?: string;
}

const {
	color = '#120f17',
	metalColor = '#e8ebf1',
	spectrum = 'full',
	tileSize = 1,
	gap = 0.08,
	roundness = 0.15,
	bevel = 0.35,
	rotation = 0,
	scatter = 0.3,
	tilt = 0.35,
	swirl = 1,
	ripple = 0.6,
	bands = 1.3,
	softness = 0.5,
	intensity = 1.25,
	saturation = 0.1,
	glitter = 0.85,
	sheen = 0.8,
	grain = 0.08,
	speed = 0.5,
	variation = 0,
	filter = 'none',
	filterSize = 1,
	fade = 0,
	opacity = 1,
	intro = true,
	mouseInteraction = true,
	mouseStrength = 1,
	mouseRadius = 0.25,
	flipOnClick = true,
	lightMode = false,
	paused = false,
	class: className = '',
} = Astro.props;
---

<div
	class:list={['holo-mosaic', className]}
	data-holo
	data-color={color}
	data-metal={metalColor}
	data-spectrum={spectrum}
	data-tile={tileSize}
	data-gap={gap}
	data-round={roundness}
	data-bevel={bevel}
	data-rotation={rotation}
	data-scatter={scatter}
	data-tilt={tilt}
	data-swirl={swirl}
	data-ripple={ripple}
	data-bands={bands}
	data-soft={softness}
	data-intensity={intensity}
	data-saturation={saturation}
	data-glitter={glitter}
	data-sheen={sheen}
	data-grain={grain}
	data-speed={speed}
	data-variation={variation}
	data-filter={filter}
	data-filtersize={filterSize}
	data-fade={fade}
	data-opacity={opacity}
	data-intro={intro ? '1' : '0'}
	data-mouse={mouseInteraction ? '1' : '0'}
	data-mousestrength={mouseStrength}
	data-mouseradius={mouseRadius}
	data-flip={flipOnClick ? '1' : '0'}
	data-lightmode={lightMode ? '1' : '0'}
	data-paused={paused ? '1' : '0'}
>
	<canvas data-holo-canvas aria-hidden="true"></canvas>
</div>

<style>
	.holo-mosaic {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}
	.holo-mosaic canvas {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	// @ts-nocheck
	// HoloMosaic 运行时：WebGL2 全屏着色器（无依赖）。见组件头注释。
	const MAX_WAVES = 6;
	const MAX_RENDER_DIM = 2400;
	const TILE_PX = 52;
	const EYE = 1.15;
	const INTRO_SECONDS = 2.4;
	const WAVE_SECONDS = 4;
	const FILTERS = { none: 0, dither: 1, ascii: 2 };
	const SPECTRUMS = {
		full: [400, 700, 0],
		warm: [565, 700, 0],
		cool: [405, 565, 0],
		pearl: [420, 690, 0.55],
	};

	const VERTEX = `#version 300 es
void main() {
  vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}`;

	const FRAGMENT = `#version 300 es
precision highp float;
uniform vec2 uRes;
uniform float uPixel;
uniform float uTime;
uniform float uClock;
uniform float uTile;
uniform vec2 uRot;
uniform float uGap;
uniform float uRound;
uniform float uBevel;
uniform float uScatter;
uniform float uTilt;
uniform float uSwirl;
uniform float uRipple;
uniform float uBands;
uniform float uSoft;
uniform float uIntensity;
uniform float uSaturation;
uniform vec3 uSpectrum;
uniform float uGlitter;
uniform float uSheen;
uniform float uGrain;
uniform vec3 uColor;
uniform vec3 uMetal;
uniform vec2 uLight;
uniform vec4 uHover;
uniform vec4 uWaves[6];
uniform vec4 uIntro;
uniform float uFade;
uniform float uOpacity;
uniform float uLightMode;
uniform float uSeed;
uniform float uFrame;
uniform float uFilter;
uniform float uFilterSize;
out vec4 outColor;

float h21(vec2 p) {
  vec3 q = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
  q += dot(q, q.yzx + 33.33);
  return fract((q.x + q.y) * q.z);
}

float h31(vec3 p) {
  p = fract(p * vec3(0.1031, 0.1030, 0.0973));
  p += dot(p, p.yxz + 33.33);
  return fract((p.x + p.y) * p.z);
}

float vn3(vec3 p) {
  vec3 i = floor(p);
  vec3 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(
    mix(mix(h31(i), h31(i + vec3(1, 0, 0)), f.x), mix(h31(i + vec3(0, 1, 0)), h31(i + vec3(1, 1, 0)), f.x), f.y),
    mix(mix(h31(i + vec3(0, 0, 1)), h31(i + vec3(1, 0, 1)), f.x), mix(h31(i + vec3(0, 1, 1)), h31(i + vec3(1, 1, 1)), f.x), f.y),
    f.z
  );
}

vec3 bump3y(vec3 x, vec3 yo) {
  return clamp(1.0 - x * x - yo, 0.0, 1.0);
}

vec3 spectral(float w) {
  float x = clamp((w - 400.0) / 300.0, 0.0, 1.0);
  vec3 c1 = vec3(3.54585104, 2.93225262, 2.41593945);
  vec3 x1 = vec3(0.69549072, 0.49228336, 0.27699880);
  vec3 y1 = vec3(0.02312639, 0.15225084, 0.52607955);
  vec3 c2 = vec3(3.90307140, 3.21182957, 3.96587128);
  vec3 x2 = vec3(0.11748627, 0.86755042, 0.66077860);
  vec3 y2 = vec3(0.84897130, 0.88445281, 0.73949448);
  return bump3y(c1 * (x - x1), y1) + bump3y(c2 * (x - x2), y2);
}

vec3 band(float lam) {
  float window = smoothstep(380.0, 425.0, lam) * (1.0 - smoothstep(680.0, 780.0, lam));
  if (window <= 0.0) return vec3(0.0);
  return spectral(mix(uSpectrum.x, uSpectrum.y, clamp((lam - 380.0) / 400.0, 0.0, 1.0))) * window;
}

float boxDist(vec2 p, float b, float r, out vec2 grad) {
  vec2 q = abs(p) - b + r;
  vec2 m = max(q, 0.0);
  float outside = length(m);
  vec2 sg = vec2(p.x < 0.0 ? -1.0 : 1.0, p.y < 0.0 ? -1.0 : 1.0);
  grad = outside > 0.0 ? sg * m / outside : sg * (q.x > q.y ? vec2(1.0, 0.0) : vec2(0.0, 1.0));
  return outside + min(max(q.x, q.y), 0.0) - r;
}

vec4 shade(vec2 frag, float solid) {
  vec2 c = frag - 0.5 * uRes;
  vec2 s = c / uRes.y;
  vec2 g = vec2(uRot.x * c.x + uRot.y * c.y, uRot.x * c.y - uRot.y * c.x) / uTile;
  vec2 id = floor(g);
  vec2 f = g - id - 0.5;
  vec2 gc = (id + 0.5) * uTile;
  vec2 cell = vec2(uRot.x * gc.x - uRot.y * gc.y, uRot.y * gc.x + uRot.x * gc.y) / uRes.y;
  vec2 seed = vec2(uSeed * 17.13, uSeed * 31.71);
  float h1 = h21(id + seed);
  float h2 = h21(id + seed + 19.7);
  float h3 = h21(id + seed + 41.3);

  float flip = 0.0;
  float presence = 1.0;
  if (uIntro.w > 0.0) {
    float k = clamp((uIntro.z - length(cell - uIntro.xy) * 0.85 - h1 * 0.22) / 0.75, 0.0, 1.0);
    float e = k * k * k * (k * (k * 6.0 - 15.0) + 10.0);
    flip = (1.0 - e) * 1.5707963;
    presence = e;
  }
  for (int i = 0; i < 6; i++) {
    vec4 w = uWaves[i];
    if (w.w <= 0.0) continue;
    float k = clamp(((uClock - w.z) * 0.95 - length(cell - w.xy)) / 0.2, 0.0, 1.0);
    flip += k * k * (3.0 - 2.0 * k) * 3.1415927;
  }

  float ca = cos(flip);
  float sa = sin(flip);
  float squash = max(abs(ca), 0.02);
  float half_ = 0.5 - 0.5 * uGap;
  vec2 grad;
  float d = boxDist(vec2(f.x / squash, f.y), half_, uRound * half_, grad);
  float aa = 1.2 / uTile;
  float aaD = mix(aa, aa / squash, abs(grad.x));
  float cover = mix((1.0 - smoothstep(-aaD, aaD, d)) * smoothstep(0.02, 0.08, abs(ca)), 1.0, solid);
  float alpha = cover * uOpacity;
  if (uFade > 0.0) {
    vec2 uv = frag / uRes;
    vec2 m = clamp(min(uv, 1.0 - uv) / max(uFade * 0.5, 1e-4), 0.0, 1.0);
    m = m * m * m * (m * (m * 6.0 - 15.0) + 10.0);
    alpha *= m.x * m.y;
  }
  if (alpha <= 0.002) return vec4(0.0);

  float edge = smoothstep(-0.02 - 0.07 * uBevel, 0.0, d) * uBevel;
  float inner = smoothstep(0.0, -0.09, d);
  vec3 n = normalize(vec3((vec2(h2, h3) - 0.5) * (0.5 * uTilt) + grad * edge * 0.55, 1.0));
  n = vec3(n.x * ca + n.z * sa, n.y, abs(n.z * ca - n.x * sa));
  vec3 N = vec3(uRot.x * n.x - uRot.y * n.y, uRot.y * n.x + uRot.x * n.y, n.z);
  vec2 hv = cell - uHover.xy;
  float hw = exp(-dot(hv, hv) / (uHover.z * uHover.z)) * uHover.w;
  N = normalize(N + vec3(-hv / uHover.z * hw * 1.3, 0.0));
  float turn = abs(sin(flip));

  float t = uTime;
  float flow = vn3(vec3(s * (1.4 * uSwirl) + seed * 0.013, t * 0.05));
  vec2 rc = vec2(0.15 + 0.22 * sin(t * 0.07), -0.05 + 0.16 * cos(t * 0.053));
  float rip = sin(length(s - rc) * 26.0 - t * 1.2) * 0.5 + 0.5;
  float phi = 6.2831853 * mix(flow, h1, uScatter) + uRipple * 0.9 * rip;
  vec3 T = vec3(cos(phi), sin(phi), 0.0);
  T = normalize(T - dot(T, N) * N);
  vec3 V = normalize(vec3(-s, 1.15));
  vec3 L = normalize(vec3(uLight, 1.0));
  float D = 1450.0 * uBands;
  vec3 sh = vec3(0.0);
  for (int k = 0; k < 3; k++) {
    float a = float(k) * 2.39996 + 0.7;
    vec3 Lk = normalize(vec3(uLight + vec2(cos(a), sin(a)) * sqrt((float(k) + 0.5) / 3.0) * uSoft, 1.0));
    float x = abs(dot(Lk + V, T)) * D;
    sh += band(x) + 0.6 * band(x * 0.5);
  }
  sh *= presence * (0.62 + 0.38 * inner) / 3.0;
  float lum = dot(sh, vec3(0.2126, 0.7152, 0.0722));
  sh = mix(vec3(lum), sh, uSaturation);
  sh = mix(sh, vec3(lum * 1.15 + 0.08 * presence), uSpectrum.z * 0.6);

  vec3 H = normalize(L + V);
  float ndh = max(dot(N, H), 0.0);
  float wide = pow(ndh, 34.0);
  float tight = pow(ndh, 700.0);
  vec2 spot = uLight * 1.15;
  float pool = pow(max(1.0 - length(s - spot) * 2.1, 0.0), 2.5) * uSheen;

  float spark = 0.0;
  vec3 sparkColor = vec3(1.0);
  if (uGlitter > 0.0) {
    vec2 gq = frag / (uPixel * 6.0);
    vec2 gid = floor(gq) + seed;
    float gh = h21(gid + 3.7);
    if (gh < 0.05 + 0.25 * uGlitter) {
      vec2 off = vec2(h21(gid + 1.3), h21(gid + 5.9)) - 0.5;
      float r = length(fract(gq) - 0.5 - off * 0.45);
      vec3 gn = normalize(vec3((vec2(h21(gid + 9.1), h21(gid + 2.2)) - 0.5) * 0.7 + N.xy, 1.0));
      float twinkle = 0.55 + 0.45 * sin(t * (2.0 + 5.0 * gh) + gh * 70.0);
      spark = smoothstep(0.991, 0.9995, dot(gn, H)) * (1.0 - smoothstep(0.07, 0.24, r)) * twinkle * presence * uGlitter;
      sparkColor = spectral(420.0 + 260.0 * h21(gid + 7.7));
    }
  }

  float grainNoise = h31(vec3(floor(frag / uPixel), uFrame)) - 0.5;
  vec3 col;
  if (uLightMode > 0.5) {
    float ink = max(max(sh.r, sh.g), sh.b) * uIntensity;
    float top = max(max(sh.r, sh.g), sh.b);
    vec3 hue = sh / max(top, 1e-3);
    float chroma = (top - min(min(sh.r, sh.g), sh.b)) / max(top, 1e-3);
    hue = clamp(mix(vec3(dot(hue, vec3(0.2126, 0.7152, 0.0722))), hue, 1.35) * 0.92, 0.0, 1.0);
    hue = mix(uMetal * 0.85, hue, smoothstep(0.08, 0.45, chroma));
    float density = 0.86 * smoothstep(0.0, 0.85, ink);
    vec3 paper = uColor * (1.0 - 0.035 * (1.0 - wide) - 0.05 * edge) + uMetal * (0.08 * tight);
    col = mix(paper, hue * mix(vec3(1.0), uColor, 0.15), density);
    col = mix(col, sparkColor * 0.9, min(spark * 1.4, 0.9));
    col -= abs(grainNoise) * uGrain * 0.35 * clamp(density * 1.6 + spark, 0.0, 1.0);
    col = mix(col, uColor, 0.12 * (1.0 - wide) * (1.0 - density) * pool);
  } else {
    vec3 base = uColor + vec3(0.018, 0.018, 0.024);
    col = base + uMetal * (0.025 + 0.07 * wide + 1.1 * tight + 0.2 * pool + 0.55 * turn * turn) * (0.75 + 0.25 * inner);
    col += sh * (1.65 * uIntensity);
    col += mix(sparkColor, vec3(1.0), 0.45) * spark * 2.4;
    col = col * (1.0 + col / 5.0) / (1.0 + col * 0.55);
    col += grainNoise * uGrain * 0.24;
  }
  col = clamp(col, 0.0, 1.0);
  return vec4(col * alpha, alpha);
}

float bayer(vec2 p) {
  int i = int(mod(p.x, 4.0)) + int(mod(p.y, 4.0)) * 4;
  int m[16] = int[16](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);
  return (float(m[i]) + 0.5) / 16.0;
}

float glyph(float level, vec2 uv) {
  int codes[8] = int[8](0, 4194304, 131200, 14336, 459200, 145536, 703136, 11512810);
  vec2 g = floor(uv * 7.0) - 1.0;
  if (g.x < 0.0 || g.y < 0.0 || g.x > 4.0 || g.y > 4.0) return 0.0;
  int code = codes[int(clamp(level * 8.0, 0.0, 7.0))];
  return float((code >> (int(g.x) + 5 * int(4.0 - g.y))) & 1);
}

void main() {
  vec2 frag = gl_FragCoord.xy;
  if (uFilter > 1.5) {
    float size = max(4.0, floor(uPixel * 10.0 * uFilterSize + 0.5));
    vec2 cellId = floor(frag / size);
    vec4 sampled = shade((cellId + 0.5) * size, 1.0);
    if (sampled.a <= 0.002) {
      outColor = vec4(0.0);
      return;
    }
    vec3 col = sampled.rgb / sampled.a;
    float ink = pow(clamp(length(col - uColor) * 1.25, 0.0, 1.0), 0.85);
    float on = glyph(ink, (frag - cellId * size) / size);
    float top = max(max(col.r, col.g), col.b);
    vec3 tone = uLightMode > 0.5 ? col * 0.82 : mix(col, col / max(top, 0.25), 0.4);
    float alpha = on * sampled.a;
    outColor = vec4(clamp(tone, 0.0, 1.0) * alpha, alpha);
  } else if (uFilter > 0.5) {
    float size = max(1.0, floor(uPixel * 2.0 * uFilterSize + 0.5));
    vec2 cellId = floor(frag / size);
    vec4 sampled = shade((cellId + 0.5) * size, 0.0);
    float threshold = bayer(cellId);
    float alpha = sampled.a >= 0.999 ? 1.0 : step(threshold, sampled.a);
    if (alpha <= 0.0) {
      outColor = vec4(0.0);
      return;
    }
    vec3 col = sampled.rgb / max(sampled.a, 1e-3);
    vec3 levels = clamp(uColor + floor((col - uColor) * 4.0 + threshold) / 4.0, 0.0, 1.0);
    outColor = vec4(levels * alpha, alpha);
  } else {
    outColor = shade(frag, 0.0);
  }
}`;

	const UNIFORMS = [
		'uRes', 'uPixel', 'uTime', 'uClock', 'uTile', 'uRot', 'uGap', 'uRound', 'uBevel', 'uScatter', 'uTilt', 'uSwirl',
		'uRipple', 'uBands', 'uSoft', 'uIntensity', 'uSaturation', 'uSpectrum', 'uGlitter', 'uSheen', 'uGrain', 'uColor',
		'uMetal', 'uLight', 'uHover', 'uWaves', 'uIntro', 'uFade', 'uOpacity', 'uLightMode', 'uSeed', 'uFrame', 'uFilter', 'uFilterSize',
	];

	const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
	const num = (value, fallback) => { const parsed = Number(value); return Number.isFinite(parsed) ? parsed : fallback; };

	function compileShader(gl, type, source) {
		const shader = gl.createShader(type);
		if (!shader) return null;
		gl.shaderSource(shader, source);
		gl.compileShader(shader);
		return shader;
	}

	function setup(host) {
		const canvas = host.querySelector('[data-holo-canvas]');
		const gl = canvas?.getContext('webgl2', { alpha: true, premultipliedAlpha: true, antialias: false, depth: false, stencil: false, powerPreference: 'default' });
		if (!canvas || !gl) return () => {};

		const read = (key, fallback) => host.dataset[key] ?? String(fallback);
		const settings = {
			color: read('color', '#120f17'),
			metal: read('metal', '#e8ebf1'),
			spectrum: SPECTRUMS[read('spectrum', 'full')] || SPECTRUMS.full,
			tileSize: clamp(num(read('tile', 1), 1), 0.2, 6),
			gap: clamp(num(read('gap', 0.08), 0), 0, 0.6),
			roundness: clamp(num(read('round', 0.15), 0), 0, 1),
			bevel: clamp(num(read('bevel', 0.35), 0), 0, 1),
			rotation: (num(read('rotation', 0), 0) * Math.PI) / 180,
			scatter: clamp(num(read('scatter', 0.3), 0), 0, 1),
			tilt: clamp(num(read('tilt', 0.35), 0), 0, 2),
			swirl: clamp(num(read('swirl', 1), 0), 0, 5),
			ripple: clamp(num(read('ripple', 0.6), 0), 0, 3),
			bands: clamp(num(read('bands', 1.3), 1), 0.3, 3),
			softness: clamp(num(read('soft', 0.5), 0), 0, 1),
			intensity: Math.max(0, num(read('intensity', 1.25), 0)),
			saturation: clamp(num(read('saturation', 0.1), 0), 0, 1.5),
			glitter: clamp(num(read('glitter', 0.85), 0), 0, 1),
			sheen: clamp(num(read('sheen', 0.8), 0), 0, 2),
			grain: clamp(num(read('grain', 0.08), 0), 0, 1),
			speed: Math.max(0, num(read('speed', 0.5), 0)),
			variation: num(read('variation', 0), 0),
			filter: FILTERS[read('filter', 'none')] ?? 0,
			filterSize: clamp(num(read('filtersize', 1), 1), 0.5, 4),
			fade: clamp(num(read('fade', 0), 0), 0, 1),
			opacity: clamp(num(read('opacity', 1), 1), 0, 1),
			intro: read('intro', '1') === '1',
			mouseInteraction: read('mouse', '1') === '1',
			mouseStrength: clamp(num(read('mousestrength', 1), 0), 0, 3),
			mouseRadius: clamp(num(read('mouseradius', 0.25), 0.25), 0.05, 1),
			flipOnClick: read('flip', '1') === '1',
			lightMode: read('lightmode', '0') === '1',
			paused: read('paused', '0') === '1',
		};

		const vertex = compileShader(gl, gl.VERTEX_SHADER, VERTEX);
		const fragment = compileShader(gl, gl.FRAGMENT_SHADER, FRAGMENT);
		const program = vertex && fragment ? gl.createProgram() : null;
		if (!vertex || !fragment || !program) return () => {};
		gl.attachShader(program, vertex);
		gl.attachShader(program, fragment);
		gl.linkProgram(program);
		if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
			console.error('[HoloMosaic] shader link failed', gl.getProgramInfoLog(program));
			return () => {};
		}
		gl.deleteShader(vertex);
		gl.deleteShader(fragment);
		const uniforms = {};
		for (const name of UNIFORMS) uniforms[name] = gl.getUniformLocation(program, name);

		const vao = gl.createVertexArray();
		const probe = document.createElement('canvas');
		probe.width = 1;
		probe.height = 1;
		const probeContext = probe.getContext('2d', { willReadFrequently: true });
		const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
		const waveData = new Float32Array(MAX_WAVES * 4);
		const state = {
			time: 17 + (settings.variation % 97) * 3.1,
			clock: 0,
			frame: 0,
			intro: settings.intro && !reduce && !settings.paused ? 0 : INTRO_SECONDS,
			started: false,
			width: 1,
			height: 1,
			ratio: 1,
			color: [0.07, 0.06, 0.09],
			metal: [0.78, 0.8, 0.85],
			pointer: { x: 0, y: 0, inside: false },
			light: { x: 0, y: 0, vx: 0, vy: 0, placed: false },
			hover: { x: 0, y: 0, vx: 0, vy: 0, presence: 0, placed: false },
			follow: 0,
			waves: [],
		};
		let raf = 0;
		let last = 0;
		let visible = true;
		let alive = true;
		let lost = false;

		const toRgb = (value, fallback) => {
			if (!probeContext || !value) return fallback;
			const css = /^[0-9a-f]{3,8}$/i.test(value) ? `#${value}` : value;
			probeContext.clearRect(0, 0, 1, 1);
			probeContext.fillStyle = '#000000';
			probeContext.fillStyle = css;
			probeContext.fillRect(0, 0, 1, 1);
			const [r, g, b] = probeContext.getImageData(0, 0, 1, 1).data;
			return [r / 255, g / 255, b / 255];
		};
		state.color = toRgb(settings.color, [0.07, 0.06, 0.09]);
		state.metal = toRgb(settings.metal, [0.78, 0.8, 0.85]);

		const aspect = () => state.width / Math.max(state.height, 1);
		const wander = () => ({ x: 0.46 * aspect() * Math.cos(state.time * 0.29 + 0.4), y: 0.36 * Math.sin(state.time * 0.41 + 1.1) });
		const toSurface = (px, py) => ({ x: (px - state.width / 2) / state.height, y: (state.height / 2 - py) / state.height });

		const render = () => {
			if (lost) return;
			const u = uniforms;
			gl.viewport(0, 0, canvas.width, canvas.height);
			gl.disable(gl.BLEND);
			gl.useProgram(program);
			gl.bindVertexArray(vao);
			waveData.fill(0);
			state.waves.forEach((wave, index) => {
				waveData[index * 4] = wave.x;
				waveData[index * 4 + 1] = wave.y;
				waveData[index * 4 + 2] = wave.start;
				waveData[index * 4 + 3] = 1;
			});
			const introLive = state.intro < INTRO_SECONDS;
			gl.uniform2f(u.uRes, canvas.width, canvas.height);
			gl.uniform1f(u.uPixel, state.ratio);
			gl.uniform1f(u.uTime, state.time);
			gl.uniform1f(u.uClock, state.clock);
			gl.uniform1f(u.uTile, TILE_PX * settings.tileSize * state.ratio);
			gl.uniform2f(u.uRot, Math.cos(settings.rotation), Math.sin(settings.rotation));
			gl.uniform1f(u.uGap, settings.gap);
			gl.uniform1f(u.uRound, settings.roundness);
			gl.uniform1f(u.uBevel, settings.bevel);
			gl.uniform1f(u.uScatter, settings.scatter);
			gl.uniform1f(u.uTilt, settings.tilt);
			gl.uniform1f(u.uSwirl, settings.swirl);
			gl.uniform1f(u.uRipple, settings.ripple);
			gl.uniform1f(u.uBands, settings.bands);
			gl.uniform1f(u.uSoft, 0.02 + 0.2 * settings.softness);
			gl.uniform1f(u.uIntensity, settings.intensity);
			gl.uniform1f(u.uSaturation, settings.saturation);
			gl.uniform3f(u.uSpectrum, settings.spectrum[0], settings.spectrum[1], settings.spectrum[2]);
			gl.uniform1f(u.uGlitter, settings.glitter);
			gl.uniform1f(u.uSheen, settings.sheen);
			gl.uniform1f(u.uGrain, settings.grain);
			gl.uniform3f(u.uColor, state.color[0], state.color[1], state.color[2]);
			gl.uniform3f(u.uMetal, state.metal[0], state.metal[1], state.metal[2]);
			gl.uniform2f(u.uLight, state.light.x / EYE, state.light.y / EYE);
			gl.uniform4f(u.uHover, state.hover.x, state.hover.y, settings.mouseRadius, 0.8 * state.hover.presence * settings.mouseStrength);
			gl.uniform4fv(u.uWaves, waveData);
			gl.uniform4f(u.uIntro, 0, 0, state.intro, introLive ? 1 : 0);
			gl.uniform1f(u.uFade, settings.fade);
			gl.uniform1f(u.uOpacity, settings.opacity);
			gl.uniform1f(u.uLightMode, settings.lightMode ? 1 : 0);
			gl.uniform1f(u.uSeed, (settings.variation % 1000) * 0.618);
			gl.uniform1f(u.uFrame, state.frame % 613);
			gl.uniform1f(u.uFilter, settings.filter);
			gl.uniform1f(u.uFilterSize, settings.filterSize);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
			gl.bindVertexArray(null);
		};

		const resize = () => {
			const width = Math.max(1, host.clientWidth);
			const height = Math.max(1, host.clientHeight);
			const base = Math.min(window.devicePixelRatio || 1, 2);
			const longest = Math.max(width, height) * base;
			const ratio = longest > MAX_RENDER_DIM ? (base * MAX_RENDER_DIM) / longest : base;
			const pixelWidth = Math.max(1, Math.round(width * ratio));
			const pixelHeight = Math.max(1, Math.round(height * ratio));
			if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
				canvas.width = pixelWidth;
				canvas.height = pixelHeight;
			}
			state.width = width;
			state.height = height;
			state.ratio = pixelHeight / height;
			if (!state.light.placed) {
				const home = wander();
				state.light.x = home.x;
				state.light.y = home.y;
				state.light.placed = true;
			}
			render();
		};

		const spring = (body, target, stiffness, damping, dt) => {
			body.vx += (stiffness * (target.x - body.x) - damping * body.vx) * dt;
			body.vy += (stiffness * (target.y - body.y) - damping * body.vy) * dt;
			body.x += body.vx * dt;
			body.y += body.vy * dt;
		};

		const frame = (now) => {
			raf = 0;
			if (!alive || !visible || document.hidden || lost) return;
			const dt = last && state.started ? Math.min(0.05, (now - last) / 1000) : 0;
			last = now;
			state.started = true;
			const moving = !settings.paused && !reduce;
			if (moving) {
				state.frame += 1;
				state.clock += dt;
				state.intro += dt;
				state.time += dt * settings.speed;
				state.waves = state.waves.filter((wave) => state.clock - wave.start < WAVE_SECONDS);
			} else if (state.intro < INTRO_SECONDS) {
				state.intro = INTRO_SECONDS;
			}
			const { pointer, light, hover } = state;
			const active = settings.mouseInteraction && pointer.inside && !reduce;
			const target = active ? toSurface(pointer.x, pointer.y) : null;
			state.follow += ((active ? 1 : 0) - state.follow) * (1 - Math.exp(-dt / (active ? 0.45 : 1.2)));
			const home = wander();
			const goal = target ? { x: home.x + (target.x - home.x) * state.follow, y: home.y + (target.y - home.y) * state.follow } : home;
			if (dt > 0) spring(light, goal, 38, 11, dt);
			if (target) {
				if (!hover.placed) { hover.x = target.x; hover.y = target.y; hover.vx = 0; hover.vy = 0; hover.placed = true; }
				if (dt > 0) spring(hover, target, 90, 18, dt);
			}
			const hoverGoal = target ? 1 : 0;
			hover.presence += (hoverGoal - hover.presence) * (1 - Math.exp(-dt / (hoverGoal > hover.presence ? 0.3 : 0.6)));
			if (!target && hover.presence < 0.001) hover.placed = false;
			render();
			const settling =
				Math.abs(hoverGoal - hover.presence) > 0.002 ||
				Math.hypot(light.vx, light.vy) > 0.0005 ||
				Math.hypot(goal.x - light.x, goal.y - light.y) > 0.0005 ||
				Math.hypot(hover.vx, hover.vy) > 0.0005;
			const animating = moving && (settings.speed > 0 || state.intro < INTRO_SECONDS || state.waves.length > 0);
			if (animating || settling) raf = requestAnimationFrame(frame);
			else last = 0;
		};

		const wake = () => {
			if (!raf && alive && visible && !document.hidden && !lost) raf = requestAnimationFrame(frame);
		};

		const locate = (event) => {
			const rect = host.getBoundingClientRect();
			const x = event.clientX - rect.left;
			const y = event.clientY - rect.top;
			return { x, y, inside: x >= 0 && y >= 0 && x <= rect.width && y <= rect.height };
		};

		const onPointerMove = (event) => {
			const spot = locate(event);
			state.pointer.x = spot.x;
			state.pointer.y = spot.y;
			state.pointer.inside = spot.inside;
			wake();
		};
		const onPointerDown = (event) => {
			if (!settings.mouseInteraction || !settings.flipOnClick || event.button !== 0 || reduce || settings.paused) return;
			if (event.target instanceof Element && event.target.closest('a, button, input, textarea, select, label, [role="button"]')) return;
			const spot = locate(event);
			if (!spot.inside) return;
			const point = toSurface(spot.x, spot.y);
			state.waves.push({ x: point.x, y: point.y, start: state.clock });
			while (state.waves.length > MAX_WAVES) state.waves.shift();
			wake();
		};
		const onPointerLeave = () => { state.pointer.inside = false; wake(); };
		const onVisibility = () => { last = 0; wake(); };
		const onLost = (event) => { event.preventDefault(); lost = true; cancelAnimationFrame(raf); raf = 0; };

		const resizeObserver = new ResizeObserver(resize);
		resizeObserver.observe(host);
		const intersection = new IntersectionObserver((entries) => {
			visible = entries.some((entry) => entry.isIntersecting);
			if (visible) { last = 0; wake(); }
		});
		intersection.observe(host);
		window.addEventListener('pointermove', onPointerMove, { passive: true });
		window.addEventListener('pointerdown', onPointerDown);
		document.documentElement.addEventListener('pointerleave', onPointerLeave);
		document.addEventListener('visibilitychange', onVisibility);
		canvas.addEventListener('webglcontextlost', onLost);
		resize();
		wake();

		return () => {
			alive = false;
			cancelAnimationFrame(raf);
			resizeObserver.disconnect();
			intersection.disconnect();
			window.removeEventListener('pointermove', onPointerMove);
			window.removeEventListener('pointerdown', onPointerDown);
			document.documentElement.removeEventListener('pointerleave', onPointerLeave);
			document.removeEventListener('visibilitychange', onVisibility);
			canvas.removeEventListener('webglcontextlost', onLost);
			if (!gl.isContextLost()) {
				gl.deleteVertexArray(vao);
				gl.deleteProgram(program);
			}
		};
	}

	const instances = new Map();
	function mount() {
		document.querySelectorAll('[data-holo]').forEach((host) => {
			if (host.dataset.holoBound === '1') return;
			host.dataset.holoBound = '1';
			instances.set(host, setup(host));
		});
	}
	function unmount() {
		instances.forEach((destroy) => destroy());
		instances.clear();
		document.querySelectorAll('[data-holo]').forEach((host) => { delete host.dataset.holoBound; });
	}
	let bound = false;
	export function initHoloMosaic() {
		if (bound) return;
		bound = true;
		document.addEventListener('astro:before-swap', unmount);
		document.addEventListener('astro:page-load', mount);
		if (document.readyState !== 'loading') mount();
		else document.addEventListener('DOMContentLoaded', mount, { once: true });
	}
	initHoloMosaic();
</script>
