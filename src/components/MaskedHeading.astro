---
/**
 * MaskedHeading — 用图片/视频填充文字（text-as-window）。
 *
 * 实现：文字本身透明，背景图通过 `background-clip: text` 透出来；
 * 滚动时背景位移做视差，鼠标附近提亮（spotlight），可选只描边（outline）。
 * 视频：优先用 poster 做填充（背景图不支持 video），并在下方叠加真实视频层，
 * 保证「视频在字里播放」的观感。没有素材时自动退化成渐变色文字。
 */
interface Props {
	text: string;
	/** image | video | gradient */
	mediaType?: 'image' | 'video' | 'gradient';
	src?: string;
	poster?: string;
	/** 背景图放大倍数 */
	fillScale?: number;
	/** 视差强度（px） */
	parallax?: number;
	reveal?: 'scale' | 'none';
	/** 进入视口才播放 */
	trigger?: 'view' | 'load';
	spotlight?: boolean;
	spotlightRadius?: number;
	/** 只保留描边 */
	outline?: boolean;
	class?: string;
	tag?: 'h1' | 'h2' | 'div';
}

const {
	text,
	mediaType = 'image',
	src,
	poster,
	fillScale = 1.3,
	parallax = 34,
	reveal = 'scale',
	trigger = 'view',
	spotlight = false,
	spotlightRadius = 180,
	outline = false,
	class: className = '',
	tag = 'h1',
} = Astro.props;

const fillUrl = mediaType === 'video' ? poster ?? src : src;
const Tag = tag;
---

<Tag
	class:list={['masked', `masked--${reveal}`, outline && 'masked--outline', spotlight && 'masked--spot', className]}
	data-masked
	data-parallax={parallax}
	data-scale={fillScale}
	data-spot={spotlight ? spotlightRadius : 0}
	data-trigger={trigger}
	style={fillUrl ? `--masked-img:url(${fillUrl});--masked-scale:${fillScale}` : undefined}
	aria-label={text}
>
	<span class="masked__text" aria-hidden="true">{text}</span>
	{mediaType === 'video' && src && (
		<video class="masked__video" src={src} poster={poster} muted loop playsinline preload="none"></video>
	)}
</Tag>

<style>
	.masked {
		position: relative;
		margin: 0;
		line-height: 0.98;
		letter-spacing: -0.035em;
		font-weight: 800;
		display: block;
	}

	.masked__text {
		display: block;
		background-image: var(--masked-img, linear-gradient(100deg, rgb(var(--accent)), rgb(var(--ochre)) 55%, rgb(var(--accent-soft))));
		background-size: calc(var(--masked-scale, 1.3) * 100%) auto;
		background-position: 50% 50%;
		background-repeat: no-repeat;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
		will-change: background-position;
	}

	.masked--outline .masked__text {
		background: transparent;
		-webkit-text-fill-color: transparent;
		-webkit-text-stroke: 1.4px rgba(var(--ink), 0.5);
	}

	/* 鼠标处提亮：叠一层白雾，mask 随指针移动 */
	.masked--spot .masked__text::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(
			circle var(--spot-r, 180px) at var(--spot-x, 50%) var(--spot-y, 50%),
			rgba(255, 255, 255, 0.55),
			transparent 70%
		);
		-webkit-mask-image: var(--masked-img, none);
		-webkit-mask-size: calc(var(--masked-scale, 1.3) * 100%) auto;
		-webkit-mask-position: 50% 50%;
		-webkit-mask-repeat: no-repeat;
		mix-blend-mode: soft-light;
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.masked--spot:hover .masked__text::after {
		opacity: 1;
	}

	/* 视频层：放在文字下方，只在支持混合的浏览器里露出 */
	.masked__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		pointer-events: none;
	}

	/* 进场：轻微放大淡入 */
	.masked--scale .masked__text {
		animation: masked-in 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) both;
	}

	@keyframes masked-in {
		from {
			opacity: 0;
			transform: scale(0.985);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.masked--scale .masked__text {
			animation: none;
		}
	}
</style>

<script>
	const seen = new WeakSet<HTMLElement>();

	function boot(el: HTMLElement) {
		if (el.dataset.maskedReady === '1') return;
		el.dataset.maskedReady = '1';

		const text = el.querySelector<HTMLElement>('.masked__text');
		if (!text) return;

		const parallax = Number(el.dataset.parallax) || 0;
		const spot = Number(el.dataset.spot) || 0;
		const video = el.querySelector<HTMLVideoElement>('.masked__video');

		// 视差：背景纵向位移，跟随元素在视口里的位置
		let raf = 0;
		const update = () => {
			raf = 0;
			if (!parallax) return;
			const r = el.getBoundingClientRect();
			const vh = window.innerHeight || 1;
			const progress = Math.min(1, Math.max(0, 1 - (r.top + r.height * 0.5) / vh));
			const y = (progress - 0.5) * parallax * 2;
			text.style.backgroundPosition = `50% calc(50% + ${y.toFixed(1)}px)`;
		};
		const onScroll = () => {
			if (raf) return;
			raf = requestAnimationFrame(update);
		};

		if (parallax && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			update();
			window.addEventListener('scroll', onScroll, { passive: true });
		}

		if (spot) {
			el.style.setProperty('--spot-r', `${spot}px`);
			el.addEventListener('pointermove', (ev) => {
				const r = el.getBoundingClientRect();
				el.style.setProperty('--spot-x', `${ev.clientX - r.left}px`);
				el.style.setProperty('--spot-y', `${ev.clientY - r.top}px`);
			});
		}

		if (video && el.dataset.trigger === 'view') {
			const io = new IntersectionObserver(
				([entry]) => {
					if (entry.isIntersecting) {
						video.play().catch(() => {});
						io.disconnect();
					}
				},
				{ threshold: 0.2 }
			);
			io.observe(el);
		} else if (video) {
			video.play().catch(() => {});
		}

		if (!seen.has(el)) {
			seen.add(el);
			el.addEventListener('pointerenter', () => {
				if (video && video.paused) video.play().catch(() => {});
				else if (video) video.play().catch(() => {});
			});
		}
	}

	const init = () => document.querySelectorAll<HTMLElement>('[data-masked]').forEach(boot);
	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
	else init();
	document.addEventListener('astro:page-load', init);
</script>
