---
/**
 * 微型栅条动态背景（MicroSlats）。
 *
 * 一整片小竖条，按高度场起伏；条顶有一道高光（glint），远处压暗，
 * 鼠标靠近会被"顶"起来。纯 Canvas 2D 绘制，不引入 React。
 *
 * 用法：
 *   <MicroSlats preset="swell" color="#A855F7" height="420px" />
 */
interface Props {
	/** 起伏形态：swell（同心波）/ ripple（斜向波）/ drift（漂移）/ mesh（交叉波） */
	preset?: 'swell' | 'ripple' | 'drift' | 'mesh';
	/** 栅条主色 */
	color?: string;
	/** 条顶高光色 */
	glintColor?: string;
	/** 底色（用于拖影淡出，需与所在区域背景一致） */
	backgroundColor?: string;
	slatWidth?: number;
	slatHeight?: number;
	gap?: number;
	/** 0–1，圆角比例 */
	roundness?: number;
	interactive?: boolean;
	cursorStrength?: number;
	cursorSize?: number;
	/** 整体旋转扭曲 */
	swirl?: number;
	/** 拖影长度，0 关闭 */
	trail?: number;
	/** 栅条倾斜 */
	lean?: number;
	/** 进场动画 */
	intro?: boolean;
	height?: string;
	class?: string;
}

const {
	preset = 'swell',
	color = '#A855F7',
	glintColor = '#ffffff',
	backgroundColor = 'transparent',
	slatWidth = 10,
	slatHeight = 25,
	gap = 3,
	roundness = 0.75,
	interactive = false,
	cursorStrength = 1,
	cursorSize = 40,
	swirl = 0,
	trail = 1.4,
	lean = 0,
	intro = true,
	height = '420px',
	class: className = '',
} = Astro.props;
---

<div
	class={`mslats ${className}`}
	data-mslats
	data-preset={preset}
	data-color={color}
	data-glint={glintColor}
	data-bg={backgroundColor}
	data-w={slatWidth}
	data-h={slatHeight}
	data-gap={gap}
	data-round={roundness}
	data-interactive={interactive ? '1' : '0'}
	data-cstrength={cursorStrength}
	data-csize={cursorSize}
	data-swirl={swirl}
	data-trail={trail}
	data-lean={lean}
	data-intro={intro ? '1' : '0'}
	style={`--ms-h:${height}`}
	aria-hidden="true"
>
	<canvas></canvas>
</div>

<style>
	.mslats {
		position: relative;
		width: 100%;
		height: var(--ms-h);
		overflow: hidden;
	}
	.mslats canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	type Preset = 'swell' | 'ripple' | 'drift' | 'mesh';

	type Cfg = {
		preset: Preset;
		color: string;
		glint: string;
		bg: string;
		w: number;
		h: number;
		gap: number;
		round: number;
		interactive: boolean;
		cstrength: number;
		csize: number;
		swirl: number;
		trail: number;
		lean: number;
		intro: boolean;
	};

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	function parseColor(input: string): [number, number, number] {
		const s = input.trim();
		if (s.startsWith('#')) {
			const hex = s.slice(1);
			const full = hex.length === 3 ? hex.split('').map((c) => c + c).join('') : hex;
			const n = parseInt(full, 16);
			return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
		}
		const m = s.match(/rgba?\(([^)]+)\)/);
		if (m) {
			const [r, g, b] = m[1].split(',').map((v) => parseFloat(v));
			return [r, g, b];
		}
		return [168, 85, 247];
	}

	function boot(el: HTMLElement) {
		if (el.dataset.msReady === '1') return;
		el.dataset.msReady = '1';

		const canvas = el.querySelector('canvas')!;
		const ctx = canvas.getContext('2d', { alpha: true })!;
		if (!ctx) return;

		const d = el.dataset;
		const cfg: Cfg = {
			preset: (d.preset as Preset) || 'swell',
			color: d.color || '#A855F7',
			glint: d.glint || '#ffffff',
			bg: d.bg || 'transparent',
			w: Number(d.w) || 10,
			h: Number(d.h) || 25,
			gap: Number(d.gap) || 3,
			round: Number(d.round ?? 0.75),
			interactive: d.interactive === '1',
			cstrength: Number(d.cstrength) || 1,
			csize: Number(d.csize) || 40,
			swirl: Number(d.swirl) || 0,
			trail: Number(d.trail ?? 1.4),
			lean: Number(d.lean) || 0,
			intro: d.intro === '1',
		};

		const base = parseColor(cfg.color);
		const glint = parseColor(cfg.glint);
		const transparentBg = cfg.bg === 'transparent';
		const bgRgb = transparentBg ? null : parseColor(cfg.bg);

		let W = 0;
		let H = 0;
		let dpr = 1;
		let cols = 0;
		let rows = 0;
		let start = performance.now();
		let running = true;
		let raf = 0;

		const pointer = { x: -9999, y: -9999, on: false };
		const t0 = performance.now();

		const resize = () => {
			const rect = el.getBoundingClientRect();
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			W = Math.max(1, Math.round(rect.width));
			H = Math.max(1, Math.round(rect.height));
			canvas.width = Math.round(W * dpr);
			canvas.height = Math.round(H * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			cols = Math.ceil(W / (cfg.w + cfg.gap)) + 1;
			rows = Math.ceil(H / (cfg.h + cfg.gap)) + 1;
			clear();
		};

		const clear = () => {
			ctx.clearRect(0, 0, W, H);
			if (bgRgb) ctx.fillStyle = `rgb(${bgRgb[0]},${bgRgb[1]},${bgRgb[2]})`;
			if (bgRgb) ctx.fillRect(0, 0, W, H);
		};

		// 高度场：值域大致 0–1
		const field = (nx: number, ny: number, t: number) => {
			switch (cfg.preset) {
				case 'ripple':
					return (
						0.5 +
						0.32 * Math.sin(nx * 3.1 + ny * 2.2 + t * 0.9) +
						0.18 * Math.sin(nx * 6.3 - ny * 4.1 + t * 1.5)
					);
				case 'drift':
					return (
						0.5 +
						0.34 * Math.sin(nx * 2.4 - t * 0.7) * Math.cos(ny * 2.9 + t * 0.45) +
						0.16 * Math.sin(ny * 5.2 + t * 1.1)
					);
				case 'mesh':
					return (
						0.5 +
						0.26 * Math.sin(nx * 4.2 + t * 0.8) +
						0.26 * Math.sin(ny * 4.6 - t * 0.62) -
						0.12
					);
				case 'swell':
				default: {
					const dx = nx - 0.5;
					const dy = ny - 0.55;
					const r = Math.sqrt(dx * dx + dy * dy);
					return 0.5 + 0.42 * Math.sin(r * 9.5 - t * 1.6) * Math.exp(-r * 1.15) + 0.12;
				}
			}
		};

		const draw = (now: number) => {
			if (!running) return;
			const t = (now - t0) / 1000;
			const introT = cfg.intro ? Math.min(1, (now - start) / 900) : 1;
			const ease = 1 - Math.pow(1 - introT, 3);

			// 拖影：用半透明底色覆盖，而不是逐帧清空
			if (cfg.trail > 0) {
				if (bgRgb) {
					ctx.fillStyle = `rgba(${bgRgb[0]},${bgRgb[1]},${bgRgb[2]},${Math.min(1, 0.16 / cfg.trail)})`;
					ctx.fillRect(0, 0, W, H);
				} else {
					ctx.clearRect(0, 0, W, H);
				}
			} else {
				clear();
			}

			const stepX = cfg.w + cfg.gap;
			const stepY = cfg.h + cfg.gap;
			const cx = pointer.x;
			const cy = pointer.y;
			const csize2 = cfg.csize * cfg.csize;

			for (let j = 0; j < rows; j++) {
				for (let i = 0; i < cols; i++) {
					const px = i * stepX + cfg.w / 2;
					const py = j * stepY + cfg.h / 2;
					const nx = px / W;
					const ny = py / H;

					let v = field(nx, ny, t);
					v = Math.max(0, Math.min(1, v));

					let lift = 0;
					if (cfg.interactive && pointer.on) {
						const dx = px - cx;
						const dy = py - cy;
						const d2 = dx * dx + dy * dy;
						if (d2 < csize2 * 4) lift = Math.exp(-d2 / csize2) * cfg.cstrength;
					}

					const hv = Math.min(1.25, v + lift * 0.85) * ease;
					const hgt = Math.max(1, cfg.h * hv);
					const x = i * stepX;
					const y = j * stepY + (cfg.h - hgt); // 以底边为锚点向上长

					// 越靠近画面上/下方越暗，避免抢内容
					const vignette = 0.55 + 0.45 * Math.sin(Math.PI * Math.min(1, Math.max(0, ny)));

					const mix = Math.min(1, hv * 1.1);
					const r = Math.round(base[0] + (glint[0] - base[0]) * mix * 0.8);
					const g = Math.round(base[1] + (glint[1] - base[1]) * mix * 0.8);
					const b = Math.round(base[2] + (glint[2] - base[2]) * mix * 0.8);

					ctx.globalAlpha = 0.22 + 0.62 * hv * vignette;
					ctx.fillStyle = `rgb(${r},${g},${b})`;

					const rad = Math.min(cfg.w, hgt) * 0.5 * cfg.round;
					ctx.beginPath();
					ctx.roundRect(x + cfg.lean * (ny - 0.5) * 12, y, cfg.w, hgt, rad);
					ctx.fill();

					// 条顶高光
					if (hv > 0.68) {
						ctx.globalAlpha = Math.min(1, (hv - 0.68) * 2.6) * 0.85;
						ctx.fillStyle = `rgb(${glint[0]},${glint[1]},${glint[2]})`;
						ctx.beginPath();
						ctx.roundRect(x + cfg.lean * (ny - 0.5) * 12, y, cfg.w, Math.max(1.5, hgt * 0.16), rad);
						ctx.fill();
					}
				}
			}
			ctx.globalAlpha = 1;

			raf = requestAnimationFrame(draw);
		};

		const startAnim = () => {
			if (raf) return;
			raf = requestAnimationFrame(draw);
		};
		const stopAnim = () => {
			if (raf) cancelAnimationFrame(raf);
			raf = 0;
		};

		resize();
		start = performance.now();

		if (reduceMotion.matches) {
			// 只画一帧静态
			running = true;
			draw(performance.now());
			stopAnim();
		} else {
			startAnim();
		}

		const ro = new ResizeObserver(() => {
			resize();
			start = performance.now();
		});
		ro.observe(el);

		const io = new IntersectionObserver(
			([entry]) => {
				running = entry.isIntersecting;
				if (running) startAnim();
				else stopAnim();
			},
			{ threshold: 0 }
		);
		io.observe(el);

		if (cfg.interactive) {
			el.addEventListener('pointermove', (ev) => {
				const r = el.getBoundingClientRect();
				pointer.x = ev.clientX - r.left;
				pointer.y = ev.clientY - r.top;
				pointer.on = true;
			});
			el.addEventListener('pointerleave', () => {
				pointer.on = false;
				pointer.x = -9999;
				pointer.y = -9999;
			});
		}
	}

	const init = () => document.querySelectorAll<HTMLElement>('[data-mslats]').forEach(boot);
	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
	else init();
	document.addEventListener('astro:page-load', init);
</script>
