---
// 全站动效引擎（无依赖）：
//   [data-ac]        AnimatedContent 式滚动进场（位移/模糊/缩放/旋转/擦除/错峰）
//   [data-reveal]    旧标记，自动映射到同一引擎（left/right/scale/mask 保留原义）
//   [data-glow]      玻璃卡片上的指针高光，写入 --mx / --my
//   [data-tilt]      卡片 3D 倾斜，角度由 data-tilt 指定
//   [data-progress]  顶部阅读进度条（写入 --progress）
//   [data-count-up]  数字滚动（CountUp.astro 只负责标记，逻辑在这里统一跑，
//                    避免同一页里出现多份相同脚本）
// Astro View Transitions 会替换 <body>，所以所有初始化都挂在 astro:page-load 上，
// 并用 data-* 标记避免重复绑定。
---

<script>
	type Cleanup = () => void;
	const cleanups: Cleanup[] = [];
	let bound = false;

	const prefersReduced = () =>
		window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const coarsePointer = () => window.matchMedia('(pointer: coarse)').matches;

	/* ---------- AnimatedContent 式滚动进场 ---------- */
	const readNum = (el: HTMLElement, key: string, fallback: number) => {
		const raw = el.dataset[key];
		if (raw === undefined || raw === '') return fallback;
		const n = Number(raw);
		return Number.isFinite(n) ? n : fallback;
	};

	/** 把参数写成 CSS 变量；CSS 侧负责初始态与过渡。
	 *  元素上已经手写过同名变量（例如标题要单独关掉模糊）时保持不动。 */
	const applyVars = (
		el: HTMLElement,
		opts: { dist: number; blur: number; scale: number; rotate: number; dur: number; delay: number },
	) => {
		const set = (name: string, value: string) => {
			if (!el.style.getPropertyValue(name)) el.style.setProperty(name, value);
		};
		set('--ac-dist', `${opts.dist}px`);
		set('--ac-blur', `${opts.blur}px`);
		set('--ac-scale', String(opts.scale));
		set('--ac-rotate', `${opts.rotate}deg`);
		set('--ac-dur', `${opts.dur}s`);
		set('--ac-delay', `${Math.round(opts.delay)}ms`);
	};

	/** 错峰延迟：按 stagger-from 把子元素排成一个进场序列 */
	const staggerDelays = (count: number, each: number, from: string): number[] => {
		const at = (i: number) => i * each;
		if (from === 'end') return Array.from({ length: count }, (_, i) => at(count - 1 - i));
		if (from === 'center')
			return Array.from({ length: count }, (_, i) => at(Math.abs(i - (count - 1) / 2)));
		if (from === 'edges')
			return Array.from({ length: count }, (_, i) => at((count - 1) / 2 - Math.abs(i - (count - 1) / 2)));
		if (from === 'random') {
			const order = Array.from({ length: count }, (_, i) => i).sort(() => Math.random() - 0.5);
			const out = new Array<number>(count).fill(0);
			order.forEach((idx, k) => (out[idx] = at(k)));
			return out;
		}
		return Array.from({ length: count }, (_, i) => at(i));
	};

	function initAnimatedContent() {
		const nodes = Array.from(
			document.querySelectorAll<HTMLElement>(
				'[data-ac]:not([data-ac-ready]), [data-ac-stagger]:not([data-ac-ready]), [data-reveal]:not([data-ac-ready])',
			),
		).filter((el) => !el.closest('[data-ac-child]'));
		if (nodes.length === 0) return;

		const reduced = prefersReduced() || !('IntersectionObserver' in window);

		const settle = (el: HTMLElement) => {
			el.classList.add('is-in');
			const done = (e: TransitionEvent) => {
				if (e.target !== el) return;
				if (e.propertyName !== 'transform' && e.propertyName !== 'opacity') return;
				el.classList.add('ac-done');
				el.removeEventListener('transitionend', done);
			};
			el.addEventListener('transitionend', done);
		};

		const watched = new Map<Element, HTMLElement[]>();

		for (const el of nodes) {
			el.dataset.acReady = '1';

			// 旧标记兼容：data-reveal="left|right|scale|mask"
			const legacy = el.dataset.reveal;
			let direction = el.dataset.acDirection;
			let reverse = el.hasAttribute('data-ac-reverse');
			let wipe = el.dataset.acWipe;
			let dist = readNum(el, 'acDistance', legacy ? 26 : 26);
			let blur = readNum(el, 'acBlur', 5);
			let scale = readNum(el, 'acScale', 1);
			const rotate = readNum(el, 'acRotate', 0);
			const dur = readNum(el, 'acDuration', 0.8);
			const delay = readNum(el, 'acDelay', Number(el.dataset.revealDelay) || 0);

			if (legacy) {
				if (legacy === 'left') {
					direction = 'horizontal';
					reverse = true;
				} else if (legacy === 'right') {
					direction = 'horizontal';
				} else if (legacy === 'scale') {
					scale = 0.94;
				} else if (legacy === 'mask') {
					wipe = 'up';
				}
			}

			const isWrap = el.hasAttribute('data-ac-stagger') && !el.hasAttribute('data-ac');
			const vars = { dist, blur, scale, rotate, dur, delay };

			if (isWrap) {
				// 容器本身不动，只把子元素排进队列
				applyVars(el, { ...vars, dist: 0, blur: 0, scale: 1 });
				el.style.setProperty('--ac-delay', '0ms');

				const kids = Array.from(el.children) as HTMLElement[];
				const each = readNum(el, 'acStagger', 0.08) * 1000;
				const order = staggerDelays(kids.length, each, el.dataset.acStaggerFrom ?? 'start');

				kids.forEach((kid, i) => {
					kid.setAttribute('data-ac-child', '');
					if (direction) kid.setAttribute('data-ac-direction', direction);
					if (reverse) kid.setAttribute('data-ac-reverse', '');
					if (wipe) kid.setAttribute('data-ac-wipe', wipe);
					applyVars(kid, { ...vars, delay: delay + order[i] });
				});

				if (reduced) kids.forEach((kid) => kid.classList.add('is-in', 'ac-done'));
				else watched.set(el, kids);
				continue;
			}

			el.setAttribute('data-ac', '');
			if (direction) el.setAttribute('data-ac-direction', direction);
			if (reverse) el.setAttribute('data-ac-reverse', '');
			if (wipe) el.setAttribute('data-ac-wipe', wipe);
			applyVars(el, vars);

			if (reduced) {
				el.classList.add('is-in', 'ac-done');
				continue;
			}
			watched.set(el, [el]);
		}

		if (watched.size === 0) return;

		// 每块可以有自己的触发阈值
		const groups = new Map<number, Element[]>();
		for (const el of watched.keys()) {
			const t = Math.min(0.9, Math.max(0, readNum(el as HTMLElement, 'acThreshold', 0.1)));
			const key = Math.round(t * 100);
			const list = groups.get(key) ?? [];
			list.push(el);
			groups.set(key, list);
		}

		const ios: IntersectionObserver[] = [];
		for (const [key, els] of groups) {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						const targets = watched.get(entry.target);
						if (targets) targets.forEach(settle);
						io.unobserve(entry.target);
					}
				},
				{ threshold: key / 100, rootMargin: '0px 0px -6% 0px' },
			);
			els.forEach((el) => io.observe(el));
			ios.push(io);
		}
		cleanups.push(() => ios.forEach((io) => io.disconnect()));
	}

	/* ---------- 指针高光 ---------- */
	function initGlow() {
		const nodes = Array.from(
			document.querySelectorAll<HTMLElement>('[data-glow]:not([data-glow-ready])'),
		);
		if (nodes.length === 0 || coarsePointer()) return;

		for (const node of nodes) {
			node.dataset.glowReady = '1';
			const move = (e: PointerEvent) => {
				const r = node.getBoundingClientRect();
				node.style.setProperty('--mx', `${e.clientX - r.left}px`);
				node.style.setProperty('--my', `${e.clientY - r.top}px`);
			};
			node.addEventListener('pointermove', move, { passive: true });
			cleanups.push(() => node.removeEventListener('pointermove', move));
		}
	}

	/* ---------- 3D 倾斜 ---------- */
	function initTilt() {
		const nodes = Array.from(
			document.querySelectorAll<HTMLElement>('[data-tilt]:not([data-tilt-ready])'),
		);
		if (nodes.length === 0 || coarsePointer() || prefersReduced()) return;

		for (const node of nodes) {
			node.dataset.tiltReady = '1';
			const max = Number(node.dataset.tilt) || 8;
			const target = node.querySelector<HTMLElement>('[data-tilt-inner]') ?? node;

			const move = (e: PointerEvent) => {
				const r = node.getBoundingClientRect();
				const px = (e.clientX - r.left) / r.width - 0.5;
				const py = (e.clientY - r.top) / r.height - 0.5;
				target.style.transform = `perspective(900px) rotateX(${(-py * max).toFixed(2)}deg) rotateY(${(px * max).toFixed(2)}deg)`;
			};
			const leave = () => {
				target.style.transform = '';
			};

			node.addEventListener('pointermove', move, { passive: true });
			node.addEventListener('pointerleave', leave, { passive: true });
			cleanups.push(() => {
				node.removeEventListener('pointermove', move);
				node.removeEventListener('pointerleave', leave);
			});
		}
	}

	/* ---------- 阅读进度 ---------- */
	function initProgress() {
		const bar = document.querySelector<HTMLElement>('[data-progress]');
		if (!bar) return;

		let raf = 0;
		const update = () => {
			raf = 0;
			const doc = document.documentElement;
			const max = doc.scrollHeight - window.innerHeight;
			const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
			bar.style.setProperty('--progress', p.toFixed(4));
		};
		const onScroll = () => {
			if (raf) return;
			raf = requestAnimationFrame(update);
		};

		update();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll, { passive: true });
		cleanups.push(() => {
			window.removeEventListener('scroll', onScroll);
			window.removeEventListener('resize', onScroll);
			if (raf) cancelAnimationFrame(raf);
		});
	}

	/* ---------- 数字滚动 ---------- */
	const formatNumber = (value: number, decimals: number, separator: string) => {
		const [int, dec] = value.toFixed(decimals).split('.');
		const grouped = separator ? int.replace(/\B(?=(\d{3})+(?!\d))/g, separator) : int;
		return dec ? `${grouped}.${dec}` : grouped;
	};

	function initCountUp() {
		const nodes = Array.from(
			document.querySelectorAll<HTMLElement>('[data-count-up]:not([data-count-ready])'),
		);
		if (nodes.length === 0) return;

		const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

		for (const el of nodes) {
			el.dataset.countReady = '1';

			const to = Number(el.dataset.to) || 0;
			const from = Number(el.dataset.from) || 0;
			const duration = Math.max(0, Number(el.dataset.duration) || 1.1) * 1000;
			const delay = Math.max(0, Number(el.dataset.delay) || 0) * 1000;
			const decimals = Math.max(0, Number(el.dataset.decimals) || 0);
			const separator = el.dataset.separator ?? '';
			const prefix = el.dataset.prefix ?? '';
			const suffix = el.dataset.suffix ?? '';

			const write = (value: number) => {
				el.textContent = `${prefix}${formatNumber(value, decimals, separator)}${suffix}`;
			};

			if (prefersReduced() || duration === 0) {
				write(to);
				continue;
			}

			// 服务端已渲染终值，这里先回到起点，等进入视口再滚
			const run = () => {
				const start = performance.now() + delay;
				const step = (now: number) => {
					if (now < start) {
						requestAnimationFrame(step);
						return;
					}
					const p = Math.min(1, (now - start) / duration);
					write(from + (to - from) * easeOut(p));
					if (p < 1) requestAnimationFrame(step);
					else write(to);
				};
				requestAnimationFrame(step);
			};

			const io = new IntersectionObserver(
				(entries) => {
					if (!entries.some((e) => e.isIntersecting)) return;
					io.disconnect();
					write(from);
					window.setTimeout(run, 60);
				},
				{ threshold: 0.4 },
			);
			io.observe(el);
			cleanups.push(() => io.disconnect());
		}
	}

	/* ---------- 编排 ---------- */
	let pageToken = 0;
	let mountedToken = -1;

	function mount() {
		if (mountedToken === pageToken) return;
		mountedToken = pageToken;
		cleanups.forEach((fn) => fn());
		cleanups.length = 0;
		initAnimatedContent();
		initGlow();
		initTilt();
		initProgress();
		initCountUp();
	}

	if (!bound) {
		bound = true;
		// 换页时令牌加一，page-load 才会重新挂载监听
		document.addEventListener('astro:before-swap', () => {
			pageToken += 1;
		});
		document.addEventListener('astro:page-load', mount);
	}
	mount();
</script>
