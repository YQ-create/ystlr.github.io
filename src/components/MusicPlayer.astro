---
// 顶部悬浮音乐播放器：曲目来自 src/data/playlist.json，音频文件放在 public/audio/。
// 面板走玻璃质感 + 弹性入场，播放中按钮显示音柱动画。

import playlist from '../data/playlist.json';

interface Track {
	title: string;
	artist?: string;
	src: string;
}

const tracks: Track[] = Array.isArray((playlist as { tracks?: Track[] }).tracks)
	? (playlist as { tracks: Track[] }).tracks
	: [];
---

<script type="application/json" data-music-tracks set:html={JSON.stringify(tracks)}></script>

<div class="music" data-music data-count={tracks.length}>
	<button class="music-btn" type="button" data-music-toggle aria-expanded="false" aria-label="音乐播放器">
		<svg class="icon-note" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
			<path
				fill="currentColor"
				d="M13.5 1.6a.6.6 0 0 1 .7.6v8.1a2.4 2.4 0 1 1-1.2-2.1V4.3L6.5 5.7v6a2.4 2.4 0 1 1-1.2-2.1V3.4a.6.6 0 0 1 .47-.58l7.73-1.22Z"
			></path>
		</svg>
		<span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
	</button>

	<div class="music-panel glass" data-music-panel hidden>
		<div class="np">
			<span class="np-kicker">NOW PLAYING</span>
			<p class="np-title" data-music-title>尚未添加音乐</p>
			<p class="np-artist" data-music-artist></p>
		</div>

		<div class="progress" data-music-bar role="slider" tabindex="0" aria-label="播放进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
			<span class="progress-fill" data-music-progress></span>
		</div>
		<div class="time">
			<span data-music-current>0:00</span>
			<span data-music-duration>0:00</span>
		</div>

		<div class="controls">
			<button type="button" data-music-prev aria-label="上一首" class="ctrl">
				<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M4 3h1.6v10H4zM13 3.4v9.2a.6.6 0 0 1-.93.5L5.9 8.5a.6.6 0 0 1 0-1l6.17-4.6a.6.6 0 0 1 .93.5Z"/></svg>
			</button>
			<button type="button" data-music-play aria-label="播放" class="ctrl ctrl-main">
				<svg class="icon-play" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M5 2.9v10.2c0 .5.54.8.97.55l8.1-5.1a.65.65 0 0 0 0-1.1l-8.1-5.1A.65.65 0 0 0 5 2.9Z"/></svg>
				<svg class="icon-pause" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M4 3h3v10H4zM9 3h3v10H9z"/></svg>
			</button>
			<button type="button" data-music-next aria-label="下一首" class="ctrl">
				<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 3h-1.6v10H12zM3 3.4v9.2a.6.6 0 0 0 .93.5L10.1 8.5a.6.6 0 0 0 0-1L3.93 2.9A.6.6 0 0 0 3 3.4Z"/></svg>
			</button>
		</div>

		<ol class="list" data-music-list>
			{tracks.map((track, index) => (
				<li>
					<button type="button" data-music-track={index} class="track">
						<span class="track-index">{String(index + 1).padStart(2, '0')}</span>
						<span class="track-name">{track.title}</span>
					</button>
				</li>
			))}
		</ol>

		<p class="hint" data-music-empty hidden>
			还没有曲目，在 playlist.json 中添加后即可播放。
		</p>

		<audio data-music-audio transition:persist preload="metadata"></audio>
	</div>
</div>

<script>
	type Track = { title: string; artist?: string; src: string };

	const MUSIC_STATE_KEY = 'ystlr:music';

	let tracks: Track[] = [];
	let currentIndex = -1;
	let timer: number | undefined;

	function audioEl(): HTMLAudioElement | null {
		return document.querySelector<HTMLAudioElement>('[data-music-audio]');
	}

	function readTracks(): Track[] {
		const node = document.querySelector<HTMLScriptElement>('script[data-music-tracks]');
		if (!node?.textContent) return [];
		try {
			return JSON.parse(node.textContent) as Track[];
		} catch {
			return [];
		}
	}

	function fmt(seconds: number): string {
		if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
		const m = Math.floor(seconds / 60);
		const s = Math.floor(seconds % 60);
		return `${m}:${String(s).padStart(2, '0')}`;
	}

	function load(index: number, autoplay: boolean) {
		const audio = audioEl();
		if (!audio || !tracks[index]) return;
		currentIndex = index;
		const track = tracks[index];
		if (audio.getAttribute('src') !== track.src) {
			audio.setAttribute('src', track.src);
			audio.load();
		}
		if (autoplay) void audio.play().catch(() => {});
		render();
	}

	function next(step = 1) {
		if (!tracks.length) return;
		const index = (currentIndex + step + tracks.length) % tracks.length;
		load(index, true);
	}

	function render() {
		const root = document.querySelector<HTMLElement>('[data-music]');
		if (!root) return;
		const audio = audioEl();
		const track = tracks[currentIndex];
		const playing = !!audio && !audio.paused && !!audio.getAttribute('src');

		root.classList.toggle('is-playing', playing);
		root.setAttribute('data-count', String(tracks.length));

		const title = root.querySelector<HTMLElement>('[data-music-title]');
		const artist = root.querySelector<HTMLElement>('[data-music-artist]');
		const playBtn = root.querySelector<HTMLButtonElement>('[data-music-play]');
		const empty = root.querySelector<HTMLElement>('[data-music-empty]');
		const list = root.querySelector<HTMLElement>('[data-music-list]');
		const progress = root.querySelector<HTMLElement>('[data-music-progress]');
		const bar = root.querySelector<HTMLElement>('[data-music-bar]');
		const current = root.querySelector<HTMLElement>('[data-music-current]');
		const duration = root.querySelector<HTMLElement>('[data-music-duration]');
		const matches = root.querySelectorAll<HTMLElement>('[data-music-track]');

		if (title) title.textContent = track?.title ?? '尚未添加音乐';
		if (artist) artist.textContent = track?.artist ?? '';
		if (playBtn) {
			playBtn.classList.toggle('is-playing', playing);
			playBtn.setAttribute('aria-label', playing ? '暂停' : '播放');
		}
		if (empty) empty.hidden = tracks.length > 0;
		if (list) list.hidden = tracks.length === 0;

		matches.forEach((node, index) => {
			node.classList.toggle('active', index === currentIndex);
		});

		if (audio) {
			const ratio = audio.duration ? audio.currentTime / audio.duration : 0;
			if (progress) progress.style.width = `${Math.min(100, ratio * 100)}%`;
			if (bar) bar.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
			if (current) current.textContent = fmt(audio.currentTime);
			if (duration) duration.textContent = fmt(audio.duration);
		}
	}

	function tick() {
		const audio = audioEl();
		if (!audio || !audio.getAttribute('src')) return;
		const root = document.querySelector<HTMLElement>('[data-music]');
		if (!root) return;
		const progress = root.querySelector<HTMLElement>('[data-music-progress]');
		const bar = root.querySelector<HTMLElement>('[data-music-bar]');
		const current = root.querySelector<HTMLElement>('[data-music-current]');
		const duration = root.querySelector<HTMLElement>('[data-music-duration]');
		const ratio = audio.duration ? audio.currentTime / audio.duration : 0;
		if (progress) progress.style.width = `${Math.min(100, ratio * 100)}%`;
		if (bar) bar.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
		if (current) current.textContent = fmt(audio.currentTime);
		if (duration) duration.textContent = fmt(audio.duration);
	}

	function openPanel(open: boolean) {
		const panel = document.querySelector<HTMLElement>('[data-music-panel]');
		const toggle = document.querySelector<HTMLElement>('[data-music-toggle]');
		const root = document.querySelector<HTMLElement>('[data-music]');
		if (!panel || !toggle) return;

		toggle.setAttribute('aria-expanded', String(open));
		root?.classList.toggle('is-open', open);

		if (open) {
			// 固定定位：面板相对按钮定位（页头面板是 overflow:hidden，绝对定位会被裁剪）
			const rect = toggle.getBoundingClientRect();
			panel.style.top = `${rect.bottom + 14}px`;
			panel.style.right = `${Math.max(12, window.innerWidth - rect.right)}px`;
			panel.hidden = false;
			// 先渲染一帧再加类，入场过渡才会生效
			requestAnimationFrame(() => panel.classList.add('is-open'));
		} else {
			panel.classList.remove('is-open');
			window.setTimeout(() => {
				if (!panel.classList.contains('is-open')) panel.hidden = true;
			}, 240);
		}
	}

	function bind() {
		tracks = readTracks();
		const audio = audioEl();
		if (!audio) return;

		// 首次进入：如果之前播放过，恢复曲目（浏览器会拦住自动播放，只恢复位置）
		if (currentIndex < 0 && audio.getAttribute('src')) {
			const src = audio.getAttribute('src');
			const found = tracks.findIndex((track) => track.src === src);
			currentIndex = found >= 0 ? found : 0;
		}

		if (currentIndex < 0 && tracks.length) load(0, false);
		render();

		window.clearInterval(timer);
		timer = window.setInterval(tick, 500);
	}

	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;
		const root = document.querySelector<HTMLElement>('[data-music]');
		if (!root) return;

		if (target.closest('[data-music-toggle]')) {
			openPanel(!root.classList.contains('is-open'));
			return;
		}

		// 点击播放器外部时收起面板
		if (!target.closest('[data-music]') && root.classList.contains('is-open')) {
			openPanel(false);
		}

		const audio = audioEl();
		if (!audio) return;

		if (target.closest('[data-music-play]')) {
			if (!tracks.length) return;
			if (!audio.getAttribute('src')) load(0, true);
			else if (audio.paused) void audio.play().catch(() => {});
			else audio.pause();
			return;
		}

		if (target.closest('[data-music-prev]')) {
			next(-1);
			return;
		}

		if (target.closest('[data-music-next]')) {
			next(1);
			return;
		}

		const trackButton = target.closest<HTMLElement>('[data-music-track]');
		if (trackButton) {
			const index = Number(trackButton.dataset.musicTrack);
			load(index, true);
			return;
		}

		const bar = target.closest('[data-music-bar]');
		if (bar && audio.duration) {
			const rect = bar.getBoundingClientRect();
			const ratio = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
			audio.currentTime = ratio * audio.duration;
			tick();
		}
	});

	// 空格 / 方向键控制进度条（进度条可聚焦）
	document.addEventListener('keydown', (event) => {
		if ((event.target as HTMLElement)?.closest?.('[data-music-bar]')) {
			const audio = audioEl();
			if (!audio?.duration) return;
			if (event.key === 'ArrowRight') {
				audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
				tick();
				event.preventDefault();
			} else if (event.key === 'ArrowLeft') {
				audio.currentTime = Math.max(0, audio.currentTime - 5);
				tick();
				event.preventDefault();
			}
		}
		if (event.key === 'Escape') {
			const root = document.querySelector<HTMLElement>('[data-music]');
			if (root?.classList.contains('is-open')) openPanel(false);
		}
	});

	// 事件挂一次即可；播放器元素在页面切换时通过 transition:persist 保留
	document.addEventListener('play', (event) => {
		if ((event.target as HTMLElement).matches?.('[data-music-audio]')) {
			render();
			window.clearInterval(timer);
			timer = window.setInterval(tick, 500);
		}
	}, true);
	document.addEventListener('pause', (event) => {
		if ((event.target as HTMLElement).matches?.('[data-music-audio]')) render();
	}, true);
	document.addEventListener('ended', (event) => {
		if ((event.target as HTMLElement).matches?.('[data-music-audio]')) next(1);
	}, true);

	// 音频解码失败（格式不被浏览器支持、文件缺失等）时给出提示
	document.addEventListener('error', (event) => {
		if (!(event.target as HTMLElement).matches?.('[data-music-audio]')) return;
		const artist = document.querySelector<HTMLElement>('[data-music-artist]');
		if (artist) artist.textContent = '这个格式当前浏览器放不出来，建议换成 mp3';
	}, true);

	document.addEventListener('astro:page-load', bind);
	if (document.readyState !== 'loading') bind();
	else document.addEventListener('DOMContentLoaded', bind);

	// 记录最后播放状态，供页面刷新后恢复
	window.addEventListener('beforeunload', () => {
		const audio = audioEl();
		if (!audio?.getAttribute('src')) return;
		sessionStorage.setItem(
			MUSIC_STATE_KEY,
			JSON.stringify({ src: audio.getAttribute('src'), currentTime: audio.currentTime }),
		);
	});
</script>

<style>
	.music {
		position: relative;
		display: flex;
		align-items: center;
	}
	.music-btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		padding: 0;
		border-radius: 50%;
		border: 1px solid rgba(var(--line), 1);
		background: var(--chip-bg);
		color: rgb(var(--muted));
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			box-shadow var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out);
	}
	.music-btn:hover {
		color: rgb(var(--accent));
		border-color: rgba(var(--accent), 0.5);
		transform: translateY(-1px);
	}
	.music.is-open .music-btn {
		color: rgb(var(--accent));
		border-color: rgba(var(--accent), 0.55);
		box-shadow: 0 0 0 4px rgba(var(--accent), 0.1);
	}
	.icon-note {
		width: 15px;
		height: 15px;
	}
	/* 播放中：音符隐藏，显示跳动音柱 */
	.bars {
		display: none;
		align-items: flex-end;
		gap: 2px;
		height: 13px;
	}
	.bars i {
		width: 2px;
		border-radius: 1px;
		background: rgb(var(--accent));
		animation: bar 0.9s ease-in-out infinite;
	}
	.bars i:nth-child(1) {
		height: 6px;
		animation-delay: 0s;
	}
	.bars i:nth-child(2) {
		height: 11px;
		animation-delay: 0.22s;
	}
	.bars i:nth-child(3) {
		height: 8px;
		animation-delay: 0.44s;
	}
	.is-playing .icon-note {
		display: none;
	}
	.is-playing .bars {
		display: flex;
	}
	@keyframes bar {
		0%,
		100% {
			transform: scaleY(0.45);
		}
		50% {
			transform: scaleY(1);
		}
	}

	.music-panel {
		position: fixed;
		width: 268px;
		padding: 1rem 1.05rem 0.9rem;
		border-radius: var(--r-lg);
		box-shadow: var(--glass-shine), var(--shadow-lg);
		opacity: 0;
		transform: translate3d(0, -8px, 0) scale(0.97);
		transform-origin: top right;
		transition:
			opacity 0.22s var(--ease-out),
			transform 0.3s var(--ease-spring);
		z-index: 45;
	}
	.music-panel.is-open {
		opacity: 1;
		transform: none;
	}

	.np-kicker {
		display: block;
		font-size: 0.6rem;
		letter-spacing: 0.24em;
		color: rgb(var(--muted-light));
		margin-bottom: 0.25rem;
	}
	.np-title {
		margin: 0;
		font-size: 0.94rem;
		font-weight: 700;
		color: rgb(var(--ink));
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.np-artist {
		margin: 0.2em 0 0;
		font-size: 0.74rem;
		color: rgb(var(--muted-light));
		min-height: 1em;
	}

	.progress {
		position: relative;
		height: 5px;
		margin-top: 0.9em;
		border-radius: 999px;
		background: rgba(var(--line), 1);
		cursor: pointer;
	}
	.progress:focus-visible {
		outline: 2px solid rgba(var(--accent), 0.5);
		outline-offset: 3px;
	}
	.progress-fill {
		position: relative;
		display: block;
		height: 100%;
		width: 0;
		border-radius: 999px;
		background: linear-gradient(90deg, rgb(var(--accent)), rgb(var(--accent-2, 190, 120, 70)));
		transition: width 0.25s linear;
	}
	.progress-fill::after {
		content: '';
		position: absolute;
		right: -4px;
		top: 50%;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: rgb(var(--paper));
		border: 1.5px solid rgb(var(--accent));
		transform: translateY(-50%);
		opacity: 0;
		transition: opacity var(--dur-fast) var(--ease-out);
	}
	.music-panel:hover .progress-fill::after {
		opacity: 1;
	}
	.time {
		display: flex;
		justify-content: space-between;
		font-size: 0.68rem;
		color: rgb(var(--muted-light));
		font-variant-numeric: tabular-nums;
		margin-top: 0.4em;
	}
	.controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.9em;
		margin: 0.55em 0 0.25em;
	}
	.ctrl {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: none;
		background: transparent;
		color: rgb(var(--muted));
		cursor: pointer;
		padding: 0.3em;
		border-radius: 50%;
		line-height: 1;
		transition:
			color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out);
	}
	.ctrl:hover {
		color: rgb(var(--accent));
		background: var(--chip-bg-strong);
		transform: translateY(-1px);
	}
	.ctrl-main {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: rgb(var(--accent));
		color: rgb(var(--paper));
		box-shadow: 0 8px 18px -8px rgba(var(--accent), 0.7);
	}
	.ctrl-main:hover {
		background: rgb(var(--accent-deep));
		color: rgb(var(--paper));
		transform: translateY(-2px) scale(1.03);
	}
	.ctrl-main .icon-pause {
		display: none;
	}
	.ctrl-main.is-playing .icon-play {
		display: none;
	}
	.ctrl-main.is-playing .icon-pause {
		display: block;
	}

	.list {
		list-style: none;
		margin: 0.55em 0 0;
		padding: 0.55em 0 0;
		border-top: 1px solid rgba(var(--line), 1);
		max-height: 132px;
		overflow-y: auto;
	}
	.track {
		display: flex;
		align-items: baseline;
		gap: 0.6em;
		width: 100%;
		padding: 0.35em 0.45em;
		border: none;
		border-radius: 8px;
		background: transparent;
		color: rgb(var(--muted));
		cursor: pointer;
		text-align: left;
		font-size: 0.8rem;
		transition:
			background-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}
	.track:hover {
		background: rgba(var(--accent), 0.09);
		color: rgb(var(--ink));
	}
	.track.active {
		color: rgb(var(--accent-deep));
		font-weight: 600;
	}
	.track-index {
		font-size: 0.65rem;
		color: rgb(var(--muted-light));
		font-variant-numeric: tabular-nums;
	}
	.track-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.hint {
		margin: 0.6em 0 0;
		font-size: 0.75rem;
		color: rgb(var(--muted-light));
		line-height: 1.5;
	}
	.hint a {
		color: rgb(var(--accent));
	}

	@media (max-width: 720px) {
		.music-panel {
			top: auto !important;
			left: 1rem !important;
			right: 1rem !important;
			width: auto !important;
			transform-origin: bottom center;
			transform: translate3d(0, 12px, 0) scale(0.98);
		}
		.music-panel.is-open {
			transform: none;
		}
	}
</style>

