---
// 丝质流动波纹背景 · 纯 Canvas 2D，无第三方依赖；一页可放多个实例。
// 颜色支持主题变量写法（如 color="rgba(var(--accent), 0.55)"），脚本用计算样式解析。

interface Props {
	preset?: 'silk' | 'mesh' | 'flow'; // 横向长丝 / 交叉网格 / 碎短线
	color?: string; color2?: string; backgroundColor?: string;
	fade?: 'edges' | 'none'; interactive?: boolean;
	cursorSize?: number; cursorStrength?: number;
	density?: number; // 缺省 26 / 34 / 20
	speed?: number; className?: string;
}

const {
	preset = 'silk', color = 'rgba(150, 84, 52, 0.55)',
	color2 = 'rgba(176, 134, 68, 0.45)', backgroundColor = 'transparent',
	fade = 'edges', interactive = true, cursorSize = 50, cursorStrength = 0.6,
	density, speed = 1, className = '',
} = Astro.props;
---

<div
	class:list={['pw', className]} data-pw="1" data-preset={preset}
	data-color={color} data-color2={color2} data-fade={fade}
	data-interactive={interactive ? '1' : '0'} data-density={density}
	data-cursor-size={String(cursorSize)} data-cursor-strength={String(cursorStrength)}
	data-speed={String(speed)} style={`--pw-bg: ${backgroundColor}`}
	aria-hidden="true"
>
	<canvas class="pw-canvas"></canvas>
</div>

<style>
	.pw {
		position: absolute; inset: 0; z-index: 0; overflow: hidden;
		pointer-events: none; /* 画布不拦截点击，交互改挂 window 指针事件 */
		background: var(--pw-bg, transparent); /* 由 backgroundColor 写入 */
	}
	.pw-canvas { display: block; width: 100%; height: 100%; }
	/* 径向羽化：中心实、边缘淡，避免画布露出矩形硬边 */
	.pw[data-fade='edges'] {
		-webkit-mask-image: radial-gradient(120% 100% at 50% 45%, #000 55%, transparent 100%);
		mask-image: radial-gradient(120% 100% at 50% 45%, #000 55%, transparent 100%);
	}
</style>

<script>
	const DENSITY = { silk: 26, mesh: 34, flow: 20 };
	const NO_DASH = [], instances = [], seen = new WeakSet(); // seen：同一 canvas 只初始化一次
	let globalsBound = false, pointerBound = false, probe = null;
	// 借 span 的 color 解析颜色，兼容 rgba() 与 rgb(var(--accent)) 主题写法
	function resolveColor(host, raw) {
		if (!raw) return 'rgba(150, 84, 52, 0.55)';
		if (!probe) { probe = document.createElement('span'); probe.style.cssText = 'position:absolute;width:0;height:0'; }
		probe.style.color = raw;
		host.appendChild(probe);
		const out = getComputedStyle(probe).color;
		probe.remove();
		return out || raw;
	}
	// 每条线的位置/振幅/频率/相位/漂移都随机，叠出自然不重复的丝缕
	function buildStrands(w, h, cfg) {
		const n = cfg.density, unit = Math.min(w, h);
		const flow = cfg.preset === 'flow', mesh = cfg.preset === 'mesh';
		const verts = mesh ? Math.round(n * 0.4) : 0, out = [];
		for (let i = 0; i < n; i++) {
			const vertical = i >= n - verts; // mesh 里约 4 成线转纵向，与横线交叉
			const k = vertical ? (i - (n - verts) + 0.5) / verts : (i + 0.5) / (n - verts);
			const extent = vertical ? w : h;
			out.push({
				base: (0.06 + k * 0.88) * extent + (Math.random() - 0.5) * extent * 0.03,
				amp: unit * (flow ? 0.035 : 0.06) * (0.35 + Math.random()),
				freq: flow ? 2.2 + Math.random() * 2.4 : 0.7 + Math.random() * 1.7,
				phase: Math.random() * Math.PI * 2, drift: Math.random() * Math.PI * 2,
				width: flow ? 0.7 + Math.random() * 0.7 : 0.6 + Math.random() * 1.1,
				alpha: (mesh ? 0.12 : 0.16) + Math.random() * (mesh ? 0.1 : 0.12),
				vertical, speed: 0.55 + Math.random() * 0.9,
				len: flow ? 0.16 + Math.random() * 0.2 : 1,
				dash: flow ? [6 + Math.random() * 16, 14 + Math.random() * 26] : null,
			});
		}
		return out;
	}
	function makeGradient(ctx, w, h, c1, c2) {
		// 左主色 → 中次色 → 右主色，不同横向位置有冷暖温差
		const g = ctx.createLinearGradient(-w * 0.1, 0, w * 1.1, h * 0.6);
		g.addColorStop(0, c1); g.addColorStop(0.5, c2); g.addColorStop(1, c1);
		return g;
	}
	function draw(s) {
		const { ctx, w, h, strands, grad } = s;
		if (!grad) return;
		ctx.clearRect(0, 0, w, h);
		ctx.globalCompositeOperation = 'lighter'; // 叠加出丝光；颜色 alpha 已低，不会成霓虹
		ctx.lineCap = 'round';
		ctx.strokeStyle = grad;
		const t = s.time;
		for (let i = 0; i < strands.length; i++) {
			const st = strands[i];
			const seg = Math.max(8, Math.min(24, Math.round((st.vertical ? h : w) / 55))); // 每帧几百段
			const start = st.len < 1 ? ((t * 0.02 * st.speed + st.phase) % 1.3) - 0.15 : 0; // 流线沿 x 循环
			const ph = t * st.speed * 0.55 + st.phase;
			ctx.setLineDash(st.dash || NO_DASH);
			if (st.dash) ctx.lineDashOffset = -t * 24 * st.speed;
			ctx.globalAlpha = st.alpha;
			ctx.lineWidth = st.width;
			ctx.beginPath();
			for (let k = 0; k <= seg; k++) {
				const u = start + (k / seg) * st.len;
				// 主波 + 细波 + 整条慢漂移：三种频率叠加，去掉规则正弦的机械感
				const off = Math.sin(u * st.freq * 6.2832 + ph) * st.amp
					+ Math.sin(u * st.freq * 17 + st.drift - ph * 0.8) * st.amp * 0.35
					+ Math.sin(t * 0.3 + st.drift) * st.amp * 0.45;
				let x = st.vertical ? st.base + off : u * w;
				let y = st.vertical ? u * h : st.base + off;
				// 光标软涟漪：f² 衰减把附近曲线沿法线推开，再叠一点距离波纹
				if (s.infl > 0.002) {
					const dx = x - s.cx, dy = y - s.cy;
					const d = Math.sqrt(dx * dx + dy * dy);
					if (d < s.cursorSize) {
						const f = 1 - d / s.cursorSize;
						const push = f * f * s.infl * s.cursorStrength * s.cursorSize * 0.55
							+ Math.sin(d * 0.22 - t * 2.4) * f * s.infl * 2;
						if (st.vertical) x += (dx < 0 ? -1 : 1) * push;
						else y += (dy < 0 ? -1 : 1) * push;
					}
				}
				if (k) ctx.lineTo(x, y); else ctx.moveTo(x, y);
			}
			ctx.stroke();
		}
		ctx.setLineDash(NO_DASH);
		ctx.globalAlpha = 1;
	}
	function resize(s) {
		const w = s.el.clientWidth || 1, h = s.el.clientHeight || 1;
		const dpr = Math.min(window.devicePixelRatio || 1, 2); // 最高 2x，兼顾清晰与开销
		if (w === s.w && h === s.h && dpr === s.dpr) return;
		s.w = w; s.h = h; s.dpr = dpr;
		s.canvas.width = Math.max(1, Math.round(w * dpr));
		s.canvas.height = Math.max(1, Math.round(h * dpr));
		s.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		s.strands = buildStrands(w, h, s);
		s.grad = makeGradient(s.ctx, w, h, s.color, s.color2);
		if (s.reduced) draw(s); // 减少动态：尺寸变化只重画静态帧
	}
	function sync(s) {
		const run = !s.reduced && s.onScreen && !document.hidden;
		if (run === !!s.raf) return;
		if (run) { s.prev = performance.now(); s.raf = requestAnimationFrame(s.tick); }
		else { cancelAnimationFrame(s.raf); s.raf = 0; }
	}
	function frame(s, now) {
		if (!s.onScreen || document.hidden || s.reduced) { s.raf = 0; return; }
		const dt = Math.min(now - s.prev, 50); // 夹紧：切回标签页不会因超大间隔瞬移
		s.prev = now;
		s.time += dt * 0.001 * s.speed;
		// 光标位置与强度指数平滑（约 0.08/帧），涟漪不会硬跳
		s.cx += (s.tx - s.cx) * 0.08; s.cy += (s.ty - s.cy) * 0.08;
		s.infl += (s.targetInfl - s.infl) * 0.08;
		draw(s);
		s.raf = requestAnimationFrame(s.tick);
	}
	function destroy(s) {
		s.ro?.disconnect(); s.io?.disconnect();
		if (s.raf) cancelAnimationFrame(s.raf);
		s.raf = 0;
		const i = instances.indexOf(s);
		if (i >= 0) instances.splice(i, 1);
	}
	function bindGlobals() {
		if (!globalsBound) {
			globalsBound = true;
			document.addEventListener('visibilitychange', () => { for (const s of instances) sync(s); });
		}
		// 减少动态 / 全部关闭交互时不注册指针监听
		if (pointerBound || !instances.some((s) => s.interactive)) return;
		pointerBound = true;
		// canvas 是 pointer-events:none，只能挂 window 才能感知悬停
		window.addEventListener('pointermove', (e) => {
			for (const s of instances) {
				if (!s.interactive) continue;
				const r = s.el.getBoundingClientRect();
				const x = e.clientX - r.left, y = e.clientY - r.top;
				if (s.targetInfl === 0) { s.cx = x; s.cy = y; } // 首次进入直接吸附
				s.tx = x; s.ty = y; s.targetInfl = 1;
			}
		}, { passive: true });
		document.addEventListener('pointerleave', () => { for (const s of instances) s.targetInfl = 0; });
	}
	function init() {
		// 先清掉被 View Transitions 换页移除的旧实例，避免观察器与 rAF 泄漏
		for (let i = instances.length - 1; i >= 0; i--) if (!instances[i].el.isConnected) destroy(instances[i]);
		document.querySelectorAll('[data-pw]').forEach((el) => {
			const canvas = el.querySelector('canvas');
			if (!canvas || seen.has(canvas)) return;
			const ctx = canvas.getContext('2d');
			if (!ctx) return;
			seen.add(canvas);
			const preset = ['silk', 'mesh', 'flow'].includes(el.dataset.preset) ? el.dataset.preset : 'silk';
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const s = {
				el, canvas, ctx, preset, reduced,
				density: Number(el.dataset.density) || DENSITY[preset],
				color: resolveColor(el, el.dataset.color), color2: resolveColor(el, el.dataset.color2),
				interactive: !reduced && el.dataset.interactive === '1',
				cursorSize: Number(el.dataset.cursorSize) || 50, cursorStrength: Number(el.dataset.cursorStrength) || 0.6,
				speed: Number(el.dataset.speed) || 1,
				w: 0, h: 0, dpr: 0, strands: [], grad: null, time: 2 + Math.random() * 8,
				raf: 0, prev: 0, onScreen: false, cx: -1e5, cy: -1e5, tx: -1e5, ty: -1e5,
				infl: 0, targetInfl: 0, ro: null, io: null, tick: null,
			};
			s.tick = (now) => frame(s, now);
			instances.push(s);
			resize(s);
			draw(s); // 先画一帧，避免等 IntersectionObserver 回调时空白
			s.ro = new ResizeObserver(() => resize(s));
			s.ro.observe(el);
			if (!reduced) {
				s.io = new IntersectionObserver((entries) => { s.onScreen = entries[0].isIntersecting; sync(s); });
				s.io.observe(el);
			}
		});
		bindGlobals();
	}
	document.addEventListener('astro:page-load', init);
	if (document.readyState !== 'loading') init();
	else document.addEventListener('DOMContentLoaded', init, { once: true });
</script>
