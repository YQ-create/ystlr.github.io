---
/**
 * ShapeWaves — 图形波浪场背景（React Bits「Shape Waves」原生移植，无 React，依赖 vgpu/WebGPU）。
 *
 * 一片三角形/圆形/方形组成的图形场，随滚动波浪变亮变大；指针划过注入涟漪，intro 扩散揭示。
 * 渲染逻辑在 src/scripts/shape-waves.ts；浏览器不支持 WebGPU 时画布留空，由上层 CSS 兜底。
 * 配色自动跟随站点主题 + 调色盘（脚本从 --bg-deep / --muted / --accent 解析，切换时热更新）。
 */
interface Props {
	text?: string;
	shapes?: 'mixed' | 'squares' | 'circles' | 'triangles';
	cellSize?: number;
	dotSize?: number;
	color?: string;
	hoverColor?: string;
	backgroundColor?: string;
	speed?: number;
	scale?: number;
	contrast?: number;
	brightness?: number;
	flow?: number;
	direction?: number;
	fade?: number;
	interactive?: boolean;
	splashRadius?: number;
	splashStrength?: number;
	glow?: number;
	intro?: boolean;
	introDuration?: number;
	paused?: boolean;
	class?: string;
}

const { class: className = '', ...rest } = Astro.props;
const cfg = JSON.stringify(rest);
---

<div class:list={['shape-waves', className]} data-shape-waves data-cfg={cfg} aria-hidden="true"></div>

<style>
	.shape-waves {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		pointer-events: none;
		isolation: isolate;
	}
	.shape-waves :global(.shape-waves__canvas) {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}
	.shape-waves[data-ready='true'] :global(.shape-waves__canvas) {
		opacity: 1;
	}
	@media (prefers-reduced-motion: reduce) {
		.shape-waves :global(.shape-waves__canvas) {
			transition: none;
		}
	}
</style>

<script>
	import { bootShapeWaves } from '../scripts/shape-waves';

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootShapeWaves, { once: true });
	else bootShapeWaves();
	document.addEventListener('astro:page-load', bootShapeWaves);
</script>
