---
/**
 * 站内搜索浮层：Cmd/Ctrl+K 或页头按钮唤出，检索文章 / 知识库 / 照片标题。
 * 索引在构建期生成（/search-index.json），首次打开时才 fetch，不占首屏。
 * 纯静态实现，无后端。
 */
---

<div class="ss" data-ss hidden>
	<div class="ss__scrim" data-ss-close></div>
	<div class="ss__panel" role="dialog" aria-modal="true" aria-label="站内搜索">
		<div class="ss__bar">
			<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
				<path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm4-1.5 3 3"></path>
			</svg>
			<input
				type="search"
				data-ss-input
				placeholder="搜索文章、知识库、照片…"
				aria-label="站内搜索"
				autocomplete="off"
				spellcheck="false"
			/>
			<button class="ss__esc" type="button" data-ss-close aria-label="关闭搜索">ESC</button>
		</div>

		<div class="ss__body" data-ss-body>
			<p class="ss__hint">输入关键词开始 —— 标题、摘要、标签都会被检索。</p>
		</div>

		<div class="ss__foot">
			<span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
			<span><kbd>Enter</kbd> 打开</span>
			<span><kbd>Esc</kbd> 关闭</span>
		</div>
	</div>
</div>

<style>
	.ss {
		position: fixed;
		inset: 0;
		z-index: 300;
		display: grid;
		place-items: start center;
		padding: clamp(4.5rem, 12vh, 9rem) 1rem 2rem;
	}
	.ss[hidden] {
		display: none;
	}
	.ss__scrim {
		position: absolute;
		inset: 0;
		background: rgba(6, 6, 7, 0.72);
		animation: ss-fade 0.18s ease-out;
	}
	:global(html[data-theme='light']) .ss__scrim {
		background: rgba(120, 112, 100, 0.32);
	}
	.ss__panel {
		position: relative;
		width: min(100%, 640px);
		max-height: min(70vh, 560px);
		display: flex;
		flex-direction: column;
		border: 1px solid rgb(var(--line));
		border-radius: 14px;
		background: rgb(var(--paper));
		box-shadow: 0 32px 80px -40px rgba(0, 0, 0, 0.85);
		overflow: hidden;
		animation: ss-rise 0.22s var(--ease-out);
	}
	@keyframes ss-fade {
		from {
			opacity: 0;
		}
	}
	@keyframes ss-rise {
		from {
			opacity: 0;
			transform: translateY(-8px);
		}
	}

	.ss__bar {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0 0.9rem 0 1rem;
		border-bottom: 1px solid rgb(var(--line-soft));
		color: rgb(var(--muted));
	}
	.ss__bar input {
		flex: 1;
		min-width: 0;
		height: 54px;
		border: 0;
		background: none;
		color: rgb(var(--ink));
		font: inherit;
		font-size: 0.98rem;
		outline: none;
	}
	.ss__bar input::placeholder {
		color: rgb(var(--muted-light));
	}
	.ss__bar input::-webkit-search-cancel-button {
		display: none;
	}
	.ss__esc {
		flex: none;
		padding: 0.2rem 0.4rem;
		border: 1px solid rgb(var(--line));
		border-radius: 5px;
		background: none;
		color: rgb(var(--muted-light));
		font: inherit;
		font-size: 0.66rem;
		letter-spacing: 0.06em;
		cursor: pointer;
	}

	.ss__body {
		flex: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.4rem 0;
	}
	:global(.ss__hint,
	.ss__empty) {
		margin: 0;
		padding: 1.6rem 1rem;
		font-size: 0.85rem;
		color: rgb(var(--muted));
		text-align: center;
	}
	:global(.ss__group) {
		padding: 0.55rem 1rem 0.25rem;
		font-size: 0.64rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgb(var(--muted-light));
	}
	:global(.ss__item) {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.15rem 1rem;
		padding: 0.62rem 1rem;
		text-decoration: none;
		color: rgb(var(--ink-soft));
		border-left: 2px solid transparent;
	}
	:global(.ss__item:hover),
	:global(.ss__item.is-active) {
		background: rgba(var(--ink), 0.05);
		border-left-color: rgb(var(--accent));
		color: rgb(var(--ink));
	}
	:global(.ss__title) {
		font-size: 0.92rem;
		line-height: 1.4;
	}
	:global(.ss__title mark) {
		background: none;
		color: rgb(var(--accent));
		font-weight: 600;
	}
	:global(.ss__meta) {
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		color: rgb(var(--muted-light));
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	:global(.ss__desc) {
		grid-column: 1 / -1;
		font-size: 0.78rem;
		line-height: 1.5;
		color: rgb(var(--muted));
		overflow: hidden;
		display: -webkit-box;
		-webkit-line-clamp: 1;
		line-clamp: 1;
		-webkit-box-orient: vertical;
	}

	.ss__foot {
		display: flex;
		gap: 1rem;
		padding: 0.5rem 1rem;
		border-top: 1px solid rgb(var(--line-soft));
		font-size: 0.68rem;
		color: rgb(var(--muted-light));
	}
	.ss__foot kbd {
		font-family: inherit;
		font-size: 0.66rem;
		padding: 0 0.28rem;
		border: 1px solid rgb(var(--line));
		border-radius: 4px;
		margin-right: 0.15rem;
	}
</style>

<script>
	type Item = {
		type: 'article' | 'note' | 'photo';
		title: string;
		desc: string;
		body: string;
		tags: string[];
		date: string;
		category?: string;
		url: string;
	};

	const LABEL: Record<Item['type'], string> = { article: '文章', note: '知识库', photo: '照片' };

	let cache: Item[] | null = null;
	let loading: Promise<Item[]> | null = null;
	let active = -1;
	let lastFocus: HTMLElement | null = null;

	const load = () => {
		if (cache) return Promise.resolve(cache);
		loading ??= fetch('/api/search.json')
			.then((r) => (r.ok ? r.json() : { items: [] }))
			.then((data: { items?: Item[] }) => (cache = data.items ?? []))
			.catch(() => (cache = []));
		return loading;
	};

	const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

	/** 命中越靠前分越高；多个关键词要求全部命中 */
	const score = (item: Item, terms: string[]) => {
		const title = item.title.toLowerCase();
		const tags = item.tags.join(' ').toLowerCase();
		const rest = `${item.desc} ${item.body} ${item.category ?? ''}`.toLowerCase();
		let total = 0;
		for (const t of terms) {
			if (title.includes(t)) total += 100 - Math.min(40, title.indexOf(t));
			else if (tags.includes(t)) total += 45;
			else if (rest.includes(t)) total += 20;
			else return 0;
		}
		return total;
	};

	function render(list: Item[], terms: string[]) {
		const body = document.querySelector<HTMLElement>('[data-ss-body]');
		if (!body) return;
		if (list.length === 0) {
			body.innerHTML = `<p class="ss__empty">没有找到「${esc(terms.join(' '))}」相关的内容。</p>`;
			return;
		}
		const groups: { type: Item['type']; items: Item[] }[] = [];
		for (const type of ['article', 'note', 'photo'] as const) {
			const group = list.filter((i) => i.type === type).slice(0, type === 'photo' ? 4 : 8);
			if (group.length) groups.push({ type, items: group });
		}
		let n = 0;
		body.innerHTML = groups
			.map(
				(g) => `
				<p class="ss__group">${LABEL[g.type]} · ${g.items.length}</p>
				${g.items
					.map((item) => {
						const idx = n++;
						const title = esc(item.title).replace(
							new RegExp(`(${terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi'),
							'<mark>$1</mark>',
						);
						return `<a class="ss__item" href="${item.url}" data-ss-item="${idx}">
							<span class="ss__title">${title}</span>
							<span class="ss__meta">${item.date}${item.type === 'note' && item.category ? ` · ${esc(item.category)}` : ''}</span>
							${item.desc || item.body ? `<span class="ss__desc">${esc(item.desc || item.body)}</span>` : ''}
						</a>`;
					})
					.join('')}`,
			)
			.join('');
		active = -1;
		// 默认高亮第一条，Enter 直接可用
		if (list.length) setActive(0);
	}

	function setActive(next: number) {
		const items = Array.from(document.querySelectorAll<HTMLElement>('[data-ss-item]'));
		if (!items.length) return;
		active = (next + items.length) % items.length;
		items.forEach((el, i) => el.classList.toggle('is-active', i === active));
		items[active].scrollIntoView({ block: 'nearest' });
	}

	function open() {
		const root = document.querySelector<HTMLElement>('[data-ss]');
		if (!root) return;
		lastFocus = document.activeElement as HTMLElement | null;
		root.hidden = false;
		document.documentElement.style.overflow = 'hidden';
		const input = root.querySelector<HTMLInputElement>('[data-ss-input]');
		input?.focus();
		void load();
	}

	function close() {
		const root = document.querySelector<HTMLElement>('[data-ss]');
		if (!root || root.hidden) return;
		root.hidden = true;
		document.documentElement.style.overflow = '';
		lastFocus?.focus?.();
	}

	function init() {
		const root = document.querySelector<HTMLElement>('[data-ss]');
		if (!root || root.dataset.ready === '1') return;
		root.dataset.ready = '1';

		const input = root.querySelector<HTMLInputElement>('[data-ss-input]');
		root.querySelectorAll('[data-ss-close]').forEach((el) => el.addEventListener('click', close));

		// 顶部按钮 / 快捷键
		document.addEventListener('click', (e) => {
			const trigger = (e.target as HTMLElement)?.closest('[data-search-open]');
			if (trigger) {
				e.preventDefault();
				open();
			}
		});
		document.addEventListener('keydown', (e) => {
			const isK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
			if (isK) {
				e.preventDefault();
				root.hidden ? open() : close();
				return;
			}
			if (root.hidden) return;
			if (e.key === 'Escape') {
				e.preventDefault();
				close();
			} else if (e.key === 'ArrowDown') {
				e.preventDefault();
				setActive(active + 1);
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				setActive(active - 1);
			} else if (e.key === 'Enter') {
				const el = document.querySelector<HTMLAnchorElement>('[data-ss-item].is-active') ?? document.querySelector<HTMLAnchorElement>('[data-ss-item]');
				if (el) {
					e.preventDefault();
					location.href = el.href;
				}
			}
		});

		let timer = 0;
		input?.addEventListener('input', () => {
			window.clearTimeout(timer);
			const q = input.value.trim().toLowerCase();
			timer = window.setTimeout(async () => {
				const body = root.querySelector<HTMLElement>('[data-ss-body]');
				if (!q) {
					if (body) body.innerHTML = '<p class="ss__hint">输入关键词开始 —— 标题、摘要、标签都会被检索。</p>';
					return;
				}
				const items = await load();
				const terms = q.split(/\s+/).filter(Boolean);
				const hits = items
					.map((item) => ({ item, s: score(item, terms) }))
					.filter((x) => x.s > 0)
					.sort((a, b) => b.s - a.s)
					.map((x) => x.item);
				render(hits, terms);
			}, 110);
		});
	}

	init();
	document.addEventListener('astro:page-load', init);
</script>
