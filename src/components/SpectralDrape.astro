---
/**
 * SpectralDrape — 首页 Hero 的「光点织物」背景（Spectral Drape 的原生实现）
 *
 * 一块由光点组成的布，从地平线一直铺到画面底部，按透视收束；
 * 布面被几条慢波推起褶皱，光从褶皱的脊上掠过，所以脊线更亮更大。
 * 指针靠近时布会被顶起一个包。纯 Canvas 2D，无第三方依赖。
 *
 * 组件只声明 data-* 配置，逻辑在同名 <script> 里。
 */
interface Props {
	/** 横向列数，16–76，越大越细腻也越吃性能 */
	density?: number;
	/** 纵深行数，10–48 */
	rows?: number;
	/** 配色预设：ember = 赭石琥珀暖谱，spectral = 全光谱，ice = 冷青 */
	preset?: 'ember' | 'spectral' | 'ice';
	/** 起伏速度，0 = 静止 */
	speed?: number;
	/** 褶皱高度，1 = 默认 */
	amp?: number;
	/** 单个光点的基准半径（CSS 像素） */
	dotSize?: number;
	/** 整体不透明度 */
	opacity?: number;
	/** 是否响应指针 */
	pointer?: boolean;
	/** 指针顶起的强度 */
	pointerStrength?: number;
	class?: string;
}

const {
	density = 104,
	rows = 40,
	preset = 'ember',
	speed = 0.9,
	amp = 1,
	dotSize = 1.6,
	opacity = 0.9,
	pointer = true,
	pointerStrength = 1,
	class: className = '',
} = Astro.props;
---

<div
	class:list={['drape', className]}
	data-drape
	data-preset={preset}
	data-density={density}
	data-rows={rows}
	data-speed={speed}
	data-amp={amp}
	data-dot={dotSize}
	data-opacity={opacity}
	data-pointer={pointer ? '1' : '0'}
	data-pointer-strength={pointerStrength}
	aria-hidden="true"
>
	<canvas class="drape__canvas" data-drape-canvas></canvas>
</div>

<style>
	.drape {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		/* 重心压在右下方，左侧标题区留干净；四周柔化避免硬边 */
		-webkit-mask-image: radial-gradient(
			88% 104% at 80% 60%,
			#000 0%,
			rgba(0, 0, 0, 0.8) 30%,
			rgba(0, 0, 0, 0.3) 56%,
			transparent 80%
		);
		mask-image: radial-gradient(
			88% 104% at 80% 60%,
			#000 0%,
			rgba(0, 0, 0, 0.8) 30%,
			rgba(0, 0, 0, 0.3) 56%,
			transparent 80%
		);
	}

	.drape__canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	type Palette = { h: number; range: number; s: number; l0: number; l1: number };

	const PALETTES: Record<string, Palette> = {
		// 赭石 → 琥珀的暖谱，和站点暖纸底色同一支
		ember: { h: 12, range: 40, s: 62, l0: 22, l1: 46 },
		// 全光谱，颜色随布面位置缓慢推移
		spectral: { h: 0, range: 360, s: 66, l0: 28, l1: 52 },
		ice: { h: 172, range: 76, s: 58, l0: 24, l1: 48 },
	};

	const HUE_STEPS = 40;
	const LIGHT_STEPS = 6;

	/** 量化色阶表，避免每帧给上千个点拼 hsl 字符串 */
	function buildColorTable(p: Palette, alpha: number) {
		const table: string[][] = [];
		for (let hi = 0; hi < HUE_STEPS; hi++) {
			const h = p.h + (p.range * hi) / HUE_STEPS;
			const row: string[] = [];
			for (let li = 0; li < LIGHT_STEPS; li++) {
				const l = p.l0 + ((p.l1 - p.l0) * li) / (LIGHT_STEPS - 1);
				row.push(`hsla(${h.toFixed(0)} ${p.s}% ${l.toFixed(0)}% / ${alpha})`);
			}
			table.push(row);
		}
		return table;
	}

	const reducedMotion = () =>
		window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function clamp(v: number, min: number, max: number) {
		return v < min ? min : v > max ? max : v;
	}

	/** 与 GLSL smoothstep 等价 */
	function smooth(edge0: number, edge1: number, v: number) {
		const x = clamp((v - edge0) / (edge1 - edge0), 0, 1);
		return x * x * (3 - 2 * x);
	}

	function setup(root: HTMLElement) {
		if (root.dataset.drapeReady === '1') return;
		const canvas = root.querySelector<HTMLCanvasElement>('[data-drape-canvas]');
		const ctx = canvas?.getContext('2d');
		if (!canvas || !ctx) return;
		root.dataset.drapeReady = '1';

		const cfg = root.dataset;
		const cols = clamp(Math.round(Number(cfg.density) || 58), 16, 76);
		const rowCount = clamp(Math.round(Number(cfg.rows) || 34), 10, 48);
		const palette = PALETTES[cfg.preset ?? 'ember'] ?? PALETTES.ember;
		const speed = Math.max(0, Number(cfg.speed) || 0);
		const amp = Number(cfg.amp) || 1;
		const dotSize = Number(cfg.dot) || 1.9;
		const baseAlpha = clamp(Number(cfg.opacity) ?? 0.9, 0, 1);
		const wantsPointer = cfg.pointer === '1';
		const pointerStrength = Number(cfg.pointerStrength) || 1;

		let w = 0;
		let colsEff = cols;
		let rowsEff = rowCount;
		let h = 0;
		let horizon = 0;
		let focal = 1;
		let cx = 0;
		let colorTable: string[][] = [];

		// 摄像机离布面的高度（布面 y=0，机位 y=CAM_H）
		const CAM_H = 0.92;
		const D_NEAR = 1.0;
		const D_FAR = 7.0;

		let t = 0;
		let raf = 0;
		let last = 0;
		let inView = false;

		// 指针位置（布面横向 u / 纵深 d），带缓动
		const pointer = { x: 0, d: 0.9, tx: 0, td: 0.9, active: false };

		const schedule = () => {
			if (raf || !inView) return;
			last = performance.now();
			raf = requestAnimationFrame(frame);
		};

		function resize() {
			const rect = root.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			w = Math.max(1, rect.width);
			h = Math.max(1, rect.height);
			canvas!.width = Math.round(w * dpr);
			canvas!.height = Math.round(h * dpr);
			ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

			// 手机上把点阵收一半，省一半绘制量，视觉上也不会太密
			const mobile = w < 640;
			colsEff = mobile ? Math.round(cols * 0.62) : cols;
			rowsEff = mobile ? Math.round(rowCount * 0.75) : rowCount;
			horizon = h * (mobile ? 0.34 : 0.28);
			focal = Math.min(w * 0.78, h * 1.35);
			cx = w * 0.5;
			colorTable = buildColorTable(palette, baseAlpha);
			draw(0);
		}

		function frame(now: number) {
			const dt = Math.min(48, now - last) / 1000;
			last = now;
			t += dt * speed;
			draw(dt);
			raf = requestAnimationFrame(frame);
		}

		/** 布面在 (u, d) 处的高度：三条慢波叠出的褶皱 + 指针顶包 */
		function heightAt(u: number, d: number, tPtr: number) {
			let z =
				amp *
				(0.62 * Math.sin(u * 1.9 + d * 0.85 + t * 0.62) +
					0.5 * Math.sin(d * 1.55 - t * 0.5) +
					0.34 * Math.cos(u * 1.15 - d * 1.15 + t * 0.42));

			if (pointer.active) {
				const du = u - pointer.x;
				const dd = d - pointer.d;
				z += tPtr * 0.55 * Math.exp(-(du * du * 1.1 + dd * dd * 1.6) / 0.16);
			}
			return z;
		}

		function draw(dt: number) {
			const c = ctx!;
			c.clearRect(0, 0, w, h);

			pointer.x += (pointer.tx - pointer.x) * Math.min(1, dt * 7);
			pointer.d += (pointer.td - pointer.d) * Math.min(1, dt * 7);
			const tPtr = pointer.active ? pointerStrength : 0;

			// 中景的透视缩放，用来把屏幕上的点距拉匀：近处多补点、远处少补点
			const refPersp = focal / ((D_NEAR + D_FAR) * 0.5);

			for (let j = 0; j < rowsEff; j++) {
				// 纵深非线性分布：远处的行挤在一起，画面才有退深感
				const q = j / (rowsEff - 1);
				const d = D_NEAR + Math.pow(q, 1.75) * (D_FAR - D_NEAR);
				const persp = focal / d;
				const rowCols = clamp(
					Math.round(colsEff * clamp(persp / refPersp, 0.4, 4)),
					8,
					220
				);

				for (let i = 0; i < rowCols; i++) {
					const u = (i / (rowCols - 1) - 0.5) * 3.6 + Math.sin(j * 2.399 + i * 0.7) * 0.012;

					const z = heightAt(u, d, tPtr);

					const sx = cx + u * persp;
					const sy = horizon + (CAM_H - z * 0.42) * persp;

					if (sx < -6 || sx > w + 6 || sy < -6 || sy > h + 6) continue;

					// 布面边缘渐隐
					const edge =
						(1 - smooth(1.35, 1.8, Math.abs(u))) *
						(1 - smooth(D_FAR * 0.82, D_FAR, d)) *
						smooth(D_NEAR, D_NEAR + 0.45, d);
					if (edge <= 0.004) continue;

					// 褶皱脊线更亮更大
					const glow = clamp(0.5 + z * 0.85, 0.05, 1);

					const hi = Math.min(
						HUE_STEPS - 1,
						Math.max(
							0,
							Math.round(
								(0.5 + 0.5 * Math.sin(u * 0.7 + d * 0.5 + t * 0.18)) *
									(HUE_STEPS - 1)
							)
						)
					);
					const li = Math.min(
						LIGHT_STEPS - 1,
						Math.max(0, Math.round(glow * (LIGHT_STEPS - 1)))
					);

					const r = Math.max(
						0.35,
						dotSize * Math.min(persp, 2.4) * 0.5 * (0.7 + 0.6 * glow)
					);

					c.globalAlpha = edge * baseAlpha * (0.55 + 0.45 * glow);
					c.fillStyle = colorTable[hi][li];
					c.beginPath();
					c.arc(sx, sy, r, 0, Math.PI * 2);
					c.fill();
				}
			}
			c.globalAlpha = 1;
		}

		// 指针 → 布面坐标（近似反投影：屏幕越靠下，离镜头越近）
		const onPointerMove = (e: PointerEvent) => {
			if (!wantsPointer) return;
			const rect = root.getBoundingClientRect();
			const nx = (e.clientX - rect.left) / rect.width - 0.5;
			const ny = (e.clientY - rect.top) / rect.height;
			if (Math.abs(nx) > 0.62 || ny < -0.05 || ny > 1.05) {
				pointer.active = false;
				return;
			}
			pointer.active = true;
			pointer.tx = nx * 4.2;
			const drop = Math.max(0.08, ny - horizon / h);
			pointer.td = clamp(CAM_H / drop, D_NEAR + 0.2, D_FAR * 0.8);
			schedule();
		};

		const onPointerLeave = () => {
			pointer.active = false;
			schedule();
		};

		const io = new IntersectionObserver(
			(entries) => {
				inView = entries.some((entry) => entry.isIntersecting);
				if (inView) schedule();
				else if (raf) {
					cancelAnimationFrame(raf);
					raf = 0;
				}
			},
			{ rootMargin: '120px' }
		);

		const ro = new ResizeObserver(() => resize());
		ro.observe(root);

		const onVisibility = () => {
			if (document.hidden) {
				if (raf) {
					cancelAnimationFrame(raf);
					raf = 0;
				}
			} else if (inView) {
				schedule();
			}
		};

		const ac = new AbortController();
		window.addEventListener('pointermove', onPointerMove, {
			passive: true,
			signal: ac.signal,
		});
		window.addEventListener('pointerleave', onPointerLeave, { signal: ac.signal });
		document.addEventListener('visibilitychange', onVisibility, {
			signal: ac.signal,
		});
		document.addEventListener('astro:before-swap', () => ac.abort(), {
			once: true,
		});

		io.observe(root);
		resize();

		if (speed > 0 && !reducedMotion()) {
			inView = true;
			schedule();
		}
	}

	function boot() {
		document
			.querySelectorAll<HTMLElement>('[data-drape]')
			.forEach((root) => setup(root));
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', boot, { once: true });
	} else {
		boot();
	}
	document.addEventListener('astro:page-load', boot);
</script>






