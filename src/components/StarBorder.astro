---
// StarBorder：按钮边框上绕行的星轨光点（Canvas2D，原生移植 React Bits 版本，无 React）
// 沿按钮内描边路径匀速绕行，带拖尾 + 光晕 + 可选火花；hover 可以补一圈（lap）、
// 整体提亮（brighten）、或平时隐藏只在 hover 出现（reveal）；点击从落点向两侧各跑半个周长。
//
// 性能：只在按钮进入视口时跑 rAF；prefers-reduced-motion 下不巡航，只留一颗静止的星。
interface Props {
	as?: 'button' | 'a';
	href?: string;
	type?: 'button' | 'submit';
	class?: string;
	/** 星轨亮部颜色，可传 CSS 变量名（如 --accent）或任意 CSS 颜色 */
	color?: string;
	trailColor?: string;
	/** 绕一圈的秒数 */
	duration?: number;
	thickness?: number;
	radius?: number;
	/** 尾巴长度占一圈的比例，0~1 */
	trailLength?: number;
	/** 同时存在几颗星，1~6 */
	stars?: number;
	glow?: number;
	sparkle?: boolean;
	direction?: 'clockwise' | 'counterclockwise';
	hover?: 'lap' | 'brighten' | 'reveal' | 'none';
	clickPulse?: boolean;
	/** light 用于浅色按钮（不会用 lighter 混合把底色冲爆）；auto 按按钮底色亮度自选 */
	theme?: 'dark' | 'light' | 'auto';
	surface?: string;
	text?: string;
	track?: string;
	ariaLabel?: string;
	title?: string;
}

const {
	as = 'button',
	href,
	type = 'button',
	class: className = '',
	color = '--accent',
	trailColor,
	duration = 4.4,
	thickness = 1,
	radius = 8,
	trailLength = 0.3,
	stars = 1,
	glow = 0.75,
	sparkle = true,
	direction = 'clockwise',
	hover = 'lap',
	clickPulse = true,
	theme = 'auto',
	surface = 'rgb(var(--btn-solid))',
	text = 'rgb(var(--btn-solid-ink))',
	track = 'rgba(var(--btn-solid-ink), 0.16)',
	ariaLabel,
	title,
} = Astro.props;

const style = `--sb-radius:${radius}px;--sb-thickness:${thickness}px;--sb-surface:${surface};--sb-text:${text};--sb-track:${track}`;
const shared = {
	'data-sb': '',
	'data-color': color,
	'data-trail-color': trailColor ?? '',
	'data-duration': String(duration),
	'data-thickness': String(thickness),
	'data-radius': String(radius),
	'data-trail-length': String(trailLength),
	'data-stars': String(stars),
	'data-glow': String(glow),
	'data-hover': hover,
	'data-theme': theme,
	'data-direction': direction,
	'data-sparkle': sparkle ? '' : undefined,
	'data-click-pulse': clickPulse ? '' : undefined,
};
---

{
	as === 'a' ? (
		<a class:list={['star-border', className]} href={href} aria-label={ariaLabel} title={title} style={style} {...shared}>
			<canvas class="star-border__light" data-sb-canvas aria-hidden="true" />
			<slot />
		</a>
	) : (
		<button
			class:list={['star-border', className]}
			type={type}
			aria-label={ariaLabel}
			title={title}
			style={style}
			{...shared}
		>
			<canvas class="star-border__light" data-sb-canvas aria-hidden="true" />
			<slot />
		</button>
	)
}

<style>
	.star-border {
		position: relative;
		isolation: isolate;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0.9rem 1.4rem;
		border: 0;
		border-radius: var(--sb-radius, 8px);
		background: var(--sb-surface);
		color: var(--sb-text);
		font: inherit;
		font-size: 0.9rem;
		font-weight: 500;
		line-height: 1.2;
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
		transition:
			transform 0.3s cubic-bezier(0.22, 0.7, 0.2, 1),
			opacity 0.3s cubic-bezier(0.22, 0.7, 0.2, 1);
	}
	.star-border::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		box-shadow: inset 0 0 0 var(--sb-thickness, 1px) var(--sb-track);
		pointer-events: none;
	}
	.star-border__light {
		position: absolute;
		top: -48px;
		left: -48px;
		z-index: -1;
		width: calc(100% + 96px);
		height: calc(100% + 96px);
		pointer-events: none;
	}
	button.star-border,
	a.star-border {
		cursor: pointer;
	}
	.star-border:hover {
		transform: translateY(-2px);
	}
	.star-border:focus-visible {
		outline: 2px solid var(--sb-track);
		outline-offset: 3px;
	}
	.star-border:disabled {
		cursor: not-allowed;
		opacity: 0.5;
	}

	@media (prefers-reduced-motion: reduce) {
		.star-border {
			transition: none;
		}
	}
</style>

<script>
	type Rgb = [number, number, number];
	type Segment = { length: number; x: number; y: number; dx: number; dy: number; angle: number | null };
	type Shape = { r: number; segments: Segment[]; total: number };
	type Point = { x: number; y: number; nx: number; ny: number };
	type Pulse = { origin: number; age: number };
	type Mote = { x: number; y: number; vx: number; vy: number; age: number; life: number; size: number; seed: number };

	type Settings = {
		light: boolean;
		color: string;
		trailColor: string;
		duration: number;
		thickness: number;
		radius: number;
		trailLength: number;
		stars: number;
		glow: number;
		sparkle: boolean;
		direction: number;
		hover: string;
		clickPulse: boolean;
	};

	const BLEED = 48;
	const LAP = 0.9;
	const TAU = Math.PI * 2;
	const WHITE: Rgb = [255, 255, 255];

	const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
	const wrap = (v: number, total: number) => ((v % total) + total) % total;
	const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (2 - 2 * t) ** 3 / 2);
	const mix = (a: Rgb, b: Rgb, t: number): Rgb => [
		a[0] + (b[0] - a[0]) * t,
		a[1] + (b[1] - a[1]) * t,
		a[2] + (b[2] - a[2]) * t,
	];
	const rgba = (rgb: Rgb, alpha: number) =>
		`rgba(${Math.round(rgb[0])}, ${Math.round(rgb[1])}, ${Math.round(rgb[2])}, ${clamp(alpha, 0, 1).toFixed(3)})`;

	let colorContext: CanvasRenderingContext2D | null = null;

	const toRgb = (input: string): Rgb => {
		colorContext = colorContext ?? document.createElement('canvas').getContext('2d');
		if (!colorContext) return WHITE;
		let value = (input || '').trim();
		// 主题变量里是 "208, 132, 92"，canvas 只认 rgb(...) 形式
		if (/^\d{1,3}\s*,\s*\d{1,3}\s*,\s*\d{1,3}$/.test(value)) value = `rgb(${value})`;
		colorContext.fillStyle = '#000000';
		colorContext.fillStyle = value;
		const resolved = String(colorContext.fillStyle);
		if (resolved.startsWith('#')) {
			const hex = parseInt(resolved.slice(1, 7), 16);
			return [(hex >> 16) & 255, (hex >> 8) & 255, hex & 255];
		}
		const parts = resolved.match(/[\d.]+/g)?.map(Number) ?? WHITE;
		return [parts[0] ?? 255, parts[1] ?? 255, parts[2] ?? 255];
	};

	const outline = (width: number, height: number, radius: number): Shape => {
		const r = Math.max(0, Math.min(radius, width / 2, height / 2));
		const arc = (Math.PI * r) / 2;
		const across = Math.max(0, width - 2 * r);
		const down = Math.max(0, height - 2 * r);
		const segments: Segment[] = [
			{ length: across, x: r, y: 0, dx: 1, dy: 0, angle: null },
			{ length: arc, x: width - r, y: r, dx: 0, dy: 0, angle: -Math.PI / 2 },
			{ length: down, x: width, y: r, dx: 0, dy: 1, angle: null },
			{ length: arc, x: width - r, y: height - r, dx: 0, dy: 0, angle: 0 },
			{ length: across, x: width - r, y: height, dx: -1, dy: 0, angle: null },
			{ length: arc, x: r, y: height - r, dx: 0, dy: 0, angle: Math.PI / 2 },
			{ length: down, x: 0, y: height - r, dx: 0, dy: -1, angle: null },
			{ length: arc, x: r, y: r, dx: 0, dy: 0, angle: Math.PI },
		];
		return {
			r,
			segments,
			total: Math.max(1, segments.reduce((sum, s) => sum + s.length, 0)),
		};
	};

	const pointAt = (shape: Shape, distance: number, point: Point) => {
		let s = wrap(distance, shape.total);
		for (const segment of shape.segments) {
			if (segment.length > 0 && s <= segment.length) {
				if (segment.angle === null) {
					point.x = segment.x + segment.dx * s;
					point.y = segment.y + segment.dy * s;
					point.nx = segment.dy;
					point.ny = -segment.dx;
				} else {
					const angle = segment.angle + s / shape.r;
					point.nx = Math.cos(angle);
					point.ny = Math.sin(angle);
					point.x = segment.x + point.nx * shape.r;
					point.y = segment.y + point.ny * shape.r;
				}
				return point;
			}
			s -= segment.length;
		}
		return point;
	};

	const project = (shape: Shape, px: number, py: number) => {
		let best = Infinity;
		let found = 0;
		let offset = 0;
		shape.segments.forEach((segment) => {
			if (segment.length > 0) {
				let s = 0;
				let x = 0;
				let y = 0;
				if (segment.angle === null) {
					s = clamp((px - segment.x) * segment.dx + (py - segment.y) * segment.dy, 0, segment.length);
					x = segment.x + segment.dx * s;
					y = segment.y + segment.dy * s;
				} else {
					let angle = wrap(Math.atan2(py - segment.y, px - segment.x) - segment.angle, TAU);
					if (angle > Math.PI / 2) angle = angle > Math.PI * 1.25 ? 0 : Math.PI / 2;
					s = angle * shape.r;
					x = segment.x + Math.cos(segment.angle + angle) * shape.r;
					y = segment.y + Math.sin(segment.angle + angle) * shape.r;
				}
				const distance = (px - x) ** 2 + (py - y) ** 2;
				if (distance < best) {
					best = distance;
					found = offset + s;
				}
			}
			offset += segment.length;
		});
		return found;
	};

	const settingsOf = (el: HTMLElement): Settings => {
		const d = el.dataset;
		const num = (key: string, fb: number) => {
			const v = Number(d[key]);
			return d[key] !== undefined && d[key] !== '' && Number.isFinite(v) ? v : fb;
		};
		const resolve = (raw: string | undefined, fallback: string) => {
			const value = (raw ?? '').trim() || fallback;
			if (value.startsWith('--')) return getComputedStyle(el).getPropertyValue(value).trim() || fallback;
			return value;
		};
		const color = resolve(d.color, '#ffffff');
		// 亮底按钮走 source-over，暗底按钮走 lighter（发光更足）
		const autoLight = () => {
			const bg = toRgb(getComputedStyle(el).backgroundColor);
			const lum = (0.2126 * bg[0] + 0.7152 * bg[1] + 0.0722 * bg[2]) / 255;
			return lum > 0.55;
		};
		const themeRaw = d.theme ?? 'auto';
		return {
			light: themeRaw === 'auto' ? autoLight() : themeRaw !== 'dark',
			color,
			trailColor: resolve(d.trailColor || undefined, color),
			duration: Math.max(0.3, num('duration', 4.4)),
			thickness: Math.max(0.5, num('thickness', 1)),
			radius: Math.max(0, num('radius', 8)),
			trailLength: clamp(num('trailLength', 0.3), 0, 1),
			stars: clamp(Math.round(num('stars', 1)), 1, 6),
			glow: clamp(num('glow', 0.75), 0, 1),
			sparkle: el.hasAttribute('data-sparkle'),
			direction: d.direction === 'counterclockwise' ? -1 : 1,
			hover: ['lap', 'brighten', 'reveal', 'none'].includes(d.hover ?? '') ? (d.hover as string) : 'lap',
			clickPulse: el.hasAttribute('data-click-pulse'),
		};
	};

	const instances: { destroy: () => void }[] = [];
	let bound = false;
	let pageToken = 0;
	let mountedToken = -1;

	function setup(root: HTMLElement) {
		const canvas = root.querySelector<HTMLCanvasElement>('[data-sb-canvas]');
		const ctx = canvas?.getContext('2d');
		if (!canvas || !ctx) return null;

		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const S = settingsOf(root);

		const point: Point = { x: 0, y: 0, nx: 0, ny: -1 };
		const state = {
			width: 0,
			height: 0,
			dpr: 1,
			phase: 0,
			velocity: 0,
			motion: 0,
			lap: -1,
			time: 0,
			reveal: 0,
			boost: 0,
			flash: 0,
			emit: 0,
			hovered: false,
			focused: false,
			pointerX: 0,
			pointerY: 0,
			visible: false,
		};
		const pulses: Pulse[] = [];
		const dust: Mote[] = [];
		const colors = { key: '', head: WHITE, tail: WHITE };
		let raf = 0;
		let last = performance.now();
		let alive = true;

		const measure = () => {
			state.width = root.offsetWidth;
			state.height = root.offsetHeight;
			state.dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = Math.max(1, Math.round((state.width + BLEED * 2) * state.dpr));
			canvas.height = Math.max(1, Math.round((state.height + BLEED * 2) * state.dpr));
			wake();
		};

		const local = (event: MouseEvent): [number, number] => {
			const rect = root.getBoundingClientRect();
			const scaleX = rect.width ? state.width / rect.width : 1;
			const scaleY = rect.height ? state.height / rect.height : 1;
			return [(event.clientX - rect.left) * scaleX, (event.clientY - rect.top) * scaleY];
		};

		const shapeFor = (s: Settings) =>
			outline(
				Math.max(1, state.width - s.thickness),
				Math.max(1, state.height - s.thickness),
				s.radius - s.thickness / 2,
			);

		const stroke = (
			x1: number,
			y1: number,
			x2: number,
			y2: number,
			width: number,
			style: string | CanvasGradient,
		) => {
			ctx.lineWidth = width;
			ctx.strokeStyle = style;
			ctx.beginPath();
			ctx.moveTo(x1, y1);
			ctx.lineTo(x2, y2);
			ctx.stroke();
		};

		const drawTrail = (
			s: Settings,
			shape: Shape,
			head: number,
			length: number,
			sign: number,
			intensity: number,
			tip = true,
		) => {
			if (length < 0.5 || intensity <= 0) return;
			const steps = clamp(Math.ceil(length / 2), 2, 90);
			pointAt(shape, head, point);
			let px = point.x;
			let py = point.y;
			for (let i = 1; i <= steps; i++) {
				pointAt(shape, head - sign * length * (i / steps), point);
				const u = 1 - (i - 0.5) / steps;
				const fade = u * u * intensity;
				let tone = mix(colors.tail, colors.head, u);
				if (!s.light) tone = mix(tone, WHITE, u ** 6 * 0.65);
				ctx.lineCap = tip && i === 1 ? 'round' : 'butt';
				stroke(px, py, point.x, point.y, 2 + 6 * s.glow, rgba(tone, fade * (s.light ? 0.22 : 0.2) * s.glow));
				stroke(px, py, point.x, point.y, s.thickness, rgba(tone, fade));
				px = point.x;
				py = point.y;
			}
		};

		const drawHead = (s: Settings, x: number, y: number, intensity: number, twinkle: number) => {
			if (intensity <= 0) return;
			const tone = colors.head;
			const reach = (12 + 40 * s.glow) * (s.light ? 0.7 : 1);
			const bloom = ctx.createRadialGradient(x, y, 0, x, y, reach);
			// light 模式原本只有 0.08，压在实心浅色按钮上几乎看不见，提到 0.3
			const strength = (s.light ? 0.3 : 0.4) * s.glow * intensity;
			bloom.addColorStop(0, rgba(tone, strength));
			bloom.addColorStop(0.2, rgba(tone, strength * 0.4));
			bloom.addColorStop(0.5, rgba(tone, strength * 0.1));
			bloom.addColorStop(1, rgba(tone, 0));
			ctx.fillStyle = bloom;
			ctx.fillRect(x - reach, y - reach, reach * 2, reach * 2);
			if (!s.sparkle) return;

			const size = (1 + s.thickness * 0.6) * (s.light ? 0.95 : 1);
			const core = ctx.createRadialGradient(x, y, 0, x, y, size * 2.2);
			core.addColorStop(0, rgba(s.light ? tone : WHITE, intensity));
			core.addColorStop(s.light ? 0.3 : 0.4, rgba(s.light ? tone : mix(tone, WHITE, 0.5), intensity * 0.9));
			core.addColorStop(s.light ? 0.55 : 1, rgba(tone, s.light ? intensity * 0.12 : 0));
			core.addColorStop(1, rgba(tone, 0));
			ctx.fillStyle = core;
			ctx.beginPath();
			ctx.arc(x, y, size * 2.2, 0, TAU);
			ctx.fill();

			const spike = (3 + 4 * s.glow + s.thickness * 1.5) * twinkle;
			const center = s.light ? tone : WHITE;
			const horizontal = ctx.createLinearGradient(x - spike, y, x + spike, y);
			horizontal.addColorStop(0, rgba(tone, 0));
			horizontal.addColorStop(0.5, rgba(center, intensity * 0.95));
			horizontal.addColorStop(1, rgba(tone, 0));
			stroke(x - spike, y, x + spike, y, s.light ? 0.75 : 1, horizontal);
			const vertical = ctx.createLinearGradient(x, y - spike, x, y + spike);
			vertical.addColorStop(0, rgba(tone, 0));
			vertical.addColorStop(0.5, rgba(center, intensity * 0.95));
			vertical.addColorStop(1, rgba(tone, 0));
			stroke(x, y - spike, x, y + spike, s.light ? 0.75 : 1, vertical);
		};

		const spawnDust = (x: number, y: number, nx: number, ny: number, speed: number) => {
			if (dust.length > 48) return;
			const push = 3 + Math.random() * 10;
			const drift = (Math.random() - 0.5) * 8;
			dust.push({
				x: x + nx * (Math.random() * 3 - 1),
				y: y + ny * (Math.random() * 3 - 1),
				vx: nx * push - ny * drift - speed * -ny * 0.04,
				vy: ny * push + nx * drift - speed * nx * 0.04,
				age: 0,
				life: 0.35 + Math.random() * 0.5,
				size: 0.45 + Math.random() * 0.7,
				seed: Math.random() * TAU,
			});
		};

		const draw = (base: Settings, shape: Shape) => {
			const s =
				state.boost > 0.001
					? { ...base, glow: Math.min(1.5, base.glow + 0.4 * state.boost) }
					: base;
			ctx.setTransform(1, 0, 0, 1, 0, 0);
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			if (state.width < 2 || state.height < 2) return;
			const offset = (BLEED + s.thickness / 2) * state.dpr;
			ctx.setTransform(state.dpr, 0, 0, state.dpr, offset, offset);
			ctx.globalCompositeOperation = s.light ? 'source-over' : 'lighter';
			ctx.lineCap = 'butt';

			const total = shape.total;
			const spacing = total / s.stars;
			const speed = Math.abs(state.motion);
			const sign = state.motion >= 0 ? 1 : -1;
			const span = s.trailLength * s.duration;
			const length = Math.min(speed * span, spacing * 0.92, total * 0.6);
			const intensity = state.reveal * (1 + 0.4 * state.boost + 0.6 * state.flash);

			const ring = state.flash * (s.light ? 0.18 : 0.32) + state.boost * state.reveal * (s.light ? 0.07 : 0.12);
			if (ring > 0.005) {
				ctx.lineWidth = s.thickness + 2 * s.glow;
				ctx.strokeStyle = rgba(colors.head, ring);
				ctx.beginPath();
				const w = Math.max(1, state.width - s.thickness);
				const h = Math.max(1, state.height - s.thickness);
				if (typeof ctx.roundRect === 'function') ctx.roundRect(0, 0, w, h, Math.max(0, shape.r));
				else ctx.rect(0, 0, w, h);
				ctx.stroke();
			}

			const still = clamp(1 - speed / Math.max(1, (total / s.duration) * 0.6), 0, 1) * Math.min(1, intensity);
			const rest = (10 + 14 * s.glow + s.thickness * 2) * still;
			for (let i = 0; i < s.stars; i++) {
				const head = state.phase + i * spacing;
				drawTrail(s, shape, head, length, sign, Math.min(1, intensity));
				if (still > 0.01) {
					drawTrail(s, shape, head, rest, 1, still, false);
					drawTrail(s, shape, head, rest, -1, still, false);
				}
			}

			pulses.forEach((pulse) => {
				const progress = pulse.age / 0.65;
				const fade = (1 - progress) ** 2;
				const travel = (total / 2) * (1 - (1 - Math.min(1, pulse.age / 0.5)) ** 2);
				const tail = Math.min(travel, total * 0.16);
				[1, -1].forEach((way) => {
					const front = pulse.origin + way * travel;
					drawTrail(s, shape, front, tail, way, fade);
					pointAt(shape, front, point);
					drawHead(s, point.x, point.y, fade * 0.8, 0.8);
				});
			});

			for (let i = 0; i < s.stars; i++) {
				pointAt(shape, state.phase + i * spacing, point);
				const twinkle =
					0.82 + 0.18 * Math.sin(state.time * 6.1 + i * 2.3) * Math.sin(state.time * 2.7 + i);
				drawHead(s, point.x, point.y, Math.min(1.3, intensity), twinkle);
			}

			dust.forEach((mote) => {
				const left = 1 - mote.age / mote.life;
				const shimmer = 0.45 + 0.55 * Math.sin(state.time * 20 + mote.seed);
				const alpha = left * shimmer * state.reveal * (s.light ? 0.45 : 0.9);
				if (alpha <= 0.01) return;
				ctx.fillStyle = rgba(s.light ? colors.head : mix(colors.tail, WHITE, 0.6), alpha);
				ctx.beginPath();
				ctx.arc(mote.x, mote.y, mote.size * (0.6 + 0.4 * left), 0, TAU);
				ctx.fill();
			});
		};

		const frame = (now: number) => {
			raf = 0;
			if (!alive) return;
			const dt = Math.min(0.05, Math.max(0.001, (now - last) / 1000));
			last = now;
			state.time += dt;

			const key = `${S.color}|${S.trailColor}`;
			if (key !== colors.key) {
				colors.key = key;
				colors.head = toRgb(S.color);
				colors.tail = toRgb(S.trailColor);
			}

			const shape = shapeFor(S);
			const total = shape.total;
			const spacing = total / S.stars;
			const engaged = state.hovered || state.focused;
			const cruise = reduce ? 0 : (S.direction * total) / S.duration;

			const revealTarget = S.hover === 'reveal' && !engaged ? 0 : 1;
			state.reveal += (revealTarget - state.reveal) * (1 - Math.exp(-dt / (revealTarget > state.reveal ? 0.16 : 0.45)));
			const boostTarget = S.hover === 'brighten' && engaged ? 1 : 0;
			state.boost += (boostTarget - state.boost) * (1 - Math.exp(-dt / (boostTarget > state.boost ? 0.18 : 0.5)));
			state.flash *= Math.exp(-dt / 0.22);

			state.velocity += (cruise - state.velocity) * (1 - Math.exp(-dt / 0.45));
			let extra = 0;
			if (state.lap >= 0) {
				const before = ease(Math.min(1, state.lap / LAP));
				state.lap += dt;
				extra = (ease(Math.min(1, state.lap / LAP)) - before) * total * S.direction;
				if (state.lap >= LAP) state.lap = -1;
			}
			state.motion = state.velocity + extra / dt;
			state.phase = wrap(state.phase + state.velocity * dt + extra, total);

			const pace = Math.abs(state.motion) / Math.max(1, Math.abs(total / S.duration));
			if (S.sparkle && !reduce && state.reveal > 0.05) {
				state.emit += dt * (2 + 6 * Math.min(2, pace)) * S.stars;
				while (state.emit > 1) {
					state.emit -= 1;
					pointAt(shape, state.phase + Math.floor(Math.random() * S.stars) * spacing, point);
					spawnDust(point.x, point.y, point.nx, point.ny, state.motion);
				}
			}
			for (let i = dust.length - 1; i >= 0; i--) {
				const mote = dust[i];
				mote.age += dt;
				mote.x += mote.vx * dt;
				mote.y += mote.vy * dt;
				mote.vx *= Math.exp(-dt * 2.2);
				mote.vy *= Math.exp(-dt * 2.2);
				if (mote.age >= mote.life) dust.splice(i, 1);
			}
			for (let i = pulses.length - 1; i >= 0; i--) {
				pulses[i].age += dt;
				if (pulses[i].age >= 0.65) pulses.splice(i, 1);
			}

			draw(S, shape);

			const settling =
				Math.abs(revealTarget - state.reveal) > 0.002 ||
				Math.abs(boostTarget - state.boost) > 0.002 ||
				state.flash > 0.01 ||
				pulses.length > 0 ||
				dust.length > 0;
			const moving = Math.abs(state.motion) > 0.05 || cruise !== 0 || state.lap >= 0;
			const showing = state.reveal > 0.002 || revealTarget > 0;
			if (state.visible && (settling || (moving && showing) || state.hovered)) raf = requestAnimationFrame(frame);
		};

		const wake = () => {
			if (raf || !alive || !state.visible) return;
			last = performance.now();
			raf = requestAnimationFrame(frame);
		};

		const onEnter = (event: PointerEvent) => {
			const [x, y] = local(event);
			state.pointerX = x;
			state.pointerY = y;
			state.hovered = true;
			if (S.hover === 'reveal' && state.reveal < 0.15) {
				state.phase = project(shapeFor(S), x - S.thickness / 2, y - S.thickness / 2);
				state.velocity = 0;
			}
			if (S.hover === 'lap' && state.lap < 0 && !reduce) state.lap = 0;
			wake();
		};
		const onLeave = () => {
			state.hovered = false;
			wake();
		};
		const pulse = (origin: number) => {
			if (!S.clickPulse) return;
			pulses.push({ origin, age: 0 });
			if (pulses.length > 4) pulses.shift();
			state.flash = 1;
			wake();
		};
		const onDown = (event: PointerEvent) => {
			if (event.pointerType === 'mouse' && event.button !== 0) return;
			const [x, y] = local(event);
			pulse(project(shapeFor(S), x - S.thickness / 2, y - S.thickness / 2));
		};
		const onClick = (event: MouseEvent) => {
			if (event.detail === 0) pulse(state.phase);
		};
		const onFocus = () => {
			state.focused = root.matches(':focus-visible');
			if (state.focused && S.hover === 'lap' && state.lap < 0 && !reduce) state.lap = 0;
			wake();
		};
		const onBlur = () => {
			state.focused = false;
			wake();
		};
		const onTheme = () => {
			const next = settingsOf(root);
			S.color = next.color;
			S.trailColor = next.trailColor;
			S.light = next.light;
			colors.key = '';
			wake();
		};

		const resizeObserver = new ResizeObserver(measure);
		resizeObserver.observe(root);
		const visibility = new IntersectionObserver((entries) => {
			state.visible = entries.some((entry) => entry.isIntersecting);
			if (state.visible) wake();
		});
		visibility.observe(root);

		root.addEventListener('pointerenter', onEnter);
		root.addEventListener('pointerleave', onLeave);
		root.addEventListener('pointerdown', onDown);
		root.addEventListener('click', onClick);
		root.addEventListener('focus', onFocus);
		root.addEventListener('blur', onBlur);
		document.addEventListener('theme-change', onTheme);
		document.addEventListener('accent-change', onTheme);
		measure();

		return {
			destroy: () => {
				alive = false;
				cancelAnimationFrame(raf);
				resizeObserver.disconnect();
				visibility.disconnect();
				root.removeEventListener('pointerenter', onEnter);
				root.removeEventListener('pointerleave', onLeave);
				root.removeEventListener('pointerdown', onDown);
				root.removeEventListener('click', onClick);
				root.removeEventListener('focus', onFocus);
				root.removeEventListener('blur', onBlur);
				document.removeEventListener('theme-change', onTheme);
				document.removeEventListener('accent-change', onTheme);
			},
		};
	}

	function mount() {
		if (mountedToken === pageToken) return;
		mountedToken = pageToken;
		for (const item of instances.splice(0)) item.destroy();
		document.querySelectorAll<HTMLElement>('[data-sb]:not([data-sb-ready])').forEach((root) => {
			root.dataset.sbReady = '1';
			const instance = setup(root);
			if (instance) instances.push(instance);
		});
	}

	if (!bound) {
		bound = true;
		document.addEventListener('astro:before-swap', () => {
			pageToken += 1;
		});
		document.addEventListener('astro:page-load', mount);
	}
	mount();
</script>
