---
/**
 * SubmitPost — 访客投稿入口（纯静态、零密钥）。
 *
 * /blog 顶部一个「投稿」按钮，点开弹窗表单，填标题/正文/标签/署名后，
 * 组装 GitHub「新建 Issue」页的预填链接并在新标签页打开。访客确认内容后
 * 用自己的 GitHub 账号点 Submit new issue，管理员在 Issues 里审核发布。
 *
 * 为什么不在前端直接调 API：站点是纯静态的，没有服务端；GitHub 不允许匿名
 * 创建 Issue，而把机器人 PAT 内联进客户端 JS 等于公开泄露密钥（任何人都能
 * 从构建产物里读走，拿去无限灌 Issue）。预填链接是纯静态站的正确解法。
 */
import { SUBMIT_ENABLED, SUBMIT_REPO } from '../consts';

// 默认关闭；打开只需把 consts.ts 的 SUBMIT_ENABLED 改成 true，无需任何密钥
const enabled = SUBMIT_ENABLED && Boolean(SUBMIT_REPO.owner) && Boolean(SUBMIT_REPO.repo);
---

{enabled && (
	<div class="submit-root" data-submit-root>
		<button class="submit-trigger" type="button" data-submit-open>
			<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
				<path
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					d="M8 3.2v9.6M3.2 8h9.6"></path>
			</svg>
			投稿
		</button>

		<!-- 弹窗：遮罩 + 居中卡片 -->
		<div class="submit-dialog" data-submit-dialog hidden>
			<div class="submit-veil" data-submit-close></div>
			<form class="submit-card" data-submit-form role="dialog" aria-modal="true" aria-label="投稿">
				<header class="submit-head">
					<div>
						<h2>投稿</h2>
						<p class="submit-note">
							写好发给我，审核通过后会作为一篇文章发布。点提交会打开 GitHub 的提交页，用你自己的账号确认一次即可。
						</p>
					</div>
					<button class="submit-x" type="button" data-submit-close aria-label="关闭">×</button>
				</header>

				<label class="field">
					<span>标题 <em>*</em></span>
					<input data-submit-title required placeholder="想分享的标题" autocomplete="off" />
				</label>

				<label class="field">
					<span>正文 <em>*</em></span>
					<textarea data-submit-body required rows="10" placeholder="支持 Markdown：**加粗**、[链接](url)、- 列表……"></textarea>
				</label>

				<div class="submit-grid2">
					<label class="field">
						<span>标签（逗号分隔）</span>
						<input data-submit-tags placeholder="生活, 想法" autocomplete="off" />
					</label>
					<label class="field">
						<span>署名 / 联系方式（选填）</span>
						<input data-submit-author placeholder="昵称 或 邮箱" autocomplete="off" />
					</label>
				</div>

				<p class="submit-status" data-submit-status data-kind="idle" hidden></p>

				<div class="submit-actions">
					<button class="btn" type="submit" data-submit-send>去 GitHub 提交</button>
					<button class="btn btn--ghost" type="button" data-submit-close>取消</button>
				</div>
			</form>
		</div>
	</div>
)}

<style>
	.submit-root {
		display: flex;
		justify-content: flex-end;
		margin: -0.2rem 0 0.4rem;
	}
	.submit-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.42rem 0.95rem;
		border-radius: var(--r-pill);
		border: 1px solid rgba(var(--accent), 0.5);
		background: rgb(var(--accent));
		color: rgb(var(--paper));
		font-size: 0.86rem;
		font-weight: 600;
		cursor: pointer;
		box-shadow: var(--shadow-sm);
		transition:
			transform var(--dur-fast) var(--ease-out),
			box-shadow var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
	}
	.submit-trigger:hover {
		transform: translateY(-1px);
		box-shadow: var(--shadow-md);
		background: rgb(var(--accent-deep));
	}
	.submit-trigger:active {
		transform: none;
	}

	/* ---- 弹窗 ---- */
	.submit-dialog {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: grid;
		place-items: center;
		padding: clamp(1rem, 4vw, 3rem);
		overscroll-behavior: contain;
	}
	.submit-dialog[hidden] {
		display: none !important;
	}
	.submit-veil {
		position: absolute;
		inset: 0;
		background: rgba(24, 21, 18, 0.66);
		backdrop-filter: blur(10px);
		opacity: 0;
		transition: opacity 0.24s var(--ease-out);
	}
	.submit-dialog.is-open .submit-veil {
		opacity: 1;
	}
	.submit-card {
		position: relative;
		width: min(560px, 100%);
		max-height: min(88vh, 720px);
		overflow-y: auto;
		padding: clamp(1.1rem, 3vw, 1.6rem);
		border-radius: var(--r-lg);
		background: rgb(var(--paper));
		border: 1px solid var(--glass-brd);
		box-shadow: var(--shadow-lg);
		transform: scale(0.96) translateY(12px);
		opacity: 0;
		transition:
			transform 0.3s var(--ease-spring),
			opacity 0.24s var(--ease-out);
	}
	.submit-dialog.is-open .submit-card {
		transform: none;
		opacity: 1;
	}

	.submit-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.submit-head h2 {
		margin: 0 0 0.3rem;
		font-size: 1.2rem;
	}
	.submit-note {
		margin: 0;
		font-size: 0.82rem;
		line-height: 1.6;
		color: rgb(var(--muted));
	}
	.submit-x {
		flex-shrink: 0;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		border: 1px solid var(--glass-brd-dim);
		background: var(--chip-bg);
		color: rgb(var(--muted));
		font-size: 1.2rem;
		line-height: 1;
		cursor: pointer;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.submit-x:hover {
		color: rgb(var(--ink));
		background: var(--chip-bg-strong);
	}

	.field {
		display: block;
		margin-bottom: 0.85rem;
	}
	.field span {
		display: block;
		margin-bottom: 0.35rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: rgb(var(--ink-soft));
	}
	.field em {
		color: rgb(var(--accent));
		font-style: normal;
	}
	.field input,
	.field textarea {
		width: 100%;
		box-sizing: border-box;
		padding: 0.55rem 0.75rem;
		border-radius: var(--r-md);
		border: 1px solid rgba(var(--line), 1);
		background: var(--chip-bg);
		color: rgb(var(--ink));
		font-size: 0.92rem;
		font-family: inherit;
		line-height: 1.6;
		transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
	}
	.field textarea {
		resize: vertical;
		min-height: 180px;
	}
	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: rgba(var(--accent), 0.55);
		box-shadow: 0 0 0 4px rgba(var(--accent), 0.12);
	}

	.submit-grid2 {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0 0.85rem;
	}
	@media (max-width: 520px) {
		.submit-grid2 {
			grid-template-columns: 1fr;
		}
	}

	.submit-status {
		margin: 0 0 0.85rem;
		padding: 0.55rem 0.7rem;
		border-radius: var(--r-md);
		font-size: 0.82rem;
		line-height: 1.5;
		background: var(--chip-bg-dim);
		color: rgb(var(--muted));
	}
	.submit-status[data-kind='err'] {
		background: rgba(var(--rose), 0.16);
		color: rgb(var(--rose));
	}
	.submit-status[data-kind='ok'] {
		background: rgba(var(--sage), 0.2);
		color: rgb(var(--sage));
	}
	.submit-status[data-kind='busy'] {
		background: rgba(var(--accent), 0.14);
		color: rgb(var(--accent-deep));
	}

	.submit-actions {
		display: flex;
		gap: 0.6rem;
		justify-content: flex-end;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem 1.1rem;
		border-radius: var(--r-pill);
		border: 1px solid transparent;
		background: rgb(var(--accent));
		color: rgb(var(--paper));
		font-size: 0.88rem;
		font-weight: 600;
		cursor: pointer;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.btn:hover {
		background: rgb(var(--accent-deep));
	}
	.btn:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
	.btn--ghost {
		background: transparent;
		border-color: var(--glass-brd);
		color: rgb(var(--muted));
	}
	.btn--ghost:hover {
		background: var(--chip-bg);
		color: rgb(var(--ink));
	}
</style>

<script>
	import { SUBMIT_REPO } from '../consts';

	// 模块级：Astro <script> 只执行一次，用它保证 document 级监听不随导航累积
	let keydownWired = false;

	function parseTags(raw: string): string[] {
		const seen = new Set<string>();
		for (const part of raw.split(/[,，]/)) {
			const tag = part.trim();
			if (tag) seen.add(tag);
		}
		return [...seen];
	}

	/** 把投稿拼成一段可读的 Markdown issue 正文 */
	function buildBody(input: { title: string; body: string; tags: string[]; author: string }): string {
		const lines: string[] = [input.body.trim()];
		if (input.tags.length) lines.push('', '---', '', `**标签**：${input.tags.join('、')}`);
		if (input.author) lines.push(`**署名**：${input.author}`);
		lines.push('', '> 这是来自 ystlr.com 的文章投稿，审核通过后会作为文章发布。');
		return lines.join('\n');
	}

	/** 组装 GitHub「新建 Issue」预填链接。全程不碰任何密钥。 */
	function buildIssueUrl(title: string, body: string, tags: string[], author: string): string {
		const url = new URL(`https://github.com/${SUBMIT_REPO.owner}/${SUBMIT_REPO.repo}/issues/new`);
		url.searchParams.set('title', `[投稿] ${title}`);
		url.searchParams.set('body', buildBody({ title, body, tags, author }));
		url.searchParams.set('labels', '投稿');
		return url.toString();
	}

	function boot() {
		const root = document.querySelector<HTMLElement>('[data-submit-root]');
		if (!root || root.dataset.wired === '1') return;
		root.dataset.wired = '1';

		const dialog = root.querySelector<HTMLElement>('[data-submit-dialog]');
		const form = root.querySelector<HTMLFormElement>('[data-submit-form]');
		const status = root.querySelector<HTMLElement>('[data-submit-status]');
		const openBtn = root.querySelector<HTMLButtonElement>('[data-submit-open]');
		if (!dialog || !form || !openBtn) return;

		const titleInput = form.querySelector<HTMLInputElement>('[data-submit-title]');
		const bodyInput = form.querySelector<HTMLTextAreaElement>('[data-submit-body]');
		const tagsInput = form.querySelector<HTMLInputElement>('[data-submit-tags]');
		const authorInput = form.querySelector<HTMLInputElement>('[data-submit-author]');

		function setStatus(kind: 'idle' | 'busy' | 'ok' | 'err', text: string) {
			if (!status) return;
			status.dataset.kind = kind;
			status.textContent = text;
			status.hidden = !text;
		}

		function open() {
			dialog!.hidden = false;
			document.documentElement.style.overflow = 'hidden';
			document.body.style.overflow = 'hidden';
			requestAnimationFrame(() => dialog!.classList.add('is-open'));
			setStatus('idle', '');
			form!.reset();
			window.setTimeout(() => titleInput?.focus(), 50);
		}

		function close() {
			dialog!.classList.remove('is-open');
			document.documentElement.style.removeProperty('overflow');
			document.body.style.removeProperty('overflow');
			window.setTimeout(() => {
				dialog!.hidden = true;
			}, 220);
		}

		openBtn!.addEventListener('click', open);
		root.querySelectorAll<HTMLElement>('[data-submit-close]').forEach((el) => el.addEventListener('click', close));
		// 只绑一次：View Transitions 下 /blog 每次回来都会生成新的 [data-submit-root]，
		// 若在 boot 里重复绑 document keydown，监听器会随导航次数累积。
		if (!keydownWired) {
			keydownWired = true;
			document.addEventListener('keydown', (e) => {
				if (e.key !== 'Escape') return;
				const current = document.querySelector<HTMLElement>('[data-submit-dialog]');
				if (!current || current.hidden) return;
				current.classList.remove('is-open');
				document.documentElement.style.removeProperty('overflow');
				document.body.style.removeProperty('overflow');
				window.setTimeout(() => {
					current.hidden = true;
				}, 220);
			});
		}

		form!.addEventListener('submit', (e) => {
			e.preventDefault();
			const title = titleInput?.value.trim() ?? '';
			const body = bodyInput?.value.trim() ?? '';
			const tags = parseTags(tagsInput?.value ?? '');
			const author = authorInput?.value.trim() ?? '';

			if (!title) {
				setStatus('err', '请填一个标题。');
				titleInput?.focus();
				return;
			}
			if (!body) {
				setStatus('err', '正文不能为空。');
				bodyInput?.focus();
				return;
			}

			const url = buildIssueUrl(title, body, tags, author);
			// 正文走 query string，GitHub 对超长 URL 会截断，超过阈值就别误导用户
			if (url.length > 7500) {
				setStatus('err', '正文太长了，预填链接放不下。请精简后重试，或直接发邮件给我。');
				return;
			}

			// 用临时 <a> 触发导航：处在用户手势内不会被拦，且自带 noopener/noreferrer
			const link = document.createElement('a');
			link.href = url;
			link.target = '_blank';
			link.rel = 'noopener noreferrer';
			link.hidden = true;
			document.body.appendChild(link);
			link.click();
			link.remove();

			setStatus('ok', '已在新标签页打开 GitHub 提交页，确认内容后点「Submit new issue」即可。');
			window.setTimeout(() => close(), 3200);
		});

		// View Transitions 切页后重新绑定（组件在 /blog 里，离开再回来时 DOM 是新的）
	}

	document.addEventListener('astro:page-load', boot);
	if (document.readyState !== 'loading') boot();
	else document.addEventListener('DOMContentLoaded', boot);
</script>
