---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	large?: boolean;
}

const { project, large = false } = Astro.props;
---

<article class:list={['work-card', { large }]}>
	<a href={project.link || '#'} class="cover-link" aria-label={project.title}>
		<div class="cover">
			<Image src={project.cover} alt={project.title} width={large ? 1200 : 900} height={large ? 900 : 675} />
		</div>
		<div class="meta">
			<h3>{project.title}</h3>
			<div class="tags">
				{project.tags.map((tag) => <span class="tag">{tag}</span>)}
			</div>
		</div>
	</a>
</article>

<style>
	.work-card {
		border-radius: 16px;
		overflow: hidden;
	}
	.cover-link {
		display: block;
		text-decoration: none;
	}
	.cover {
		overflow: hidden;
		border-radius: 16px;
		border: 1px solid rgb(var(--line));
		background: rgb(var(--bg-soft));
		aspect-ratio: 4 / 3;
	}
	.cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 16px;
		transition: transform 0.4s ease;
	}
	.work-card:hover .cover img {
		transform: scale(1.04);
	}
	.meta {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		margin-top: 0.9em;
	}
	h3 {
		margin: 0;
		font-size: 1.05rem;
		color: rgb(var(--ink));
	}
	.tags {
		flex-shrink: 0;
	}
</style>
