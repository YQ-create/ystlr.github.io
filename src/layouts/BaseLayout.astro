---
// 全站骨架：页头 + 内容 + 页脚 + 动效引擎。
// 所有页面都用它包一层，页头页脚只写一遍。
import BaseHead from '../components/BaseHead.astro';
import ClickSpark from '../components/ClickSpark.astro';
import DockNav from '../components/DockNav.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Motion from '../components/Motion.astro';
import SiteSearch from '../components/SiteSearch.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	noindex?: boolean;
	/** 给 <body> 追加类名，便于单页定制 */
	bodyClass?: string;
	/** 首屏整屏 Hero：页头改成固定定位，融入画面 */
	hero?: boolean;
	/** 页面类型：website（默认）| article（文章页） */
	type?: 'website' | 'article';
	/** 文章发布时间（article 类型时用于结构化数据） */
	publishedTime?: Date;
}

const { title, description, image, noindex, bodyClass, hero = false, type, publishedTime } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="js">
	<head>
		<BaseHead title={title} description={description} image={image} noindex={noindex} type={type} publishedTime={publishedTime} />
	</head>
	<!-- studio：全站统一走「近黑台面 + 发丝线」版式（见 global.css 的 .studio） -->
	<body class:list={['studio', bodyClass]} data-hero={hero ? '1' : undefined}>
		<!-- 全站底图层：默认 ASCII 字符光场 / 可选自定义图片 / 遮罩，由调色盘切换 -->
		<div class="site-bg" aria-hidden="true">
			<div class="site-bg__image" data-site-bg-image></div>
			<div class="site-bg__ascii" data-site-bg-ascii></div>
			<div class="site-bg__veil"></div>
		</div>
		<a class="skip-link" href="#main-content" data-skip-link>跳到正文</a>
		<div class="scroll-progress" data-progress aria-hidden="true"></div>
		<Header />
		<slot />
		<Footer />
		<DockNav />
		<Motion />
		<SiteSearch />
		<ClickSpark size={11} radius={24} count={7} />
	</body>
</html>

<script>
	// skip-link：点击后把焦点交给第一个 <main>，键盘用户可跳过页头直接读正文。
	// 用事件委托绑在 document 上（换页后新链接照样生效），并给 <main> 补上锚点 id，
	// 这样即使 JS 未执行，href="#main-content" 也能落到正确位置。
	const ensureMainAnchor = () => {
		const main = document.querySelector<HTMLElement>('main');
		if (main && !main.id) main.id = 'main-content';
	};
	ensureMainAnchor();

	document.addEventListener('click', (e) => {
		const link = (e.target as Element | null)?.closest('[data-skip-link]');
		if (!link) return;
		const main = document.querySelector<HTMLElement>('main');
		if (!main) return;
		e.preventDefault();
		main.setAttribute('tabindex', '-1');
		main.focus({ preventScroll: true });
		main.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});

	document.addEventListener('astro:page-load', ensureMainAnchor);
</script>
