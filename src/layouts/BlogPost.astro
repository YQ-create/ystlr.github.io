---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: import('astro').ImageMetadata;
	tags?: string[];
}

const { title, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				max-width: 700px;
			}
			.back-link {
				display: inline-block;
				font-size: 0.9rem;
				color: rgb(var(--muted));
				text-decoration: none;
				margin-bottom: 2em;
			}
			.back-link:hover {
				color: rgb(var(--accent));
			}
			.hero-image {
				margin: 1em 0 2em;
			}
			.hero-image img {
				display: block;
				width: 100%;
			}
			.title h1 {
				font-size: clamp(1.8rem, 4vw, 2.3rem);
				margin-bottom: 0.5em;
				line-height: 1.3;
			}
			.meta {
				color: rgb(var(--muted));
				font-size: 0.9rem;
				margin-bottom: 0.8em;
			}
			.last-updated-on {
				font-style: italic;
			}
			.excerpt {
				color: rgb(var(--muted));
				font-size: 1.05rem;
				border-left: 3px solid rgb(var(--line));
				padding-left: 1em;
				margin: 1.5em 0 2.5em;
			}
			.tags {
				margin: 1.5em 0;
			}
			article img {
				margin: 1em 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<a class="back-link" href="/blog">← 回到博客</a>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<header class="title">
					<div class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="last-updated-on">
								· 更新于 <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					<h1>{title}</h1>
				</header>
				<p class="excerpt">{description}</p>
				{tags.length > 0 && (
					<div class="tags">
						{tags.map((tag) => <span class="tag">{tag}</span>)}
					</div>
				)}
				<div class="prose">
					<slot />
				</div>
				<Giscus />
			</article>
		</main>
		<Footer />
	</body>
</html>
