---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: import('astro').ImageMetadata;
	tags?: string[];
	/** 阅读时长（分钟），由页面层估算后传入 */
	readingMinutes?: number;
	prev?: { href: string; title: string };
	next?: { href: string; title: string };
	/** 相关文章：优先标签交集，其次最新（排除自己与相邻文章） */
	related?: { href: string; title: string; date: string }[];
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	readingMinutes,
	prev,
	next,
	related = [],
} = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<main class="post">
		<a class="back-link" href="/blog">
			<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
				<path
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M13 8H3M7.5 3.5 3 8l4.5 4.5"></path>
			</svg>
			返回文章列表
		</a>

		<header class="post-head">
			<div class="post-meta">
				<time datetime={pubDate.toISOString()}>
					<FormattedDate date={pubDate} />
				</time>
				{readingMinutes && <span class="dot-sep">·</span>}
				{readingMinutes && <span>约 {readingMinutes} 分钟</span>}
				{updatedDate && (
					<>
						<span class="dot-sep">·</span>
						<span class="update">更新于 <FormattedDate date={updatedDate} /></span>
					</>
				)}
			</div>

			<h1 class="post-title">{title}</h1>

			{tags.length > 0 && (
				<div class="post-tags">
					{tags.map((tag) => <span class="tag">{tag}</span>)}
				</div>
			)}
		</header>

		{heroImage && (
			<figure class="post-hero">
				<Image width={1080} height={560} src={heroImage} alt="" loading="eager" fetchpriority="high" decoding="async" />
			</figure>
		)}

		<p class="post-excerpt glass">{description}</p>

		<div class="prose">
			<slot />
		</div>

		<nav class="post-nav" aria-label="相邻文章">
			{prev ? (
				<a class="post-nav__item post-nav__item--prev glass" href={prev.href}>
					<span class="post-nav__label">← 上一篇</span>
					<span class="post-nav__title">{prev.title}</span>
				</a>
			) : (
				<span></span>
			)}
			{next ? (
				<a class="post-nav__item post-nav__item--next glass" href={next.href}>
					<span class="post-nav__label">下一篇 →</span>
					<span class="post-nav__title">{next.title}</span>
				</a>
			) : (
				<span></span>
			)}
		</nav>

		{related.length > 0 && (
			<section class="related" aria-label="相关文章">
				<h2 class="related__title">继续阅读</h2>
				<ul class="related__list">
					{related.map((item) => (
						<li>
							<a class="related__item glass" href={item.href}>
								<span class="related__date">{item.date}</span>
								<span class="related__name">{item.title}</span>
								<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="1.7"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
								</svg>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		<Giscus />
	</main>
</BaseLayout>

<style>
	.post {
		width: min(100% - 2 * var(--gutter), 720px);
		padding-bottom: clamp(2rem, 5vw, 3.5rem);
	}
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0.6rem 0 1.8rem;
		padding: 0.32rem 0.9rem 0.32rem 0.7rem;
		border-radius: var(--r-pill);
		background: var(--glass-bg);
		border: 1px solid var(--glass-brd);
		backdrop-filter: blur(10px);
		font-size: 0.82rem;
		text-decoration: none;
		color: rgb(var(--muted));
		transition:
			color var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out);
	}
	.back-link:hover {
		color: rgb(var(--accent-deep));
		transform: translateX(-3px);
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.82rem;
		letter-spacing: 0.04em;
		color: rgb(var(--muted-light));
	}
	.dot-sep {
		opacity: 0.6;
	}
	.post-title {
		font-size: clamp(1.9rem, 4.6vw, 2.7rem);
		line-height: 1.22;
		margin: 0.35em 0 0.7em;
		letter-spacing: -0.015em;
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.6rem;
	}
	.post-tags .tag {
		font-size: 0.74rem;
		padding: 0.2rem 0.7rem;
		border-radius: var(--r-pill);
		border: 1px solid rgba(var(--line), 1);
		background: var(--chip-bg);
		color: rgb(var(--muted));
	}

	.post-hero {
		margin: 0 0 1.8rem;
		border-radius: var(--r-lg);
		overflow: hidden;
		box-shadow: var(--glass-shine), var(--shadow-md);
	}
	.post-hero img {
		display: block;
		width: 100%;
	}

	.post-excerpt {
		padding: 1rem 1.2rem;
		border-radius: var(--r-md);
		border-left: 2px solid rgba(var(--accent), 0.55);
		font-size: 0.98rem;
		line-height: 1.75;
		color: rgb(var(--ink-soft));
		margin: 0 0 2rem;
	}

	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.8rem;
		margin: clamp(2.5rem, 6vw, 4rem) 0 2rem;
	}
	.post-nav__item {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.95rem 1.1rem;
		border-radius: var(--r-md);
		text-decoration: none;
		transition:
			transform var(--dur) var(--ease-out),
			box-shadow var(--dur) var(--ease-out);
	}
	.post-nav__item:hover {
		transform: translateY(-3px);
		box-shadow: var(--glass-shine), var(--shadow-md);
	}
	.post-nav__item--next {
		text-align: right;
		align-items: flex-end;
	}
	.post-nav__label {
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		color: rgb(var(--muted-light));
	}
	.post-nav__title {
		font-size: 0.95rem;
		font-weight: 600;
		color: rgb(var(--ink));
		line-height: 1.45;
	}
	.post-nav__item:hover .post-nav__title {
		color: rgb(var(--accent-deep));
	}

	.related {
		margin: 0 0 2rem;
	}
	.related__title {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		color: rgb(var(--muted-light));
		margin: 0 0 0.9rem;
		text-transform: uppercase;
	}
	.related__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}
	.related__item {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.85rem 1.1rem;
		border-radius: var(--r-md);
		text-decoration: none;
		color: inherit;
		transition:
			transform var(--dur) var(--ease-out),
			box-shadow var(--dur) var(--ease-out);
	}
	.related__item:hover {
		transform: translateX(4px);
		box-shadow: var(--glass-shine), var(--shadow-md);
	}
	.related__date {
		font-size: 0.76rem;
		color: rgb(var(--muted-light));
		font-variant-numeric: tabular-nums;
		flex-shrink: 0;
	}
	.related__name {
		flex: 1;
		font-size: 0.95rem;
		font-weight: 600;
		color: rgb(var(--ink));
		line-height: 1.4;
	}
	.related__item:hover .related__name {
		color: rgb(var(--accent-deep));
	}
	.related__item svg {
		color: rgb(var(--muted-light));
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}
	.related__item:hover svg {
		opacity: 1;
		transform: none;
		color: rgb(var(--accent));
	}

	@media (max-width: 620px) {
		.post-nav {
			grid-template-columns: 1fr;
		}
		.post-nav__item--next {
			text-align: left;
			align-items: flex-start;
		}
	}
</style>
