---
import BaseLayout from '../layouts/BaseLayout.astro';
import Shredder from '../components/Shredder.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`页面未找到 · ${SITE_TITLE}`} description="你访问的页面不存在。">
	<main class="not-found">
		<div class="not-found__copy">
			<span class="sec-head__index">ERROR / 404</span>
			<h1>这一页，走丢了</h1>
			<p>
				链接可能已经失效，或者地址写错了一个字母。<br />
				要不，把它送进碎纸机？
			</p>
			<div class="quick-links">
				<a href="/">回到首页</a>
				<a href="/blog">看看文章</a>
				<a href="/gallery">看看照片</a>
			</div>
		</div>

		<div class="not-found__machine">
			<Shredder
				title="404"
				message="这一页好像被人碎掉了。"
				actionLabel="碎掉这一页"
				resetLabel="复原"
				homeHref="/"
				homeLabel="回到首页"
				width={340}
				height={440}
			/>
		</div>
	</main>
</BaseLayout>

<style>
	.not-found {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: clamp(1.5rem, 5vw, 4rem);
		width: var(--w-page);
		padding: clamp(2rem, 6vw, 4rem) 0;
	}
	.not-found__copy h1 {
		font-size: clamp(2rem, 5vw, 3.2rem);
		margin: 0.25em 0 0.5em;
	}
	.not-found__copy p {
		color: rgb(var(--muted));
		max-width: 34ch;
	}
	.quick-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.4rem;
	}
	.quick-links a {
		padding: 0.5rem 1.05rem;
		border-radius: var(--r-pill);
		border: 1px solid rgba(var(--line), 1);
		background: var(--glass-bg);
		backdrop-filter: blur(10px);
		font-size: 0.85rem;
		text-decoration: none;
		color: rgb(var(--ink-soft));
		transition:
			transform var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}
	.quick-links a:hover {
		transform: translateY(-2px);
		border-color: rgba(var(--accent), 0.45);
		color: rgb(var(--accent-deep));
	}
	.not-found__machine {
		justify-self: center;
	}

	@media (max-width: 900px) {
		.not-found {
			grid-template-columns: 1fr;
			text-align: center;
		}
		.not-found__copy p {
			margin-inline: auto;
		}
		.quick-links {
			justify-content: center;
		}
	}
</style>
