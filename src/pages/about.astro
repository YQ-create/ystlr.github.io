---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="about-main">
			<section class="intro">
				<p class="section-kicker">ABOUT</p>
				<h1>你好，我是 {AUTHOR_NAME}</h1>
				<p class="bio">
					这里是一段占位简介：介绍你是谁、在记录什么、关注哪些方向。本站用来沉淀日常随笔、阅读笔记与生活照片，
					慢慢整理成属于自己的记录空间。
				</p>
				<p class="bio">
					写作偏随性，不追求产量；照片用来留住那些容易被遗忘的瞬间。想看看最近写了什么，可以前往{' '}
					<a href="/blog">文章</a>；想看看最近拍了什么，可以前往 <a href="/gallery">照片墙</a>。
				</p>
			</section>

			<section class="info">
				<div class="info-col">
					<h2>在这里记录什么</h2>
					<ul>
						<li>日常随笔</li>
						<li>阅读笔记</li>
						<li>生活片段</li>
						<li>随想与思考</li>
					</ul>
				</div>
				<div class="info-col">
					<h2>保持联系</h2>
					<ul class="contact-list">
						{SOCIAL_LINKS.email && (
							<li>
								<span>邮箱</span>
								<a href={SOCIAL_LINKS.email}>{SOCIAL_LINKS.email.replace('mailto:', '')}</a>
							</li>
						)}
						{SOCIAL_LINKS.github && (
							<li>
								<span>GitHub</span>
								<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">YQ-create</a>
							</li>
						)}
					</ul>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-main {
		max-width: none;
		width: 100%;
		padding: 0;
	}
	section {
		max-width: 1040px;
		margin: 0 auto;
		padding: 3.5em 1.5em;
	}
	.intro {
		border-bottom: 1px solid rgb(var(--line));
	}
	.section-kicker {
		color: rgb(var(--accent));
		font-size: 0.9rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		margin: 0 0 1em;
	}
	.intro h1 {
		font-size: clamp(2rem, 4vw, 2.6rem);
		margin: 0 0 0.8em;
	}
	.bio {
		color: rgb(var(--muted));
		max-width: 620px;
		margin-bottom: 1em;
	}
	.info {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3em;
	}
	.info-col h2 {
		font-size: 1.1rem;
		margin-bottom: 1em;
		color: rgb(var(--ink));
	}
	.info-col ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6em;
	}
	.info-col li {
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		padding: 0.25em 1em;
		color: rgb(var(--muted));
		font-size: 0.9rem;
	}
	.contact-list {
		flex-direction: column;
		gap: 0.7em;
	}
	.contact-list li {
		display: flex;
		gap: 1em;
		border: none;
		padding: 0;
	}
	.contact-list span {
		color: rgb(var(--muted-light));
		width: 64px;
		flex-shrink: 0;
	}

	@media (max-width: 720px) {
		.info {
			grid-template-columns: 1fr;
			gap: 2em;
		}
	}
</style>
