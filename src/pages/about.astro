---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import { getCollection } from 'astro:content';
import { AUTHOR_NAME, PROFILE, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';

const posts = await getCollection('blog');
const photos = await getCollection('gallery');

const published = posts
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recent = published.slice(0, 3);

const startedAt = posts.reduce<Date | null>((earliest, post) => {
	const d = post.data.pubDate;
	return !earliest || d < earliest ? d : earliest;
}, null);

const facts = [
	{ label: '记录方式', value: '文字 · 照片' },
	{ label: '更新节奏', value: '不定期，想起来就写' },
	{ label: '文章数量', value: `${posts.length} 篇` },
	{ label: '照片数量', value: `${photos.length} 张` },
	{ label: '站点技术', value: 'Astro · GitHub Pages' },
	{ label: '留言', value: '文章页底部评论区' },
];

const topics = PROFILE.topics;
---

<BaseLayout title={`关于 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main class="about">
		<section class="about-hero">
			<div class="about-hero__blob" aria-hidden="true"></div>
			<div class="wrap">
				<SpotlightCard class="about-card" color="255,184,108" size={280} intensity={0.16} tilt={3}>
					<div class="about-card__ava" aria-hidden="true">
						{PROFILE.avatar ? (
							<img src={PROFILE.avatar} alt={AUTHOR_NAME} loading="lazy" decoding="async" />
						) : (
							<span>{AUTHOR_NAME.slice(0, 1).toUpperCase()}</span>
						)}
					</div>
					<div class="about-card__id">
						<h1>{AUTHOR_NAME}</h1>
						<span class="about-card__role">{PROFILE.role}</span>
					</div>
					<p class="about-card__bio">{PROFILE.bio}</p>
					<div class="about-card__social">
						{SOCIAL_LINKS.github && (
							<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener" aria-label="GitHub">
								<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
									<path
										fill="currentColor"
										d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
									></path>
								</svg>
							</a>
						)}
						{SOCIAL_LINKS.email && (
							<a href={SOCIAL_LINKS.email} aria-label="邮箱">
								<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
									<path
										fill="currentColor"
										d="M1.5 3h13a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5Zm.7 1 5.68 4.38a.5.5 0 0 0 .64 0L14.1 4H2.2ZM14 5.62 9.62 8.99a1.5 1.5 0 0 1-1.92 0L3 5.62V12h11V5.62Z"
									></path>
								</svg>
							</a>
						)}
					</div>
					{startedAt && (
						<p class="about-card__since">
							<span>从</span>
							<FormattedDate date={startedAt} />
							<span>开始记录</span>
						</p>
					)}
				</SpotlightCard>
			</div>
		</section>

		<section class="wrap about-body">
			<div class="panel glass" data-reveal data-glow>
				<h2>在这里记录什么</h2>
				<ul class="chips">
					{topics.map((topic) => (
						<li>{topic}</li>
					))}
				</ul>
			</div>

			<div class="panel glass" data-reveal data-reveal-delay="80" data-glow>
				<h2>保持联系</h2>
				<ul class="contact">
					{SOCIAL_LINKS.email && (
						<li>
							<span>邮箱</span>
							<a href={SOCIAL_LINKS.email}>{SOCIAL_LINKS.email.replace('mailto:', '')}</a>
						</li>
					)}
					{SOCIAL_LINKS.github && (
						<li>
							<span>GitHub</span>
							<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">YQ-create</a>
						</li>
					)}
				</ul>
			</div>
		</section>

		<section class="wrap about-facts">
			<dl class="fact-grid">
				{facts.map((fact, i) => (
					<div class="fact" data-reveal data-reveal-delay={i * 50}>
						<dt>{fact.label}</dt>
						<dd>{fact.value}</dd>
					</div>
				))}
			</dl>
		</section>

		{recent.length > 0 && (
			<section class="wrap about-recent">
				<header class="about-recent__head" data-reveal>
					<div>
						<span class="sec-head__index">RECENT / {String(recent.length).padStart(2, '0')}</span>
						<h2>最近写的</h2>
					</div>
					<a class="sec-head__more" href="/blog">
						全部文章
						<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
							<path
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"
							/>
						</svg>
					</a>
				</header>

				<ul class="recent-list">
					{recent.map((post, i) => (
						<li data-reveal data-reveal-delay={i * 70}>
							<a href={`/blog/${post.id}/`}>
								<span class="recent-date"><FormattedDate date={post.data.pubDate} /></span>
								<span class="recent-title">{post.data.title}</span>
								<span class="recent-desc">{post.data.description}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}
	</main>
</BaseLayout>

<style>
	/* 与全站正文同宽（main 默认是阅读宽度 --w-read） */
	main.about {
		width: var(--w-page);
	}
	.wrap {
		width: 100%;
		margin: 0 auto;
	}

	.about-hero {
		position: relative;
		padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(1.5rem, 4vw, 2.5rem);
		overflow: hidden;
		isolation: isolate;
	}
	.about-hero__blob {
		position: absolute;
		top: -6%;
		right: -4%;
		width: min(620px, 78vw);
		aspect-ratio: 1;
		z-index: -1;
		border-radius: 50%;
		background:
			radial-gradient(circle at 38% 34%, rgba(var(--accent), 0.07), transparent 58%),
			radial-gradient(circle at 64% 62%, rgba(var(--ochre), 0.05), transparent 56%);
		filter: blur(64px);
		/* 光晕自己在边缘淡出，免得被 .about-hero 的 overflow 裁成一块硬边矩形 */
		-webkit-mask-image: radial-gradient(closest-side circle, #000 30%, transparent 72%);
		mask-image: radial-gradient(closest-side circle, #000 30%, transparent 72%);
		animation: blob-drift 22s var(--ease-out) infinite alternate;
	}
	@keyframes blob-drift {
		to {
			transform: translate3d(-6%, 8%, 0) scale(1.12);
		}
	}
	.about-hero h1 {
		margin: 0;
	}
	.accent {
		color: rgb(var(--accent));
	}

	/* 资料名片（SpotlightCard 聚光灯卡片） */
	:global(.about-card) {
		display: grid;
		grid-template-columns: 104px minmax(0, 1fr);
		align-items: start;
		gap: 1rem clamp(1.2rem, 2.6vw, 2rem);
		max-width: 820px;
		padding: clamp(1.4rem, 3vw, 2.1rem);
		border-radius: var(--card-radius, var(--r-xl));
		background: rgb(var(--paper));
		border: 1px solid rgb(var(--line-soft));
	}
	.about-card__ava,
	.about-card__social {
		grid-column: 1;
	}
	.about-card__id,
	.about-card__bio {
		grid-column: 2;
	}
	.about-card__ava {
		width: 104px;
		height: 104px;
		border-radius: 14px;
		display: grid;
		place-items: center;
		overflow: hidden;
		font-size: 1.6rem;
		font-weight: 800;
		color: #fff;
		background:
			radial-gradient(120% 90% at 30% 20%, rgba(var(--accent), 0.5), transparent 60%),
			linear-gradient(160deg, rgba(var(--ochre), 0.4), rgba(var(--sage), 0.3));
	}
	.about-card__ava img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.about-card__id {
		display: flex;
		align-items: baseline;
		gap: 0.8rem;
		flex-wrap: wrap;
	}
	.about-card__id h1 {
		font-size: clamp(1.8rem, 3.4vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.05;
		margin: 0 0 0.35rem;
	}
	.about-card__role {
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgb(var(--muted-light));
	}
	.about-card__bio {
		margin: 0;
		max-width: 50ch;
		color: rgb(var(--ink-soft));
		font-size: 0.98rem;
		line-height: 1.75;
	}
	.about-card__social {
		display: flex;
		gap: 0.5rem;
	}
	.about-card__social a {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		color: rgb(var(--muted));
		text-decoration: none;
		background: var(--chip-bg);
		border: 1px solid var(--glass-brd-dim);
		transition:
			color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out);
	}
	.about-card__social a:hover {
		color: rgb(var(--accent));
		background: var(--chip-bg-strong);
		transform: translateY(-2px);
	}
	.about-card__since {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4em;
		margin: 0;
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		color: rgb(var(--muted));
	}

	.about-body {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: clamp(1rem, 2.5vw, 1.6rem);
		padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
	}
	.panel {
		padding: clamp(1.3rem, 3vw, 2rem);
		border-radius: var(--r-xl);
	}
	.panel h2 {
		font-size: 1.05rem;
		margin: 0 0 1.1rem;
		letter-spacing: 0.02em;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.chips li {
		padding: 0.35rem 0.95rem;
		border-radius: var(--r-pill);
		border: 1px solid rgba(var(--line), 1);
		background: var(--chip-bg);
		font-size: 0.85rem;
		color: rgb(var(--ink-soft));
		transition:
			transform var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}
	.chips li:hover {
		transform: translateY(-2px);
		border-color: rgba(var(--accent), 0.45);
		color: rgb(var(--accent-deep));
	}
	.contact {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	.contact li {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px dashed rgba(var(--line), 0.95);
	}
	.contact li:last-child {
		border-bottom: none;
	}
	.contact span {
		width: 56px;
		flex-shrink: 0;
		font-size: 0.8rem;
		color: rgb(var(--muted-light));
	}
	.contact a {
		color: rgb(var(--ink));
		text-decoration: none;
		border-bottom: 1px solid rgba(var(--accent), 0.35);
	}
	.contact a:hover {
		color: rgb(var(--accent));
	}

	.about-facts {
		padding-bottom: clamp(2rem, 4vw, 3rem);
	}
	.fact-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1px;
		margin: 0;
		background: rgba(var(--line), 1);
		border-radius: var(--r-lg);
		overflow: hidden;
	}
	.fact {
		background: var(--glass-bg-strong);
		padding: 1.1rem 1.2rem;
		transition: background-color var(--dur-fast) var(--ease-out);
	}
	.fact:hover {
		background: var(--chip-bg-strong);
	}
	.fact dt {
		font-size: 0.74rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgb(var(--muted-light));
		margin-bottom: 0.35rem;
	}
	.fact dd {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 600;
		color: rgb(var(--ink));
	}

	@media (max-width: 860px) {
		.about-body {
			grid-template-columns: 1fr;
		}
		.fact-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 520px) {
		.fact-grid {
			grid-template-columns: 1fr;
		}
	}

	/* ---- 最近写的 ---- */
	.about-recent {
		padding-bottom: clamp(2.5rem, 5vw, 4rem);
	}
	.about-recent__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.1rem;
	}
	.about-recent__head h2 {
		margin: 0;
		font-size: clamp(1.3rem, 2.4vw, 1.6rem);
	}
	.recent-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.7rem, 1.8vw, 1rem);
	}
	.recent-list a {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		height: 100%;
		padding: 1.05rem 1.15rem;
		border-radius: var(--r-lg);
		border: 1px solid var(--glass-brd-dim);
		background: var(--glass-bg);
		backdrop-filter: blur(14px);
		text-decoration: none;
		transition:
			transform var(--dur) var(--ease-out),
			border-color var(--dur) var(--ease-out);
	}
	.recent-list a:hover {
		transform: translateY(-3px);
		border-color: rgba(var(--accent), 0.35);
	}
	.recent-date {
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		color: rgb(var(--muted-light));
		font-variant-numeric: tabular-nums;
	}
	.recent-title {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.45;
		color: rgb(var(--ink));
	}
	.recent-list a:hover .recent-title {
		color: rgb(var(--accent-deep));
	}
	.recent-desc {
		font-size: 0.82rem;
		line-height: 1.6;
		color: rgb(var(--muted));
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (max-width: 860px) {
		.recent-list {
			grid-template-columns: 1fr;
		}
	}
</style>
