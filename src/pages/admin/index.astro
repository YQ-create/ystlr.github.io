---
import { ADMIN } from '../../consts';

// 管理后台：纯静态页面 + GitHub API 直连，没有后端服务，也不在站点导航里暴露。
// 所有改动都会提交到仓库 main 分支，由 Actions 重新构建发布。
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>管理后台 · {ADMIN.repo}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	</head>
	<body>
		<header class="bar">
			<a class="brand" href="/">
				<span class="dot" aria-hidden="true"></span>
				<span>ystlr</span>
				<span class="sep">/</span>
				<span class="muted">管理后台</span>
			</a>
			<div class="bar-right">
				<span class="who" data-who></span>
				<a class="link" data-actions href="#" target="_blank" rel="noopener" hidden>构建进度 ↗</a>
				<button class="ghost" type="button" data-logout hidden>退出</button>
			</div>
		</header>

		<main class="wrap">
			<!-- 登录 -->
			<section class="card login" data-login>
				<h1>登录</h1>
				<p class="note">
					用 GitHub Token 登录。只有持有该仓库写入权限的 Token 才能进来，所以这里不需要额外的密码系统。
				</p>
				<form data-login-form autocomplete="off">
					<label>
						<span>仓库</span>
						<input name="repo" value={`${ADMIN.owner}/${ADMIN.repo}`} required />
					</label>
					<label>
						<span>分支</span>
						<input name="branch" value={ADMIN.branch} required />
					</label>
					<label>
						<span>GitHub Token</span>
						<input name="token" type="password" placeholder="github_pat_… 或 ghp_…" required />
					</label>
					<label class="check">
						<input name="remember" type="checkbox" checked />
						<span>记住登录（只存在这台电脑的浏览器里）</span>
					</label>
					<button class="primary" type="submit">登录</button>
					<p class="err" data-login-error hidden></p>
				</form>

				<details>
					<summary>怎么拿到 Token？</summary>
					<ol>
						<li>
							打开
							<a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">
								Fine-grained tokens → Generate new token
							</a>
						</li>
						<li>Repository access 选 <strong>Only select repositories</strong>，勾选 <code>{ADMIN.repo}</code></li>
						<li>Permissions → Repository permissions → <strong>Contents: Read and write</strong></li>
						<li>有效期建议 1 年，生成后复制 <code>github_pat_…</code> 粘贴到上面</li>
					</ol>
					<p class="note">
						Token 等同于仓库写入权限：只在自己电脑上登录，不要在公共电脑勾选「记住登录」。
					</p>
				</details>
			</section>

			<!-- 后台主体 -->
			<section data-app hidden>
				<nav class="tabs" role="tablist">
					<button type="button" class="tab on" data-tab="projects" role="tab">作品</button>
					<button type="button" class="tab" data-tab="blog" role="tab">博客</button>
					<button type="button" class="tab" data-tab="music" role="tab">音乐</button>
				</nav>

				<!-- 作品 -->
				<div data-panel="projects">
					<div class="panel-head">
						<div>
							<h2>作品</h2>
							<p class="note">首页横滑与 /projects 共用这份数据，保存后约 1–2 分钟上线。</p>
						</div>
						<button class="primary" type="button" data-project-new>+ 新建作品</button>
					</div>

					<ul class="list" data-projects-list></ul>

					<form class="card form" data-project-form hidden>
						<h3 data-project-form-title>作品信息</h3>
						<label>
							<span>标题</span>
							<input name="title" required maxlength="40" />
						</label>
						<label>
							<span>简介</span>
							<textarea name="description" rows="3" required maxlength="200"></textarea>
						</label>
						<div class="grid2">
							<label>
								<span>标签（逗号分隔）</span>
								<input name="tags" placeholder="品牌视觉, 3D 图形" />
							</label>
							<label>
								<span>年份</span>
								<input name="year" maxlength="4" inputmode="numeric" />
							</label>
						</div>
						<label>
							<span>外链（可留空）</span>
							<input name="link" type="url" placeholder="https://…" />
						</label>
						<label>
							<span>封面图</span>
							<input name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
						</label>
						<p class="note" data-project-cover-hint></p>
						<div class="actions">
							<button class="primary" type="submit">保存</button>
							<button class="ghost" type="button" data-project-cancel>取消</button>
							<button class="ghost danger" type="button" data-project-delete hidden>删除</button>
						</div>
						<p class="err" data-project-error hidden></p>
					</form>
				</div>

				<!-- 博客 -->
				<div data-panel="blog" hidden>
					<div class="panel-head">
						<div>
							<h2>博客</h2>
							<p class="note">写 Markdown 正文，保存即提交到 <code>src/content/blog/</code>。</p>
						</div>
						<button class="primary" type="button" data-blog-new>+ 写新文章</button>
					</div>

					<ul class="list" data-blog-list></ul>

					<form class="card form" data-blog-form hidden>
						<h3>文章</h3>
						<label>
							<span>标题</span>
							<input name="title" required maxlength="80" />
						</label>
						<div class="grid2">
							<label>
								<span>文件名（可留空自动生成）</span>
								<input name="slug" placeholder="my-first-post" />
							</label>
							<label>
								<span>发布日期</span>
								<input name="pubDate" type="date" required />
							</label>
						</div>
						<label>
							<span>摘要</span>
							<input name="description" required maxlength="160" />
						</label>
						<div class="grid2">
							<label>
								<span>标签（逗号分隔）</span>
								<input name="tags" placeholder="前端, 学习笔记" />
							</label>
							<label>
								<span>题图（可选）</span>
								<input name="heroImage" type="file" accept="image/jpeg,image/png,image/webp" />
							</label>
						</div>
						<p class="note" data-blog-hero-hint></p>
						<label>
							<span>正文（Markdown）</span>
							<textarea name="body" rows="16" required placeholder="## 小标题&#10;&#10;正文……"></textarea>
						</label>
						<div class="actions">
							<button class="primary" type="submit">发布</button>
							<button class="ghost" type="button" data-blog-cancel>取消</button>
							<button class="ghost danger" type="button" data-blog-delete>删除</button>
						</div>
						<p class="err" data-blog-error hidden></p>
					</form>
				</div>

				<!-- 音乐 -->
				<div data-panel="music" hidden>
					<div class="panel-head">
						<div>
							<h2>音乐</h2>
							<p class="note">
								上传的音频放在 <code>public/audio/</code>，按顺序出现在顶部播放器里。建议 mp3，单曲 25MB 以内。
							</p>
						</div>
					</div>

					<ul class="list" data-music-list></ul>

					<form class="card form" data-music-form>
						<h3>添加曲目</h3>
						<div class="grid2">
							<label>
								<span>曲名</span>
								<input name="title" required maxlength="60" />
							</label>
							<label>
								<span>作者 / 备注（可留空）</span>
								<input name="artist" maxlength="60" />
							</label>
						</div>
						<label>
							<span>音频文件</span>
							<input name="file" type="file" accept="audio/mpeg,audio/mp4,audio/ogg,audio/wav" required />
						</label>
						<div class="actions">
							<button class="primary" type="submit">上传并添加</button>
						</div>
						<p class="err" data-music-error hidden></p>
					</form>
				</div>
			</section>

			<p class="footnote">
				所有保存都会生成一次 git commit（作者显示为你的 GitHub 账号），随后由
				<a href={`https://github.com/${ADMIN.owner}/${ADMIN.repo}/actions`} target="_blank" rel="noopener">GitHub Actions</a>
				自动重建站点。
			</p>
		</main>

		<div class="toast" data-toast role="status" aria-live="polite"></div>

		<script>
			import { boot } from '../../admin/app';
			boot();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0d0f0e;
		--surface: #141715;
		--ink: #f2f4f1;
		--muted: #9aa39c;
		--muted-light: #6f776f;
		--line: #262b27;
		--accent: #b4ff3a;
		--danger: #ff5a52;
		color-scheme: dark;
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family:
			'PingFang SC', 'Microsoft YaHei', system-ui, -apple-system, 'Segoe UI', sans-serif;
		line-height: 1.6;
	}
	a {
		color: inherit;
	}
	code {
		font-size: 0.85em;
		background: rgba(255, 255, 255, 0.06);
		padding: 0.1em 0.35em;
		border-radius: 4px;
	}

	.bar {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		padding: 0.9em 1.4em;
		background: rgba(13, 15, 14, 0.85);
		border-bottom: 1px solid var(--line);
		backdrop-filter: blur(10px);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0.03em;
	}
	.brand .dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 10px rgba(180, 255, 58, 0.7);
	}
	.brand .sep,
	.brand .muted {
		color: var(--muted-light);
		font-weight: 500;
	}
	.bar-right {
		display: flex;
		align-items: center;
		gap: 0.9em;
		font-size: 0.85rem;
	}
	.who {
		color: var(--muted);
	}
	.link {
		color: var(--accent);
		text-decoration: none;
	}

	.wrap {
		max-width: 880px;
		margin: 0 auto;
		padding: 2.2em 1.4em 5em;
	}
	h1,
	h2,
	h3 {
		line-height: 1.25;
	}
	h1 {
		font-size: 1.5rem;
		margin: 0 0 0.4em;
	}
	h2 {
		font-size: 1.25rem;
		margin: 0;
	}
	h3 {
		font-size: 1rem;
		margin: 0 0 1em;
	}
	.note {
		margin: 0.2em 0 0;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.6;
	}
	.footnote {
		margin-top: 2.5em;
		color: var(--muted-light);
		font-size: 0.78rem;
		text-align: center;
	}

	.card {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 18px;
		padding: 1.6em;
	}
	.login {
		max-width: 520px;
		margin: 1em auto;
	}
	.login h1 {
		font-size: 1.35rem;
	}
	form {
		display: grid;
		gap: 0.9em;
		margin-top: 1.2em;
	}
	label {
		display: grid;
		gap: 0.35em;
		font-size: 0.85rem;
		color: var(--muted);
	}
	input,
	textarea {
		width: 100%;
		padding: 0.6em 0.7em;
		border-radius: 10px;
		border: 1px solid var(--line);
		background: #0b0d0c;
		color: var(--ink);
		font: inherit;
		font-size: 0.9rem;
	}
	input:focus,
	textarea:focus {
		outline: 2px solid rgba(180, 255, 58, 0.35);
		outline-offset: 1px;
		border-color: rgba(180, 255, 58, 0.5);
	}
	textarea {
		resize: vertical;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		line-height: 1.6;
	}
	.check {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-size: 0.8rem;
	}
	.check input {
		width: auto;
	}
	.grid2 {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.9em;
	}
	.actions {
		display: flex;
		gap: 0.7em;
		align-items: center;
		margin-top: 0.4em;
	}
	button {
		font: inherit;
		cursor: pointer;
		border-radius: 10px;
	}
	.primary {
		padding: 0.62em 1.15em;
		border: none;
		background: var(--accent);
		color: #0d0f0e;
		font-weight: 700;
		font-size: 0.9rem;
	}
	.primary:hover {
		filter: brightness(1.08);
	}
	.primary:disabled {
		opacity: 0.6;
		cursor: progress;
	}
	.ghost {
		padding: 0.55em 0.95em;
		background: transparent;
		border: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.86rem;
	}
	.ghost:hover {
		color: var(--ink);
		border-color: var(--muted-light);
	}
	.ghost.danger {
		color: var(--danger);
		border-color: rgba(255, 90, 82, 0.35);
	}

	details {
		margin-top: 1.4em;
		border-top: 1px solid var(--line);
		padding-top: 1em;
		color: var(--muted);
		font-size: 0.84rem;
	}
	summary {
		cursor: pointer;
		color: var(--ink);
	}
	details ol {
		padding-left: 1.2em;
	}
	details li {
		margin: 0.3em 0;
	}

	.tabs {
		display: inline-flex;
		gap: 0.3em;
		padding: 0.3em;
		margin: 0 0 1.6em;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
	}
	.tab {
		padding: 0.45em 1.1em;
		border: none;
		background: transparent;
		color: var(--muted);
		font-size: 0.88rem;
		border-radius: 999px;
	}
	.tab.on {
		background: rgba(180, 255, 58, 0.12);
		color: var(--accent);
	}

	.panel-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1em;
		margin-bottom: 1.1em;
	}

	.list {
		list-style: none;
		margin: 0 0 1.2em;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 16px;
		overflow: hidden;
		background: var(--surface);
	}
	.list li {
		display: flex;
		align-items: center;
		gap: 0.6em;
		border-bottom: 1px solid var(--line);
	}
	.list li:last-child {
		border-bottom: none;
	}
	.list li.empty {
		padding: 1.1em 1.2em;
		color: var(--muted-light);
		font-size: 0.86rem;
	}
	.item {
		flex: 1;
		display: grid;
		gap: 0.1em;
		padding: 0.85em 1.1em;
		border: none;
		background: transparent;
		text-align: left;
		color: var(--ink);
	}
	.item:not(.static):hover {
		background: rgba(180, 255, 58, 0.06);
	}
	.item-main {
		font-size: 0.94rem;
		font-weight: 600;
	}
	.item-sub {
		font-size: 0.75rem;
		color: var(--muted-light);
	}
	.list .ghost {
		margin-right: 0.8em;
	}

	.form {
		margin-top: 0.4em;
	}
	.err {
		margin: 0.2em 0 0;
		color: var(--danger);
		font-size: 0.82rem;
	}

	.toast {
		position: fixed;
		right: 1.2em;
		bottom: 1.2em;
		max-width: 380px;
		padding: 0.85em 1.1em;
		border-radius: 12px;
		border: 1px solid var(--line);
		background: #1a1f1b;
		color: var(--ink);
		font-size: 0.86rem;
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
		transition: opacity 0.2s ease, transform 0.2s ease;
		z-index: 50;
	}
	.toast.show {
		opacity: 1;
		transform: none;
	}
	.toast.err {
		border-color: rgba(255, 90, 82, 0.5);
		color: #ffd9d7;
	}

	@media (max-width: 640px) {
		.grid2 {
			grid-template-columns: 1fr;
		}
		.panel-head {
			flex-direction: column;
		}
		.brand .muted,
		.brand .sep {
			display: none;
		}
	}
</style>
