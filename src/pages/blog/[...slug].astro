---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

	return posts.map((post, i) => {
		// posts 是倒序：i+1 更早（上一篇），i-1 更新（下一篇）
		const older = posts[i + 1];
		const newer = posts[i - 1];
		return {
			params: { slug: post.id },
			props: {
				post,
				prev: older && { href: `/blog/${older.id}/`, title: older.data.title },
				next: newer && { href: `/blog/${newer.id}/`, title: newer.data.title },
			},
		};
	});
}
type Props = {
	post: CollectionEntry<'blog'>;
	prev?: { href: string; title: string };
	next?: { href: string; title: string };
};

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

// 粗估阅读时长：去掉 Markdown 记号后按 350 字/分钟算
const plain = (post.body ?? '')
	.replace(/```[\s\S]*?```/g, '')
	.replace(/!\[[^\]]*\]\([^)]*\)/g, '')
	.replace(/\[[^\]]*\]\([^)]*\)/g, '')
	.replace(/[#>*_`~\-|]/g, '');
const readingMinutes = Math.max(1, Math.round(plain.length / 350));
---

<BlogPost {...post.data} readingMinutes={readingMinutes} prev={prev} next={next}>
	<Content />
</BlogPost>
