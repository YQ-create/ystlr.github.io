---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((post) => !post.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

	return posts.map((post, i) => {
		// posts 是倒序：i+1 更早（上一篇），i-1 更新（下一篇）
		const older = posts[i + 1];
		const newer = posts[i - 1];
		// 相关文章：优先挑标签有交集的（按交集数量降序），不够再用最新的补，
		// 排除自己、上一篇、下一篇，避免和底部导航重复。
		const exclude = new Set([post.id, older?.id, newer?.id].filter(Boolean));
		const others = posts.filter((p) => !exclude.has(p.id));
		const scored = others
			.map((p) => {
				const overlap = p.data.tags.filter((t) => post.data.tags.includes(t)).length;
				return { p, overlap };
			})
			.sort((a, b) => b.overlap - a.overlap || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf());
		const related = scored.slice(0, 3).map(({ p }) => ({
			href: `/blog/${p.id}/`,
			title: p.data.title,
			date: p.data.pubDate.toISOString().slice(0, 10),
		}));
		return {
			params: { slug: post.id },
			props: {
				post,
				prev: older && { href: `/blog/${older.id}/`, title: older.data.title },
				next: newer && { href: `/blog/${newer.id}/`, title: newer.data.title },
				related,
			},
		};
	});
}
type Props = {
	post: CollectionEntry<'blog'>;
	prev?: { href: string; title: string };
	next?: { href: string; title: string };
	related?: { href: string; title: string; date: string }[];
};

const { post, prev, next, related = [] } = Astro.props;
const { Content, headings } = await render(post);

// 粗估阅读时长：去掉 Markdown 记号后按 350 字/分钟算
const plain = (post.body ?? '')
	.replace(/```[\s\S]*?```/g, '')
	.replace(/!\[[^\]]*\]\([^)]*\)/g, '')
	.replace(/\[[^\]]*\]\([^)]*\)/g, '')
	.replace(/[#>*_`~\-|]/g, '');
const plainChars = plain.replace(/\s/g, '').length;
const readingMinutes = Math.max(1, Math.round(plain.length / 350));
---

<BlogPost
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	heroImage={post.data.heroImage as ImageMetadata}
	tags={post.data.tags}
	readingMinutes={readingMinutes}
	words={plainChars}
	headings={headings}
	prev={prev}
	next={next}
	related={related}
>
	<Content />
</BlogPost>
