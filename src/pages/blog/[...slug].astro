---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BlogPost from '../../layouts/BlogPost.astro';
import discoverData from '../../data/discover.json';

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((post) => !post.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	const notes = (await getCollection('knowledge')).filter((n) => !n.data.draft);
	const links = discoverData.collections.flatMap((g) => g.links);

	return posts.map((post, i) => {
		const older = posts[i + 1];
		const newer = posts[i - 1];
		const topics = post.data.topics;

		// 相关文章：topics 交集降序，排除自己与相邻文章
		const exclude = new Set([post.id, older?.id, newer?.id].filter(Boolean));
		const related = posts
			.filter((p) => !exclude.has(p.id))
			.map((p) => ({ p, overlap: p.data.topics.filter((t) => topics.includes(t)).length }))
			.sort((a, b) => b.overlap - a.overlap || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
			.slice(0, 3)
			.map(({ p }) => ({ href: `/blog/${p.id}/`, title: p.data.title, date: p.data.pubDate.toISOString().slice(0, 10) }));

		// 相关知识：topics 有交集才推荐
		const relatedNotes = notes
			.map((n) => ({ n, overlap: n.data.topics.filter((t) => topics.includes(t)).length }))
			.filter((x) => x.overlap > 0)
			.sort((a, b) => b.overlap - a.overlap)
			.slice(0, 3)
			.map(({ n }) => ({ href: `/knowledge/${n.id}/`, title: n.data.title }));

		// 相关发现：topics 有交集才推荐
		const relatedLinks = links
			.filter((l) => ((l as { topics?: string[] }).topics ?? []).some((t) => topics.includes(t)))
			.slice(0, 3)
			.map((l) => ({ href: l.url, title: l.name }));

		return {
			params: { slug: post.id },
			props: {
				post,
				prev: older && { href: `/blog/${older.id}/`, title: older.data.title },
				next: newer && { href: `/blog/${newer.id}/`, title: newer.data.title },
				related,
				relatedNotes,
				relatedLinks,
			},
		};
	});
}
type Props = {
	post: CollectionEntry<'blog'>;
	prev?: { href: string; title: string };
	next?: { href: string; title: string };
	related?: { href: string; title: string; date: string }[];
	relatedNotes?: { href: string; title: string }[];
	relatedLinks?: { href: string; title: string }[];
};

const { post, prev, next, related = [], relatedNotes = [], relatedLinks = [] } = Astro.props;
const { Content, headings } = await render(post);

// 粗估阅读时长：去掉 Markdown 记号后按 350 字/分钟算
const plain = (post.body ?? '')
	.replace(/```[\s\S]*?```/g, '')
	.replace(/!\[[^\]]*\]\([^)]*\)/g, '')
	.replace(/\[[^\]]*\]\([^)]*\)/g, '')
	.replace(/[#>*_`~\-|]/g, '');
const plainChars = plain.replace(/\s/g, '').length;
const readingMinutes = Math.max(1, Math.round(plain.length / 350));
---

<BlogPost
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	heroImage={post.data.heroImage as ImageMetadata}
	topics={post.data.topics}
	readingMinutes={readingMinutes}
	words={plainChars}
	headings={headings}
	prev={prev}
	next={next}
	related={related}
	relatedNotes={relatedNotes}
	relatedLinks={relatedLinks}
>
	<Content />
</BlogPost>
