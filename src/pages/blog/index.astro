---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import SubmitPost from '../../components/SubmitPost.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// 草稿只在本地/详情页可见，不进公开列表
const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 汇总全站标签：按出现次数排序，常用的排前面（同次数按拼音）
const tagCount = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
}
const allTags = [...tagCount.entries()]
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hans-CN'))
	.map(([tag]) => tag);

// 按年份分组（时间线视图用）：年份从新到旧
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	if (!byYear.has(year)) byYear.set(year, []);
	byYear.get(year)!.push(post);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<BaseLayout title={`文章 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main class="blog-main">
		<header class="page-head" data-reveal>
			<span class="sec-head__index">ARCHIVE / {String(posts.length).padStart(2, '0')}</span>
			<h1>文章</h1>
			<p>记录日常、想法与读过的东西，按时间倒序排列。</p>
		</header>

		<SubmitPost />

		<div class="toolbar glass" data-reveal data-reveal-delay="80">
			<label class="search">
				<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						d="M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm4-1.5 3 3"></path>
				</svg>
				<input
					id="post-search"
					type="search"
					placeholder="搜索标题、摘要或标签…"
					aria-label="搜索文章"
					autocomplete="off"
				/>
			</label>

			<div class="tag-filter" id="tag-filter" role="group" aria-label="按标签筛选">
				<button class="tag-chip is-active" data-tag="" type="button">全部</button>
				{allTags.map((tag) => (
					<button class="tag-chip" data-tag={tag} type="button">{tag}</button>
				))}
			</div>
		</div>

		<p class="result-count" id="result-count" aria-live="polite"></p>

		<div class="view-toggle" data-reveal data-reveal-delay="40">
			<button class="view-toggle__btn is-active" type="button" data-view="list">列表</button>
			<button class="view-toggle__btn" type="button" data-view="timeline">时间线</button>
		</div>

		<ul class="post-list" id="post-list" data-list-view>
			{posts.map((post, i) => (
				<PostListItem post={post} tags={post.data.tags} index={i} delay={i * 60} />
			))}
		</ul>

		<div class="timeline" id="post-timeline" data-timeline-view hidden>
			{years.map(([year, list]) => (
				<section class="timeline-year">
					<h2 class="timeline-year__head">
						<span class="timeline-year__num">{year}</span>
						<span class="timeline-year__count">{list.length} 篇</span>
					</h2>
					<ul class="timeline-year__list">
						{list.map((post) => (
							<li>
								<a
									class="timeline-item"
									href={`/blog/${post.id}/`}
									data-tags={post.data.tags.join(',')}
								>
									<span class="timeline-item__date">
										{post.data.pubDate.toISOString().slice(5, 10).replace('-', '·')}
									</span>
									<span class="timeline-item__title">{post.data.title}</span>
									{post.data.tags.length > 0 && (
										<span class="timeline-item__tags">{post.data.tags.join(' / ')}</span>
									)}
								</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>

		<div class="empty-state" id="empty-state" hidden>
			<p>没有匹配的文章，换个关键词试试。</p>
		</div>
	</main>
</BaseLayout>

<script>
	// View Transitions 下页面脚本只执行一次，绑定逻辑集中在 init()，每次导航后重跑。
	let wired = false;
	let activeTag = '';
	let view: 'list' | 'timeline' = 'list';

	function applyFilter() {
		const searchInput = document.getElementById('post-search') as HTMLInputElement | null;
		const q = searchInput?.value.trim().toLowerCase() ?? '';
		const emptyState = document.getElementById('empty-state');
		const resultCount = document.getElementById('result-count');

		// 列表视图：逐行过滤
		const items = Array.from(
			document.querySelectorAll<HTMLElement>('#post-list .post-row'),
		);
		let visible = 0;
		for (const item of items) {
			const text = item.textContent?.toLowerCase() ?? '';
			// 精确匹配标签：用 includes 会把「生活」误判成命中「生活片段」
			const tags = (item.dataset.tags ?? '').split(',').filter(Boolean);
			const matchTag = !activeTag || tags.includes(activeTag);
			const matchQuery = !q || text.includes(q);
			const show = matchTag && matchQuery;
			item.hidden = !show;
			if (show) visible++;
		}

		// 时间线视图：逐条过滤，并按年份分组收起空年份
		const timeline = document.getElementById('post-timeline');
		if (timeline) {
			const tItems = Array.from(timeline.querySelectorAll<HTMLElement>('.timeline-item'));
			let tVisible = 0;
			for (const item of tItems) {
				const text = item.textContent?.toLowerCase() ?? '';
				const tags = (item.dataset.tags ?? '').split(',').filter(Boolean);
				const matchTag = !activeTag || tags.includes(activeTag);
				const matchQuery = !q || text.includes(q);
				const show = matchTag && matchQuery;
				(item.closest('li') as HTMLElement).hidden = !show;
				if (show) tVisible++;
			}
			for (const section of Array.from(timeline.querySelectorAll<HTMLElement>('.timeline-year'))) {
				const anyVisible = Array.from(
					section.querySelectorAll<HTMLElement>('.timeline-item'),
				).some((it) => !(it.closest('li') as HTMLElement).hidden);
				section.hidden = !anyVisible;
			}
			visible = view === 'timeline' ? tVisible : visible;
		}

		if (resultCount) resultCount.textContent = visible > 0 ? `共 ${visible} 篇` : '';
		if (emptyState) emptyState.hidden = visible !== 0;
	}

	/** 切换列表 / 时间线视图 */
	function setView(next: 'list' | 'timeline') {
		view = next;
		const list = document.getElementById('post-list');
		const timeline = document.getElementById('post-timeline');
		if (list) list.hidden = next !== 'list';
		if (timeline) timeline.hidden = next !== 'timeline';
		document
			.querySelectorAll<HTMLButtonElement>('.view-toggle__btn')
			.forEach((b) => b.classList.toggle('is-active', b.dataset.view === next));
		applyFilter();
	}

	/** 地址栏跟着筛选走：刷新、分享、从文章页返回都能还原状态 */
	function syncUrl() {
		const url = new URL(location.href);
		if (activeTag) url.searchParams.set('tag', activeTag);
		else url.searchParams.delete('tag');
		history.replaceState(history.state, '', url.pathname + url.search + url.hash);
	}

	function setActive(button: HTMLButtonElement) {
		document
			.querySelectorAll('#tag-filter .tag-chip')
			.forEach((b) => b.classList.toggle('is-active', b === button));
	}

	function init() {
		const searchInput = document.getElementById('post-search') as HTMLInputElement | null;
		if (!searchInput) return;
		const tagButtons = Array.from(
			document.querySelectorAll<HTMLButtonElement>('#tag-filter .tag-chip'),
		);

		// 列表换页后要重绑，用 dataset 标记避免同一批元素重复监听
		if (searchInput.dataset.wired === '1') {
			applyFilter();
			return;
		}
		searchInput.dataset.wired = '1';

		searchInput.addEventListener('input', applyFilter);
		tagButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				activeTag = btn.dataset.tag ?? '';
				setActive(btn);
				syncUrl();
				applyFilter();
			});
		});

		// 首页标签条跳过来是 /blog/?tag=日常，这里要把对应标签点亮
		const initial = new URLSearchParams(location.search).get('tag') ?? '';
		if (initial) {
			const match = tagButtons.find((btn) => (btn.dataset.tag ?? '') === initial);
			if (match) {
				activeTag = initial;
				setActive(match);
			}
		}

		// 列表 / 时间线视图切换
		const viewButtons = Array.from(
			document.querySelectorAll<HTMLButtonElement>('.view-toggle__btn'),
		);
		viewButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				setView((btn.dataset.view as 'list' | 'timeline') ?? 'list');
			});
		});

		applyFilter();
	}

	// 按 “/” 快速聚焦搜索框，Esc 清空；document 级监听只挂一次
	if (!wired) {
		wired = true;
		document.addEventListener('keydown', (e) => {
			const input = document.getElementById('post-search') as HTMLInputElement | null;
			if (!input) return;
			const target = e.target as HTMLElement | null;
			const typing = target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);
			if (e.key === '/' && !typing) {
				e.preventDefault();
				input.focus();
			}
			if (e.key === 'Escape' && document.activeElement === input) {
				input.value = '';
				applyFilter();
				input.blur();
			}
		});
	}

	document.addEventListener('astro:page-load', init);
	if (document.readyState !== 'loading') init();
	else document.addEventListener('DOMContentLoaded', init);
</script>

<style>
	.blog-main {
		width: var(--w-page);
	}
	.page-head {
		padding: 1rem 0 1.6rem;
	}
	.page-head h1 {
		margin: 0.2em 0 0.35em;
	}
	.page-head p {
		color: rgb(var(--muted));
		margin: 0;
	}

	.toolbar {
		position: sticky;
		top: calc(var(--head-h) + 0.35rem);
		z-index: 20;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem 1rem;
		padding: 0.6rem 0.75rem;
		border-radius: var(--r-lg);
		margin-bottom: 1.1rem;
	}
	.search {
		flex: 1 1 240px;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.1rem 0.85rem;
		border-radius: var(--r-pill);
		background: var(--glass-brd-dim);
		border: 1px solid rgba(var(--line), 0.9);
		color: rgb(var(--muted));
	}
	.search:focus-within {
		border-color: rgba(var(--accent), 0.5);
		box-shadow: 0 0 0 4px rgba(var(--accent), 0.1);
	}
	.search input {
		flex: 1;
		border: none;
		background: transparent;
		padding: 0.55rem 0;
		font-size: 0.92rem;
	}
	.search input:focus {
		outline: none;
		box-shadow: none;
	}
	.tag-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.tag-chip {
		font-size: 0.78rem;
		padding: 0.28rem 0.8rem;
		border-radius: var(--r-pill);
		border: 1px solid rgba(var(--line), 1);
		background: var(--chip-bg);
		color: rgb(var(--muted));
		cursor: pointer;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.tag-chip:hover {
		color: rgb(var(--accent));
		border-color: rgba(var(--accent), 0.45);
		transform: translateY(-1px);
	}
	.tag-chip.is-active {
		background: rgb(var(--accent));
		border-color: rgb(var(--accent));
		color: rgb(var(--paper));
		box-shadow: var(--shadow-sm);
	}
	.result-count {
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		color: rgb(var(--muted-light));
		margin: 0 0 0.9rem;
		padding-left: 0.2rem;
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.view-toggle {
		display: inline-flex;
		gap: 0.2rem;
		padding: 0.2rem;
		border-radius: var(--r-pill);
		background: var(--chip-bg-dim);
		margin: 0 0 1rem;
	}
	.view-toggle__btn {
		font-size: 0.8rem;
		padding: 0.32rem 0.95rem;
		border-radius: var(--r-pill);
		border: none;
		background: transparent;
		color: rgb(var(--muted));
		cursor: pointer;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.view-toggle__btn:hover {
		color: rgb(var(--ink));
	}
	.view-toggle__btn.is-active {
		background: var(--glass-bg-strong);
		color: rgb(var(--accent-deep));
		font-weight: 700;
		box-shadow: 0 1px 2px rgba(var(--shadow-color), 0.12);
	}

	/* ---- 时间线视图 ---- */
	.timeline[hidden] {
		display: none;
	}
	.timeline-year {
		position: relative;
		padding-left: 1.6rem;
		margin-bottom: 2.2rem;
	}
	/* 左侧年份竖线 */
	.timeline-year::before {
		content: '';
		position: absolute;
		left: 0.28rem;
		top: 0.5rem;
		bottom: 0.5rem;
		width: 1px;
		background: linear-gradient(rgba(var(--accent), 0.5), rgba(var(--line), 0.9));
	}
	.timeline-year__head {
		display: flex;
		align-items: baseline;
		gap: 0.8rem;
		margin: 0 0 0.9rem;
		position: relative;
	}
	.timeline-year__head::before {
		content: '';
		position: absolute;
		left: -1.6rem;
		top: 0.5em;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: rgb(var(--accent));
		box-shadow: 0 0 0 4px rgba(var(--accent), 0.15);
	}
	.timeline-year__num {
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: rgb(var(--ink));
		line-height: 1;
	}
	.timeline-year__count {
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		color: rgb(var(--muted-light));
		font-variant-numeric: tabular-nums;
	}
	.timeline-year__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.timeline-item {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.55rem 0.7rem;
		border-radius: var(--r-md);
		text-decoration: none;
		color: inherit;
		transition: background-color var(--dur-fast) var(--ease-out);
	}
	.timeline-item:hover {
		background: var(--glass-bg);
	}
	.timeline-item__date {
		font-size: 0.78rem;
		color: rgb(var(--muted-light));
		font-variant-numeric: tabular-nums;
		flex-shrink: 0;
	}
	.timeline-item__title {
		font-size: 0.98rem;
		font-weight: 600;
		color: rgb(var(--ink));
		transition: color var(--dur-fast) var(--ease-out);
	}
	.timeline-item:hover .timeline-item__title {
		color: rgb(var(--accent-deep));
	}
	.timeline-item__tags {
		margin-left: auto;
		font-size: 0.72rem;
		color: rgb(var(--muted-light));
		white-space: nowrap;
	}
	.empty-state {
		margin-top: 2em;
		text-align: center;
		color: rgb(var(--muted));
	}
	@media (max-width: 720px) {
		.toolbar {
			position: static;
		}
		.timeline-item {
			flex-wrap: wrap;
			gap: 0.2rem 0.7rem;
		}
		.timeline-item__tags {
			margin-left: 0;
			width: 100%;
		}
	}
</style>
