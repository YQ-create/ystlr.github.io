---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import discoverData from '../../data/discover.json';

const collections = discoverData.collections;
const totalLinks = collections.reduce((n, group) => n + group.links.length, 0);
---

<BaseLayout title={`发现 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main class="discover">
		<header class="page-head" data-reveal>
			<span class="sec-head__index">DISCOVER / {String(totalLinks).padStart(2, '0')}</span>
			<h1>发现</h1>
			<p>收藏的书签、推荐站点与常逛的角落。</p>
		</header>

		<div class="filter glass" data-reveal data-reveal-delay="80">
			<label class="search">
				<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						d="M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm4-1.5 3 3"></path>
				</svg>
				<input id="link-search" type="search" placeholder="搜索站点…" aria-label="搜索站点" autocomplete="off" />
			</label>
		</div>

		<div data-discover-groups>
			{collections.map((group) => (
				<section class="group">
					<header class="group-head" data-reveal>
						<h2 class="group-title">{group.category}</h2>
						<span class="group-count">{group.links.length}</span>
					</header>
					<div class="link-grid">
						{group.links.map((link, i) => (
							<a
								class="link-card glass"
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
								data-reveal
								data-reveal-delay={i * 60}
								data-glow
							>
								<span class="link-card__domain">{new URL(link.url).hostname.replace(/^www\./, '')}</span>
								<h3>{link.title}</h3>
								<p>{link.description}</p>
								<span class="link-card__arrow" aria-hidden="true">
									<svg viewBox="0 0 16 16" width="14" height="14">
										<path
											fill="none"
											stroke="currentColor"
											stroke-width="1.7"
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6"></path>
									</svg>
								</span>
							</a>
						))}
					</div>
				</section>
			))}
		</div>

		<p class="empty-state" data-empty hidden>没有匹配的站点，换个关键词试试。</p>
	</main>
</BaseLayout>

<script>
	function init() {
		const input = document.getElementById('link-search') as HTMLInputElement | null;
		if (!input || input.dataset.wired === '1') return;
		input.dataset.wired = '1';

		const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.link-card'));
		const groups = Array.from(document.querySelectorAll<HTMLElement>('.group'));
		const empty = document.querySelector<HTMLElement>('[data-empty]');

		const apply = () => {
			const q = input.value.trim().toLowerCase();
			let visible = 0;

			for (const card of cards) {
				const show = !q || (card.textContent ?? '').toLowerCase().includes(q);
				card.hidden = !show;
				if (show) visible++;
			}
			// 分组空了就整组收起
			for (const group of groups) {
				const anyVisible = Array.from(group.querySelectorAll<HTMLElement>('.link-card')).some(
					(c) => !c.hidden,
				);
				group.hidden = !anyVisible;
			}
			if (empty) empty.hidden = visible !== 0;
		};

		input.addEventListener('input', apply);
	}

	document.addEventListener('astro:page-load', init);
	if (document.readyState !== 'loading') init();
	else document.addEventListener('DOMContentLoaded', init);
</script>

<style>
	.discover {
		width: var(--w-page);
	}
	.page-head {
		padding: 1rem 0 1.4rem;
	}
	.page-head h1 {
		margin: 0.2em 0 0.35em;
	}
	.page-head p {
		color: rgb(var(--muted));
		margin: 0;
	}

	.filter {
		position: sticky;
		top: calc(0.75rem + 62px);
		z-index: 20;
		padding: 0.55rem 0.75rem;
		border-radius: var(--r-pill);
		margin-bottom: 1.6rem;
		max-width: 380px;
	}
	.search {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: rgb(var(--muted));
		padding: 0 0.4rem;
	}
	.search input {
		flex: 1;
		border: none;
		background: transparent;
		padding: 0.4rem 0;
		font-size: 0.9rem;
	}
	.search input:focus {
		outline: none;
		box-shadow: none;
	}

	.group {
		margin-bottom: clamp(1.8rem, 4vw, 2.6rem);
	}
	.group-head {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		margin-bottom: 0.9rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid rgba(var(--line), 1);
	}
	.group-title {
		font-size: 1.05rem;
		margin: 0;
	}
	.group-count {
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		color: rgb(var(--muted-light));
		font-variant-numeric: tabular-nums;
	}

	.link-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
		gap: clamp(0.7rem, 1.6vw, 1rem);
	}
	.link-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1.15rem 1.25rem 1.2rem;
		border-radius: var(--r-lg);
		text-decoration: none;
		color: rgb(var(--ink));
		transition:
			transform var(--dur) var(--ease-out),
			box-shadow var(--dur) var(--ease-out);
	}
	.link-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--glass-shine), var(--shadow-lg);
	}
	.link-card__domain {
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		text-transform: lowercase;
		color: rgb(var(--muted-light));
	}
	.link-card h3 {
		font-size: 1.02rem;
		margin: 0;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.link-card:hover h3 {
		color: rgb(var(--accent-deep));
	}
	.link-card p {
		margin: 0.15rem 0 0;
		font-size: 0.86rem;
		line-height: 1.6;
		color: rgb(var(--muted));
	}
	.link-card__arrow {
		position: absolute;
		top: 1rem;
		right: 1rem;
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		color: rgb(var(--muted-light));
		background: rgba(255, 255, 255, 0.55);
		transition:
			color var(--dur-fast) var(--ease-out),
			transform var(--dur) var(--ease-spring),
			background-color var(--dur-fast) var(--ease-out);
	}
	.link-card:hover .link-card__arrow {
		color: rgb(var(--paper));
		background: rgb(var(--accent));
		transform: translate3d(2px, -2px, 0) rotate(6deg);
	}

	.empty-state {
		padding: 2rem 0 4rem;
		color: rgb(var(--muted));
	}
	@media (max-width: 720px) {
		.filter {
			position: static;
			max-width: none;
		}
	}
</style>
