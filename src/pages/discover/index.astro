---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import discoverData from '../../data/discover.json';

const collections = discoverData.collections;
const totalLinks = collections.reduce((n, group) => n + group.links.length, 0);
---

<BaseLayout title={`发现 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main class="discover">
		<header class="page-head" data-reveal>
			<span class="sec-head__index">DISCOVER / {String(totalLinks).padStart(2, '0')}</span>
			<h1>发现</h1>
			<p>收藏的书签、推荐站点与常逛的角落。</p>
		</header>

		<div class="filter glass" data-reveal data-reveal-delay="80">
			<label class="search">
				<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						d="M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm4-1.5 3 3"></path>
				</svg>
				<input id="link-search" type="search" placeholder="搜索站点…" aria-label="搜索站点" autocomplete="off" />
			</label>
		</div>

		<div data-discover-groups>
			{collections.map((group) => (
				<section class="group">
					<header class="group-head" data-reveal>
						<h2 class="group-title">{group.category}</h2>
						<span class="group-count">{group.links.length} 个站点</span>
					</header>
					<div class="link-grid">
						{group.links.map((link, i) => (
							<a
								class="link-card glass"
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
								data-reveal
								data-reveal-delay={i * 60}
								data-glow
							>
								<span class="link-card__logo" data-logo data-domain={new URL(link.url).hostname.replace(/^www\./, '')} data-name={link.title}>
									<span class="link-card__logo-fallback" aria-hidden="true">{link.title.slice(0, 1).toUpperCase()}</span>
								</span>
								<div class="link-card__body">
									<span class="link-card__domain">{new URL(link.url).hostname.replace(/^www\./, '')}</span>
									<h3>{link.title}</h3>
									<p>{link.description}</p>
								</div>
								<span class="link-card__arrow" aria-hidden="true">
									<svg viewBox="0 0 16 16" width="14" height="14">
										<path
											fill="none"
											stroke="currentColor"
											stroke-width="1.7"
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6"></path>
									</svg>
								</span>
							</a>
						))}
					</div>
				</section>
			))}
		</div>

		<p class="empty-state" data-empty hidden>没有匹配的站点，换个关键词试试。</p>
	</main>
</BaseLayout>

<script>
	// favicon 自动识别：用 Google 的 favicon 服务抓取站点图标，
	// 加载失败（无图标/网络问题）时回退到名称首字母。
	function loadFavicons() {
		const logos = document.querySelectorAll<HTMLElement>('[data-logo]');
		for (const logo of logos) {
			if (logo.dataset.done === '1') continue;
			logo.dataset.done = '1';
			const domain = logo.dataset.domain;
			const name = logo.dataset.name || '';
			if (!domain) continue;
			const img = document.createElement('img');
			img.alt = '';
			img.loading = 'lazy';
			img.decoding = 'async';
			img.src = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`;
			img.onload = () => {
				logo.classList.add('has-logo');
				logo.prepend(img);
			};
			img.onerror = () => {
				// 抓不到就用首字母兜底（fallback 已经在 HTML 里）
				logo.classList.add('no-logo');
			};
		}
	}

	function init() {
		loadFavicons();
		const input = document.getElementById('link-search') as HTMLInputElement | null;
		if (!input || input.dataset.wired === '1') return;
		input.dataset.wired = '1';

		const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.link-card'));
		const groups = Array.from(document.querySelectorAll<HTMLElement>('.group'));
		const empty = document.querySelector<HTMLElement>('[data-empty]');

		const apply = () => {
			const q = input.value.trim().toLowerCase();
			let visible = 0;

			for (const card of cards) {
				const show = !q || (card.textContent ?? '').toLowerCase().includes(q);
				card.hidden = !show;
				if (show) visible++;
			}
			// 分组空了就整组收起
			for (const group of groups) {
				const anyVisible = Array.from(group.querySelectorAll<HTMLElement>('.link-card')).some(
					(c) => !c.hidden,
				);
				group.hidden = !anyVisible;
			}
			if (empty) empty.hidden = visible !== 0;
		};

		input.addEventListener('input', apply);
	}

	document.addEventListener('astro:page-load', init);
	if (document.readyState !== 'loading') init();
	else document.addEventListener('DOMContentLoaded', init);
</script>

<style>
	.discover {
		width: var(--w-page);
	}
	/* .link-card 用了 display:flex，会盖掉 [hidden] 的 display:none，
	   搜索过滤必须显式兜一层，否则「隐藏」的卡片还留在原位 */
	.discover [hidden] {
		display: none !important;
	}
	.page-head {
		padding: 1rem 0 1.4rem;
	}
	.page-head h1 {
		margin: 0.2em 0 0.35em;
	}
	.page-head p {
		color: rgb(var(--muted));
		margin: 0;
	}

	.filter {
		position: sticky;
		top: calc(var(--head-h) + 0.35rem);
		z-index: 20;
		padding: 0.4rem 0.55rem;
		border-radius: var(--r-pill);
		margin-bottom: 1.8rem;
		max-width: 380px;
	}
	.search {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: rgb(var(--muted));
		padding: 0 0.4rem;
	}
	.search input {
		flex: 1;
		border: none;
		background: transparent;
		padding: 0.4rem 0;
		font-size: 0.9rem;
	}
	.search input:focus {
		outline: none;
		box-shadow: none;
	}

	/* 分组做成「左侧分类 + 右侧卡片」的书签册版式：
	   分类名当侧栏标签，卡片自动铺满右侧，不会出现半行空白 */
	.group {
		display: grid;
		grid-template-columns: minmax(120px, 168px) minmax(0, 1fr);
		gap: clamp(0.9rem, 2.4vw, 2rem);
		align-items: start;
		padding-top: clamp(1.1rem, 2.6vw, 1.6rem);
		margin-bottom: clamp(1.1rem, 2.6vw, 1.6rem);
		border-top: 1px solid rgba(var(--line), 0.9);
	}
	.group-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.3rem;
		margin: 0;
		padding: 0;
		border-bottom: none;
	}
	.group-title {
		font-size: 1rem;
		margin: 0;
		letter-spacing: 0.01em;
	}
	.group-count {
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		color: rgb(var(--muted-light));
		font-variant-numeric: tabular-nums;
	}

	/* 用 grid + auto-fit：两条链接就两等分，三条就三等分，永远铺满整行 */
	.link-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
		gap: clamp(0.7rem, 1.6vw, 1rem);
	}
	.link-card {
		position: relative;
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 0.85rem;
		padding: 1.1rem 1.2rem 1.15rem;
		border-radius: var(--r-lg);
		text-decoration: none;
		color: rgb(var(--ink));
		transition:
			transform var(--dur) var(--ease-out),
			box-shadow var(--dur) var(--ease-out);
	}
	.link-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--glass-shine), var(--shadow-lg);
	}
	.link-card__logo {
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		display: grid;
		place-items: center;
		overflow: hidden;
		background: var(--chip-bg);
		border: 1px solid var(--glass-brd-dim);
	}
	.link-card__logo img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}
	.link-card__logo-fallback {
		font-size: 1.1rem;
		font-weight: 700;
		color: rgb(var(--accent-deep));
	}
	.link-card__body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.link-card__domain {
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		text-transform: lowercase;
		color: rgb(var(--muted-light));
	}
	.link-card h3 {
		font-size: 1.02rem;
		margin: 0;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.link-card:hover h3 {
		color: rgb(var(--accent-deep));
	}
	.link-card p {
		margin: 0.15rem 0 0;
		font-size: 0.86rem;
		line-height: 1.6;
		color: rgb(var(--muted));
	}
	.link-card__arrow {
		position: absolute;
		top: 1rem;
		right: 1rem;
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		color: rgb(var(--muted-light));
		background: var(--glass-brd-dim);
		transition:
			color var(--dur-fast) var(--ease-out),
			transform var(--dur) var(--ease-spring),
			background-color var(--dur-fast) var(--ease-out);
	}
	.link-card:hover .link-card__arrow {
		color: rgb(var(--paper));
		background: rgb(var(--accent));
		transform: translate3d(2px, -2px, 0) rotate(6deg);
	}

	.empty-state {
		padding: 2rem 0 4rem;
		color: rgb(var(--muted));
	}
	@media (max-width: 720px) {
		.filter {
			position: static;
			max-width: none;
		}
		.group {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.8rem;
		}
		.group-head {
			flex-direction: row;
			align-items: baseline;
			gap: 0.6rem;
		}
	}
</style>
