---
// 照片墙：全视口 WebGL 网格（GlassGrid）。
// 页面在画布里滚动，tile 用骨架 → 静帧淡入、悬停推近、点击开灯箱；
// 上下 8% 有玻璃折射带。数据仍全部来自 src/content/gallery。
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlassGrid from '../../components/GlassGrid.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const photos = (await getCollection('gallery')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// tile 用 1200px 静帧（1440 宽三列时约 470 CSS px，2x 屏刚好够），灯箱另取 1600px
const items = await Promise.all(
	photos.map(async (photo, i) => {
		const [tile, big] = await Promise.all([
			getImage({ src: photo.data.image as ImageMetadata, width: 1200, format: 'webp' }),
			getImage({ src: photo.data.image as ImageMetadata, width: 1600, format: 'webp' }),
		]);
		const d = photo.data.date;
		const meta = `${d.getFullYear()} · ${String(d.getMonth() + 1)} 月 ${String(d.getDate())} 日`;
		const title = photo.data.title ?? photo.data.caption ?? `第 ${String(i + 1).padStart(2, '0')} 帧`;
		const img = photo.data.image as ImageMetadata;
		return {
			src: tile.src,
			big: big.src,
			title,
			meta,
			label: `${String(i + 1).padStart(2, '0')}  ${photo.data.tags?.[0] ?? '照片'}`,
			alt: title,
			ar: img.width / img.height,
		};
	}),
);
---

<BaseLayout title={`照片墙 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} bodyClass="page-gallery">
	<main class="gallery-view">
		<h1 class="sr-only">照片墙</h1>
		{
			photos.length === 0 ? (
				<div class="empty-wall glass">
					<span class="empty-wall__index">WALL IS EMPTY</span>
					<h2>这张墙还在等第一张照片</h2>
					<p>
						本地跑一条命令就行：<code>npm run photo -- 图片路径</code>，脚本会压图并生成同名记录；
						也可以打开 <a href="/admin">/admin</a> 直接上传，或者手动把图片放进
						<code>src/assets/gallery/</code>、在 <code>src/content/gallery/</code>
						里新建一个 <code>.md</code> 填上日期。
					</p>
					<pre><code># 一条命令：压图 + 写记录（支持文件夹批量）
npm run photo -- ./照片.jpg -t "江边的傍晚" -d 2026-10-22 -g 生活,风景</code></pre>
				</div>
			) : (
				<GlassGrid items={items} />
			)
		}
	</main>
</BaseLayout>

<style>
	.gallery-view {
		position: relative;
	}

	/* 空状态：画布没内容时给一块正常的阅读版心 */
	.empty-wall {
		max-width: 760px;
		margin: calc(var(--head-h) + 4rem) auto 8rem;
		padding: clamp(1.6rem, 3vw, 2.6rem);
		border-radius: 14px;
	}

	.empty-wall__index {
		display: block;
		margin-bottom: 0.8rem;
		color: rgb(var(--muted));
		font-size: 11px;
		letter-spacing: 0.18em;
	}

	.empty-wall h2 {
		margin: 0 0 0.8rem;
		font-family: var(--font-display), 'Noto Serif SC', Georgia, serif;
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		font-weight: 400;
	}

	.empty-wall p {
		color: rgb(var(--ink-soft));
		font-size: 15px;
		line-height: 1.8;
	}

	.empty-wall code {
		padding: 1px 5px;
		border-radius: 4px;
		background: var(--chip-bg);
		font-size: 0.9em;
	}

	.empty-wall pre {
		overflow-x: auto;
		padding: 1rem 1.1rem;
		border: 1px solid rgba(var(--line), 1);
		border-radius: 8px;
		background: rgba(0, 0, 0, 0.25);
	}

	.empty-wall pre code {
		padding: 0;
		background: none;
		font-size: 12.5px;
		line-height: 1.7;
	}
</style>
