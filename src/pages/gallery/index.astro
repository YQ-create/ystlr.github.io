---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { Image } from 'astro:assets';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const photos = (await getCollection('gallery')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// 按年分组，年内再按月分组
interface MonthGroup {
	month: number;
	items: typeof photos;
}
interface YearGroup {
	year: number;
	months: MonthGroup[];
}

const yearGroups: YearGroup[] = [];
for (const photo of photos) {
	const d = photo.data.date;
	let year = yearGroups.find((y) => y.year === d.getFullYear());
	if (!year) {
		year = { year: d.getFullYear(), months: [] };
		yearGroups.push(year);
	}
	let month = year.months.find((m) => m.month === d.getMonth() + 1);
	if (!month) {
		month = { month: d.getMonth() + 1, items: [] };
		year.months.push(month);
	}
	month.items.push(photo);
}

const monthLabel = (m: number) => `${m} 月`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`照片墙 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>照片墙</h1>
				<p>生活里的瞬间，按年月慢慢整理成墙。</p>
			</header>

			{photos.length === 0 ? (
				<div class="empty-state">
					<p>暂无照片，后续添加后会在这里按年月展示。</p>
				</div>
			) : (
				yearGroups.map((year) => (
					<section class="year-section">
						<h2 class="year-title">{year.year} 年</h2>
						{year.months.map((month) => (
							<div class="month-group">
								<h3 class="month-title">{monthLabel(month.month)}</h3>
								<div class="gallery-grid">
									{month.items.map((photo) => (
										<figure class="gallery-item">
											<Image
												src={photo.data.image}
												alt={photo.data.caption ?? photo.data.title ?? ''}
												width={640}
												loading="lazy"
											/>
											{photo.data.caption && (
												<figcaption>{photo.data.caption}</figcaption>
											)}
										</figure>
									))}
								</div>
							</div>
						))}
					</section>
				))
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 920px;
	}
	.page-head {
		padding: 1em 0 1.2em;
		border-bottom: 1px solid rgb(var(--line));
		margin-bottom: 1.5em;
	}
	.page-head h1 {
		font-size: 2rem;
		margin-bottom: 0.3em;
	}
	.page-head p {
		color: rgb(var(--muted));
		margin: 0;
	}
	.year-section {
		margin-bottom: 2.5em;
	}
	.year-title {
		font-size: 1.3rem;
		color: rgb(var(--accent));
		border-left: 3px solid rgb(var(--accent));
		padding-left: 0.7em;
		margin-bottom: 1em;
	}
	.month-group {
		margin-bottom: 1.8em;
	}
	.month-title {
		font-size: 0.95rem;
		color: rgb(var(--muted));
		margin-bottom: 0.8em;
		font-weight: 600;
	}
	.gallery-grid {
		columns: 3;
		column-gap: 1em;
	}
	.gallery-item {
		break-inside: avoid;
		margin: 0 0 1em;
		background: rgb(var(--paper));
		border: 1px solid rgb(var(--line));
		border-radius: 14px;
		overflow: hidden;
		box-shadow: var(--box-shadow);
	}
	.gallery-item img {
		display: block;
		width: 100%;
		border-radius: 0;
	}
	.gallery-item figcaption {
		padding: 0.7em 0.9em;
		font-size: 0.88rem;
		color: rgb(var(--muted));
		line-height: 1.5;
	}
	.empty-state {
		margin-top: 2em;
		text-align: center;
		color: rgb(var(--muted));
	}
	@media (max-width: 720px) {
		.gallery-grid {
			columns: 2;
		}
	}
</style>
