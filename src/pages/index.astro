---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import PostListItem from '../components/PostListItem.astro';
import { Image } from 'astro:assets';
import { HERO, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const photos = (await getCollection('gallery'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<section class="hero">
			<div class="hero-inner">
				<p class="kicker">{HERO.role}</p>
				<h1 class="hero-title">
					<span class="line accent">{HERO.tagline}</span>
					<span class="line outline">{HERO.tagline2}</span>
				</h1>
				<p class="tagline">
					这里记录日常、想法与读过的东西，把散落的生活片段整理成文字与照片。
				</p>
				<div class="hero-actions">
					<a class="btn primary" href="/blog">阅读文章</a>
					<a class="btn ghost" href="/gallery">看看照片墙</a>
				</div>
			</div>
		</section>

		<main class="home-main">
			<section class="section latest-posts">
				<div class="section-head">
					<h2>最新文章</h2>
					<a href="/blog" class="more">全部文章 →</a>
				</div>
				{posts.length === 0 ? (
					<p class="empty-hint">还没有发布文章，第一篇写好后会出现在这里。</p>
				) : (
					<ul class="post-list">
						{posts.map((post) => (
							<PostListItem post={post} tags={post.data.tags} />
						))}
					</ul>
				)}
			</section>

			<section class="section gallery-preview">
				<div class="section-head">
					<h2>照片墙速览</h2>
					<a href="/gallery" class="more">进入照片墙 →</a>
				</div>
				{photos.length === 0 ? (
					<p class="empty-hint">暂无照片，后续添加后会在这里展示。</p>
				) : (
					<div class="preview-grid">
						{photos.map((photo) => (
							<figure class="preview-item">
								<Image
									src={photo.data.image}
									alt={photo.data.caption ?? ''}
									width={600}
									loading="lazy"
								/>
							</figure>
						))}
					</div>
				)}
			</section>

			<section class="about-preview">
				<p class="kicker">ABOUT</p>
				<h2>写点关于自己的话</h2>
				<p class="about-desc">
					这里是一段占位简介：介绍你关注的方向、记录生活的方式，以及你正在探索的内容。之后可在
					<code>src/pages/about.astro</code> 中替换成自己的文字。
				</p>
				<a href="/about" class="more-link">了解更多 →</a>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.home-main {
		max-width: none;
		width: 100%;
		padding: 0;
	}

	/* ---- Hero ---- */
	.hero {
		position: relative;
		background: rgb(var(--bg));
		display: flex;
		align-items: center;
		padding: 6em 1.5em 5em;
	}
	.hero-inner {
		width: 100%;
		max-width: 1040px;
		margin: 0 auto;
	}
	.kicker {
		color: rgb(var(--accent));
		font-size: 0.9rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		margin: 0 0 1.2em;
	}
	.hero-title {
		margin: 0 0 1.4em;
		line-height: 1.1;
		font-weight: 800;
	}
	.line {
		display: block;
		font-size: clamp(2.2rem, 6vw, 4rem);
	}
	.line.accent {
		color: rgb(var(--ink));
	}
	.line.outline {
		color: rgb(var(--muted));
		font-size: clamp(1.4rem, 3.5vw, 2.2rem);
		font-weight: 500;
		margin-top: 0.4em;
	}
	.tagline {
		color: rgb(var(--muted));
		max-width: 580px;
		font-size: 1.05rem;
	}
	.hero-actions {
		display: flex;
		gap: 0.9em;
		margin-top: 2em;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.7em 1.4em;
		border-radius: 999px;
		font-size: 0.95rem;
		text-decoration: none;
		font-weight: 600;
	}
	.btn.primary {
		background: rgb(var(--accent));
		color: rgb(var(--paper));
	}
	.btn.primary:hover {
		background: rgb(var(--accent-soft));
	}
	.btn.ghost {
		border: 1px solid rgb(var(--line));
		color: rgb(var(--ink));
	}
	.btn.ghost:hover {
		border-color: rgb(var(--accent));
		color: rgb(var(--accent));
	}

	/* ---- 区块 ---- */
	.section {
		max-width: 1040px;
		margin: 0 auto;
		padding: 3.5em 1.5em;
	}
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 1.6em;
	}
	.section-head h2 {
		font-size: 1.5rem;
		margin: 0;
	}
	.more {
		font-size: 0.92rem;
		text-decoration: none;
		color: rgb(var(--muted));
	}
	.more:hover {
		color: rgb(var(--accent));
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.empty-hint {
		color: rgb(var(--muted));
		font-size: 0.95rem;
	}

	/* ---- 照片墙速览 ---- */
	.preview-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1em;
	}
	.preview-item {
		margin: 0;
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid rgb(var(--line));
		background: rgb(var(--paper));
	}
	.preview-item img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 0;
	}

	/* ---- 关于预览 ---- */
	.about-preview {
		max-width: 1040px;
		margin: 0 auto;
		padding: 3.5em 1.5em 5em;
		border-top: 1px solid rgb(var(--line));
	}
	.about-preview h2 {
		font-size: clamp(1.7rem, 4vw, 2.4rem);
		margin: 0.2em 0 0.8em;
	}
	.about-desc {
		color: rgb(var(--muted));
		max-width: 620px;
	}
	.more-link {
		display: inline-block;
		margin-top: 1.2em;
		color: rgb(var(--accent));
		text-decoration: none;
		font-weight: 600;
	}

	@media (max-width: 720px) {
		.hero {
			padding: 4em 1.2em 3.5em;
		}
		.preview-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
