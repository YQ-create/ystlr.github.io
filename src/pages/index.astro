---
import BaseLayout from '../layouts/BaseLayout.astro';
import Particles from '../components/Particles.astro';
import CountUp from '../components/CountUp.astro';
import PostCard from '../components/PostCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { AUTHOR_NAME, HERO, PROFILE, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pinned = posts.filter((post) => post.data.featured);
const featured = [...pinned, ...posts.filter((post) => !post.data.featured)].slice(0, 3);

const photos = (await getCollection('gallery')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const knowledge = (await getCollection('knowledge'))
	.filter((n) => !n.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 标签云 + 最新动态 + 站点统计
const tagCount = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
const tagStats = [...tagCount.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 6)
	.map(([name, count]) => ({ name, count }));

const activity = posts.slice(0, 4).map((post) => ({
	title: post.data.title,
	href: `/blog/${post.id}/`,
	date: post.data.pubDate.toISOString().slice(0, 10),
}));

const totalWords = posts.reduce((sum, post) => sum + (post.body?.replace(/\s/g, '').length ?? 0), 0);
const firstDate = posts.length ? new Date(Math.min(...posts.map((p) => p.data.pubDate.valueOf()))) : null;
const days = firstDate ? Math.max(1, Math.ceil((Date.now() - firstDate.valueOf()) / 86400000)) : 0;

const stats = [
	{ label: '文章', value: posts.length, unit: '篇' },
	{ label: '照片', value: photos.length, unit: '张' },
	{ label: '知识', value: knowledge.length, unit: '条' },
	{ label: '总字数', value: totalWords, unit: '字' },
	{ label: '运行', value: days, unit: '天' },
];

const latest = posts[0]?.data.pubDate;

import discoverData from '../data/discover.json';
const discoverPreview = discoverData.collections
	.flatMap((g) => g.links)
	.slice(0, 6);

// 深色分栏配图：取最新一张照片
let splitImgSrc = '';
if (photos.length > 0) {
	const img = await getImage({ src: photos[0].data.image as ImageMetadata, width: 1400, format: 'webp' });
	splitImgSrc = img.src;
}
---

<BaseLayout title={`${SITE_TITLE} · ${HERO.tagline}`} description={SITE_DESCRIPTION} hero>
	<!-- 粒子场背景（固定层，全屏） -->
	<div class="atmo" aria-hidden="true">
		<Particles
			particleColors={['#ffffff', '#d8e4ff', '#fff1d6']}
			particleCount={420}
			particleSpread={10}
			speed={0.1}
			particleBaseSize={120}
			glow={0.9}
			twinkle={0.7}
			moveParticlesOnHover={true}
			hoverEffect="parallax"
			shape="sparkle"
			alphaParticles={true}
		/>
	</div>

	<main class="home">
		<!-- ═══════════ Act 1: Hero ═══════════ -->
		<section class="hero" id="home" data-section="home">
			<div class="hero-inner">
				<div class="hero-copy">
					<p class="hero-eyebrow fade-up" style="--d:0.15s">
						<span class="pulse" aria-hidden="true"></span>
						{HERO.role}
					</p>

					<h1 class="hero-title" data-hero-letters>
						在这里<span class="hl">记录日常</span>
					</h1>
					<p class="hero-sub" data-hero-sub>
						想法与读过的东西
					</p>

					<p class="hero-trust fade-up" style="--d:0.9s">{HERO.tagline2}。</p>

					<div class="hero-actions fade-up" style="--d:1.05s">
						<a class="btn lg" href="/blog">
							<span class="lbl">阅读文章</span>
							<span class="dot" aria-hidden="true">
								<svg viewBox="0 0 12 12" width="12" height="12"><path d="M4.5 2.5 8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
							</span>
						</a>
						<a class="btn ghost" href="/gallery">
							<span class="lbl">看看照片</span>
							<span class="dot" aria-hidden="true">
								<svg viewBox="0 0 12 12" width="12" height="12"><path d="M4.5 2.5 8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
							</span>
						</a>
					</div>
				</div>

				<div class="topics fade-up" style="--d:1.2s" aria-label="关注方向">
					{PROFILE.topics.map((topic, i) => (
						<div class="topic-cell" style={`--td:${1.25 + i * 0.07}s`}>
							<span class="topic-mark" aria-hidden="true"></span>
							<span class="topic-word">{topic}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- ═══════════ Act 2: Statement（钉住式逐字揭示） ═══════════ -->
		<section class="statement" id="statement" aria-label="宣言">
			<div class="pin">
				<p id="stmt">
					在这里，把日常写成文字<br>
					把读过的书、走过的路、看过的风景<br>
					慢慢整理成属于自己的记录<br>
					不求产量，只留真实的痕迹
				</p>
			</div>
		</section>

		<!-- ═══════════ Act 3: Dark Split ═══════════ -->
		<section class="split" id="split">
			<div class="l">
				<div class="split-guide" aria-hidden="true"></div>
				<h2 id="split-h2">
					记录生活的方式<br>像呼吸一样自然
				</h2>
				<div id="split-row">
					<h3>关注方向</h3>
					<p><strong>文字、照片、不定期更新。</strong>把零散的日常整理成有序的记录，慢慢沉淀成属于自己的空间。</p>
				</div>
			</div>
			<div class="r">
				{splitImgSrc ? (
					<img id="split-img" src={splitImgSrc} alt="记录下的生活瞬间" loading="lazy" decoding="async" />
				) : (
					<div class="split-img-fallback" aria-hidden="true"></div>
				)}
			</div>
		</section>

		<!-- 声明阅读时浮现的浮动 CTA -->
		<a class="float-cta" href="/blog" aria-label="阅读文章">
			<span class="float-cta__dot" aria-hidden="true">
				<svg viewBox="0 0 12 12" width="14" height="14"><path d="M4.5 2.5 8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</span>
			<span class="float-cta__text">阅读文章</span>
		</a>

		<!-- ═══════════ 文章（精选） ═══════════ -->
		<section class="sec sec--blog" id="articles" data-section="articles">
			<div class="wrap">
				<div class="tagbar" data-reveal>
					<a class="tagbar__home" href="/" aria-label="首页">
						<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 7.2 8 2l6 5.2V14H2z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
					</a>
					{tagStats.map((t) => (
						<a class="tagbar__item" href={`/blog/?tag=${encodeURIComponent(t.name)}`}>
							{t.name}<span>{t.count}</span>
						</a>
					))}
					<a class="tagbar__more" href="/blog">更多 →</a>
				</div>

				<div class="bloggrid">
					<aside data-reveal>
						<SpotlightCard class="profile" color="255, 184, 108" size={260} intensity={0.18} tilt={4}>
							<div class="profile__ava" aria-hidden="true">
								{PROFILE.avatar ? (
									<img src={PROFILE.avatar} alt={AUTHOR_NAME} loading="lazy" decoding="async" />
								) : (
									<span>{AUTHOR_NAME.slice(0, 1).toUpperCase()}</span>
								)}
							</div>
							<div class="profile__id">
								<h3 class="profile__name">{AUTHOR_NAME}</h3>
								<span class="profile__role">{PROFILE.role}</span>
							</div>
							<p class="profile__bio">{HERO.tagline}</p>
							<ul class="profile__social">
								{SOCIAL_LINKS.github && (
									<li>
										<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener" aria-label="GitHub">
											<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
												<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
											</svg>
										</a>
									</li>
								)}
								{SOCIAL_LINKS.email && (
									<li>
										<a href={SOCIAL_LINKS.email} aria-label="邮箱">
											<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
												<path fill="currentColor" d="M1.5 3h13a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5Zm.7 1 5.68 4.38a.5.5 0 0 0 .64 0L14.1 4H2.2ZM14 5.62 9.62 8.99a1.5 1.5 0 0 1-1.92 0L3 5.62V12h11V5.62Z"></path>
											</svg>
										</a>
									</li>
								)}
							</ul>
							<div class="profile__links">
								<a href="/about">关于我</a>
								<a href="/rss.xml">RSS</a>
							</div>
						</SpotlightCard>
					</aside>

					<div class="bloggrid__main">
						<header class="sec-head">
							<div>
								<span class="sec-head__index">01 — WRITING</span>
								<h2>精选文章</h2>
							</div>
							<a class="sec-head__more" href="/blog">
								全部文章
								<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
									<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
								</svg>
							</a>
						</header>

						{featured.length === 0 ? (
							<p class="empty-hint">还没有文章。第一篇文章写好后，会出现在这里。</p>
						) : (
							<div class="post-grid">
								{featured.map((post, i) => (
									<PostCard post={post} index={i} delay={i * 90} lead={i === 0} />
								))}
							</div>
						)}
					</div>

					<aside class="bloggrid__side">
						<section class="portal" data-reveal data-reveal-delay="60">
							<h4 class="portal__title">最新动态</h4>
							<ul class="feed">
								{activity.map((item) => (
									<li class="feed__item">
										<a href={item.href}>{item.title}</a>
										<time>{item.date}</time>
									</li>
								))}
							</ul>
							<a class="portal__more" href="/blog">更多动态 →</a>
						</section>

						<section class="portal" data-reveal data-reveal-delay="120">
							<h4 class="portal__title">站点统计</h4>
							<ul class="stats">
								{stats.map((s) => (
									<li>
										<span>{s.label}</span>
										<b><CountUp to={s.value} separator="," /><em>{s.unit}</em></b>
									</li>
								))}
							</ul>
						</section>
					</aside>
				</div>
			</div>
		</section>

		<!-- 滚动标语 -->
		<div class="ticker" aria-hidden="true">
			<div class="ticker-track">
				{[0, 1, 2, 3].map(() => (
					<span class="ticker-item">
						记录日常 <i>·</i> 写下想法 <i>·</i> 沉淀知识 <i>·</i> 留住光影 <i>·</i> 慢慢整理 <i>·</i>
					</span>
				))}
			</div>
		</div>

		<!-- 知识库 -->
		<section class="sec sec--knowledge" id="knowledge" data-section="knowledge">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">02 — KNOWLEDGE</span>
						<h2>知识库</h2>
					</div>
				</header>
				<a class="portal-entry glass" href="/knowledge" data-reveal data-glow>
					<div class="portal-entry__body">
						<span class="portal-entry__kicker">成体系的笔记 · 分类沉淀</span>
						<h3 class="portal-entry__title">进入知识库</h3>
						<p class="portal-entry__desc">前端、工具、阅读……把零散的想法整理成结构化的笔记，慢慢累积成自己的知识体系。</p>
					</div>
					<span class="portal-entry__arrow" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="20" height="20"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path></svg>
					</span>
				</a>
			</div>
		</section>

		<!-- 发现 -->
		<section class="sec sec--discover" id="discover" data-section="discover">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">03 — DISCOVER</span>
						<h2>发现</h2>
					</div>
					<a class="sec-head__more" href="/discover">
						全部链接
						<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
							<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
						</svg>
					</a>
				</header>

				<div class="discover-grid">
					{discoverPreview.map((link, i) => (
						<a class="discover-card glass" href={link.url} target="_blank" rel="noopener noreferrer" data-reveal data-reveal-delay={i * 60}>
							<span class="discover-card__logo" data-logo data-domain={new URL(link.url).hostname.replace(/^www\./, '')}>
								<span class="discover-card__fallback" aria-hidden="true">{link.title.slice(0, 1).toUpperCase()}</span>
							</span>
							<div class="discover-card__body">
								<h3>{link.title}</h3>
								<p>{link.description}</p>
							</div>
						</a>
					))}
				</div>

				<a class="portal-entry portal-entry--photos glass" href="/gallery" data-reveal data-glow>
					<div class="portal-entry__body">
						<span class="portal-entry__kicker">生活里的光影 · 按年月整理</span>
						<h3 class="portal-entry__title">进入照片墙</h3>
						<p class="portal-entry__desc">记录下的瞬间都收在这里，追光网格里点开看每一张照片。</p>
					</div>
					<span class="portal-entry__arrow" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="20" height="20"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path></svg>
					</span>
				</a>
			</div>
		</section>

		<!-- 关于 -->
		<section class="sec" id="about" data-section="about">
			<div class="wrap">
				<div class="about-card glass" data-reveal data-glow>
					<div class="about-main">
						<span class="sec-head__index">04 — ABOUT</span>
						<h2>写点关于自己的话</h2>
						<p>{PROFILE.bio}</p>
						<a class="about-link" href="/about">
							了解一下
							<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
								<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
							</svg>
						</a>
					</div>
					<ul class="about-facts">
						<li><span>记录方式</span>文字 · 照片</li>
						<li><span>更新节奏</span>不定期，想起来就写</li>
						<li><span>站点技术</span>Astro · GitHub Pages</li>
						<li><span>留言</span>文章页底部评论区</li>
					</ul>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	import { splitChars, paint } from '../scripts/letter-reveal';

	function clamp(v: number, a: number, b: number) {
		return Math.min(b, Math.max(a, v));
	}

	/** 从 CSS 变量取颜色字符串（"r, g, b" → "rgb(r,g,b)"） */
	function cssColor(name: string, fallback: string): string {
		const raw = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
		if (!raw) return fallback;
		return raw.includes(',') ? `rgb(${raw})` : raw;
	}

	let wired = false;

	function init() {
		if (wired) return;
		wired = true;

		// ---- 颜色 ----
		const ink = () => cssColor('--ink', 'rgb(24,21,18)');
		const accent = () => cssColor('--accent', 'rgb(208,132,92)');
		const ghost = () => cssColor('--muted-light', 'rgb(180,170,158)');
		const darkFinal = '#f0ede8';
		const darkAccent = () => cssColor('--accent', 'rgb(208,132,92)');
		const darkGhost = 'rgb(92,111,146)';

		// ---- Act 1: Hero 逐字揭示（时间驱动 1.25s） ----
		const heroTitleEl = document.querySelector<HTMLElement>('[data-hero-letters]');
		const heroSubEl = document.querySelector<HTMLElement>('[data-hero-sub]');
		let heroChars: ReturnType<typeof splitChars> = [];
		let heroSubChars: ReturnType<typeof splitChars> = [];
		if (heroTitleEl) heroChars = splitChars(heroTitleEl);
		if (heroSubEl) heroSubChars = splitChars(heroSubEl);

		const heroStart = performance.now();
		function tickHero(now: number) {
			const p = clamp((now - heroStart) / 1250, 0, 1);
			paint(heroChars, p, 0.35, ink(), accent(), ghost());
			// 副标题延迟 0.3s 启动，spread 更窄
			const pSub = clamp((now - heroStart - 300) / 1000, 0, 1);
			paint(heroSubChars, pSub, 0.25, accent(), accent(), ghost());
			if (p < 1 || pSub < 1) requestAnimationFrame(tickHero);
		}
		requestAnimationFrame(tickHero);

		// ---- Act 2: Statement（滚动驱动） ----
		const stmtEl = document.getElementById('stmt');
		const stmtChars = stmtEl ? splitChars(stmtEl) : [];

		// ---- Act 3: Dark split ----
		const splitH2El = document.getElementById('split-h2');
		const splitCharsArr = splitH2El ? splitChars(splitH2El) : [];
		const splitRow = document.getElementById('split-row');
		const splitImg = document.getElementById('split-img') as HTMLImageElement | null;
		const splitSection = document.getElementById('split');

		// ---- 滚动主循环 ----
		let ticking = false;
		function onScroll() {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				ticking = false;
				const q = window.scrollY / Math.max(1, window.innerHeight);

				// Statement: rise + reveal（压缩到约 1 屏内完成，避免滚动过长）
				// rise: s = clamp((q - 0.6) / 0.7) → translateY(.205 * (1-s)^2 * vh)
				const s = clamp((q - 0.6) / 0.7, 0, 1);
				const riseY = 0.205 * Math.pow(1 - s, 2) * window.innerHeight;
				if (stmtEl) stmtEl.style.transform = `translateY(${riseY.toFixed(1)}px)`;

				// reveal: p = clamp((q - 0.5) / 1.0)
				const stmtP = clamp((q - 0.5) / 1.0, 0, 1);
				paint(stmtChars, stmtP, 0.16, ink(), accent(), ghost());

				// 导航 CTA 弹入（statement 40% 时）
				document.body.classList.toggle('stmt-on', stmtP > 0.4);

				// Dark split: headline reveal + row + image scale
				if (splitSection) {
					const splitTop = splitSection.getBoundingClientRect().top;
					const p2 = clamp((0.8 - splitTop / window.innerHeight) / 0.65, 0, 1);
					paint(splitCharsArr, p2, 0.35, darkFinal, darkAccent(), darkGhost);

					if (splitRow) {
						const rowOn = p2 > 0.92;
						splitRow.classList.toggle('is-on', rowOn);
					}
					if (splitImg) {
						const scaleP = clamp(1 - splitTop / window.innerHeight, 0, 1);
						splitImg.style.transform = `scale(${(1.08 - 0.08 * scaleP).toFixed(4)})`;
					}
				}
			});
		}
		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();

		// ---- fade-up 入场 ----
		requestAnimationFrame(() => document.body.classList.add('ready'));
