---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpectralDrape from '../components/SpectralDrape.astro';
import SpecularButton from '../components/SpecularButton.astro';
import DepthCarousel from '../components/DepthCarousel.astro';
import MaskedHeading from '../components/MaskedHeading.astro';
import heroFillImage from '../assets/blog/hero-01.jpg';
import PostCard from '../components/PostCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { AUTHOR_NAME, HERO, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// 精选 = 手动标了 featured 的（按时间倒序），不足 3 篇时用最新的补齐
const pinned = posts.filter((post) => post.data.featured);
const featured = [...pinned, ...posts.filter((post) => !post.data.featured)].slice(0, 3);

const photos = (await getCollection('gallery')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const galleryItems = photos.map((photo) => ({
	image: photo.data.image,
	title: photo.data.title ?? photo.data.caption ?? '',
	href: '/gallery/',
}));

// 照片墙还是空的时候，用文章封面把流动照片带撑起来，首页不至于空一块
const coverItems = posts
	.filter((post) => post.data.heroImage)
	.slice(0, 6)
	.map((post) => ({
		image: post.data.heroImage!,
		title: post.data.title,
		href: `/blog/${post.id}/`,
	}));
const carouselItems = [...galleryItems, ...coverItems].slice(0, 8).map((it) => ({
	image: it.image,
	alt: it.title,
	title: it.title,
}));

// 标签云 + 最新动态 + 站点统计（门户式版块用）
const tagCount = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
const tagStats = [...tagCount.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 6)
	.map(([name, count]) => ({ name, count }));

const activity = posts.slice(0, 4).map((post) => ({
	title: post.data.title,
	href: `/blog/${post.id}/`,
	date: post.data.pubDate.toISOString().slice(0, 10),
}));

const totalWords = posts.reduce((sum, post) => sum + (post.body?.replace(/\s/g, '').length ?? 0), 0);
const firstDate = posts.length ? new Date(Math.min(...posts.map((p) => p.data.pubDate.valueOf()))) : null;
const days = firstDate ? Math.max(1, Math.ceil((Date.now() - firstDate.valueOf()) / 86400000)) : 0;

const stats = [
	{ label: '文章', value: `${posts.length} 篇` },
	{ label: '照片', value: `${photos.length} 张` },
	{ label: '标签', value: `${tagCount.size} 个` },
	{ label: '总字数', value: totalWords > 9999 ? `${(totalWords / 1000).toFixed(1)}k` : String(totalWords) },
	{ label: '运行', value: `${days} 天` },
];

const latest = posts[0]?.data.pubDate;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} hero>
	<main class="home">
		<!-- ============ Hero ============ -->
		<section class="hero">
			<div class="hero-waves" aria-hidden="true">
				<SpectralDrape
					preset="ember"
					density={104}
					rows={42}
					speed={0.85}
					amp={0.95}
					dotSize={1.6}
					opacity={0.95}
					pointer
					pointerStrength={1}
				/>
			</div>

			<div class="hero-inner">
				<p class="hero-eyebrow">
					<span class="pulse" aria-hidden="true"></span>
					{HERO.role}
				</p>

				<div class="hero-head">
				<MaskedHeading
					class="hero-title"
					text="在这里记录日常"
					src={heroFillImage.src}
					fillScale={1.4}
					parallax={42}
					spotlight
					spotlightRadius={220}
				/>
				<MaskedHeading
					class="hero-sub"
					tag="div"
					text="想法与读过的东西"
					outline
					parallax={18}
				/>
				</div>

				<p class="hero-lede">{HERO.tagline2}。</p>

				<div class="hero-actions">
					<SpecularButton
						href="/blog"
						size="md"
						radius={999}
						tintOpacity={0.8}
						blur={10}
						lineColor="#c2743f"
						baseColor="#e7d9c8"
						idleIntensity={0.3}
						intensity={1.15}
						shineSize={8}
						shineFade={24}
						thickness={2}
						glow={0.75}
						proximity={260}
						autoAnimate
						speed={0.22}
					>
						阅读文章
					</SpecularButton>
					<SpecularButton
						href="/gallery"
						size="md"
						radius={999}
						class="sb-ghost"
						tintOpacity={0.4}
						blur={8}
						textColor="var(--muted)"
						lineColor="#9c8168"
						baseColor="#e2d3c1"
						idleIntensity={0.16}
						shineSize={10}
						shineFade={30}
						thickness={1}
						glow={0.7}
						proximity={220}
					>
						看看照片
					</SpecularButton>
				</div>

				<dl class="hero-stats">
					<div>
						<dt>文章</dt>
						<dd>{posts.length}<span>篇</span></dd>
					</div>
					<div>
						<dt>照片</dt>
						<dd>{photos.length}<span>张</span></dd>
					</div>
					<div>
						<dt>最近更新</dt>
						<dd class="hero-stats__date">
							{latest ? <FormattedDate date={latest} /> : '—'}
						</dd>
					</div>
				</dl>
			</div>

			<a class="scroll-cue" href="#featured" aria-label="向下浏览">
				<span>SCROLL</span>
				<svg viewBox="0 0 16 26" width="14" height="22" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						stroke-linecap="round"
						d="M8 2v18M3 15l5 5 5-5"></path>
				</svg>
			</a>

		</section>

		<!-- ============ 精选文章（参考 Firefly：标签条 + 三栏门户式） ============ -->
		<section class="sec sec--blog" id="featured">
			<div class="wrap">
				<div class="tagbar" data-reveal>
					<a class="tagbar__home" href="/" aria-label="首页">
						<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 7.2 8 2l6 5.2V14H2z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
					</a>
					{tagStats.map((t) => (
						<a class="tagbar__item" href={`/blog/?tag=${encodeURIComponent(t.name)}`}>
							{t.name}<span>{t.count}</span>
						</a>
					))}
					<a class="tagbar__more" href="/blog">更多 →</a>
				</div>

				<div class="bloggrid">
					<aside class="portal profile" data-reveal>
						<div class="profile__ava" aria-hidden="true">
							<span>{AUTHOR_NAME.slice(0, 1).toUpperCase()}</span>
						</div>
						<h3 class="profile__name">{AUTHOR_NAME}</h3>
						<p class="profile__bio">{HERO.tagline}</p>
						<div class="profile__links">
							<a href="/about">关于我</a>
							<a href="/rss.xml">RSS</a>
						</div>
					</aside>

					<div class="bloggrid__main">
						<header class="sec-head">
							<div>
								<span class="sec-head__index">01 — WRITING</span>
								<h2>精选文章</h2>
							</div>
							<a class="sec-head__more" href="/blog">
								全部文章
								<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
									<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
								</svg>
							</a>
						</header>

						{featured.length === 0 ? (
							<p class="empty-hint">还没有文章。第一篇文章写好后，会出现在这里。</p>
						) : (
							<div class="post-grid">
								{featured.map((post, i) => <PostCard post={post} index={i} delay={i * 90} />)}
							</div>
						)}
					</div>

					<aside class="bloggrid__side">
						<section class="portal" data-reveal data-reveal-delay="60">
							<h4 class="portal__title">最新动态</h4>
							<ul class="feed">
								{activity.map((item) => (
									<li class="feed__item">
										<a href={item.href}>{item.title}</a>
										<time>{item.date}</time>
									</li>
								))}
							</ul>
							<a class="portal__more" href="/blog">更多动态 →</a>
						</section>

						<section class="portal" data-reveal data-reveal-delay="120">
							<h4 class="portal__title">站点统计</h4>
							<ul class="stats">
								{stats.map((s) => (
									<li><span>{s.label}</span><b>{s.value}</b></li>
								))}
							</ul>
						</section>
					</aside>
				</div>
			</div>
		</section>

		<!-- ============ 滚动标语 ============ -->
		<div class="ticker" aria-hidden="true">
			<div class="ticker-track">
				{[0, 1, 2, 3].map(() => (
					<span class="ticker-item">
						记录日常 <i>·</i> 写下想法 <i>·</i> 留住光影 <i>·</i> 慢慢整理 <i>·</i>
					</span>
				))}
			</div>
		</div>

		<!-- ============ 照片墙 ============ -->
		<section class="sec sec--gallery sec--wall">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">02 — PHOTOS</span>
						<h2>照片墙</h2>
					</div>
					<a class="sec-head__more" href="/gallery">
						进入照片墙
						<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
							<path
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
						</svg>
					</a>
				</header>
			</div>

			{photos.length === 0 ? (
				<div class="wrap">
					<p class="empty-hint">暂无照片，添加后这里会转起来。</p>
				</div>
			) : (
				<div class="wrap">
					<div data-reveal="scale" data-reveal-delay="120">
						<DepthCarousel
							items={carouselItems}
							depth={260}
							spread={215}
							tilt={26}
							tiltDirection="right"
							perspective={1400}
							visibleCards={4}
							falloff={0.18}
							blur={4}
							autoplay
							loop
							interval={3600}
						/>
					</div>
				</div>
			)}
		</section>

		<!-- ============ 关于 ============ -->
		<section class="sec">
			<div class="wrap">
				<div class="about-card glass" data-reveal data-glow>
					<div class="about-main">
						<span class="sec-head__index">03 — ABOUT</span>
						<h2>写点关于自己的话</h2>
						<p>
							这里是一段占位简介：介绍你在记录什么、关注哪些方向，以及为什么开始写。
							我会把日常随笔、阅读笔记和生活照片慢慢放在这里，不追求产量，只求留下一些真实的痕迹。
						</p>
						<a class="about-link" href="/about">
							了解一下
							<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
								<path
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
							</svg>
						</a>
					</div>
					<ul class="about-facts">
						<li><span>记录方式</span>文字 · 照片</li>
						<li><span>更新节奏</span>不定期，想起来就写</li>
						<li><span>站点技术</span>Astro · GitHub Pages</li>
						<li><span>留言</span>文章页底部评论区</li>
					</ul>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.home {
		width: 100%;
		max-width: none;
		padding: 0;
	}

	.wrap {
		width: 100%;
		max-width: var(--w-wide);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: center;
		padding: clamp(6rem, 14vh, 9rem) 0 clamp(4rem, 9vh, 6rem);
		overflow: hidden;
		isolation: isolate;
	}
	.hero-waves {
		position: absolute;
		inset: -16% -12% -10%;
		z-index: -1;
		opacity: 1;
		transform: scale(1.08);
	}
	/* 让整屏像一张连续的画：底部压暗、左上角留一层暖雾 */
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(120% 80% at 8% 6%, rgba(var(--bg), 0.66), transparent 46%),
			linear-gradient(to bottom, transparent 58%, rgba(var(--bg), 0.88) 100%);
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--w-wide);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}
	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 1.6rem;
		padding: 0.35rem 0.9rem 0.35rem 0.7rem;
		border-radius: var(--r-pill);
		font-size: 0.72rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgb(var(--accent-deep));
		background: var(--glass-bg);
		border: 1px solid var(--glass-brd);
		backdrop-filter: blur(12px);
	}
	.pulse {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: rgb(var(--accent));
		box-shadow: 0 0 0 0 rgba(var(--accent), 0.5);
		animation: pulse-ring 2.8s var(--ease-out) infinite;
	}
	@keyframes pulse-ring {
		0%,
		70%,
		100% {
			box-shadow: 0 0 0 0 rgba(var(--accent), 0.45);
		}
		35% {
			box-shadow: 0 0 0 6px rgba(var(--accent), 0);
		}
	}

	/* 标题在子组件里，样式要 :global 才能命中 */
	.hero-head {
		display: grid;
		gap: 1.9rem;
		margin: 0 0 1.7rem;
	}
	:global(.hero-title) {
		font-size: clamp(2.4rem, 7.4vw, 5.9rem);
	}
	:global(.hero-title .masked__text) {
		/* 让图片填充别太跳，和暖色调统一 */
		filter: saturate(0.72) contrast(1.12) sepia(0.12);
	}
	:global(.hero-sub) {
		font-size: clamp(1.4rem, 3.4vw, 2.4rem);
		font-weight: 500;
	}
	.hero-line {
		display: block;
		overflow: hidden;
		padding-bottom: 0.06em;
	}
	.hero-line > span {
		display: inline-block;
		transform: translateY(110%);
		animation: line-rise 1.05s var(--ease-out) forwards;
	}
	.hero-line:nth-child(2) > span {
		animation-delay: 0.12s;
	}
	.hero-line--outline > span {
		color: transparent;
		-webkit-text-stroke: 1.4px rgba(var(--ink), 0.55);
	}
	@keyframes line-rise {
		to {
			transform: translateY(0);
		}
	}

	.hero-lede {
		max-width: 34em;
		margin: 0 0 2rem;
		font-size: clamp(1rem, 1.5vw, 1.12rem);
		color: rgb(var(--muted));
		opacity: 0;
		animation: soft-in 0.9s var(--ease-out) 0.34s forwards;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		opacity: 0;
		animation: soft-in 0.9s var(--ease-out) 0.46s forwards;
	}
	.hero-stats {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(1.4rem, 5vw, 3.4rem);
		margin: clamp(2.2rem, 5vh, 3.4rem) 0 0;
		padding-top: 1.4rem;
		border-top: 1px solid rgba(var(--line), 0.9);
		opacity: 0;
		animation: soft-in 0.9s var(--ease-out) 0.58s forwards;
	}
	.hero-stats div {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.2rem;
	}
	.hero-stats dt {
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgb(var(--muted-light));
	}
	.hero-stats dd {
		margin: 0;
		font-size: clamp(1.3rem, 2.4vw, 1.7rem);
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.02em;
		color: rgb(var(--ink));
	}
	.hero-stats dd span {
		margin-left: 0.25em;
		font-size: 0.7rem;
		font-weight: 500;
		color: rgb(var(--muted));
	}
	.hero-stats__date {
		font-size: 1rem !important;
		font-weight: 600 !important;
		color: rgb(var(--muted)) !important;
		padding-top: 0.35rem;
	}
	@keyframes soft-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.scroll-cue {
		position: absolute;
		left: 50%;
		bottom: 1.6rem;
		transform: translateX(-50%);
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.62rem;
		letter-spacing: 0.34em;
		color: rgb(var(--muted-light));
		text-decoration: none;
		animation: cue-float 3.4s var(--ease-out) infinite;
	}
	.scroll-cue svg {
		opacity: 0.65;
	}
	@keyframes cue-float {
		0%,
		100% {
			transform: translate(-50%, 0);
		}
		50% {
			transform: translate(-50%, 7px);
		}
	}

	/* ---------- 区块 ---------- */
	/* 照片墙：往上压住 Hero 的底边，卡片像是从画面里浮出来 */
	.sec--wall {
		position: relative;
		z-index: 2;
	}
	.sec--wall .wrap {
		max-width: none;
		padding-inline: clamp(0.25rem, 1.5vw, 1.5rem);
	}

	/* ---------- 门户式精选区 ---------- */
	.tagbar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-bottom: clamp(1.2rem, 3vw, 2rem);
	}
	.tagbar__home {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1px solid var(--glass-brd-dim);
		background: var(--chip-bg);
		color: rgb(var(--accent));
		text-decoration: none;
	}
	.tagbar__item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.34rem 0.8rem;
		border-radius: var(--r-pill);
		border: 1px solid var(--glass-brd-dim);
		background: var(--chip-bg);
		font-size: 0.82rem;
		color: rgb(var(--ink-soft));
		text-decoration: none;
		transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out);
	}
	.tagbar__item span {
		font-size: 0.72rem;
		color: rgb(var(--muted-light));
	}
	.tagbar__item:hover {
		background: var(--chip-bg-strong);
		color: rgb(var(--accent-deep));
	}
	.tagbar__more {
		margin-left: auto;
		font-size: 0.82rem;
		color: rgb(var(--muted));
		text-decoration: none;
	}

	.bloggrid {
		display: grid;
		grid-template-columns: 232px minmax(0, 1fr) 268px;
		gap: clamp(1rem, 2vw, 1.6rem);
		align-items: start;
	}
	.bloggrid__main {
		min-width: 0;
	}
	.bloggrid__side {
		display: grid;
		gap: clamp(1rem, 2vw, 1.4rem);
	}

	/* 精选区只要文字，不要封面图 */
	.bloggrid__main :global(.card img),
	.bloggrid__main :global(.card-glyph),
	.bloggrid__main :global(.card figure),
	.bloggrid__main :global(.card picture),
	.bloggrid__main :global(.card [class*='card-media']) {
		display: none !important;
	}
	.bloggrid__main :global(.post-grid) {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.bloggrid__main :global(.post-grid > :first-child) {
		grid-column: 1 / -1;
	}
	@media (max-width: 900px) {
		.bloggrid__main :global(.post-grid) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.portal {
