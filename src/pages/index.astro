---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroBackground from '../components/HeroBackground.astro';
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
import { HERO, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<section class="hero">
			<HeroBackground />
			<div class="hero-mask" aria-hidden="true"></div>
			<div class="hero-inner">
				<p class="kicker">{HERO.role}</p>
				<h1 class="hero-title">
					<span class="star star-a" aria-hidden="true">✦</span>
					<span class="line accent">YSTLR</span>
					<span class="star star-b" aria-hidden="true">✦</span>
					<span class="line outline">PORTFOLIO</span>
				</h1>
				<p class="tagline">{HERO.tagline}，{HERO.tagline2}。</p>
				<a class="scroll-hint" href="#works" aria-label="向下浏览作品">
					<span>SCROLL</span>
					<svg viewBox="0 0 16 24" width="14" height="22" aria-hidden="true">
						<path d="M8 1v20M3 16l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
			</div>
		</section>

		<main class="home-main">
			<section id="works" class="section">
				<div class="section-head">
					<h2>精选作品</h2>
					<a href="/projects" class="more">全部作品 →</a>
				</div>
				<div class="marquee" role="region" aria-label="精选作品，自动向左循环滚动">
					<div class="marquee-track">
						{[...projects, ...projects].map((project, index) => (
							<a
								class="rail-card"
								href="/projects"
								aria-label={project.title}
								aria-hidden={index >= projects.length ? 'true' : undefined}
								tabindex={index >= projects.length ? -1 : undefined}
							>
								<div class="rail-cover">
									<Image src={project.cover} alt={project.title} width={600} height={450} />
								</div>
								<div class="rail-meta">
									<span class="rail-title">{project.title}</span>
									<span class="rail-year">{project.year}</span>
								</div>
							</a>
						))}
					</div>
				</div>
			</section>

			<section class="about-preview">
				<p class="kicker">ABOUT ME</p>
				<h2>视觉设计 × AI 工作流</h2>
				<p class="about-desc">
					这里是一段占位简介：介绍你专注的方向（品牌视觉、3D、插画、产品或摄影）、你的工作方式，以及你正在探索的内容。之后可在
					<code>src/pages/about.astro</code> 中替换成自己的文字。
				</p>
				<a href="/about" class="more-link">了解更多 →</a>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* 首页使用全宽布局，覆盖全局 720px 限制 */
	.home-main {
		max-width: none;
		width: 100%;
		padding: 0;
	}

	/* ---- Hero ---- */
	.hero {
		position: relative;
		min-height: 100vh;
		background: rgb(var(--bg));
		display: flex;
		align-items: center;
		overflow: hidden;
	}
	.hero-mask {
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(180deg, rgba(13, 15, 14, 0.55) 0%, rgba(13, 15, 14, 0.25) 45%, rgba(13, 15, 14, 0.92) 100%);
	}
	.hero-inner {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
		padding: 8em 1.5em 12em;
	}
	.kicker {
		color: rgb(var(--accent));
		font-size: 0.95rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		margin: 0 0 1.2em;
	}
	.hero-title {
		margin: 0;
		line-height: 0.95;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}
	.line {
		display: block;
		font-size: clamp(3.2rem, 11vw, 8.5rem);
	}
	.line.accent {
		color: rgb(var(--accent));
		text-shadow: 0 0 40px rgba(var(--accent), 0.35);
	}
	.line.outline {
		color: transparent;
		-webkit-text-stroke: 2px rgb(var(--ink));
		margin-top: 0.1em;
	}
	.star {
		color: rgb(var(--accent));
		font-size: clamp(1.2rem, 3vw, 2rem);
		vertical-align: super;
	}
	.star-a {
		margin-right: 0.2em;
	}
	.star-b {
		margin-left: 0.2em;
	}
	.tagline {
		margin-top: 1.6em;
		font-size: clamp(1rem, 2vw, 1.3rem);
		color: rgb(var(--ink));
		max-width: 560px;
	}
	.scroll-hint {
		position: absolute;
		left: 50%;
		bottom: 2.2em;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5em;
		color: rgb(var(--muted));
		text-decoration: none;
		font-size: 0.7rem;
		letter-spacing: 0.3em;
	}
	.scroll-hint:hover {
		color: rgb(var(--accent));
	}

	/* ---- 作品横滑条 ---- */
	.section {
		max-width: 1120px;
		margin: 0 auto;
		padding: 4.5em 1.5em;
	}
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 1.6em;
	}
	.section-head h2 {
		font-size: 1.6rem;
		margin: 0;
	}
	.more {
		font-size: 0.92rem;
		text-decoration: none;
		color: rgb(var(--muted));
	}
	.more:hover {
		color: rgb(var(--accent));
	}
	/* ---- 作品自动横滚（无缝循环） ---- */
	.marquee {
		position: relative;
		overflow: hidden;
		padding-bottom: 1em;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
	}
	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee-scroll 42s linear infinite;
		will-change: transform;
	}
	/* 悬停 / 键盘聚焦 / 触摸时暂停，方便看清和点击 */
	.marquee:hover .marquee-track,
	.marquee:focus-within .marquee-track,
	.marquee.is-paused .marquee-track {
		animation-play-state: paused;
	}
	@keyframes marquee-scroll {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}
	.rail-card {
		flex: 0 0 min(340px, 78vw);
		margin-right: 1.4em;
		text-decoration: none;
	}
	.rail-cover {
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid rgb(var(--line));
		aspect-ratio: 4 / 3;
	}
	.rail-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 16px;
		transition: transform 0.4s ease;
	}
	.rail-card:hover .rail-cover img {
		transform: scale(1.05);
	}
	.rail-meta {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-top: 0.8em;
	}
	.rail-title {
		color: rgb(var(--ink));
		font-weight: 600;
	}
	.rail-year {
		color: rgb(var(--muted-light));
		font-size: 0.85rem;
	}

	/* ---- 关于预览 ---- */
	.about-preview {
		max-width: 1120px;
		margin: 0 auto;
		padding: 4.5em 1.5em 6em;
		border-top: 1px solid rgb(var(--line));
	}
	.about-preview h2 {
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		margin: 0.2em 0 0.8em;
	}
	.about-desc {
		color: rgb(var(--muted));
		max-width: 620px;
	}
	.more-link {
		display: inline-block;
		margin-top: 1.2em;
		color: rgb(var(--accent));
		text-decoration: none;
		font-weight: 600;
	}

	/* 系统开启“减少动态效果”时退化为可手动横滑 */
	@media (prefers-reduced-motion: reduce) {
		.marquee {
			overflow-x: auto;
		}
		.marquee-track {
			animation: none;
		}
	}

	@media (max-width: 720px) {
		.hero-inner {
			padding: 6em 1.2em 10em;
		}
	}
</style>
