---
// 首页（内容阅读优先）：
// 首屏 → 精选文章 → 主题入口 → 知识库精选 → 全站最近更新 → 简短关于我。
// 去掉图片遮罩标题、逐字破碎、打字机、GitHub 热门、重复关于区块等装饰，
// 雨滴仅作首屏轻量签名动效。
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Rain from '../components/Rain.astro';
import { getCollection } from 'astro:content';
import { HERO, PROFILE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import discoverData from '../data/discover.json';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pinned = posts.filter((p) => p.data.featured);
const featured = [...pinned, ...posts.filter((p) => !p.data.featured)].slice(0, 4);

const notes = (await getCollection('knowledge'))
	.filter((n) => !n.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pinnedNotes = notes.filter((n) => n.data.pinned);
const knowledgePreview = (pinnedNotes.length >= 3 ? pinnedNotes : [...pinnedNotes, ...notes]).slice(0, 4);

// 主题聚合：文章 + 知识 + 发现，按出现次数排序
const topicCount = new Map<string, number>();
const bump = (t: string) => topicCount.set(t, (topicCount.get(t) ?? 0) + 1);
for (const p of posts) for (const t of p.data.topics) bump(t);
for (const n of notes) for (const t of n.data.topics) bump(t);
for (const l of discoverData.collections.flatMap((g) => g.links)) for (const t of (l as { topics?: string[] }).topics ?? []) bump(t);
const topics = [...topicCount.entries()]
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hans-CN'))
	.slice(0, 8)
	.map(([name, count]) => ({ name, count }));

// 全站最近更新：文章 + 知识合并，按时间倒序
type RecentItem = { type: '文章' | '知识'; href: string; title: string; date: Date; desc?: string };
const recent: RecentItem[] = [
	...posts.map((p) => ({ type: '文章' as const, href: `/blog/${p.id}/`, title: p.data.title, date: p.data.pubDate, desc: p.data.description })),
	...notes.map((n) => ({ type: '知识' as const, href: `/knowledge/${n.id}/`, title: n.data.title, date: n.data.pubDate, desc: n.data.description })),
]
	.sort((a, b) => b.date.valueOf() - a.date.valueOf())
	.slice(0, 8);
---

<BaseLayout title={`${SITE_TITLE} · ${HERO.tagline}`} description={SITE_DESCRIPTION} hero bodyClass="home">
	<div class="home-bg" aria-hidden="true"></div>
	<Rain />

	<main class="home">
		<!-- 首屏 -->
		<section class="hero">
			<h1 class="hero-title">{HERO.title}</h1>
			<p class="hero-desc">{HERO.tagline2}。</p>
			<div class="hero-actions">
				<a class="hero-cta" href="/blog">
					开始阅读
					<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path></svg>
				</a>
				<button class="hero-search" type="button" data-search-open>
					<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm4-1.5 3 3"></path></svg>
					搜索全站
				</button>
			</div>
		</section>

		<!-- 01 精选文章 -->
		<section class="sec" id="articles">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">01 / 精选文章</span>
						<h2>最近在写</h2>
					</div>
					<a class="sec-head__more" href="/blog">全部文章 →</a>
				</header>
				{featured.length === 0 ? (
					<p class="empty-hint">还没有文章。第一篇文章写好后，会出现在这里。</p>
				) : (
					<ul class="post-list">
						{featured.map((p) => (
							<li>
								<a href={`/blog/${p.id}/`}>
									<span class="post-list__title">{p.data.title}</span>
									<time><FormattedDate date={p.data.pubDate} /></time>
								</a>
								<p class="post-list__desc">{p.data.description}</p>
							</li>
						))}
					</ul>
				)}
			</div>
		</section>

		<!-- 02 主题入口 -->
		<section class="sec" id="topics">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">02 / 主题</span>
						<h2>按主题逛</h2>
					</div>
				</header>
				<div class="topic-grid">
					{topics.map((t) => (
						<a class="topic-chip" href={`/topics/${t.name}/`}>
							<span>{t.name}</span>
							<em>{t.count}</em>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- 03 知识库精选 -->
		<section class="sec" id="knowledge">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">03 / 知识库</span>
						<h2>知识精选</h2>
					</div>
					<a class="sec-head__more" href="/knowledge">全部知识 →</a>
				</header>
				<ul class="post-list">
					{knowledgePreview.map((n) => (
						<li>
							<a href={`/knowledge/${n.id}/`}>
								<span class="post-list__title">{n.data.title}</span>
								{n.data.stage && <span class="post-list__stage">{n.data.stage}</span>}
								<time><FormattedDate date={n.data.pubDate} /></time>
							</a>
							{n.data.description && <p class="post-list__desc">{n.data.description}</p>}
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- 04 全站最近更新 -->
		<section class="sec" id="recent">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">04 / 最近更新</span>
						<h2>最近更新</h2>
					</div>
				</header>
				<ul class="recent-list">
					{recent.map((item) => (
						<li>
							<a href={item.href}>
								<span class="recent-list__type">{item.type}</span>
								<span class="recent-list__title">{item.title}</span>
								<time><FormattedDate date={item.date} /></time>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- 05 简短关于我 -->
		<section class="sec" id="about">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">05 / 关于</span>
						<h2>关于我</h2>
					</div>
				</header>
				<p class="about-bio">{PROFILE.bio}</p>
				<a class="sec-head__more" href="/about">了解更多 →</a>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	:global(body.home .site-bg) {
		display: none;
	}
	:global(.home .rain) {
		--rain-gain: 0.4;
	}
	.home {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: none;
		padding: 0;
	}
	.home-bg {
		position: fixed;
		inset: -30px;
		z-index: 0;
		background-image: url('/wallpaper.jpg');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		filter: blur(16px);
	}

	/* ── 首屏 ── */
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1.4rem;
		min-height: 88svh;
		padding: calc(var(--head-h) + 3rem) var(--gutter) 4rem;
		max-width: var(--w-wide, 1272px);
		margin: 0 auto;
	}
	.hero-title {
		margin: 0;
		font-size: clamp(2.4rem, 6vw, 4.4rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.05;
		color: rgb(var(--ink));
	}
	.hero-desc {
		margin: 0;
		max-width: 36ch;
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		line-height: 1.75;
		color: rgb(var(--ink-soft));
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.9rem;
		margin-top: 0.6rem;
	}
	.hero-cta,
	.hero-search {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		padding: 0 1.3rem;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
	}
	.hero-cta {
		background: rgb(var(--accent));
		color: rgb(11, 11, 12);
		border: 1px solid rgb(var(--accent));
	}
	.hero-cta:hover {
		transform: translateY(-1px);
	}
	.hero-search {
		background: transparent;
		color: rgb(var(--ink));
		border: 1px solid rgb(var(--line));
	}
	.hero-search:hover {
		border-color: rgb(var(--muted));
	}

	/* ── 区块通用 ── */
	.sec {
		position: relative;
		padding: clamp(2.6rem, 6vw, 4.5rem) 0;
		border-top: 1px solid rgb(var(--line-soft));
	}
	.sec:first-of-type {
		border-top: none;
	}
	.wrap {
		width: 100%;
		max-width: var(--w-wide, 1272px);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}
	.sec-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.4rem;
	}
	.sec-head__index {
		display: block;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgb(var(--muted));
		margin-bottom: 0.4rem;
	}
	.sec-head h2 {
		margin: 0;
		font-size: clamp(1.4rem, 2.6vw, 1.9rem);
		letter-spacing: -0.02em;
	}
	.sec-head__more {
		font-size: 0.85rem;
		color: rgb(var(--ink-soft));
		text-decoration: none;
		white-space: nowrap;
	}
	.sec-head__more:hover {
		color: rgb(var(--accent));
	}
	.empty-hint {
		color: rgb(var(--muted));
	}

	/* ── 文章/知识列表 ── */
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.3rem;
	}
	.post-list li {
		padding: 0.9rem 0;
		border-bottom: 1px solid rgb(var(--line-soft));
	}
	.post-list li:last-child {
		border-bottom: none;
	}
	.post-list a {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		text-decoration: none;
		color: inherit;
	}
	.post-list__title {
		font-size: 1.02rem;
		font-weight: 600;
		color: rgb(var(--ink));
		transition: color var(--dur-fast) var(--ease-out);
	}
	.post-list a:hover .post-list__title {
		color: rgb(var(--accent));
	}
	.post-list time {
		margin-left: auto;
		font-size: 0.78rem;
		color: rgb(var(--muted));
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.post-list__stage {
		font-size: 0.68rem;
		padding: 0.1rem 0.5rem;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		color: rgb(var(--muted));
		white-space: nowrap;
	}
	.post-list__desc {
		margin: 0.35rem 0 0;
		font-size: 0.88rem;
		line-height: 1.65;
		color: rgb(var(--muted));
		max-width: 60ch;
	}

	/* ── 主题入口 ── */
	.topic-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.topic-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 1.1rem;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		font-size: 0.9rem;
		color: rgb(var(--ink-soft));
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
	}
	.topic-chip em {
		font-style: normal;
		font-size: 0.72rem;
		color: rgb(var(--muted));
		font-variant-numeric: tabular-nums;
	}
	.topic-chip:hover {
		color: rgb(var(--accent));
		border-color: rgba(var(--accent), 0.5);
	}

	/* ── 最近更新 ── */
	.recent-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.15rem;
	}
	.recent-list a {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid rgb(var(--line-soft));
		text-decoration: none;
		color: inherit;
	}
	.recent-list__type {
		flex: none;
		font-size: 0.68rem;
		padding: 0.1rem 0.5rem;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		color: rgb(var(--muted));
	}
	.recent-list__title {
		font-size: 0.95rem;
		color: rgb(var(--ink));
		transition: color var(--dur-fast) var(--ease-out);
	}
	.recent-list a:hover .recent-list__title {
		color: rgb(var(--accent));
	}
	.recent-list time {
		margin-left: auto;
		font-size: 0.76rem;
		color: rgb(var(--muted));
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	/* ── 关于 ── */
	.about-bio {
		margin: 0 0 1.2rem;
		max-width: 48ch;
		font-size: 0.98rem;
		line-height: 1.8;
		color: rgb(var(--ink-soft));
	}

	/* 移动端：标题和列表项适配 */
	@media (max-width: 640px) {
		.hero {
			min-height: 82svh;
			padding-top: calc(var(--head-h) + 2rem);
		}
		.post-list a,
		.recent-list a {
			flex-wrap: wrap;
			gap: 0.25rem 0.7rem;
		}
		.post-list time,
		.recent-list time {
			margin-left: 0;
			width: 100%;
		}
	}
</style>
