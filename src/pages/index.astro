---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpectralDrape from '../components/SpectralDrape.astro';
import SpecularButton from '../components/SpecularButton.astro';
import DriftWall from '../components/DriftWall.astro';
import PostCard from '../components/PostCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { HERO, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// 精选 = 手动标了 featured 的（按时间倒序），不足 3 篇时用最新的补齐
const pinned = posts.filter((post) => post.data.featured);
const featured = [...pinned, ...posts.filter((post) => !post.data.featured)].slice(0, 3);

const photos = (await getCollection('gallery')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const galleryItems = photos.map((photo) => ({
	image: photo.data.image,
	title: photo.data.title ?? photo.data.caption ?? '',
	href: '/gallery/',
}));

// 照片墙还是空的时候，用文章封面把流动照片带撑起来，首页不至于空一块
const coverItems = posts
	.filter((post) => post.data.heroImage)
	.slice(0, 6)
	.map((post) => ({
		image: post.data.heroImage!,
		title: post.data.title,
		href: `/blog/${post.id}/`,
	}));
const wallItems = galleryItems.length >= 3 ? galleryItems : [...galleryItems, ...coverItems];

const latest = posts[0]?.data.pubDate;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main class="home">
		<!-- ============ Hero ============ -->
		<section class="hero">
			<div class="hero-waves" aria-hidden="true">
				<SpectralDrape
					preset="ember"
					density={104}
					rows={42}
					speed={0.85}
					amp={0.95}
					dotSize={1.6}
					opacity={0.95}
					pointer
					pointerStrength={1}
				/>
			</div>

			<div class="hero-inner">
				<p class="hero-eyebrow">
					<span class="pulse" aria-hidden="true"></span>
					{HERO.role}
				</p>

				<h1 class="hero-title">
					<span class="hero-line"><span>在这里记录日常</span></span>
					<span class="hero-line hero-line--outline"><span>想法与读过的东西</span></span>
				</h1>

				<p class="hero-lede">{HERO.tagline2}。</p>

				<div class="hero-actions">
					<SpecularButton
						href="/blog"
						size="md"
						radius={999}
						tintOpacity={0.8}
						blur={10}
						lineColor="#c2743f"
						baseColor="#e7d9c8"
						idleIntensity={0.3}
						intensity={1.15}
						shineSize={8}
						shineFade={24}
						thickness={2}
						glow={0.75}
						proximity={260}
						autoAnimate
						speed={0.22}
					>
						阅读文章
					</SpecularButton>
					<SpecularButton
						href="/gallery"
						size="md"
						radius={999}
						class="sb-ghost"
						tintOpacity={0.4}
						blur={8}
						textColor="var(--muted)"
						lineColor="#9c8168"
						baseColor="#e2d3c1"
						idleIntensity={0.16}
						shineSize={10}
						shineFade={30}
						thickness={1}
						glow={0.7}
						proximity={220}
					>
						看看照片
					</SpecularButton>
				</div>

				<dl class="hero-stats">
					<div>
						<dt>文章</dt>
						<dd>{posts.length}<span>篇</span></dd>
					</div>
					<div>
						<dt>照片</dt>
						<dd>{photos.length}<span>张</span></dd>
					</div>
					<div>
						<dt>最近更新</dt>
						<dd class="hero-stats__date">
							{latest ? <FormattedDate date={latest} /> : '—'}
						</dd>
					</div>
				</dl>
			</div>

			<a class="scroll-cue" href="#featured" aria-label="向下浏览">
				<span>SCROLL</span>
				<svg viewBox="0 0 16 26" width="14" height="22" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						stroke-linecap="round"
						d="M8 2v18M3 15l5 5 5-5"></path>
				</svg>
			</a>

			<div class="hero-wall" aria-hidden="true">
				<DriftWall
					items={wallItems}
					columns={7}
					rows={2}
					tileWidth={188}
					tileHeight={124}
					gap={16}
					tilt={11}
					turn={-8}
					perspective={1300}
					depth={80}
					speed={22}
					direction="left"
					variance={0.5}
					parallax={0.4}
					lift={38}
					fade={0.5}
					dim={0.22}
					height="clamp(148px, 20vh, 236px)"
				/>
			</div>
		</section>

		<!-- ============ 精选文章 ============ -->
		<section class="sec" id="featured">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">01 — WRITING</span>
						<h2>精选文章</h2>
					</div>
					<a class="sec-head__more" href="/blog">
						全部文章
						<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
							<path
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
						</svg>
					</a>
				</header>

				{featured.length === 0 ? (
					<p class="empty-hint">还没有文章。第一篇文章写好后，会出现在这里。</p>
				) : (
					<div class="post-grid">
						{featured.map((post, i) => (
							<PostCard post={post} index={i} delay={i * 90} />
						))}
					</div>
				)}
			</div>
		</section>

		<!-- ============ 滚动标语 ============ -->
		<div class="ticker" aria-hidden="true">
			<div class="ticker-track">
				{[0, 1, 2, 3].map(() => (
					<span class="ticker-item">
						记录日常 <i>·</i> 写下想法 <i>·</i> 留住光影 <i>·</i> 慢慢整理 <i>·</i>
					</span>
				))}
			</div>
		</div>

		<!-- ============ 照片墙 ============ -->
		<section class="sec sec--gallery">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">02 — PHOTOS</span>
						<h2>照片墙</h2>
					</div>
					<a class="sec-head__more" href="/gallery">
						进入照片墙
						<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
							<path
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
						</svg>
					</a>
				</header>
			</div>

			{photos.length === 0 ? (
				<div class="wrap">
					<p class="empty-hint">暂无照片，添加后这里会流动起来。</p>
				</div>
			) : (
				<div class="wall-stage" data-reveal="mask">
					<DriftWall
						items={wallItems}
						columns={5}
						rows={3}
						tileWidth={200}
						tileHeight={132}
						gap={18}
						tilt={14}
						turn={-12}
						perspective={1200}
						depth={120}
						speed={34}
						direction="left"
						variance={0.45}
						parallax={0.6}
						lift={64}
						fade={0.7}
						dim={0.35}
						height="clamp(380px, 56vh, 620px)"
					/>
					<div class="wall-edge wall-edge--top" aria-hidden="true"></div>
					<div class="wall-edge wall-edge--bottom" aria-hidden="true"></div>
					<div class="wall-note glass">
						<span class="wall-note__num">{photos.length}</span>
						<span class="wall-note__txt">张照片，按年月整理在照片墙里</span>
						<a href="/gallery" class="wall-note__link">去看看 →</a>
					</div>
				</div>
			)}
		</section>

		<!-- ============ 关于 ============ -->
		<section class="sec">
			<div class="wrap">
				<div class="about-card glass" data-reveal data-glow>
					<div class="about-main">
						<span class="sec-head__index">03 — ABOUT</span>
						<h2>写点关于自己的话</h2>
						<p>
							这里是一段占位简介：介绍你在记录什么、关注哪些方向，以及为什么开始写。
							我会把日常随笔、阅读笔记和生活照片慢慢放在这里，不追求产量，只求留下一些真实的痕迹。
						</p>
						<a class="about-link" href="/about">
							了解一下
							<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
								<path
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
							</svg>
						</a>
					</div>
					<ul class="about-facts">
						<li><span>记录方式</span>文字 · 照片</li>
						<li><span>更新节奏</span>不定期，想起来就写</li>
						<li><span>站点技术</span>Astro · GitHub Pages</li>
						<li><span>留言</span>文章页底部评论区</li>
					</ul>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.home {
		width: 100%;
		max-width: none;
		padding: 0;
	}

	.wrap {
		width: 100%;
		max-width: var(--w-wide);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		min-height: min(96vh, 940px);
		display: flex;
		align-items: center;
		padding: clamp(3.5rem, 9vh, 6rem) 0 clamp(2.5rem, 6vh, 4rem);
		overflow: hidden;
		isolation: isolate;
	}
	.hero-waves {
		position: absolute;
		inset: -10% -10% 0;
		z-index: -1;
		opacity: 0.9;
	}
	.hero-wall {
		position: absolute;
		inset: auto 0 0 0;
		height: clamp(148px, 20vh, 236px);
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 42%);
		mask-image: linear-gradient(to bottom, transparent 0, #000 42%);
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--w-wide);
		margin: 0 auto;
		/* 底部留出 hero 照片带的高度（顺序别换，简写会把 padding-bottom 冲掉） */
		padding: 0 var(--gutter) clamp(12rem, 24vh, 16rem);
	}
	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 1.6rem;
		padding: 0.35rem 0.9rem 0.35rem 0.7rem;
		border-radius: var(--r-pill);
		font-size: 0.72rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgb(var(--accent-deep));
		background: var(--glass-bg);
		border: 1px solid var(--glass-brd);
		backdrop-filter: blur(12px);
	}
	.pulse {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: rgb(var(--accent));
		box-shadow: 0 0 0 0 rgba(var(--accent), 0.5);
		animation: pulse-ring 2.8s var(--ease-out) infinite;
	}
	@keyframes pulse-ring {
		0%,
		70%,
		100% {
			box-shadow: 0 0 0 0 rgba(var(--accent), 0.45);
		}
		35% {
			box-shadow: 0 0 0 6px rgba(var(--accent), 0);
		}
	}

	.hero-title {
		margin: 0 0 1.5rem;
		font-size: clamp(2.5rem, 7.2vw, 5.4rem);
		line-height: 1.02;
		letter-spacing: -0.03em;
		font-weight: 800;
	}
	.hero-line {
		display: block;
		overflow: hidden;
		padding-bottom: 0.06em;
	}
	.hero-line > span {
		display: inline-block;
		transform: translateY(110%);
		animation: line-rise 1.05s var(--ease-out) forwards;
	}
	.hero-line:nth-child(2) > span {
		animation-delay: 0.12s;
	}
	.hero-line--outline > span {
		color: transparent;
		-webkit-text-stroke: 1.4px rgba(var(--ink), 0.55);
	}
	@keyframes line-rise {
		to {
			transform: translateY(0);
		}
	}

	.hero-lede {
		max-width: 34em;
		margin: 0 0 2rem;
		font-size: clamp(1rem, 1.5vw, 1.12rem);
		color: rgb(var(--muted));
		opacity: 0;
		animation: soft-in 0.9s var(--ease-out) 0.34s forwards;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		opacity: 0;
		animation: soft-in 0.9s var(--ease-out) 0.46s forwards;
	}
	.hero-stats {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(1.4rem, 5vw, 3.4rem);
		margin: clamp(2.2rem, 5vh, 3.4rem) 0 0;
		padding-top: 1.4rem;
		border-top: 1px solid rgba(var(--line), 0.9);
		opacity: 0;
		animation: soft-in 0.9s var(--ease-out) 0.58s forwards;
	}
	.hero-stats div {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.2rem;
	}
	.hero-stats dt {
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgb(var(--muted-light));
	}
	.hero-stats dd {
		margin: 0;
		font-size: clamp(1.3rem, 2.4vw, 1.7rem);
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.02em;
		color: rgb(var(--ink));
	}
	.hero-stats dd span {
		margin-left: 0.25em;
		font-size: 0.7rem;
		font-weight: 500;
		color: rgb(var(--muted));
	}
	.hero-stats__date {
		font-size: 1rem !important;
		font-weight: 600 !important;
		color: rgb(var(--muted)) !important;
		padding-top: 0.35rem;
	}
	@keyframes soft-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.scroll-cue {
		position: absolute;
		left: 50%;
		bottom: 1.6rem;
		transform: translateX(-50%);
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.62rem;
		letter-spacing: 0.34em;
		color: rgb(var(--muted-light));
		text-decoration: none;
		animation: cue-float 3.4s var(--ease-out) infinite;
	}
	.scroll-cue svg {
		opacity: 0.65;
	}
	@keyframes cue-float {
		0%,
		100% {
			transform: translate(-50%, 0);
		}
		50% {
			transform: translate(-50%, 7px);
		}
	}

	/* ---------- 区块 ---------- */
	.sec {
		padding: clamp(3.6rem, 8vw, 6.5rem) 0;
	}
	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2vw, 1.5rem);
	}

	/* ---------- 滚动标语 ---------- */
	.ticker {
		position: relative;
		overflow: hidden;
		padding: 0.9rem 0;
		border-block: 1px solid rgba(var(--line), 0.85);
		mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
	}
	.ticker-track {
		display: flex;
		width: max-content;
		animation: ticker-move 34s linear infinite;
	}
	.ticker-item {
		display: inline-flex;
		align-items: center;
		gap: 1.1rem;
		padding-right: 1.1rem;
		font-size: 0.8rem;
		letter-spacing: 0.26em;
		color: rgba(var(--ink), 0.42);
		white-space: nowrap;
	}
	.ticker-item i {
		font-style: normal;
		color: rgba(var(--accent), 0.5);
	}
	@keyframes ticker-move {
		to {
			transform: translateX(-50%);
		}
	}

	/* ---------- 照片墙 ---------- */
	.wall-stage {
		position: relative;
		margin-top: 0.5rem;
	}
	/* 上下边缘融进纸面，避免照片带被切出一条硬边 */
	.wall-edge {
		position: absolute;
		inset-inline: 0;
		height: clamp(48px, 9vh, 96px);
		pointer-events: none;
		z-index: 2;
	}
	.wall-edge--top {
		top: 0;
		background: linear-gradient(to bottom, rgb(var(--bg)), rgba(var(--bg), 0));
	}
	.wall-edge--bottom {
		bottom: 0;
		background: linear-gradient(to top, rgb(var(--bg)), rgba(var(--bg), 0));
	}
	.wall-note {
		position: absolute;
		z-index: 3;
		left: var(--gutter);
		bottom: clamp(1rem, 4vh, 2.4rem);
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.7rem 1.1rem;
		border-radius: var(--r-pill);
		font-size: 0.82rem;
		color: rgb(var(--ink-soft));
	}
	.wall-note__num {
		font-size: 1.1rem;
		font-weight: 800;
		color: rgb(var(--accent));
		font-variant-numeric: tabular-nums;
	}
	.wall-note__link {
		font-weight: 700;
		text-decoration: none;
		color: rgb(var(--accent));
	}
	.wall-note__link:hover {
		color: rgb(var(--accent-deep));
	}

	/* ---------- 关于 ---------- */
	.about-card {
		display: grid;
		grid-template-columns: 1.25fr 0.75fr;
		gap: clamp(1.6rem, 4vw, 3.4rem);
		padding: clamp(1.6rem, 4vw, 3rem);
		border-radius: var(--r-xl);
	}
	.about-main h2 {
		margin: 0.15em 0 0.7em;
	}
	.about-main p {
		color: rgb(var(--muted));
		max-width: 46ch;
	}
	.about-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.4rem;
		font-weight: 700;
		text-decoration: none;
		color: rgb(var(--accent));
		transition: gap var(--dur-fast) var(--ease-out);
	}
	.about-link:hover {
		gap: 0.7rem;
	}
	.about-facts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.1rem;
	}
	.about-facts li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.7rem 0;
		border-bottom: 1px dashed rgba(var(--line), 0.95);
		font-size: 0.9rem;
		color: rgb(var(--ink-soft));
	}
	.about-facts li:last-child {
		border-bottom: none;
	}
	.about-facts span {
		color: rgb(var(--muted-light));
		font-size: 0.82rem;
	}

	@media (max-width: 980px) {
		.post-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.post-grid > :first-child {
			grid-column: span 2;
		}
		.about-card {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 680px) {
		.hero {
			min-height: auto;
			padding-top: 3rem;
			padding-bottom: 0;
		}
		.hero-stats {
			gap: 1.6rem;
		}
		.post-grid {
			grid-template-columns: 1fr;
		}
		.post-grid > :first-child {
			grid-column: auto;
		}
		.wall-note {
			position: static;
			margin: 1rem var(--gutter) 0;
			justify-content: space-between;
		}
		.scroll-cue {
			display: none;
		}
	}
</style>



