---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShapeWaves from '../components/ShapeWaves.astro';
import SplitText from '../components/SplitText.astro';
import SpecularButton from '../components/SpecularButton.astro';
import CountUp from '../components/CountUp.astro';
import PostCard from '../components/PostCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import { getCollection } from 'astro:content';
import { AUTHOR_NAME, HERO, PROFILE, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// 精选 = 手动标了 featured 的（按时间倒序），不足 3 篇时用最新的补齐
const pinned = posts.filter((post) => post.data.featured);
const featured = [...pinned, ...posts.filter((post) => !post.data.featured)].slice(0, 3);

const photos = (await getCollection('gallery')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// 知识库：仅用于首页统计（板块改为入口卡片，点击进入独立页）
const knowledge = (await getCollection('knowledge'))
	.filter((n) => !n.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 标签云 + 最新动态 + 站点统计（门户式版块用）
const tagCount = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
const tagStats = [...tagCount.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 6)
	.map(([name, count]) => ({ name, count }));

const activity = posts.slice(0, 4).map((post) => ({
	title: post.data.title,
	href: `/blog/${post.id}/`,
	date: post.data.pubDate.toISOString().slice(0, 10),
}));

const totalWords = posts.reduce((sum, post) => sum + (post.body?.replace(/\s/g, '').length ?? 0), 0);
const firstDate = posts.length ? new Date(Math.min(...posts.map((p) => p.data.pubDate.valueOf()))) : null;
const days = firstDate ? Math.max(1, Math.ceil((Date.now() - firstDate.valueOf()) / 86400000)) : 0;

const stats = [
	{ label: '文章', value: posts.length, unit: '篇' },
	{ label: '照片', value: photos.length, unit: '张' },
	{ label: '知识', value: knowledge.length, unit: '条' },
	{ label: '总字数', value: totalWords, unit: '字' },
	{ label: '运行', value: days, unit: '天' },
];

const latest = posts[0]?.data.pubDate;

// 发现页链接摘要：首页「发现」板块展示前几条
import discoverData from '../data/discover.json';
const discoverPreview = discoverData.collections
	.flatMap((g) => g.links)
	.slice(0, 6);
---

<BaseLayout title={`${SITE_TITLE} · ${HERO.tagline}`} description={SITE_DESCRIPTION} hero>
	<main class="home">
		<!-- ============ 首页 Hero ============ -->
		<section class="hero" id="home" data-section="home">
			<div class="hero-waves" aria-hidden="true">
				<ShapeWaves
					shapes="mixed"
					cellSize={12}
					dotSize={0.72}
					speed={0.8}
					scale={1.1}
					contrast={1.15}
					brightness={0.42}
					flow={0.6}
					direction={24}
					fade={0.28}
					interactive={true}
					splashRadius={60}
					splashStrength={0.5}
					glow={0.45}
					intro={true}
					introDuration={1.8}
				/>
			</div>

			<div class="hero-inner">
				<p class="hero-eyebrow">
					<span class="pulse" aria-hidden="true"></span>
					{HERO.role}
				</p>

				<div class="hero-head">
					<h1 class="hero-title">
						<SplitText
							text={HERO.title}
							tag="span"
							effect="blur"
							duration={0.9}
							delay={45}
							staggerFrom="start"
							trigger="load"
							mask
							class="hero-title__text"
						/>
					</h1>
					<p class="hero-sub">
						<SplitText
							text={HERO.subtitle}
							tag="span"
							effect="fade"
							duration={0.9}
							delay={70}
							staggerFrom="start"
							trigger="load"
							class="hero-sub__text"
						/>
					</p>
				</div>

				<p class="hero-lede">{HERO.tagline2}。</p>

				<div class="hero-actions">
					<SpecularButton
						href="/blog"
						size="md"
						radius={999}
						tintOpacity={0.8}
						blur={10}
						lineColor="#c2743f"
						baseColor="#e7d9c8"
						idleIntensity={0.3}
						intensity={1.15}
						shineSize={8}
						shineFade={24}
						thickness={2}
						glow={0.75}
						proximity={260}
						autoAnimate
						speed={0.22}
					>
						阅读文章
					</SpecularButton>
					<SpecularButton
						href="/gallery"
						size="md"
						radius={999}
						class="sb-ghost"
						tintOpacity={0.4}
						blur={8}
						textColor="var(--muted)"
						lineColor="#9c8168"
						baseColor="#e2d3c1"
						idleIntensity={0.16}
						shineSize={10}
						shineFade={30}
						thickness={1}
						glow={0.7}
						proximity={220}
					>
						看看照片
					</SpecularButton>
				</div>

				<dl class="hero-stats">
					<div>
						<dt>文章</dt>
						<dd><CountUp to={posts.length} /><span>篇</span></dd>
					</div>
					<div>
						<dt>照片</dt>
						<dd><CountUp to={photos.length} /><span>张</span></dd>
					</div>
					<div>
						<dt>最近更新</dt>
						<dd class="hero-stats__date">
							{latest ? <FormattedDate date={latest} /> : '—'}
						</dd>
					</div>
				</dl>
			</div>

			<a class="scroll-cue" href="#articles" aria-label="向下浏览">
				<span>SCROLL</span>
				<svg viewBox="0 0 16 26" width="14" height="22" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						stroke-linecap="round"
						d="M8 2v18M3 15l5 5 5-5"></path>
				</svg>
			</a>

		</section>

		<!-- ============ 文章（精选） ============ -->
		<section class="sec sec--blog" id="articles" data-section="articles">
			<div class="wrap">
				<div class="tagbar" data-reveal>
					<a class="tagbar__home" href="/" aria-label="首页">
						<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 7.2 8 2l6 5.2V14H2z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
					</a>
					{tagStats.map((t) => (
						<a class="tagbar__item" href={`/blog/?tag=${encodeURIComponent(t.name)}`}>
							{t.name}<span>{t.count}</span>
						</a>
					))}
					<a class="tagbar__more" href="/blog">更多 →</a>
				</div>

				<div class="bloggrid">
					<aside data-reveal>
						<SpotlightCard class="profile" color="255, 184, 108" size={260} intensity={0.18} tilt={4}>
							<div class="profile__ava" aria-hidden="true">
								{PROFILE.avatar ? (
									<img src={PROFILE.avatar} alt={AUTHOR_NAME} loading="lazy" decoding="async" />
								) : (
									<span>{AUTHOR_NAME.slice(0, 1).toUpperCase()}</span>
								)}
							</div>
							<div class="profile__id">
								<h3 class="profile__name">{AUTHOR_NAME}</h3>
								<span class="profile__role">{PROFILE.role}</span>
							</div>
							<p class="profile__bio">{HERO.tagline}</p>
							<ul class="profile__social">
								{SOCIAL_LINKS.github && (
									<li>
										<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener" aria-label="GitHub">
											<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
												<path
													fill="currentColor"
													d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
												></path>
											</svg>
										</a>
									</li>
								)}
								{SOCIAL_LINKS.email && (
									<li>
										<a href={SOCIAL_LINKS.email} aria-label="邮箱">
											<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
												<path
													fill="currentColor"
													d="M1.5 3h13a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5Zm.7 1 5.68 4.38a.5.5 0 0 0 .64 0L14.1 4H2.2ZM14 5.62 9.62 8.99a1.5 1.5 0 0 1-1.92 0L3 5.62V12h11V5.62Z"
												></path>
											</svg>
										</a>
									</li>
								)}
							</ul>
							<div class="profile__links">
								<a href="/about">关于我</a>
								<a href="/rss.xml">RSS</a>
							</div>
						</SpotlightCard>
					</aside>

					<div class="bloggrid__main">
						<header class="sec-head">
							<div>
								<span class="sec-head__index">01 — WRITING</span>
								<h2>精选文章</h2>
							</div>
							<a class="sec-head__more" href="/blog">
								全部文章
								<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
									<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
								</svg>
							</a>
						</header>

						{featured.length === 0 ? (
							<p class="empty-hint">还没有文章。第一篇文章写好后，会出现在这里。</p>
						) : (
							<div class="post-grid">
								{featured.map((post, i) => (
									<PostCard post={post} index={i} delay={i * 90} lead={i === 0} />
								))}
							</div>
						)}
					</div>

					<aside class="bloggrid__side">
						<section class="portal" data-reveal data-reveal-delay="60">
							<h4 class="portal__title">最新动态</h4>
							<ul class="feed">
								{activity.map((item) => (
									<li class="feed__item">
										<a href={item.href}>{item.title}</a>
										<time>{item.date}</time>
									</li>
								))}
							</ul>
							<a class="portal__more" href="/blog">更多动态 →</a>
						</section>

						<section class="portal" data-reveal data-reveal-delay="120">
							<h4 class="portal__title">站点统计</h4>
							<ul class="stats">
								{stats.map((s) => (
									<li>
										<span>{s.label}</span>
										<b><CountUp to={s.value} separator="," /><em>{s.unit}</em></b>
									</li>
								))}
							</ul>
						</section>
					</aside>
				</div>
			</div>
		</section>

		<!-- ============ 滚动标语 ============ -->
		<div class="ticker" aria-hidden="true">
			<div class="ticker-track">
				{[0, 1, 2, 3].map(() => (
					<span class="ticker-item">
						记录日常 <i>·</i> 写下想法 <i>·</i> 沉淀知识 <i>·</i> 留住光影 <i>·</i> 慢慢整理 <i>·</i>
					</span>
				))}
			</div>
		</div>

		<!-- ============ 知识库 ============ -->
		<section class="sec sec--knowledge" id="knowledge" data-section="knowledge">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">02 — KNOWLEDGE</span>
						<h2>知识库</h2>
					</div>
				</header>

				<a class="portal-entry glass" href="/knowledge" data-reveal data-glow>
					<div class="portal-entry__body">
						<span class="portal-entry__kicker">成体系的笔记 · 分类沉淀</span>
						<h3 class="portal-entry__title">进入知识库</h3>
						<p class="portal-entry__desc">
							前端、工具、阅读……把零散的想法整理成结构化的笔记，慢慢累积成自己的知识体系。
						</p>
					</div>
					<span class="portal-entry__arrow" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="20" height="20">
							<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
						</svg>
					</span>
				</a>
			</div>
		</section>

		<!-- ============ 发现 ============ -->
		<section class="sec sec--discover" id="discover" data-section="discover">
			<div class="wrap">
				<header class="sec-head">
					<div>
						<span class="sec-head__index">03 — DISCOVER</span>
						<h2>发现</h2>
					</div>
					<a class="sec-head__more" href="/discover">
						全部链接
						<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
							<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
						</svg>
					</a>
				</header>

				<div class="discover-grid">
					{discoverPreview.map((link, i) => (
						<a
							class="discover-card glass"
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							data-reveal
							data-reveal-delay={i * 60}
						>
							<span class="discover-card__logo" data-logo data-domain={new URL(link.url).hostname.replace(/^www\./, '')}>
								<span class="discover-card__fallback" aria-hidden="true">{link.title.slice(0, 1).toUpperCase()}</span>
							</span>
							<div class="discover-card__body">
								<h3>{link.title}</h3>
								<p>{link.description}</p>
							</div>
						</a>
					))}
				</div>

				<!-- 照片墙入口：放在发现模块 -->
				<a class="portal-entry portal-entry--photos glass" href="/gallery" data-reveal data-glow>
					<div class="portal-entry__body">
						<span class="portal-entry__kicker">生活里的光影 · 按年月整理</span>
						<h3 class="portal-entry__title">进入照片墙</h3>
						<p class="portal-entry__desc">
							记录下的瞬间都收在这里，追光网格里点开看每一张照片。
						</p>
					</div>
					<span class="portal-entry__arrow" aria-hidden="true">
						<svg viewBox="0 0 16 16" width="20" height="20">
							<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
						</svg>
					</span>
				</a>
			</div>
		</section>

		<!-- ============ 关于 ============ -->
		<section class="sec" id="about" data-section="about">
			<div class="wrap">
				<div class="about-card glass" data-reveal data-glow>
					<div class="about-main">
						<span class="sec-head__index">04 — ABOUT</span>
						<h2>写点关于自己的话</h2>
						<p>{PROFILE.bio}</p>
						<a class="about-link" href="/about">
							了解一下
							<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
								<path
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
							</svg>
						</a>
					</div>
					<ul class="about-facts">
						<li><span>记录方式</span>文字 · 照片</li>
						<li><span>更新节奏</span>不定期，想起来就写</li>
						<li><span>站点技术</span>Astro · GitHub Pages</li>
						<li><span>留言</span>文章页底部评论区</li>
					</ul>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	// 首页 scroll-spy：滚动时根据各板块位置，更新顶部导航高亮 + 发现页 favicon 自动加载。
	// 板块顺序即导航顺序；板块 id 需映射到导航的 href。
	const SECTION_MAP = [
		{ id: 'home', href: '/' },
		{ id: 'articles', href: '/blog' },
		{ id: 'knowledge', href: '/knowledge' },
		{ id: 'discover', href: '/discover' },
		{ id: 'about', href: '/about' },
	];

	function loadFavicons() {
		const logos = document.querySelectorAll<HTMLElement>('[data-logo]');
		for (const logo of logos) {
			if (logo.dataset.done === '1') continue;
			logo.dataset.done = '1';
			const domain = logo.dataset.domain;
			if (!domain) continue;
			const img = document.createElement('img');
			img.alt = '';
			img.loading = 'lazy';
			img.decoding = 'async';
			img.src = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`;
			img.onload = () => logo.prepend(img);
		}
	}

	function initScrollSpy() {
		const sections = SECTION_MAP.map((s) => ({ ...s, el: document.getElementById(s.id) })).filter((s) => s.el);
		if (!sections.length) return;

		let ticking = false;
		const update = () => {
			ticking = false;
			const probe = window.innerHeight * 0.4;
			let current = sections[0];
			for (const sec of sections) {
				const r = sec.el!.getBoundingClientRect();
				if (r.top <= probe) current = sec;
			}
			// 同步导航高亮：给对应 nav-link 加/去 is-active，并触发 Header 高亮块滑动
			const navLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-item]'));
			navLinks.forEach((link) => {
				const on = link.dataset.href === current.href;
				link.classList.toggle('is-active', on);
				if (on) link.setAttribute('aria-current', 'page');
				else link.removeAttribute('aria-current');
			});
			window.dispatchEvent(new CustomEvent('scroll-spy', { detail: { href: current.href } }));
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};
		window.addEventListener('scroll', onScroll, { passive: true });
		update();
	}

	function init() {
		loadFavicons();
		initScrollSpy();
	}

	document.addEventListener('astro:page-load', init);
	if (document.readyState !== 'loading') init();
	else document.addEventListener('DOMContentLoaded', init);
</script>

<style>
	.home {
		width: 100%;
		max-width: none;
		padding: 0;
	}

	.wrap {
		width: 100%;
		max-width: var(--w-wide);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: center;
		padding: clamp(6rem, 14vh, 9rem) 0 clamp(4rem, 9vh, 6rem);
		overflow: hidden;
		isolation: isolate;
	}
	.hero-waves {
		position: absolute;
		inset: 0;
		z-index: -1;
		/* 方格地面往下渐隐，避免和后面的卡片抢注意力 */
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 80%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 0%, #000 80%, transparent 100%);
	}
	/* 让整屏像一张连续的画：底部压暗、左上角留一层暖雾 */
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(120% 80% at 8% 6%, rgba(var(--bg), 0.66), transparent 46%),
			linear-gradient(to bottom, transparent 58%, rgba(var(--bg), 0.88) 100%);
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--w-wide);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}
	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 1.6rem;
		padding: 0.35rem 0.9rem 0.35rem 0.7rem;
		border-radius: var(--r-pill);
		font-size: 0.72rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgb(var(--accent-deep));
		background: var(--glass-bg);
