---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const notes = (await getCollection('knowledge'))
		.filter((n) => !n.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

type Props = { note: CollectionEntry<'knowledge'> };
const { note } = Astro.props;
const { Content } = await render(note);
---

<BaseLayout title={`${note.data.title} · 知识库 · ${SITE_TITLE}`} description={note.data.description ?? SITE_DESCRIPTION}>
	<main class="kb-post">
		<header class="kb-post__head">
			<a class="kb-back" href="/knowledge">← 知识库</a>
			<span class="kb-post__category">{note.data.category}</span>
			<h1>{note.data.title}</h1>
			{note.data.description && <p class="kb-post__desc">{note.data.description}</p>}
			<div class="kb-post__meta">
				<time datetime={note.data.pubDate.toISOString()}>
					<FormattedDate date={note.data.pubDate} />
				</time>
				{note.data.tags.length > 0 && (
					<span class="kb-post__tags">
						{note.data.tags.map((t) => (
							<span class="kb-post__tag">{t}</span>
						))}
					</span>
				)}
			</div>
		</header>
		<article class="prose">
			<Content />
		</article>
	</main>
</BaseLayout>

<style>
	.kb-post {
		width: var(--w-read);
		margin-inline: auto;
		padding-top: 1rem;
	}
	.kb-post__head {
		padding: 0 0 1.4rem;
		margin-bottom: 1.6rem;
		border-bottom: 1px solid rgba(var(--line), 1);
	}
	.kb-back {
		display: inline-block;
		font-size: 0.84rem;
		color: rgb(var(--muted));
		text-decoration: none;
		margin-bottom: 1rem;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.kb-back:hover {
		color: rgb(var(--accent-deep));
	}
	.kb-post__category {
		display: inline-block;
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		color: rgb(var(--accent-deep));
		background: rgba(var(--accent), 0.12);
		border-radius: var(--r-pill);
		padding: 0.15rem 0.6rem;
		margin-bottom: 0.7rem;
	}
	.kb-post__head h1 {
		margin: 0 0 0.4rem;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		line-height: 1.25;
	}
	.kb-post__desc {
		margin: 0 0 0.8rem;
		color: rgb(var(--muted));
		font-size: 1rem;
	}
	.kb-post__meta {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		font-size: 0.82rem;
		color: rgb(var(--muted-light));
	}
	.kb-post__tags {
		display: flex;
		gap: 0.35rem;
	}
	.kb-post__tag {
		font-size: 0.72rem;
		color: rgb(var(--muted));
		background: var(--chip-bg);
		border-radius: var(--r-pill);
		padding: 0.05rem 0.55rem;
	}
</style>
