---
// 知识库总览：左侧「索引」栏（分类 / 标签 / 条目清单）+ 右侧按分类分组的卡片。
// 索引栏在桌面端常驻吸附，窄屏收成一条可横滑的分类胶囊，节省首屏高度。
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import BranchedMenu from '../../components/BranchedMenu.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const notes = (await getCollection('knowledge'))
	.filter((n) => !n.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 按分类分组：pinned 置顶排前，其余按时间倒序
const byCategory = new Map<string, typeof notes>();
for (const note of notes) {
	const cat = note.data.category || '未分类';
	if (!byCategory.has(cat)) byCategory.set(cat, []);
	byCategory.get(cat)!.push(note);
}
// 分类顺序：置顶多的分类排前，再按分类名
const categories = [...byCategory.entries()].sort((a, b) => {
	const ap = a[1].filter((n) => n.data.pinned).length;
	const bp = b[1].filter((n) => n.data.pinned).length;
	if (ap !== bp) return bp - ap;
	return a[0].localeCompare(b[0], 'zh-Hans-CN');
});

// 标签只保留两个维度：阶段（学习顺序）与主题（横向领域），顺序固定，不求全。
const STAGES = ['入门', '核心', '进阶', '实战'];
const TOPICS = ['前端', '网络', '数据', '工具', '运行时', '算法'];
const stageOf = (note: (typeof notes)[number]) =>
	note.data.tags.find((t) => STAGES.includes(t)) ?? '其他';

// 锚点用序号（cat-01），避免中文分类名进 id；索引栏与正文共用这份编号。
// 每个大类内部再按阶段分组；分类 section 仍是滚动高亮与筛选的粒度。
const groups = categories.map(([name, list], i) => {
	const catId = `cat-${String(i + 1).padStart(2, '0')}`;
	const byStage = STAGES.map((s, si) => ({
		id: `${catId}-s${si + 1}`,
		num: String(si + 1).padStart(2, '0'),
		name: s,
		list: list.filter((n) => stageOf(n) === s),
	})).filter((g) => g.list.length > 0);
	const rest = list.filter((n) => !STAGES.includes(stageOf(n)));
	if (rest.length) byStage.push({ id: `${catId}-s0`, num: '00', name: '其他', list: rest });
	return {
		id: catId,
		num: String(i + 1).padStart(2, '0'),
		name,
		list,
		stages: byStage,
	};
});

// 标签聚合：只数阶段与主题两组，不把每个技术名词都做成筛选按钮
const tagCount = new Map<string, number>();
for (const note of notes) {
	for (const tag of note.data.tags) tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
}
const tagGroup = (names: string[]) =>
	names.filter((n) => tagCount.has(n)).map((n) => ({ name: n, count: tagCount.get(n)! }));
const stageTags = tagGroup(STAGES);
const topicTags = tagGroup(TOPICS);

const pad = (n: number) => String(n).padStart(2, '0');
const pinnedCount = notes.filter((n) => n.data.pinned).length;

// 分叉导航（BranchedMenu）：分类 → 条目，条目直接指向详情页；
// data-tags 沿用页面筛选脚本的数据源，不需要另写一套筛选。
const menuItems = groups.map((group) => ({
	label: group.name,
	value: group.id,
	anchor: group.id,
	num: group.num,
	count: pad(group.list.length),
	children: group.stages.flatMap((stage) => stage.list).map((note) => ({
		value: note.id,
		label: note.data.title,
		href: `/knowledge/${note.id}/`,
		tags: note.data.tags.join(','),
	})),
}));

// 知识库为空时的「导航样式预览」。只用于渲染，不写入 content 集合，
// 因此不会生成假的详情页；一旦有笔记，下面这个分支就不会被用到。
const previewItems = [
	{
		label: '开始使用',
		value: 'preview-start',
		num: '01',
		children: [
			{ value: 'p-new', label: '新建第一条笔记' },
			{ value: 'p-admin', label: '用 /admin 直接上传' },
			{ value: 'p-fields', label: 'Frontmatter 字段' },
		],
	},
	{
		label: '内容组织',
		value: 'preview-organize',
		num: '02',
		children: [
			{ value: 'p-category', label: '分类与编号' },
			{ value: 'p-tags', label: '标签筛选' },
			{ value: 'p-pinned', label: '置顶与草稿' },
		],
	},
];
---

<BaseLayout title={`知识库 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main class="kb-main">
		<header class="kb-head" data-reveal>
			<span class="sec-head__index">KNOWLEDGE / {pad(notes.length)}</span>
			<h1>知识库</h1>
			<p class="kb-head__desc">
				成体系的笔记与心得，独立于日常随笔，按分类沉淀、按阶段推进。
			</p>
			<p class="kb-head__meta">
				<span>{pad(groups.length)} 个分类</span>
				<span>{pad(stageTags.length)} 个阶段 / {pad(topicTags.length)} 个主题</span>
				{pinnedCount > 0 && <span>{pad(pinnedCount)} 条置顶</span>}
			</p>
			<p class="kb-filter-note" data-kb-note hidden>
				<span data-kb-note-text></span>
				<button type="button" class="kb-filter-note__reset" data-kb-reset>清除筛选</button>
			</p>
		</header>

		{notes.length === 0 ? (
			<div class="kb-empty glass" data-reveal>
				<span class="sec-head__index">EMPTY / PREVIEW</span>
				<h2>知识库还空着</h2>
				<p>
					在 <code>src/content/knowledge/</code> 目录下新建一个 <code>.md</code> 文件，
					填上 <code>title / category / pubDate</code>，提交后就会在这里出现。
				</p>
				<!-- 没有内容时也把导航效果展示出来：明确标注为预览，不是真实条目 -->
				<div class="kb-empty__preview">
					<p class="kb-empty__preview-note">导航样式预览 · 添加笔记后会自动替换为真实目录</p>
					<BranchedMenu
						items={previewItems}
						defaultOpen={[0, 1]}
						preview
						forceTree
						ariaLabel="知识库导航样式预览"
					/>
				</div>
			</div>
		) : (
			<div class="kb-shell">
				<!-- ═══ 左：分类索引树 ═══ -->
				<aside class="kb-index" aria-label="知识库索引">
					<div class="kb-index__head">
						<span class="sec-head__index">INDEX</span>
						<span class="kb-index__total">{pad(notes.length)} 条</span>
					</div>

					<BranchedMenu items={menuItems} defaultOpen={0} ariaLabel="按分类跳转" />

					<p class="kb-index__empty" data-kb-empty hidden>没有匹配的条目</p>
				</aside>

				<!-- ═══ 右端：标签筛选（阶段 / 主题两组） ═══ -->
				<aside class="kb-tags" aria-label="按标签筛选">
					<div class="kb-tags__head">
						<span class="sec-head__index">FILTER</span>
						<span class="kb-tags__total" data-kb-total>{pad(notes.length)} 条</span>
					</div>

					{stageTags.length > 0 && (
						<div class="kb-tags__set">
							<p class="kb-tags__label">阶段 / STAGE</p>
							<div class="kb-tags__group" role="group" aria-label="按阶段筛选">
								{stageTags.map(({ name, count }) => (
									<button class="kb-tag" type="button" data-kb-tag={name} aria-pressed="false">
										<span class="kb-tag__name">{name}</span>
										<span class="kb-tag__count">{count}</span>
									</button>
								))}
							</div>
						</div>
					)}

					{topicTags.length > 0 && (
						<div class="kb-tags__set">
							<p class="kb-tags__label">主题 / TOPIC</p>
							<div class="kb-tags__group" role="group" aria-label="按主题筛选">
								{topicTags.map(({ name, count }) => (
									<button class="kb-tag" type="button" data-kb-tag={name} aria-pressed="false">
										<span class="kb-tag__name">{name}</span>
										<span class="kb-tag__count">{count}</span>
									</button>
								))}
							</div>
						</div>
					)}

					<p class="kb-tags__hint">点标签筛选，再点一次取消</p>
				</aside>

				<!-- ═══ 中：按分类 → 阶段分组 ═══ -->
				<div class="kb-body">
					{groups.map((group) => (
						<section class="kb-cat" id={group.id} data-kb-section={group.id}>
							<h2 class="kb-cat__title">
								<span class="kb-cat__n">{group.num}</span>
								<span class="kb-cat__name">{group.name}</span>
								<span class="kb-cat__rule" aria-hidden="true"></span>
								<span class="kb-cat__count" data-kb-count>{pad(group.list.length)} 条</span>
							</h2>
							{group.stages.map((stage) => (
								<div class="kb-stage" data-kb-stage>
									<h3 class="kb-stage__title">
										<span class="kb-stage__n">{stage.num}</span>
										<span class="kb-stage__name">{stage.name}</span>
										<span class="kb-stage__rule" aria-hidden="true"></span>
										<span class="kb-stage__count" data-kb-stage-count>{pad(stage.list.length)} 条</span>
									</h3>
									<div class="kb-grid">
										{stage.list.map((note) => (
											<a
												class="kb-card"
												href={`/knowledge/${note.id}/`}
												data-kb-card
												data-tags={note.data.tags.join(',')}
											>
												<div class="kb-card__top">
													<span class="kb-card__tags">
														{note.data.tags.map((t) => (
															<span class="kb-card__tag">{t}</span>
														))}
													</span>
													{note.data.pinned && (
														<span class="kb-card__pin" title="置顶">◆</span>
													)}
												</div>
												<h4 class="kb-card__title">{note.data.title}</h4>
												{note.data.description && (
													<p class="kb-card__desc">{note.data.description}</p>
												)}
												<time class="kb-card__date" datetime={note.data.pubDate.toISOString()}>
													<FormattedDate date={note.data.pubDate} />
												</time>
											</a>
										))}
									</div>
								</div>
							))}
						</section>
					))}

					<p class="kb-body__end">
						— 共 <span data-kb-end>{pad(notes.length)}</span> 条
					</p>
				</div>
			</div>
		)}
	</main>
</BaseLayout>

<script>
	// 索引栏两件事：标签筛选（同步过滤索引条目与正文卡片）、分类高亮（跟随滚动）。
	function init() {
		const main = document.querySelector<HTMLElement>('.kb-main');
		if (!main || main.dataset.kbWired) return;
		main.dataset.kbWired = '1';

		const chips = Array.from(main.querySelectorAll<HTMLButtonElement>('[data-kb-tag]'));
		const cards = Array.from(main.querySelectorAll<HTMLElement>('[data-kb-card]'));
		const links = Array.from(main.querySelectorAll<HTMLElement>('[data-kb-link]'));
		const sections = Array.from(main.querySelectorAll<HTMLElement>('[data-kb-section]'));
		const stages = Array.from(main.querySelectorAll<HTMLElement>('[data-kb-stage]'));
		const groups = Array.from(main.querySelectorAll<HTMLElement>('[data-kb-group]'));
		const anchors = Array.from(main.querySelectorAll<HTMLElement>('[data-kb-anchor]'));
		const note = main.querySelector<HTMLElement>('[data-kb-note]');
		const noteText = main.querySelector<HTMLElement>('[data-kb-note-text]');
		const reset = main.querySelector<HTMLButtonElement>('[data-kb-reset]');
		const empty = main.querySelector<HTMLElement>('[data-kb-empty]');
		const total = main.querySelector<HTMLElement>('[data-kb-total]');
		const end = main.querySelector<HTMLElement>('[data-kb-end]');
		const totalLabel = total?.textContent ?? '';
		const endLabel = end?.textContent ?? '';

		const hasTag = (el: HTMLElement, tag: string) =>
			(tag ? (el.dataset.tags ?? '') : '')
				.split(',')
				.map((t) => t.trim())
				.filter(Boolean)
				.includes(tag);

		let active = '';

		const apply = (tag: string) => {
			active = tag;
			chips.forEach((chip) => {
				const on = chip.dataset.kbTag === tag;
				chip.classList.toggle('is-active', on);
				chip.setAttribute('aria-pressed', String(on));
			});

			let visibleCards = 0;
			cards.forEach((card) => {
				const on = !tag || hasTag(card, tag);
				card.hidden = !on;
				if (on) visibleCards += 1;
			});

			links.forEach((link) => {
				const on = !tag || hasTag(link, tag);
				// 分叉导航的条目本身就是 <a>，直接隐藏它；
				// 组件 CSS 里已显式兜住 display:flex 盖掉 [hidden] 的问题
				link.hidden = !on;
			});

			// 阶段小组：筛选后整组没有可见卡片就收起来，计数同步更新
			stages.forEach((stage) => {
				const shown = Array.from(stage.querySelectorAll<HTMLElement>('[data-kb-card]')).filter(
					(c) => !c.hidden,
				).length;
				stage.hidden = shown === 0;
				const count = stage.querySelector<HTMLElement>('[data-kb-stage-count]');
				if (count) count.textContent = `${String(shown).padStart(2, '0')} 条`;
			});

			sections.forEach((section) => {
				const on = Array.from(section.querySelectorAll<HTMLElement>('[data-kb-card]')).some((c) => !c.hidden);
				section.hidden = !on;
				const count = section.querySelector<HTMLElement>('[data-kb-count]');
				if (count) {
					const n = Array.from(section.querySelectorAll<HTMLElement>('[data-kb-card]')).filter(
						(c) => !c.hidden,
					).length;
					count.textContent = `${String(n).padStart(2, '0')} 条`;
				}
			});

			groups.forEach((group) => {
				const linksInGroup = Array.from(group.querySelectorAll<HTMLElement>('[data-kb-link]'));
				const shown = linksInGroup.filter((link) => !link.hidden).length;
				group.hidden = shown === 0;
				const count = group.querySelector<HTMLElement>('[data-kb-gcount]');
				if (count) count.textContent = String(shown).padStart(2, '0');
			});

			if (empty) empty.hidden = visibleCards > 0;
			if (total) total.textContent = tag ? `${String(visibleCards).padStart(2, '0')} 条` : totalLabel;
			if (end) end.textContent = tag ? String(visibleCards).padStart(2, '0') : endLabel;
			if (note) note.hidden = !tag;
			if (noteText) noteText.textContent = tag ? `筛选「${tag}」· ${visibleCards} 条` : '';
		};

		chips.forEach((chip) => {
			chip.addEventListener('click', () => {
				const tag = chip.dataset.kbTag ?? '';
				apply(active === tag ? '' : tag);
			});
		});
		reset?.addEventListener('click', () => apply(''));

		// 分类高亮：视口上半区（页头下方到约 38% 高处）属于哪个分类
		if (sections.length && 'IntersectionObserver' in window) {
			const BAND_TOP = 96;
			let currentId = '';
			const setActive = (id: string) => {
				if (!id || id === currentId) return;
				currentId = id;
				anchors.forEach((anchor) => {
					anchor.classList.toggle('is-active', anchor.dataset.kbAnchor === id);
				});
				// 分叉导航：把当前分类的首个可见条目点亮，强调色连线随之绘制
				main.querySelector('[data-branched]')?.dispatchEvent(
					new CustomEvent('bm:set-active', { detail: { anchor: id } }),
				);
				if (window.matchMedia('(max-width: 980px)').matches) {
					const activeAnchor = anchors.find((a) => a.dataset.kbAnchor === id);
					activeAnchor?.scrollIntoView({ block: 'nearest', inline: 'center' });
				}
			};

			const isAtBottom = () => {
				const max = document.documentElement.scrollHeight - window.innerHeight;
				// 内容还没把高度撑开时 max <= 0，不能误判成「已到底」
				return max > 0 && window.scrollY >= max - 2;
			};

			const update = () => {
				// 不能只从本次 entries 里挑：某个分区「进入」时，会把仍占着观察带的
				// 分区顶掉（分区变多后尤其明显）。每次都基于所有可见分区的实时位置，
				// 取与观察带重叠面积最大的那个。
				const bandBottom = window.innerHeight * 0.38;
				const visible = sections.filter((section) => !section.hidden);
				const atBottom = isAtBottom();
				let best = { id: '', overlap: 0 };
				for (const section of visible) {
					const box = section.getBoundingClientRect();
					const overlap = Math.min(box.bottom, bandBottom) - Math.max(box.top, BAND_TOP);
					if (overlap > best.overlap) best = { id: section.dataset.kbSection ?? '', overlap };
				}
				// 滚到底时最后一个分区往往只露出一小截，直接高亮它
				if (atBottom && visible.length) {
					best = { id: visible[visible.length - 1].dataset.kbSection ?? '', overlap: 1 };
				}
				if (best.overlap > 0) setActive(best.id);
			};

			const io = new IntersectionObserver(update, {
				rootMargin: `-${BAND_TOP}px 0px -62% 0px`,
				threshold: 0,
			});
			sections.forEach((section) => io.observe(section));

			// 页面较短时「跳到最后一组」会被滚动上限钳制，交叉状态不再变化，观察器
			// 也就不会再回调。只在滚到底时补一次重算，正常滚动不读布局、不增加开销。
			const controller = new AbortController();
			let raf = 0;
			window.addEventListener(
				'scroll',
				() => {
					if (raf) return;
					raf = requestAnimationFrame(() => {
						raf = 0;
						if (isAtBottom()) update();
					});
				},
				{ passive: true, signal: controller.signal },
			);
			// View Transitions 换页时撤掉监听与观察器，避免旧页面残留
			document.addEventListener(
				'astro:before-swap',
				() => {
					controller.abort();
					io.disconnect();
					cancelAnimationFrame(raf);
				},
				{ once: true, signal: controller.signal },
			);
		}
	}

	document.addEventListener('astro:page-load', init);
	if (document.readyState !== 'loading') init();
</script>

<style>
	.kb-main {
		width: var(--w-wide);
		max-width: calc(100% - var(--gutter) * 2);
		margin-inline: auto;
	}

	/* ── 页头 ── */
	.kb-head {
		padding: 1rem 0 clamp(1.4rem, 3vw, 2.2rem);
		border-bottom: 1px solid rgb(var(--line));
	}
	.kb-head h1 {
		margin: 0.16em 0 0.3em;
		font-size: clamp(2.1rem, 5vw, 3.4rem);
		letter-spacing: -0.04em;
	}
	.kb-head__desc {
		margin: 0;
		max-width: 34em;
		color: rgb(var(--muted));
		line-height: 1.75;
	}
	.kb-head__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1.4rem;
		margin: 0.9rem 0 0;
		font-size: 0.72rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: rgb(var(--muted-light));
		font-variant-numeric: tabular-nums;
	}
	.kb-filter-note {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 1rem 0 0;
		font-size: 0.8rem;
		color: rgb(var(--ink-soft));
	}
	.kb-filter-note[hidden] {
		display: none;
	}
	.kb-filter-note__reset {
		padding: 0.16rem 0.6rem;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		background: none;
		color: rgb(var(--muted));
		font: inherit;
		font-size: 0.74rem;
		cursor: pointer;
		transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
	}
	.kb-filter-note__reset:hover {
		color: rgb(var(--ink));
		border-color: rgb(var(--ink));
	}

	/* ── 空状态 ── */
	.kb-empty {
		margin-top: clamp(1.4rem, 3vw, 2rem);
		padding: clamp(1.4rem, 3.4vw, 2.4rem);
		border-radius: var(--card-radius);
		max-width: 44rem;
	}
	.kb-empty h2 {
		margin: 0.5rem 0 0.7rem;
		font-size: clamp(1.25rem, 2.4vw, 1.6rem);
	}
	.kb-empty p {
		margin: 0;
		color: rgb(var(--muted));
		line-height: 1.85;
	}
	.kb-empty code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.88em;
		padding: 0.1em 0.38em;
		border-radius: 4px;
		background: rgba(var(--accent), 0.12);
		color: rgb(var(--accent-deep));
	}

	/* ── 空状态：导航样式预览 ── */
