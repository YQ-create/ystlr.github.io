---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const notes = (await getCollection('knowledge'))
	.filter((n) => !n.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 按分类分组：pinned 置顶排前，其余按时间倒序
const byCategory = new Map<string, typeof notes>();
for (const note of notes) {
	const cat = note.data.category || '未分类';
	if (!byCategory.has(cat)) byCategory.set(cat, []);
	byCategory.get(cat)!.push(note);
}
// 分类顺序：置顶多的分类排前，再按分类名
const categories = [...byCategory.entries()].sort((a, b) => {
	const ap = a[1].filter((n) => n.data.pinned).length;
	const bp = b[1].filter((n) => n.data.pinned).length;
	if (ap !== bp) return bp - ap;
	return a[0].localeCompare(b[0], 'zh-Hans-CN');
});
---

<BaseLayout title={`知识库 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main class="kb-main">
		<header class="page-head" data-reveal>
			<span class="sec-head__index">KNOWLEDGE / {String(notes.length).padStart(2, '0')}</span>
			<h1>知识库</h1>
			<p>成体系的笔记与心得，独立于日常随笔，按分类慢慢沉淀。</p>
		</header>

		{notes.length === 0 ? (
			<div class="kb-empty glass" data-reveal>
				<span class="sec-head__index">EMPTY</span>
				<h2>知识库还空着</h2>
				<p>
					在 <code>src/content/knowledge/</code> 目录下新建一个 <code>.md</code> 文件，
					填上 <code>title / category / pubDate</code>，提交后就会在这里出现。
				</p>
			</div>
		) : (
			categories.map(([category, list]) => (
				<section class="kb-cat" data-reveal>
					<h2 class="kb-cat__title">
						<span class="kb-cat__name">{category}</span>
						<span class="kb-cat__count">{list.length}</span>
					</h2>
					<div class="kb-grid">
						{list.map((note) => (
							<a class="kb-card glass" href={`/knowledge/${note.id}/`}>
								<div class="kb-card__top">
									<span class="kb-card__tags">
										{note.data.tags.slice(0, 3).map((t) => (
											<span class="kb-card__tag">{t}</span>
										))}
									</span>
									{note.data.pinned && (
										<span class="kb-card__pin" title="置顶">◆</span>
									)}
								</div>
								<h3 class="kb-card__title">{note.data.title}</h3>
								{note.data.description && (
									<p class="kb-card__desc">{note.data.description}</p>
								)}
								<time class="kb-card__date" datetime={note.data.pubDate.toISOString()}>
									<FormattedDate date={note.data.pubDate} />
								</time>
							</a>
						))}
					</div>
				</section>
			))
		)}
	</main>
</BaseLayout>

<style>
	.kb-main {
		width: var(--w-page);
		margin-inline: auto;
	}
	.page-head {
		padding: 1rem 0 1.2rem;
	}
	.page-head h1 {
		margin: 0.2em 0 0.35em;
	}
	.page-head p {
		color: rgb(var(--muted));
		margin: 0;
	}

	.kb-empty {
		padding: clamp(1.4rem, 3.4vw, 2.4rem);
		border-radius: var(--r-lg);
		max-width: 44rem;
	}
	.kb-empty h2 {
		margin: 0.5rem 0 0.7rem;
		font-size: clamp(1.25rem, 2.4vw, 1.6rem);
	}
	.kb-empty p {
		margin: 0;
		color: rgb(var(--muted));
		line-height: 1.85;
	}
	.kb-empty code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.88em;
		padding: 0.1em 0.38em;
		border-radius: 4px;
		background: rgba(var(--accent), 0.12);
		color: rgb(var(--accent-deep));
	}

	.kb-cat {
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}
	.kb-cat__title {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-size: 1.2rem;
		color: rgb(var(--ink));
		margin: 0 0 1rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid rgba(var(--line), 1);
	}
	.kb-cat__count {
		font-size: 0.74rem;
		font-weight: 600;
		color: rgb(var(--muted-light));
		background: var(--chip-bg);
		border-radius: var(--r-pill);
		padding: 0.1rem 0.6rem;
	}

	.kb-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: clamp(0.8rem, 1.6vw, 1.1rem);
	}
	.kb-card {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 1.1rem 1.2rem;
		border-radius: var(--r-md);
		text-decoration: none;
		color: inherit;
		transition:
			transform var(--dur) var(--ease-out),
			box-shadow var(--dur) var(--ease-out),
			border-color var(--dur) var(--ease-out);
	}
	.kb-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--glass-shine), var(--shadow-lg);
		border-color: rgba(var(--accent), 0.4);
	}
	.kb-card__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.kb-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	.kb-card__tag {
		font-size: 0.68rem;
		color: rgb(var(--accent-deep));
		background: rgba(var(--accent), 0.12);
		border-radius: var(--r-pill);
		padding: 0.1rem 0.5rem;
	}
	.kb-card__pin {
		font-size: 0.7rem;
		color: rgb(var(--ochre));
	}
	.kb-card__title {
		margin: 0;
		font-size: 1.02rem;
		font-weight: 650;
		line-height: 1.4;
	}
	.kb-card__desc {
		margin: 0;
		font-size: 0.84rem;
		color: rgb(var(--muted));
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.kb-card__date {
		margin-top: auto;
		font-size: 0.74rem;
		color: rgb(var(--muted-light));
		letter-spacing: 0.04em;
	}
</style>
