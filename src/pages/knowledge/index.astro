---
// 知识库总览（内容优先）：
// 关键词搜索 + 阶段/主题筛选（stage/topics 独立字段）+ 前端学习路径 + 折叠分类。
// 分类默认折叠，只有含置顶笔记的分类展开；学习进度与最近阅读存 localStorage。
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const notes = (await getCollection('knowledge'))
	.filter((n) => !n.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 阶段与主题（独立受控字段）
const STAGES = ['入门', '核心', '进阶', '实战'];
const TOPICS = ['前端', '网络', '数据', '工具', '运行时', '算法'];
const stageTags = STAGES.filter((s) => notes.some((n) => n.data.stage === s));
const topicTags = TOPICS.filter((t) => notes.some((n) => n.data.topics.includes(t)));

// 分类分组：置顶多的排前，再按分类名
const byCategory = new Map<string, typeof notes>();
for (const note of notes) {
	const cat = note.data.category || '未分类';
	if (!byCategory.has(cat)) byCategory.set(cat, []);
	byCategory.get(cat)!.push(note);
}
const categories = [...byCategory.entries()].sort((a, b) => {
	const ap = a[1].filter((n) => n.data.pinned).length;
	const bp = b[1].filter((n) => n.data.pinned).length;
	if (ap !== bp) return bp - ap;
	return a[0].localeCompare(b[0], 'zh-Hans-CN');
});

// 前端入门学习路径：topics 含「前端」的笔记按阶段顺序
const STAGE_ORDER: Record<string, number> = { 入门: 0, 核心: 1, 进阶: 2, 实战: 3 };
const frontendPath = notes
	.filter((n) => n.data.topics.includes('前端'))
	.sort((a, b) => (STAGE_ORDER[a.data.stage ?? ''] ?? 9) - (STAGE_ORDER[b.data.stage ?? ''] ?? 9) || a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

const pad = (n: number) => String(n).padStart(2, '0');
const pinnedCount = notes.filter((n) => n.data.pinned).length;
---

<BaseLayout title={`知识库 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main class="kb-main">
		<header class="kb-head" data-reveal>
			<span class="sec-head__index">KNOWLEDGE / {pad(notes.length)}</span>
			<h1>知识库</h1>
			<p class="kb-head__desc">成体系的笔记与心得，按分类沉淀、按阶段推进。</p>
			<p class="kb-head__meta">
				<span>{pad(categories.length)} 个分类</span>
				<span>{pad(stageTags.length)} 个阶段 / {pad(topicTags.length)} 个主题</span>
				{pinnedCount > 0 && <span>{pad(pinnedCount)} 条置顶</span>}
			</p>
		</header>

		<!-- 搜索 + 筛选 -->
		<div class="kb-toolbar" data-reveal data-reveal-delay="60">
			<label class="kb-search">
				<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" d="M7 12.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Zm4-1.5 3 3"></path></svg>
				<input id="kb-search" type="search" placeholder="搜索标题或摘要…" aria-label="搜索知识库" autocomplete="off" />
			</label>
			<div class="kb-filter">
				{stageTags.length > 0 && (
					<div class="kb-filter__set" role="group" aria-label="按阶段筛选">
						<span class="kb-filter__label">阶段</span>
						{stageTags.map((s) => (
							<button class="kb-chip" type="button" data-kb-tag={s} aria-pressed="false">{s}</button>
						))}
					</div>
				)}
				{topicTags.length > 0 && (
					<div class="kb-filter__set" role="group" aria-label="按主题筛选">
						<span class="kb-filter__label">主题</span>
						{topicTags.map((t) => (
							<button class="kb-chip" type="button" data-kb-tag={t} aria-pressed="false">{t}</button>
						))}
					</div>
				)}
			</div>
			<p class="kb-filter-note" data-kb-note hidden>
				<span data-kb-note-text></span>
				<button type="button" class="kb-filter-note__reset" data-kb-reset>清除筛选</button>
			</p>
		</div>

		<!-- 前端学习路径 -->
		{frontendPath.length > 0 && (
			<section class="kb-path" data-reveal>
				<h2 class="kb-path__title">前端入门学习路径</h2>
				<p class="kb-path__desc">按「入门 → 核心 → 进阶 → 实战」的顺序，一步步学完前端主线。</p>
				<ol class="kb-path__list">
					{frontendPath.map((n, i) => (
						<li>
							<a href={`/knowledge/${n.id}/`} data-kb-card data-tags={`${n.data.stage ?? ''},${n.data.topics.join(',')}`}>
								<span class="kb-path__n">{String(i + 1).padStart(2, '0')}</span>
								<span class="kb-path__stage">{n.data.stage}</span>
								<span class="kb-path__name">{n.data.title}</span>
							</a>
						</li>
					))}
				</ol>
			</section>
		)}

		<!-- 最近阅读（localStorage） -->
		<section class="kb-recent" data-kb-recent hidden data-reveal>
			<h2 class="kb-recent__title">最近阅读</h2>
			<ul class="kb-recent__list" data-kb-recent-list></ul>
		</section>

		<!-- 分类列表（折叠） -->
		<div class="kb-cats">
			{categories.map(([cat, list], i) => {
				const hasPinned = list.some((n) => n.data.pinned);
				return (
					<section class="kb-cat" data-kb-cat data-category={cat}>
						<details class="kb-cat__details" open={hasPinned}>
							<summary class="kb-cat__summary">
								<span class="kb-cat__n">{pad(i + 1)}</span>
								<span class="kb-cat__name">{cat}</span>
								<span class="kb-cat__count">{pad(list.length)} 条</span>
							</summary>
							<ul class="kb-cat__list">
								{list.map((n) => (
									<li data-kb-card data-tags={`${n.data.stage ?? ''},${n.data.topics.join(',')}`}>
										<a href={`/knowledge/${n.id}/`}>
											<span class="kb-item__title">{n.data.title}</span>
											{n.data.stage && <span class="kb-item__stage">{n.data.stage}</span>}
											{n.data.pinned && <span class="kb-item__pin" title="置顶">◆</span>}
											<time><FormattedDate date={n.data.pubDate} /></time>
										</a>
										{n.data.description && <p class="kb-item__desc">{n.data.description}</p>}
									</li>
								))}
							</ul>
						</details>
					</section>
				);
			})}
		</div>

		<p class="kb-empty" data-kb-empty hidden>没有匹配的条目，换个关键词试试。</p>
	</main>
</BaseLayout>

<script>
	function initKb() {
		const main = document.querySelector<HTMLElement>('.kb-main');
		if (!main || main.dataset.kbWired) return;
		main.dataset.kbWired = '1';

		const search = document.getElementById('kb-search') as HTMLInputElement | null;
		const chips = Array.from(main.querySelectorAll<HTMLButtonElement>('[data-kb-tag]'));
		const cards = Array.from(main.querySelectorAll<HTMLElement>('[data-kb-card]'));
		const cats = Array.from(main.querySelectorAll<HTMLElement>('[data-kb-cat]'));
		const note = main.querySelector<HTMLElement>('[data-kb-note]');
		const noteText = main.querySelector<HTMLElement>('[data-kb-note-text]');
		const reset = main.querySelector<HTMLButtonElement>('[data-kb-reset]');
		const empty = main.querySelector<HTMLElement>('[data-kb-empty]');

		let activeTag = '';

		const apply = () => {
			const q = search?.value.trim().toLowerCase() ?? '';
			let visible = 0;
			cards.forEach((card) => {
				const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
				const matchTag = !activeTag || tags.includes(activeTag);
				const matchQ = !q || (card.textContent ?? '').toLowerCase().includes(q);
				const show = matchTag && matchQ;
				card.hidden = !show;
				if (show) visible++;
			});
			cats.forEach((cat) => {
				const anyVisible = Array.from(cat.querySelectorAll<HTMLElement>('[data-kb-card]')).some((c) => !c.hidden);
				cat.hidden = !anyVisible;
			});
			if (empty) empty.hidden = visible !== 0;
			if (note) note.hidden = !activeTag;
			if (noteText) noteText.textContent = activeTag ? `筛选「${activeTag}」· ${visible} 条` : '';
		};

		chips.forEach((chip) => {
			chip.addEventListener('click', () => {
				const tag = chip.dataset.kbTag ?? '';
				activeTag = activeTag === tag ? '' : tag;
				chips.forEach((c) => {
					const on = c.dataset.kbTag === activeTag;
					c.classList.toggle('is-active', on);
					c.setAttribute('aria-pressed', String(on));
				});
				apply();
			});
		});
		reset?.addEventListener('click', () => {
			activeTag = '';
			chips.forEach((c) => {
				c.classList.remove('is-active');
				c.setAttribute('aria-pressed', 'false');
			});
			apply();
		});
		search?.addEventListener('input', apply);

		// 最近阅读：从 localStorage 读
		const recentSec = main.querySelector<HTMLElement>('[data-kb-recent]');
		const recentList = main.querySelector<HTMLElement>('[data-kb-recent-list]');
		if (recentSec && recentList) {
			try {
				const raw = localStorage.getItem('ystlr:recent-reading');
				const list: { href: string; title: string }[] = raw ? JSON.parse(raw) : [];
				if (list.length) {
					recentList.innerHTML = list
						.map((item) => `<li><a href="${item.href}">${item.title.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c)}</a></li>`)
						.join('');
					recentSec.hidden = false;
				}
			} catch {}
		}
	}
	document.addEventListener('astro:page-load', initKb);
	if (document.readyState !== 'loading') initKb();
</script>

<style>
	.kb-main {
		width: var(--w-wide);
		max-width: calc(100% - var(--gutter) * 2);
		margin-inline: auto;
	}

	.kb-head {
		padding: 1rem 0 clamp(1.2rem, 3vw, 1.8rem);
		border-bottom: 1px solid rgb(var(--line));
	}
	.kb-head h1 {
		margin: 0.16em 0 0.3em;
		font-size: clamp(2rem, 5vw, 3.2rem);
		letter-spacing: -0.04em;
	}
	.kb-head__desc {
		margin: 0;
		max-width: 34em;
		color: rgb(var(--muted));
		line-height: 1.75;
	}
	.kb-head__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1.4rem;
		margin: 0.9rem 0 0;
		font-size: 0.72rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: rgb(var(--muted));
		font-variant-numeric: tabular-nums;
	}

	/* 工具栏 */
	.kb-toolbar {
		padding: 1.2rem 0 0.4rem;
	}
	.kb-search {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		max-width: 420px;
		padding: 0.55rem 0.9rem;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		color: rgb(var(--muted));
		background: var(--chip-bg);
	}
	.kb-search input {
		flex: 1;
		min-width: 0;
		border: 0;
		background: none;
		color: rgb(var(--ink));
		font: inherit;
		font-size: 0.92rem;
		outline: none;
	}
	.kb-filter {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin-top: 0.9rem;
	}
	.kb-filter__set {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
	}
	.kb-filter__label {
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		color: rgb(var(--muted));
		margin-right: 0.3rem;
	}
	.kb-chip {
		font-size: 0.78rem;
		padding: 0.32rem 0.85rem;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		background: none;
		color: rgb(var(--muted));
		cursor: pointer;
		transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
	}
	.kb-chip:hover {
		color: rgb(var(--ink));
	}
	.kb-chip.is-active {
		background: rgb(var(--accent));
		border-color: rgb(var(--accent));
		color: rgb(11, 11, 12);
		font-weight: 600;
	}
	.kb-filter-note {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.8rem 0 0;
		font-size: 0.8rem;
		color: rgb(var(--ink-soft));
	}
	.kb-filter-note[hidden] {
		display: none;
	}
	.kb-filter-note__reset {
		padding: 0.2rem 0.7rem;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		background: none;
		color: rgb(var(--muted));
		font: inherit;
		font-size: 0.74rem;
		cursor: pointer;
	}
	.kb-filter-note__reset:hover {
		color: rgb(var(--ink));
	}

	/* 学习路径 */
	.kb-path {
		margin-top: 1.6rem;
		padding: 1.2rem 1.3rem;
		border: 1px solid rgb(var(--line-soft));
		border-radius: var(--r-lg);
	}
	.kb-path__title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
	}
	.kb-path__desc {
		margin: 0.35rem 0 1rem;
		font-size: 0.82rem;
		color: rgb(var(--muted));
	}
	.kb-path__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.15rem;
	}
	.kb-path__list a {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		padding: 0.5rem 0.4rem;
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
	}
	.kb-path__list a:hover {
		background: var(--chip-bg);
	}
	.kb-path__n {
		font-size: 0.7rem;
		color: rgb(var(--accent));
		font-variant-numeric: tabular-nums;
		flex: none;
	}
	.kb-path__stage {
		font-size: 0.68rem;
		padding: 0.1rem 0.5rem;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		color: rgb(var(--muted));
		flex: none;
	}
	.kb-path__name {
		font-size: 0.92rem;
		font-weight: 500;
		color: rgb(var(--ink));
	}

	/* 最近阅读 */
	.kb-recent {
		margin-top: 1.6rem;
		padding: 1.2rem 1.3rem;
		border: 1px solid rgb(var(--line-soft));
		border-radius: var(--r-lg);
	}
	.kb-recent[hidden] {
		display: none;
	}
	.kb-recent__title {
		margin: 0 0 0.6rem;
		font-size: 0.9rem;
		font-weight: 700;
	}
	.kb-recent__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.1rem;
	}
	.kb-recent__list a {
		display: block;
		padding: 0.4rem 0;
		font-size: 0.88rem;
		color: rgb(var(--ink-soft));
		text-decoration: none;
	}
	.kb-recent__list a:hover {
		color: rgb(var(--accent));
	}

	/* 分类列表 */
	.kb-cats {
		margin-top: 1.8rem;
		display: grid;
		gap: 0.6rem;
	}
	.kb-cat[hidden] {
		display: none;
	}
	.kb-cat__details {
		border: 1px solid rgb(var(--line-soft));
		border-radius: var(--r-md);
		overflow: hidden;
	}
	.kb-cat__summary {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.85rem 1.1rem;
		cursor: pointer;
		list-style: none;
		user-select: none;
	}
	.kb-cat__summary::-webkit-details-marker {
		display: none;
	}
	.kb-cat__summary:hover {
		background: var(--chip-bg);
	}
	.kb-cat__n {
		font-size: 0.7rem;
		color: rgb(var(--muted));
		font-variant-numeric: tabular-nums;
	}
	.kb-cat__name {
		font-size: 1rem;
		font-weight: 650;
		color: rgb(var(--ink));
	}
	.kb-cat__count {
		margin-left: auto;
		font-size: 0.72rem;
		color: rgb(var(--muted));
		font-variant-numeric: tabular-nums;
	}
	.kb-cat__list {
		list-style: none;
		margin: 0;
		padding: 0 1.1rem 0.5rem;
	}
	.kb-cat__list li {
		padding: 0.6rem 0;
		border-top: 1px solid rgb(var(--line-soft));
	}
	.kb-cat__list li[hidden] {
		display: none;
	}
	.kb-cat__list a {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		text-decoration: none;
		color: inherit;
	}
	.kb-item__title {
		font-size: 0.95rem;
		font-weight: 500;
		color: rgb(var(--ink));
		transition: color var(--dur-fast) var(--ease-out);
	}
	.kb-cat__list a:hover .kb-item__title {
		color: rgb(var(--accent));
	}
	.kb-item__stage {
		font-size: 0.68rem;
		padding: 0.08rem 0.5rem;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		color: rgb(var(--muted));
	}
	.kb-item__pin {
		font-size: 0.68rem;
		color: rgb(var(--accent));
	}
	.kb-cat__list time {
		margin-left: auto;
		font-size: 0.74rem;
		color: rgb(var(--muted));
		font-variant-numeric: tabular-nums;
	}
	.kb-item__desc {
		margin: 0.3rem 0 0;
		font-size: 0.84rem;
		line-height: 1.6;
		color: rgb(var(--muted));
	}

	.kb-empty {
		margin: 2rem 0 0;
		text-align: center;
		color: rgb(var(--muted));
	}
	.kb-empty[hidden] {
		display: none;
	}
</style>
