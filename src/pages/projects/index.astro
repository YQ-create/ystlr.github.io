---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import WorkCard from '../../components/WorkCard.astro';
import { projects } from '../../data/projects';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`作品 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="works-main">
			<header class="page-head">
				<p class="kicker">SELECTED WORKS ↓</p>
				<h1>作品合集</h1>
				<p class="lead">品牌视觉、3D 图形、插画、产品渲染与摄影记录，按时间倒序排列。</p>
			</header>

			<div class="work-grid">
				{projects.map((project) => <WorkCard project={project} />)}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.works-main {
		max-width: none;
		width: 100%;
		padding: 0;
	}
	.page-head {
		max-width: 1120px;
		margin: 0 auto;
		padding: 5em 1.5em 2.5em;
	}
	.kicker {
		color: rgb(var(--accent));
		font-size: 0.9rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		margin: 0 0 0.8em;
	}
	.page-head h1 {
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		margin: 0 0 0.5em;
	}
	.lead {
		color: rgb(var(--muted));
		max-width: 560px;
		margin: 0;
	}
	.work-grid {
		max-width: 1120px;
		margin: 0 auto;
		padding: 1em 1.5em 5em;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.4em 1.8em;
	}
	@media (max-width: 720px) {
		.work-grid {
			grid-template-columns: 1fr;
			gap: 2em;
		}
	}
</style>
